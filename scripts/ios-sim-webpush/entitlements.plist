<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What the simulator's webpushd needs to subscribe and show notifications: the
  three the runtime's copy already carries, plus the device build's
  notification proxy and APNs entitlements (WebKit's
  Source/WebKit/Scripts/process-entitlements.sh, ios_family_process_webpushd_entitlements,
  which has no simulator branch). Test use in the iOS Simulator only.
-->
<plist version="1.0">
<dict>
  <key>com.apple.private.webkit.use-xpc-endpoint</key><true/>
  <key>com.apple.private.webkit.webpush</key><true/>
  <key>com.apple.runningboard.assertions.webkit</key><true/>
  <key>com.apple.private.usernotifications.app-management-domain.proxy</key><string>com.apple.WebKit.PushBundles</string>
  <key>com.apple.usernotification.notificationschedulerproxy</key><true/>
  <key>aps-connection-initiate</key><true/>
  <key>com.apple.frontboard.launchapplications</key><true/>
  <key>com.apple.private.launchservices.allowopenwithanyhandler</key><true/>
  <key>com.apple.springboard.opensensitiveurl</key><true/>
  <key>com.apple.private.launchservices.canspecifysourceapplication</key><true/>
  <key>com.apple.uikitservices.app.value-access</key><true/>
</dict>
</plist>
