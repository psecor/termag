# shellcheck shell=bash
# The body of <root>/real-github/git-credential (E2E_REAL_GITHUB), the git
# credential helper of every box's git for https://github.com. fakes.sh writes
# HOST_HOME, HOST_PATH and HOST_USER (yours, from the shell that ran up.sh)
# above it. It holds no credential: on `get` it asks your own git, with your
# HOME and your credential helpers (the keychain, gh's), and passes the answer
# to the box's git for that one request. `store` and `erase` are ignored, so
# nothing reaches your keychain or gh either.
#
# Read only: it answers only the remote helper git runs for an https fetch
# (git-remote-https) under a git clone, fetch, pull or ls-remote. A push gets
# nothing (pushes are also sent to the stub, fakes_box_github_gitconfig), and
# neither does a bare `git credential fill`, so git's own plumbing cannot print
# the token. fakes.sh makes it the box git's only credential helper (through
# the environment, real_github_helper), so no helper from a config file, a
# linked dotfiles .gitconfig's included, is sent its answer or git's `store`.
# A helper the box puts on a command line (git -c credential.helper=…,
# wrapping this one) still sees it. Stand-in boxes run as you, so this guards
# against accidents, not against code that sets out to read your credentials.
set -uo pipefail

action=${1:-}
input=$(cat)
[ "$action" = get ] || exit 0

field() { printf '%s\n' "$input" | sed -n "s/^$1=//p" | head -n 1; }
[ "$(field protocol)" = https ] && [ "$(field host)" = github.com ] || exit 0

# The git subcommand a command line runs: clone, fetch, pull, ls-remote and
# fetch-pack read; anything else (push, send-pack, credential) does not get one.
git_reads() {
  local -a words
  read -r -a words <<<"$1"
  [ "${#words[@]}" -gt 0 ] && [ "${words[0]##*/}" = git ] || return 1
  local i=1 w
  while [ "$i" -lt "${#words[@]}" ]; do
    w=${words[$i]}
    case $w in
      -c|-C|--git-dir|--work-tree|--namespace) i=$((i + 2)); continue ;;
      -*) i=$((i + 1)); continue ;;
    esac
    case $w in clone|fetch|pull|ls-remote|fetch-pack) return 0 ;; *) return 1 ;; esac
  done
  return 1
}

# Up the process tree to git-remote-https (git runs it as `git remote-https`,
# which execs git-remote-https as a child of its own), then the git command
# above them that started the transport.
fetching() {
  local pid=$PPID line ppid cmd depth=0 remote=
  while [ "$depth" -lt 12 ] && [ "${pid:-0}" -gt 1 ]; do
    line=$(ps -ww -o ppid=,command= -p "$pid" 2>/dev/null) || return 1
    line=${line#"${line%%[![:space:]]*}"}
    ppid=${line%%[[:space:]]*}
    cmd=${line#"$ppid"}
    cmd=${cmd#"${cmd%%[![:space:]]*}"}
    case " $cmd " in
      */git-remote-https\ *|*\ git-remote-https\ *|*/git\ remote-https\ *|*\ git\ remote-https\ *) remote=1 ;;
      *) if [ -n "$remote" ]; then git_reads "$cmd"; return; fi ;;
    esac
    pid=$ppid
    depth=$((depth + 1))
  done
  return 1
}
fetching || exit 0

out=$(cd / && env -i HOME="$HOST_HOME" PATH="$HOST_PATH" USER="$HOST_USER" LOGNAME="$HOST_USER" \
  GIT_TERMINAL_PROMPT=0 GCM_INTERACTIVE=never \
  git credential fill 2>/dev/null <<'EOF'
protocol=https
host=github.com

EOF
) || exit 0
printf '%s\n' "$out" | grep -E '^(username|password|password_expiry_utc|oauth_refresh_token)=' || true
