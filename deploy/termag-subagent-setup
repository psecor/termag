#!/usr/bin/env bash
# termag-subagent-setup -- prepare a box for agent-to-agent ask runs.
#
# Creates the `termag-subagent` system user (no login shell, no sudo, no
# docker group, home under the sandbox root) and the root it works in:
#
#   /var/lib/termag-subagent/          root 0755
#   /var/lib/termag-subagent/bin/      root 0755: termag-subagent-exec, the
#                                      token helper, and a copy of claude
#   /var/lib/termag-subagent/threads/  the box user 0755: one dir per thread
#
# Idempotent: run by termag-reconcile on every boot and by
# termag-subagent-run before a run when something is missing. Everything
# under bin/ is root-owned, so neither a run nor the box user's files can
# change what the next run executes without sudo.
#
# Usage:
#   termag-subagent-setup           create or repair, reporting what changed
#   termag-subagent-setup --check   report what is missing, change nothing:
#                                   exit 1 when setup would fix it, 3 when it
#                                   can't (no Claude Code, no systemd-run)
#
# Env (tests): TERMAG_SUBAGENT_ROOT, TERMAG_SUBAGENT_USER,
#   TERMAG_SUBAGENT_SUDO (default "sudo -n"), TERMAG_SUBAGENT_EXEC_SRC,
#   TERMAG_SUBAGENT_CLAUDE (default ~/.local/bin/claude),
#   TERMAG_SUBAGENT_OWNER (who owns the root and bin/, default root)
set -uo pipefail

ROOT=${TERMAG_SUBAGENT_ROOT:-/var/lib/termag-subagent}
SUBUSER=${TERMAG_SUBAGENT_USER:-termag-subagent}
read -r -a SUDO <<< "${TERMAG_SUBAGENT_SUDO-sudo -n}"
EXEC_SRC=${TERMAG_SUBAGENT_EXEC_SRC:-$HOME/.local/lib/termag/termag-subagent-exec}
CLAUDE_SRC=${TERMAG_SUBAGENT_CLAUDE:-$HOME/.local/bin/claude}
BOXUSER=$(id -un)
OWNER=${TERMAG_SUBAGENT_OWNER:-root}

MODE=apply
case "${1:-}" in
  --check) MODE=check ;;
  '') ;;
  -h|--help) sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *) printf 'termag-subagent-setup: unknown flag %s\n' "$1" >&2; exit 2 ;;
esac

todo=0
unfixable=0
say() { printf 'termag-subagent-setup: %s\n' "$*"; }
need() { todo=$((todo + 1)); if [ "$MODE" = check ]; then say "MISSING: $*"; return 1; fi; return 0; }
sudo_() { "${SUDO[@]}" "$@"; }

# The token helper: Claude Code's apiKeyHelper inside the run. It reads the box
# token systemd loaded for this run's unit only (LoadCredential=token:...).
TOKEN_HELPER='#!/bin/sh
# termag-subagent-token -- apiKeyHelper for an ask run (termag-subagent-setup).
exec cat "$CREDENTIALS_DIRECTORY/token"'

ensure_user() {
  if id -u "$SUBUSER" >/dev/null 2>&1; then return 0; fi
  need "user $SUBUSER" || return 0
  sudo_ useradd --system --user-group --home-dir "$ROOT/home" --no-create-home \
    --shell /usr/sbin/nologin --comment 'termag ask runs' "$SUBUSER" \
    && say "created user $SUBUSER" || { say "could not create user $SUBUSER"; return 1; }
}

# dir path owner mode
ensure_dir() {
  local path=$1 owner=$2 mode=$3 cur
  cur=$(stat -c '%U %a' "$path" 2>/dev/null) || cur=
  [ "$cur" = "$owner $mode" ] && return 0
  need "$path ($owner $mode)" || return 0
  sudo_ install -d -o "$owner" -m "$mode" "$path" \
    && sudo_ chown "$owner" "$path" && sudo_ chmod "$mode" "$path" \
    && say "prepared $path" || { say "could not prepare $path"; return 1; }
}

# file-from dest mode: install a root-owned copy when its content differs.
ensure_file() {
  local src=$1 dest=$2 mode=$3
  if [ -f "$dest" ] && cmp -s "$src" "$dest" && [ "$(stat -c '%U %a' "$dest" 2>/dev/null)" = "$OWNER $mode" ]; then return 0; fi
  need "$dest" || return 0
  sudo_ install -o "$OWNER" -m "$mode" "$src" "$dest" && say "installed $dest" || { say "could not install $dest"; return 1; }
}

# The run cannot read the owner's home, so claude is copied out of it. Keyed
# by the binary's real path, which names its version: a Claude Code update on
# the box gets a fresh copy on the next run.
ensure_claude() {
  local real
  real=$(readlink -f "$CLAUDE_SRC" 2>/dev/null) || real=
  if [ -z "$real" ] || [ ! -x "$real" ]; then
    unfixable=1; say "MISSING: claude at $CLAUDE_SRC (install Claude Code for $BOXUSER)"; return 1
  fi
  if [ -x "$ROOT/bin/claude" ] && [ "$(cat "$ROOT/bin/claude.src" 2>/dev/null)" = "$real" ]; then return 0; fi
  need "$ROOT/bin/claude (from $real)" || return 0
  sudo_ install -o "$OWNER" -m 0755 "$real" "$ROOT/bin/claude" \
    && printf '%s\n' "$real" | sudo_ tee "$ROOT/bin/claude.src" >/dev/null \
    && say "copied claude from $real" || { say "could not copy claude"; return 1; }
}

rc=0
ensure_user || rc=1
ensure_dir "$ROOT" "$OWNER" 755 || rc=1
ensure_dir "$ROOT/bin" "$OWNER" 755 || rc=1
ensure_dir "$ROOT/threads" "$BOXUSER" 755 || rc=1
if [ -f "$EXEC_SRC" ]; then
  ensure_file "$EXEC_SRC" "$ROOT/bin/termag-subagent-exec" 755 || rc=1
else
  todo=$((todo + 1)); say "MISSING: $EXEC_SRC (run termag-reconcile)"; rc=1
fi
helper=$(mktemp) && printf '%s\n' "$TOKEN_HELPER" > "$helper" && {
  ensure_file "$helper" "$ROOT/bin/termag-subagent-token" 755 || rc=1
  rm -f "$helper"
}
ensure_claude || rc=1
command -v systemd-run >/dev/null 2>&1 || { unfixable=1; say 'MISSING: systemd-run'; rc=1; }

if [ "$MODE" = check ]; then
  [ "$todo" -gt 0 ] && exit 1
  [ "$unfixable" = 1 ] && exit 3
  exit 0
fi
exit "$rc"
