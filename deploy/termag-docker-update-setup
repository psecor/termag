#!/usr/bin/env bash
# termag-docker-update-setup — put Docker's at-start updater in place.
# Run as root;
# idempotent.
#
# Docker is root's packages (download.docker.com, packer/scripts/setup.sh),
# and its update runs only at boot, before containerd and dockerd. This
# installs, all root's:
#
#   1. /usr/local/libexec/termag/: the recipe (termag-docker-update, 0755) and
#      its copy of termag-tool-update-lib (0644: root sources this one, never
#      the user's ~/.local/bin copy)
#   2. the system unit termag-docker-update.service, enabled (wanted by
#      multi-user.target), and /etc/termag/docker-update.env naming the agent
#      user by uid
#   3. /var/lib/termag/docker-update (0700): the lock and the rejection record
#
# No sudoers line and no start helper: nothing on a running box starts the
# unit. The agent only reads whether it is enabled (agent/tool-update.js).
#
# Content-compared like termag-reconcile: a current box writes nothing.
# Only where the image installed Docker from download.docker.com (its apt
# list is there); elsewhere it does nothing and reports nothing.
# Called by packer/scripts/setup.sh at bake, and by termag-reconcile through
# `sudo -n` on every boot and box update, so a box that predates it converges
# without a bake.
#
# Usage:
#   termag-docker-update-setup [--agent-user NAME]           apply, reporting only
#                                                        what changed
#   termag-docker-update-setup [--agent-user NAME] --check   report what is missing
#                       or differs, change nothing (exit 1 if anything)
#
# --agent-user is the box user the agent runs as (default termag, the name at
# bake; termag-reconcile passes its own name).
#
# Env (tests): TERMAG_DOCKER_SETUP_ROOT prefixes every path this writes or reads;
# TERMAG_DOCKER_SETUP_DEPLOY is where the sources are (default: this script's
# directory).
set -u

AGENT_USER=termag
DEPLOY="${TERMAG_DOCKER_SETUP_DEPLOY:-$(cd "$(dirname "$0")" && pwd)}"
ROOT="${TERMAG_DOCKER_SETUP_ROOT:-}"
LIBEXEC=/usr/local/libexec/termag

MODE=apply
while [ $# -gt 0 ]; do
  case "$1" in
    --check) MODE=check ;;
    --agent-user) AGENT_USER="${2:-}"; shift ;;
    -h|--help) sed -n '2,36p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) printf 'unknown flag: %s (try --help)\n' "$1" >&2; exit 2 ;;
  esac
  shift
done
AGENT_UID=$(id -u "$AGENT_USER" 2>/dev/null) || AGENT_UID=
case "$AGENT_UID" in
  ''|0) printf 'termag-docker-update-setup: no usable agent user %s\n' "$AGENT_USER" >&2; exit 2 ;;
esac

if [ -z "$ROOT" ] && [ "$(id -u)" != 0 ]; then
  echo 'termag-docker-update-setup: run as root' >&2
  exit 1
fi

changed=0
failed=0
units_changed=0

say() { printf '%s\n' "$*"; }
drift() { changed=$((changed + 1)); [ "$MODE" = check ] && say "DRIFT: $*"; return 0; }
broke() { failed=$((failed + 1)); printf 'termag-docker-update-setup: %s\n' "$*" >&2; }

# Owner flags only as root: a test run writes as its own user.
install_owned() {
  if [ "$(id -u)" = 0 ]; then install -o root -g root "$@"; else install "$@"; fi
}

# put <source> <installed path> <mode> <kind: unit|file>
# A source is a file in deploy/, or an absolute path (a rendered one).
put() {
  local src="$1" dest="$ROOT$2" mode=$3 kind=$4 name
  case "$src" in /*) name=$(basename "$src") ;; *) name=$src; src="$DEPLOY/$src" ;; esac
  if [ ! -f "$src" ]; then broke "missing source $src"; return; fi
  if cmp -s "$src" "$dest" 2>/dev/null && [ "$(stat -c %a "$dest")" = "$mode" ]; then
    return
  fi
  if [ -e "$dest" ]; then drift "$2 differs from $name"; else drift "$2 is missing"; fi
  [ "$MODE" = apply ] || return
  install_owned -d -m 0755 "$(dirname "$dest")" 2>/dev/null || mkdir -p "$(dirname "$dest")" || { broke "could not create $(dirname "$dest")"; return; }
  # Into place in one rename: sudo and systemd never read half a file.
  if install_owned -m "$mode" "$src" "$dest.termag-new" && mv -f "$dest.termag-new" "$dest"; then
    say "installed: $2"
    [ "$kind" = unit ] && units_changed=1
  else
    rm -f "$dest.termag-new"
    broke "could not install $2"
  fi
}

RENDERED=$(mktemp -d)
trap 'rm -rf "$RENDERED"' EXIT
printf '# The agent user, by uid (deploy/termag-docker-update-setup).\nTERMAG_DOCKER_AGENT_UID=%s\n' "$AGENT_UID" >"$RENDERED/docker-update.env"

# Only a box whose Docker is the image's, from Docker's own repository.
DOCKER_LIST="${TERMAG_DOCKER_SETUP_LIST:-/etc/apt/sources.list.d/docker.list}"
if ! grep -qs '^deb .*https://download\.docker\.com/linux/ubuntu' "$ROOT$DOCKER_LIST"; then
  [ "$MODE" = check ] && say "no $DOCKER_LIST from download.docker.com: nothing to set up"
  exit 0
fi

# ── 1 and 2. the files ────────────────────────────────────────────────────────
# The lib and the recipe before the unit that runs them, so a setup that stops
# halfway never leaves an enabled unit on missing code.
put termag-tool-update-lib "$LIBEXEC/termag-tool-update-lib" 644 file
put termag-docker-update "$LIBEXEC/termag-docker-update" 755 file
put "$RENDERED/docker-update.env" /etc/termag/docker-update.env 644 file
put termag-docker-update.service /etc/systemd/system/termag-docker-update.service 644 unit

# Enabled: a link in multi-user.target.wants, as `systemctl enable` makes it
# (written here so a test root gets it too, and a bake without a running
# systemd as well).
wants="$ROOT/etc/systemd/system/multi-user.target.wants/termag-docker-update.service"
if [ "$(readlink "$wants" 2>/dev/null)" != /etc/systemd/system/termag-docker-update.service ]; then
  drift "termag-docker-update.service is not enabled"
  if [ "$MODE" = apply ]; then
    { mkdir -p "$(dirname "$wants")" && ln -sfn /etc/systemd/system/termag-docker-update.service "$wants"; } \
      && { say "installed: enabled termag-docker-update.service"; units_changed=1; } || broke "could not enable termag-docker-update.service"
  fi
fi

# ── 3. the state directory ────────────────────────────────────────────────────
state="$ROOT/var/lib/termag/docker-update"
if [ ! -d "$state" ] || [ "$(stat -c %a "$state")" != 700 ]; then
  drift "/var/lib/termag/docker-update is missing or not 0700"
  if [ "$MODE" = apply ]; then
    { install_owned -d -m 0700 "$state" && chmod 0700 "$state"; } && say "installed: /var/lib/termag/docker-update" || broke "could not create /var/lib/termag/docker-update"
  fi
fi

if [ "$MODE" = apply ] && [ "$units_changed" = 1 ] && [ -z "$ROOT" ]; then
  systemctl daemon-reload || broke 'daemon-reload failed'
fi

[ "$MODE" = check ] && [ "$changed" -gt 0 ] && exit 1
[ "$failed" -gt 0 ] && exit 1
exit 0
