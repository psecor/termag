#!/bin/bash
# termag-gh-update-start — start one GitHub CLI update run, as root.
# Installed as
# /usr/local/libexec/termag/termag-gh-update-start (root's, 0755) by
# deploy/termag-gh-update-setup; deploy/termag-gh-update.sudoers lets the
# agent user run this, and only this, as root, with one argument.
#
# It takes a run id and starts termag-gh-update@<run>.service, the system
# unit that runs deploy/termag-gh-update as root, without waiting for it
# (the agent's tool-update RPC answers at once). Nothing else: no shell, no
# other unit, no other verb. The run id is the orchestrator's id pattern,
# checked here as the sudoers rule and the recipe check it.
#
# Usage: termag-gh-update-start <run-id>
set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin
if [ $# -ne 1 ] || ! [[ "$1" =~ ^[a-z0-9]{20,40}$ ]]; then
  printf 'usage: termag-gh-update-start <run-id>\n' >&2
  exit 2
fi
exec systemctl start --no-block "termag-gh-update@$1.service"
