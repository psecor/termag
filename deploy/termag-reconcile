reconcile_pi_config() {
  # Same gate as the Claude config: an older checkout without the server has
  # nothing to register. Pi not being installed is fine -- the file simply
  # waits for it, as the Claude one does.
  [ -f "$CHECKOUT/metaterm/mcp-server.mjs" ] || return 0
  if ! command -v jq >/dev/null 2>&1; then
    printf 'termag-reconcile: jq not found; skipping the MetaTerm pi config\n' >&2
    return 0
  fi
  # Owner-tunable pi fields survive the merge: enabled (the only durable
  # off-switch -- `pi mcp remove` is simply re-added), exposure, toolExposure,
  # timeout, cwd. Everything else is rewritten to the canonical value. A
  # non-object entry (a scalar the owner or an old write left behind) is
  # coerced to {} first, so with_entries cannot error on it.
  merge_json "$HOME/.pi/agent/mcp.json" 'MetaTerm MCP server (pi)' "$PI_METATERM_MCP" \
    '.mcpServers.metaterm = ($v + ((.mcpServers.metaterm // {}) | if type == "object" then . else {} end | with_entries(select(.key | IN("enabled","exposure","toolExposure","timeout","cwd")))))'
}

# Devin's status hooks: deploy/devin-hooks.json merged
# into the `hooks` key of ~/.config/devin/config.json, the only global hook
# location Devin reads (a hooks.v1.json under ~/.config/devin or ~/.devin is
# ignored). Every hook that invokes termag-status, under any event, is dropped
# (a group it leaves empty goes with it) and the canonical ones are appended
# per event; the owner's other hooks and every other key (Devin's own
# permissions allow-list lives in this file) are kept. Devin keeps the key when
# it rewrites the file, and accepts a file holding only `hooks`, so a box whose
# owner has not run Devin yet gets one that waits for it, as pi's does.
reconcile_devin_hooks() {
  local canon="$CHECKOUT/deploy/devin-hooks.json" hooks
  [ -f "$canon" ] || return 0
  if ! command -v jq >/dev/null 2>&1; then
    printf 'termag-reconcile: jq not found; skipping the Devin status hooks\n' >&2
    return 0
  fi
  hooks=$(jq -c '.hooks' "$canon") || return 0
  merge_json "$HOME/.config/devin/config.json" 'termag status hooks (Devin)' "$hooks" '
    def termag: (.command // "") | test("termag-status");
    def strip: map(if any(.hooks[]?; termag)
      then (.hooks |= map(select(termag | not))) | select(.hooks | length > 0)
      else . end);
    .hooks = ((.hooks // {}) as $eh
      | reduce ((($eh | keys) + ($v | keys)) | unique[]) as $ev ($eh;
          .[$ev] = ((($eh[$ev] // []) | strip) + ($v[$ev] // [])))
      | with_entries(select((.value | length) > 0 or (($eh[.key] // []) | length) == 0)))'
}

# The Generated-by: termag commit trailer (deploy/termag-commit-msg). The hook
# sits in the box user's git template, which init.templateDir names in the XDG
# global config ($XDG_CONFIG_HOME/git/config, never ~/.gitconfig, which may be an
# owner's dotfiles symlink) as a tilde path, because the bake home is renamed at
# first boot. Every repository inited or cloned afterwards gets a copy; the
# termag projects that already exist get one too when they have no commit-msg
# hook of their own, and an older copy of ours is updated. A global
# core.hooksPath would reach every repository at once, but pre-commit refuses
# to install while one is set. An owner's own init.templateDir is left alone,
# and then nothing is copied into projects either.
# shellcheck disable=SC2088  # git expands the tilde itself
GIT_TEMPLATE_PATH='~/.local/share/termag/git-template'

reconcile_git_template() {
  local hook="$GIT_TEMPLATE_DIR/hooks/commit-msg" cur dest
  local xdg="${XDG_CONFIG_HOME:-$HOME/.config}/git/config"
  [ -x "$hook" ] || return 0
  command -v git >/dev/null 2>&1 || return 0
  # Both global files, the way git itself reads them (~/.gitconfig after XDG,
  # so it wins). Not `git config --global`: once ~/.gitconfig exists that reads
  # only it, and the XDG value written below would never be seen.
  cur=$(git config --includes --file "$HOME/.gitconfig" --type=path --get init.templateDir 2>/dev/null \
    || git config --includes --file "$xdg" --type=path --get init.templateDir 2>/dev/null \
    || true)
  if [ -z "$cur" ]; then
    changed=$((changed + 1))
    if [ "$MODE" = check ]; then
      printf 'DRIFT: no global init.templateDir (would set %s)\n' "$GIT_TEMPLATE_PATH"
    elif mkdir -p "$(dirname "$xdg")" \
      && git config --file "$xdg" init.templateDir "$GIT_TEMPLATE_PATH"; then
      printf 'reconciled: init.templateDir %s in %s\n' "$GIT_TEMPLATE_PATH" "$xdg"
    else
      printf 'termag-reconcile: failed to set init.templateDir\n' >&2
      return 0
    fi
  elif [ "$(realpath -m -- "$cur")" != "$(realpath -m -- "$GIT_TEMPLATE_DIR")" ]; then
    return 0
  fi
  for dest in "$HOME"/termag/projects/*/.git/hooks; do
    [ -d "$dest" ] || continue
    dest="$dest/commit-msg"
    if [ -e "$dest" ] || [ -L "$dest" ]; then
      grep -q '^# termag-commit-msg ' "$dest" 2>/dev/null || continue
      cmp -s "$hook" "$dest" && continue
    fi
    changed=$((changed + 1))
    if [ "$MODE" = check ]; then
      printf 'MISSING: %s (would install the commit trailer hook)\n' "$dest"
    elif install -m 755 "$hook" "$dest"; then
      printf 'reconciled: %s\n' "$dest"
    else
      printf 'termag-reconcile: failed to install %s\n' "$dest" >&2
    fi
  done
}

# Every file of each deploy/claude-plugins/<name>/ except *.test.ts, rendered,
# into CLAUDE_PLUGINS_DIR/<name>/; a file no longer in the checkout is removed.
# Rendering on every boot also follows the home rename cloud-init does.
reconcile_claude_plugins() {
  local root="$DEPLOY/claude-plugins" plugin name rel src dest tmp
  [ -d "$root" ] || return 0
  for plugin in "$root"/*/; do
    [ -d "$plugin" ] || continue
    name=$(basename "$plugin")
    while IFS= read -r -d '' src; do
      rel=${src#"$plugin"}
      dest="$CLAUDE_PLUGINS_DIR/$name/$rel"
      tmp=$(mktemp) || return 0
      sed "s#@TERMAG_MCP_VERSION_FILE@#$HOME/.config/termag/mcp-connectors.version#g" "$src" > "$tmp"
      if cmp -s "$tmp" "$dest" 2>/dev/null; then rm -f "$tmp"; continue; fi
      changed=$((changed + 1))
      if [ "$MODE" = check ]; then
        if [ -e "$dest" ]; then printf 'DRIFT: %s differs from %s\n' "$dest" "$src"; else printf 'MISSING: %s (would install from %s)\n' "$dest" "$src"; fi
      elif mkdir -p "$(dirname "$dest")" && install -m 644 "$tmp" "$dest"; then
        printf 'reconciled: %s\n' "$dest"
      else
        printf 'termag-reconcile: failed to install %s\n' "$dest" >&2
      fi
      rm -f "$tmp"
    done < <(find "$plugin" -type f ! -name '*.test.ts' -print0)
    [ -d "$CLAUDE_PLUGINS_DIR/$name" ] || continue
    while IFS= read -r -d '' dest; do
      rel=${dest#"$CLAUDE_PLUGINS_DIR/$name/"}
      [ -f "$plugin$rel" ] && [[ "$rel" != *.test.ts ]] && continue
      changed=$((changed + 1))
      if [ "$MODE" = check ]; then
        printf 'STALE: %s (would remove; not in %s)\n' "$dest" "$plugin"
      elif rm -f "$dest"; then
        printf 'reconciled: removed %s\n' "$dest"
      fi
    done < <(find "$CLAUDE_PLUGINS_DIR/$name" -type f -print0)
  done
}

# ~/.local and ~/.local/state without group or other write. The box image's
# umask 002 makes them drwxrwxr-x, and tools that check every ancestor of their
# state directory (cmux's remote helper is one) refuse to start under that.
# Only go-w is ever applied, so nothing is loosened and a second run finds
# nothing to do. -L: an owner's symlinked ~/.local is judged by its target.
reconcile_local_dir_modes() {
  local dir perm
  for dir in "$HOME/.local" "$HOME/.local/state"; do
    if [ ! -e "$dir" ]; then
      changed=$((changed + 1))
      if [ "$MODE" = check ]; then
        printf 'MISSING: %s (would create without group or other write)\n' "$dir"
      elif mkdir -p "$dir" && chmod go-w "$dir"; then
        printf 'reconciled: created %s\n' "$dir"
      else
        printf 'termag-reconcile: failed to create %s\n' "$dir" >&2
      fi
      continue
    fi
    perm=$(ls -ldL -- "$dir" 2>/dev/null) || continue
    case $perm in
      ?????w*|????????w*) ;;
      *) continue ;;
    esac
    changed=$((changed + 1))
    if [ "$MODE" = check ]; then
      printf 'DRIFT: %s is group- or other-writable\n' "$dir"
    elif chmod go-w "$dir"; then
      printf 'reconciled: removed group and other write from %s\n' "$dir"
    else
      printf 'termag-reconcile: failed to remove group and other write from %s\n' "$dir" >&2
    fi
  done
}

WANTS="$HOME/.config/systemd/user/default.target.wants"

# Is the unit enabled, i.e. does the wants symlink point where it should?
unit_enabled() {
  [ "$(readlink "$WANTS/$1" 2>/dev/null)" = "../$1" ]
}

# Equivalent of `systemctl --user enable`, done with a symlink so it works with
# no running user manager (the AMI bake has none, and neither does a --check run
# over SSH). Returns 0 only when it actually changed something.
enable_unit() {
  unit_enabled "$1" && return 1
  mkdir -p "$WANTS" || return 1
  ln -sfn "../$1" "$WANTS/$1" || return 1
  return 0
}

if [ "$MODE" = list ]; then artifacts; exit 0; fi

if [ ! -d "$DEPLOY" ]; then
  printf 'termag-reconcile: no checkout at %s; nothing to reconcile\n' "$CHECKOUT" >&2
  exit 0
fi

changed=0
reload=0

while IFS=: read -r name dest mode kind enable; do
  [ -n "${name:-}" ] || continue
  src="$DEPLOY/$name"
  # A source that isn't in this checkout yet is not an error: an older checkout
  # legitimately has fewer artifacts than a newer script knows about.
  [ -f "$src" ] || continue

  # Enablement is checked independently of content: a box can already have the
  # right unit file and still not have the symlink, which is precisely the state
  # every box built before this script existed is in.
  if [ "${enable:-noenable}" = enable ] && ! unit_enabled "$name"; then
    if [ "$MODE" = check ]; then
      printf 'NOT-ENABLED: %s (would link into %s)\n' "$name" "$WANTS"
      changed=$((changed + 1))
    elif enable_unit "$name"; then
      printf 'enabled: %s\n' "$name"
      changed=$((changed + 1))
      reload=1
    else
      printf 'termag-reconcile: failed to enable %s\n' "$name" >&2
    fi
  fi

  if cmp -s "$src" "$dest" 2>/dev/null; then
    continue
  fi

  if [ "$MODE" = check ]; then
    if [ -e "$dest" ]; then
      printf 'DRIFT: %s differs from %s\n' "$dest" "$src"
    else
      printf 'MISSING: %s (would install from %s)\n' "$dest" "$src"
    fi
    changed=$((changed + 1))
    continue
  fi

  mkdir -p "$(dirname "$dest")" || continue
  # install(1) writes to a temp name and renames, so a concurrent reader never
  # sees a half-written file. Reconciling this script while it is itself running
  # is safe for the same reason: the running process keeps the old inode.
  if install -m "$mode" "$src" "$dest"; then
    printf 'reconciled: %s\n' "$dest"
    changed=$((changed + 1))
    [ "$kind" = unit ] && reload=1
  else
    printf 'termag-reconcile: failed to install %s\n' "$dest" >&2
  fi
done <<EOF
$(artifacts)
EOF

reconcile_claude_config
reconcile_claude_path_hook
reconcile_claude_onboarding
reconcile_cli
reconcile_t3_server
retire_ask_sandbox
reconcile_guest_browser
reconcile_gh_update
reconcile_aws_update
reconcile_terminfo
reconcile_pi_config
reconcile_devin_hooks
reconcile_git_template
reconcile_claude_plugins
reconcile_local_dir_modes

if [ "$MODE" = check ]; then
  [ "$changed" -eq 0 ] || exit 1
  exit 0
fi

if [ "$reload" = 1 ]; then
  # Reload only. Restarting termag-agent here is what this script exists to
  # avoid; the unit is ordered before it, so systemd will start it from the
  # reconciled unit without any restart.
  systemctl --user daemon-reload 2>/dev/null \
    && printf 'reconciled: systemd user daemon-reload\n' \
    || printf 'termag-reconcile: daemon-reload failed (no user manager?)\n' >&2
fi

exit 0
