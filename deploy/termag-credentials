#!/usr/bin/env bash
# termag-credentials — apply credentials the orchestrator delivers to this box
# termag-agent runs it for the credentials-apply and
# credentials-remove RPCs, with the payload on stdin; it never logs a value.
#
# Usage:
#   termag-credentials apply claude-gateway   < {apiKeyHelper, env}  merged into ~/.claude/settings.json
#   termag-credentials apply github           < {broker, login}   git and gh via the orchestrator's broker
#   termag-credentials remove claude-gateway|github
#   termag-credentials skip claude-gateway    this box logs in to Claude by hand instead
#   termag-credentials unskip claude-gateway  back to the gateway at the next delivery
#   termag-credentials skip github            this box uses your own gh/git credentials: no broker rewrites, no GH_HOST
#   termag-credentials unskip github          back to the broker at the next delivery
#   termag-credentials status                 each credential: on, off and why, or NOT WORKING and why
#
# Everything is content-compared, so a repeated delivery changes nothing, and
# remove only ever touches what apply wrote.
#
# No GitHub or Claude credential is ever written to the box: git and gh reach
# GitHub through the orchestrator's broker, and Claude Code reaches Bedrock
# through the Claude gateway, both authenticated with this box's agent token,
# read from the agent config on each use.
#
# Env: TERMAG_AGENT_CONFIG (set by termag-agent). Tests: TERMAG_CLAUDE_SETTINGS, TERMAG_CLAUDE_MANAGED_SETTINGS,
# TERMAG_CREDENTIALS_SUDO, GIT_CONFIG_SYSTEM, TERMAG_PROFILE_D
set -euo pipefail

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
CLAUDE_SETTINGS="${TERMAG_CLAUDE_SETTINGS:-$HOME/.claude/settings.json}"
# Where an earlier revision put the gateway settings; removed on every apply.
MANAGED="${TERMAG_CLAUDE_MANAGED_SETTINGS:-/etc/claude-code/managed-settings.json}"
SUDO="${TERMAG_CREDENTIALS_SUDO-sudo -n}"
STATE="$HOME/.config/termag"
SKIP="$STATE/claude-gateway.skip"
# The keys apply last merged into CLAUDE_SETTINGS, with their values: what
# remove takes out again, and what termag-claude-runner strips from the host
# config it hands a runner.
CLAUDE_STATE="$STATE/claude-gateway.json"
GH_TOKEN_HASH="$STATE/github-token.sha256"
KEY="$HOME/.ssh/termag_github"
SSH_CONFIG="$HOME/.ssh/config"
BEGIN='# >>> termag github (managed by termag-credentials)'
END='# <<< termag github'
GIT_SYSTEM="${GIT_CONFIG_SYSTEM:-/etc/gitconfig}"
PROFILE_D="${TERMAG_PROFILE_D:-/etc/profile.d}"
ZSHENV="$HOME/.zshenv"
BROKER_STATE="$STATE/github-broker"
GH_SKIP="$STATE/github.skip"
BROKER_BEGIN='# >>> termag github broker (managed by termag-credentials)'
BROKER_END='# <<< termag github broker'
HELPER_PLACEHOLDER='@TERMAG_CLAUDE_TOKEN@'

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
chmod 700 "$WORK"

say() { printf 'termag-credentials: %s\n' "$*" >&2; }

write_if_changed() {  # src dest mode
  if [ -f "$2" ] && cmp -s "$1" "$2"; then return 1; fi
  install -m "$3" "$1" "$2"
}

# Why the orchestrator removed a credential ({"reason": ...} on stdin), for
# status. An apply clears it.
record_reason() {  # provider
  local reason=
  [ -t 0 ] || reason=$(jq -r '.reason // empty' 2>/dev/null || true)
  install -d -m 700 "$STATE"
  if [ -n "$reason" ]; then printf '%s\n' "$reason" > "$STATE/$1.status"; fi
}
clear_reason() { rm -f "$STATE/$1.status"; }

# ── Claude gateway ───────────────────────────────────────────────────────────
# The gateway settings go into the owner's user settings, not managed settings:
# a Claude Code cloud session on this box gets its own config dir from the
# runner (termag-claude-runner), never reads this file, and so infers with the
# token Anthropic issues it. Managed settings would reach every session.
#
# Merged key by key into a file the owner edits. A key the owner set to a value
# of their own is left alone (and not recorded as ours); remove takes out only
# the keys whose value is still the one apply wrote.

# The delivery's keys as [path, value] pairs.
JQ_PAIRS='def pairs: [(if has("apiKeyHelper") then [["apiKeyHelper"], .apiKeyHelper] else empty end),
                      ((.env // {}) | to_entries[] | [["env", .key], .value])];'
# Drop the recorded keys that still hold the recorded value; an emptied env goes too.
JQ_STRIP='def strip($mine): reduce ($mine | pairs[]) as $p (.; if getpath($p[0]) == $p[1] then delpaths([$p[0]]) else . end)
                        | if .env == {} then del(.env) else . end;'

# Writes through a symlink to its target (dotfiles), keeping the file's mode.
write_settings() {  # json-file dest
  local dest tmp
  # readlink -f needs the parent to exist (a box that never ran claude has no ~/.claude).
  mkdir -p "$(dirname "$2")"
  dest=$(readlink -f "$2")
  tmp=$(mktemp "$dest.XXXXXX")
  if [ -e "$dest" ]; then chmod --reference="$dest" "$tmp"; else chmod 600 "$tmp"; fi
  jq . "$1" > "$tmp" && mv -f "$tmp" "$dest" || { rm -f "$tmp"; return 1; }
}

claude_apply() {
  local work=$WORK
  if [ -e "$SKIP" ]; then
    claude_remove
    say 'claude-gateway skipped on this box (termag-credentials unskip claude-gateway to undo)'
    return 0
  fi
  local config
  config=$(agent_config) || { say 'no agent config for the Claude gateway token'; return 1; }
  # apiKeyHelper is a shell command; both paths are quoted for it.
  jq --arg helper "$SELF_DIR/termag-claude-token" --arg config "$config" --arg ph "$HELPER_PLACEHOLDER" \
    'if .apiKeyHelper == $ph then .apiKeyHelper = "\($helper | @sh) \($config | @sh)" else . end' > "$work/delivery.json"
  jq -e '.env.CLAUDE_CODE_USE_BEDROCK == "1"' "$work/delivery.json" >/dev/null \
    || { say 'refusing claude-gateway settings without CLAUDE_CODE_USE_BEDROCK'; return 1; }
  clear_reason claude-gateway
  if [ -s "$CLAUDE_SETTINGS" ]; then cp "$CLAUDE_SETTINGS" "$work/current.json"; else echo '{}' > "$work/current.json"; fi
  if [ -s "$CLAUDE_STATE" ]; then cp "$CLAUDE_STATE" "$work/mine.json"; else echo '{}' > "$work/mine.json"; fi
  jq -e 'type == "object"' "$work/current.json" >/dev/null 2>&1 \
    || { say "$CLAUDE_SETTINGS is not a JSON object; not adding the Claude gateway"; return 1; }
  # Our previous keys out, then each delivered key in unless the owner holds it.
  jq --slurpfile mine "$work/mine.json" --slurpfile new "$work/delivery.json" "$JQ_PAIRS $JQ_STRIP"'
    strip($mine[0]) as $base
    | reduce ($new[0] | pairs[]) as $p ({settings: $base, mine: {}, kept: []};
        if ($base | getpath($p[0])) == null
        then .settings |= setpath($p[0]; $p[1]) | .mine |= setpath($p[0]; $p[1])
        elif ($base | getpath($p[0])) == $p[1] then .
        else .kept += [$p[0] | join(".")] end)' "$work/current.json" > "$work/merged.json"
  jq '.settings' "$work/merged.json" > "$work/settings.json"
  jq '.mine' "$work/merged.json" > "$work/mine.next.json"
  if [ -n "$(jq -r '.kept | join(", ")' "$work/merged.json")" ]; then
    say "left your own $(jq -r '.kept | join(", ")' "$work/merged.json") in $CLAUDE_SETTINGS in place of the gateway's"
  fi
  install -d -m 700 "$STATE"
  if ! { [ -s "$CLAUDE_SETTINGS" ] && [ "$(jq -S . "$work/current.json")" = "$(jq -S . "$work/settings.json")" ]; }; then
    write_settings "$work/settings.json" "$CLAUDE_SETTINGS" || { say "failed to write $CLAUDE_SETTINGS"; return 1; }
    say "wrote the Claude gateway settings into $CLAUDE_SETTINGS"
  fi
  write_if_changed "$work/mine.next.json" "$CLAUDE_STATE" 600 || true
  # Only now: until the user settings hold the gateway, the managed copy is
  # all an existing box has.
  remove_managed
}

claude_remove() {
  remove_managed
  [ -s "$CLAUDE_STATE" ] || return 0
  if [ -s "$CLAUDE_SETTINGS" ]; then
    jq --slurpfile mine "$CLAUDE_STATE" "$JQ_PAIRS $JQ_STRIP"' strip($mine[0])' "$CLAUDE_SETTINGS" > "$WORK/settings.json" 2>/dev/null \
      || { say "$CLAUDE_SETTINGS is not valid JSON; the Claude gateway keys are still in it"; return 1; }
    if [ "$(jq -S . "$CLAUDE_SETTINGS")" != "$(jq -S . "$WORK/settings.json")" ]; then
      write_settings "$WORK/settings.json" "$CLAUDE_SETTINGS" || { say "failed to write $CLAUDE_SETTINGS"; return 1; }
      say "removed the Claude gateway settings from $CLAUDE_SETTINGS"
    fi
  fi
  rm -f "$CLAUDE_STATE"
}

# The managed settings file an earlier revision wrote. Only a file this script
# wrote: its apiKeyHelper is our token helper. Match the name, not the path:
# the agent's copy and the one on PATH differ.
remove_managed() {
  [ -e "$MANAGED" ] || return 0
  if jq -e '(.apiKeyHelper // "") | test("/termag-claude-token(\u0027|$)")' "$MANAGED" >/dev/null 2>&1; then
    $SUDO rm -f "$MANAGED"
    say "removed $MANAGED"
  fi
}

# ── GitHub (through the orchestrator's broker) ──────────────────────────────
strip_block() {  # begin end < in > out
  awk -v b="$1" -v e="$2" '$0 == b { skip = 1; next } $0 == e { skip = 0; next } !skip'
}

# A file's content, or nothing when it does not exist yet (/etc/gitconfig
# usually doesn't).
content_of() { if [ -f "$1" ]; then cat "$1"; fi; }

agent_config() {
  local c
  for c in "${TERMAG_AGENT_CONFIG:-}" "$HOME/src/termag/agent/agent.config.json" \
           "$HOME/.termag/agent.config.json" "$HOME/.config/termag/agent.config.json"; do
    if [ -n "$c" ] && [ -r "$c" ]; then printf '%s' "$c"; return 0; fi
  done
  return 1
}

# What the pre-broker revision wrote: a per-user key, an ssh config block and a
# gh login to github.com. Only the gh login termag made is logged out.
github_remove_legacy() {
  local work=$WORK current
  if [ -e "$KEY" ]; then rm -f "$KEY" "$KEY.pub"; say "removed $KEY"; fi
  if grep -qxF "$BEGIN" "$SSH_CONFIG" 2>/dev/null; then
    strip_block "$BEGIN" "$END" < "$SSH_CONFIG" > "$work/ssh_config"
    install -m 600 "$work/ssh_config" "$SSH_CONFIG"
    say "removed the termag block from $SSH_CONFIG"
  fi
  if [ -f "$GH_TOKEN_HASH" ]; then
    current=$(gh auth token -h github.com 2>/dev/null || true)
    if [ -n "$current" ] && [ "$(printf '%s' "$current" | sha256sum | cut -d' ' -f1)" = "$(cat "$GH_TOKEN_HASH")" ]; then
      gh auth logout -h github.com >/dev/null 2>&1 || true
      say 'gh logged out of github.com'
    fi
    rm -f "$GH_TOKEN_HASH"
  fi
}

# Git picks the longest matching insteadOf and never chains rewrites, so a
# user rule for a longer github.com prefix (the baked ~/.gitconfig sends
# https://github.com/example-org/ to ssh) would bypass the broker. Mirror each
# one onto the broker; the system file is read first and wins the tie.
broker_gitconfig() {  # broker config -> stdout
  local broker=$1 config=$2 v rest p
  printf '%s\n[url "%s/"]\n' "$BROKER_BEGIN" "$broker"
  printf '\tinsteadOf = %s\n' 'https://github.com/' 'git@github.com:' 'ssh://git@github.com/'
  { git config --global --get-regexp '^url\..*\.insteadof$' 2>/dev/null || true; } | while read -r _ v; do
    for p in 'https://github.com/' 'git@github.com:' 'ssh://git@github.com/'; do
      case $v in "$p"?*) rest=${v#"$p"}; printf '[url "%s/%s"]\n\tinsteadOf = %s\n' "$broker" "$rest" "$v" ;; esac
    done
  done
  printf '[credential "%s"]\n\thelper =\n\thelper = "%s %s"\n' "$broker" "$SELF_DIR/termag-git-credential" "$config"
  printf '%s\n' "$BROKER_END"
}

github_apply() {
  local work=$WORK payload broker host config token
  payload="$work/payload.json"
  cat > "$payload"
  if [ -e "$GH_SKIP" ]; then
    github_remove
    return 0
  fi
  broker=$(jq -r '.broker // empty' "$payload")
  case $broker in https://?*) ;; *) say 'github payload has no https broker'; return 1 ;; esac
  broker=${broker%/}
  host=${broker#https://}
  config=$(agent_config) || { say 'no agent config to authenticate to the broker with'; return 1; }
  install -d -m 700 "$STATE"

  github_remove_legacy

  { content_of "$GIT_SYSTEM" | strip_block "$BROKER_BEGIN" "$BROKER_END"
    broker_gitconfig "$broker" "$config"; } > "$work/gitconfig"
  if ! cmp -s "$work/gitconfig" "$GIT_SYSTEM" 2>/dev/null; then
    $SUDO install -m 0644 "$work/gitconfig" "$GIT_SYSTEM"
    say "git reaches github.com through $host ($GIT_SYSTEM)"
  fi

  printf 'export GH_HOST=%s\n' "$host" > "$work/gh-host.sh"
  if ! cmp -s "$work/gh-host.sh" "$PROFILE_D/termag-github.sh" 2>/dev/null; then
    $SUDO install -m 0644 "$work/gh-host.sh" "$PROFILE_D/termag-github.sh"
  fi
  { content_of "$ZSHENV" | strip_block "$BROKER_BEGIN" "$BROKER_END"
    printf '%s\nexport GH_HOST=%s\n%s\n' "$BROKER_BEGIN" "$host" "$BROKER_END"; } > "$work/zshenv"
  write_if_changed "$work/zshenv" "$ZSHENV" 644 || true

  # gh keeps the box token for the broker host; it is the same credential the
  # agent config holds, and the broker is the only host it is valid for.
  token=$(jq -r '.token // empty' "$config")
  if [ -n "$token" ] && [ "$(gh auth token -h "$host" 2>/dev/null || true)" != "$token" ]; then
    if printf '%s' "$token" | gh auth login --hostname "$host" --git-protocol https --with-token >/dev/null 2>&1; then
      say "gh logged in to $host"
    else
      say "gh could not log in to $host yet; git works, gh retries at the next delivery"
    fi
  fi
  printf '%s\n' "$host" > "$BROKER_STATE"
  clear_reason github
}

github_remove() {
  local work=$WORK host token
  github_remove_legacy
  if grep -qxF "$BROKER_BEGIN" "$GIT_SYSTEM" 2>/dev/null; then
    strip_block "$BROKER_BEGIN" "$BROKER_END" < "$GIT_SYSTEM" > "$work/gitconfig"
    $SUDO install -m 0644 "$work/gitconfig" "$GIT_SYSTEM"
    say "removed the broker from $GIT_SYSTEM"
  fi
  if [ -e "$PROFILE_D/termag-github.sh" ]; then $SUDO rm -f "$PROFILE_D/termag-github.sh"; fi
  if grep -qxF "$BROKER_BEGIN" "$ZSHENV" 2>/dev/null; then
    strip_block "$BROKER_BEGIN" "$BROKER_END" < "$ZSHENV" > "$work/zshenv"
    install -m 644 "$work/zshenv" "$ZSHENV"
  fi
  if [ -f "$BROKER_STATE" ]; then
    host=$(cat "$BROKER_STATE")
    token=$(jq -r '.token // empty' "$(agent_config)" 2>/dev/null || true)
    if [ -n "$host" ] && [ -n "$token" ] && [ "$(gh auth token -h "$host" 2>/dev/null || true)" = "$token" ]; then
      gh auth logout -h "$host" >/dev/null 2>&1 || true
      say "gh logged out of $host"
    fi
    rm -f "$BROKER_STATE"
  fi
}

# Why nothing was delivered when the orchestrator never said.
no_delivery_reason() {
  local url
  url=$(jq -r '.termag_url // empty' "$(agent_config 2>/dev/null)" 2>/dev/null || true)
  case $url in
    '')     echo 'no termag agent config found on this box' ;;
    *)      echo 'termag has delivered nothing yet: is termag-agent running and connected (and new enough)?' ;;
  esac
}

off_line() {  # provider
  if [ -s "$STATE/$1.status" ]; then echo "$1: off: $(cat "$STATE/$1.status")"
  else echo "$1: off: $(no_delivery_reason)"
  fi
}

# The gateway's /termag/auth-check takes the same check as a model call and
# answers 204, so this makes no Bedrock call.
claude_status() {
  local base token code err
  if [ -e "$SKIP" ]; then echo 'claude-gateway: skipped on this box (manual Claude login)'; return; fi
  if [ ! -s "$CLAUDE_STATE" ]; then off_line claude-gateway; return; fi
  base=$(jq -r '.env.ANTHROPIC_BEDROCK_BASE_URL // empty' "$CLAUDE_SETTINGS" 2>/dev/null || true)
  if [ -z "$base" ]; then echo "claude-gateway: NOT WORKING: $CLAUDE_SETTINGS no longer names the gateway (env.ANTHROPIC_BEDROCK_BASE_URL)"; return; fi
  token=$(jq -r '.token // empty' "$(agent_config 2>/dev/null)" 2>/dev/null || true)
  # The token goes in curl's config on stdin, never on the command line.
  code=$(printf 'header = "Authorization: Bearer %s"\n' "$token" | curl -sS -m 15 -K - -o "$WORK/claude" \
    -w '%{http_code}' "${base%/}/termag/auth-check" 2>"$WORK/claude.err" || true)
  case $code in
    204) echo "claude-gateway: on ($CLAUDE_SETTINGS), the gateway at $base accepts this box's token" ;;
    000|'') err=$(tail -n1 "$WORK/claude.err" 2>/dev/null | sed 's/^curl: ([0-9]*) //')
            echo "claude-gateway: NOT WORKING: the gateway at $base is unreachable (${err:-no response})" ;;
    5*) echo "claude-gateway: NOT WORKING: the gateway at $base could not reach termag to check this box (HTTP $code)" ;;
    *) echo "claude-gateway: NOT WORKING: the gateway at $base refused this box (HTTP $code): $(jq -r '.message // empty' "$WORK/claude" 2>/dev/null)" ;;
  esac
}

github_status() {
  local host token code err
  if [ -e "$GH_SKIP" ]; then echo 'github: skipped on this box (your own gh and git credentials)'; return; fi
  if [ ! -s "$BROKER_STATE" ]; then off_line github; return; fi
  host=$(cat "$BROKER_STATE")
  token=$(jq -r '.token // empty' "$(agent_config 2>/dev/null)" 2>/dev/null || true)
  # The token goes in curl's config on stdin, never on the command line.
  code=$(printf 'user = "termag-box:%s"\n' "$token" | curl -sS -m 10 -K - -o "$WORK/github" \
    -w '%{http_code}' "https://$host/api/v3/user" 2>"$WORK/github.err" || true)
  case $code in
    200) echo "github: on, through the termag broker ($host) as @$(jq -r '.login // "?"' "$WORK/github" 2>/dev/null)" ;;
    000|'') err=$(tail -n1 "$WORK/github.err" 2>/dev/null | sed 's/^curl: ([0-9]*) //')
            echo "github: NOT WORKING: the termag broker at $host is unreachable (${err:-no response})" ;;
    *) echo "github: NOT WORKING: the termag broker at $host refused (HTTP $code): $(jq -r '.message // empty' "$WORK/github" 2>/dev/null)" ;;
  esac
}

status() {
  claude_status
  github_status
  if [ -e "$KEY" ]; then echo 'github: a pre-broker termag key is still on disk (removed at the next delivery)'; fi
}

case "${1:-} ${2:-}" in
  'apply claude-gateway')  claude_apply ;;
  'remove claude-gateway') record_reason claude-gateway; claude_remove ;;
  'skip claude-gateway')   install -d -m 700 "$STATE"; touch "$SKIP"; claude_remove ;;
  'unskip claude-gateway') rm -f "$SKIP"; say 'the next delivery turns the gateway back on' ;;
  'apply github')          github_apply ;;
  'remove github')         record_reason github; github_remove ;;
  'skip github')           install -d -m 700 "$STATE"; touch "$GH_SKIP"; github_remove
                           say 'github skipped on this box; open a new shell to drop GH_HOST (termag-credentials unskip github to undo)' ;;
  'unskip github')         rm -f "$GH_SKIP"; say 'the next delivery routes git and gh through the broker again' ;;
  'status '*)              status ;;
  *) sed -n '6,14p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
