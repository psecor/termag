#!/usr/bin/env bash
# termag-credentials — apply credentials the orchestrator delivers to this box
# termag-agent runs it for the credentials-apply and
# credentials-remove RPCs, with the payload on stdin; it never logs a value.
#
# Usage:
#   termag-credentials apply claude-gateway   < {apiKeyHelper, env}  merged into ~/.claude/settings.json
#   termag-credentials apply github           < {broker, login}   git and gh via the orchestrator's broker
#   termag-credentials apply telemetry        < {env}             Claude Code's OpenTelemetry, merged into ~/.claude/settings.json
#   termag-credentials telemetry-launch <replay-id|->            JSON for `claude --settings`: the telemetry resource plus the browser replay the launch came from (and `model: ""` over a saved Fireworks id)
#                                                                 and, from TERMAG_PROJECT / TERMAG_WORKSTREAM, the project and workstream of the pane,
#                                                                 with work-resource's repository, branch, commit and spawn
#   termag-credentials work-resource              the session's work for an agent resource: repository, branch and commit of the
#                                                                 checkout (TERMAG_WORK_DIR, else here) and the TERMAG_SPAWN_* spawn, as ,key=value pairs
#   termag-credentials launch-settings [--backend <name> --model <id> [--fast <id>] [--context <n>] [--models <base64>]] <replay-id|->
#                                                                 the same, merged with a model backend's settings and the launch's model;
#                                                                 fails, saying why, when that backend is not set up here
#   termag-credentials pi-model --model <id> [--context <n>] [--models <base64>]
#                                                                 pi's Fireworks provider: the flag's models (--models), or add the launch's model
#   termag-credentials apply agent-telemetry  < {endpoint, resourceAttributes}  Codex, Cursor, Devin and pi telemetry
#   termag-credentials apply mcp              < {broker, connectors: [{id, name}], agents?: [name]}  Claude Code mcpServers entries through the MCP broker
#                                                                 and, for each agent CLI named in agents and installed here
#                                                                 (auggie codex cursor devin gemini pi vibe), stdio entries that run termag-mcp-bridge
#   termag-credentials apply fireworks        < {baseUrl}         the gateway's Fireworks route for pi and Claude Code
#   termag-credentials apply bazel-cache      < {seq, url, flushGeneration, remoteTimeoutSeconds, remoteRetries, jobs, downloadOutputs, goHostModcache}
#                                                                 read webapp's shared Bazel cache (S3, anonymous): a marked block in /etc/bazel.bazelrc,
#                                                                 rendered from the checked values; a higher flushGeneration first deletes the local disk
#                                                                 cache and output bases if this box used the cache; a seq older than the last step is refused
#   termag-credentials remove bazel-cache     < {reason?, flushGeneration?, seq?}  the block out, then a flush if flushGeneration rose and this box used the cache
#   termag-credentials remove claude-gateway|github|telemetry|agent-telemetry|mcp|fireworks|bazel-cache
#   termag-credentials skip claude-gateway    this box logs in to Claude by hand instead
#   termag-credentials unskip claude-gateway  back to the gateway at the next delivery
#   termag-credentials skip github            this box uses your own gh/git credentials: no broker rewrites, no GH_HOST
#   termag-credentials unskip github          back to the broker at the next delivery
#   termag-credentials skip fireworks         no Fireworks agents on this box (termag-credentials unskip fireworks to undo)
#   termag-credentials skip bazel-cache       this box builds without the shared Bazel cache (termag-credentials unskip bazel-cache to undo)
#   termag-credentials status                 each credential: on, off and why, or NOT WORKING and why
#
# Everything is content-compared, so a repeated delivery changes nothing, and
# remove only ever touches what apply wrote.
#
# No GitHub or Claude credential is ever written to the box: git and gh reach
# GitHub through the orchestrator's broker, and Claude Code reaches Bedrock
# through the Claude gateway, both authenticated with this box's agent token,
# read from the agent config on each use.
#
# Env: TERMAG_AGENT_CONFIG (set by termag-agent), TERMAG_WEBAPP_DIR (default
# ~/src/webapp). Tests: TERMAG_PI_MODELS, TERMAG_CLAUDE_JSON, TERMAG_CLAUDE_SETTINGS, TERMAG_CLAUDE_MANAGED_SETTINGS,
# TERMAG_CREDENTIALS_SUDO, GIT_CONFIG_SYSTEM, TERMAG_PROFILE_D, TERMAG_MCP_AGENTS_INSTALLED, TERMAG_BAZEL_RC
set -euo pipefail

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
CLAUDE_SETTINGS="${TERMAG_CLAUDE_SETTINGS:-$HOME/.claude/settings.json}"
# Where an earlier revision put the gateway settings; removed on every apply.
MANAGED="${TERMAG_CLAUDE_MANAGED_SETTINGS:-/etc/claude-code/managed-settings.json}"
SUDO="${TERMAG_CREDENTIALS_SUDO-sudo -n}"
STATE="$HOME/.config/termag"
SKIP="$STATE/claude-gateway.skip"
# The keys apply last merged into CLAUDE_SETTINGS, with their values: what
# remove takes out again, and what termag-claude-runner strips from the host
# config it hands a runner.
CLAUDE_STATE="$STATE/claude-gateway.json"
GH_TOKEN_HASH="$STATE/github-token.sha256"
KEY="$HOME/.ssh/termag_github"
SSH_CONFIG="$HOME/.ssh/config"
BEGIN='# >>> termag github (managed by termag-credentials)'
END='# <<< termag github'
GIT_SYSTEM="${GIT_CONFIG_SYSTEM:-/etc/gitconfig}"
PROFILE_D="${TERMAG_PROFILE_D:-/etc/profile.d}"
ZSHENV="$HOME/.zshenv"
BROKER_STATE="$STATE/github-broker"
GH_SKIP="$STATE/github.skip"
BROKER_BEGIN='# >>> termag github broker (managed by termag-credentials)'
BROKER_END='# <<< termag github broker'
HELPER_PLACEHOLDER='@TERMAG_CLAUDE_TOKEN@'
# As CLAUDE_STATE, for the telemetry keys.
TELEMETRY_STATE="$STATE/telemetry.json"
# Where the other agents' telemetry goes ({endpoint, resourceAttributes}), read
# by termag-agent-otel, the Cursor hook and the pi extension; and the hook
# command apply put in Cursor's user hooks, so remove takes out only that.
AGENT_TELEMETRY_STATE="$STATE/agent-telemetry.json"
CURSOR_HOOKS="${TERMAG_CURSOR_HOOKS:-$HOME/.cursor/hooks.json}"
CURSOR_HOOKS_STATE="$STATE/cursor-hooks.json"
# Claude Code's own config, where user-scope mcpServers live; the entries
# apply wrote there ({name: entry}); and the file the termag-mcp-refresh mod
# and the chat runner's live turns (agent/chat-turn.js) watch, rewritten only
# after CLAUDE_JSON and only when our entries changed.
CLAUDE_JSON="${TERMAG_CLAUDE_JSON:-$HOME/.claude.json}"
MCP_STATE="$STATE/mcp.json"
MCP_VERSION="$STATE/mcp-connectors.version"
# Where a CLI finds the API broker: the
# broker's URL and the command that prints this box's token as a header. No
# secret, so 0644; written with every mcp delivery, removed with it.
API_BROKER_STATE="$STATE/api-broker.json"
# The termag-mcp-refresh mod as termag-reconcile installs it, named in
# CLAUDE_CODE_PLUGIN_DIRS in CLAUDE_SETTINGS' env so every interactive session
# loads it, the ones an owner starts by hand included.
MCP_PLUGIN_DIR="${TERMAG_MCP_PLUGIN_DIR:-$HOME/.local/share/termag/claude-plugins/termag-mcp-refresh}"
# Fireworks: the delivery as received (termag-pi-fireworks
# reads the default model from it), the Claude Code settings launch-settings
# merges in, pi's own models file, and the provider entry apply put there, so
# remove takes out only that.
FIREWORKS_STATE="$STATE/fireworks.json"
FIREWORKS_CLAUDE="$STATE/claude-fireworks.json"
FIREWORKS_SKIP="$STATE/fireworks.skip"
PI_MODELS="${TERMAG_PI_MODELS:-$HOME/.pi/agent/models.json}"
PI_FIREWORKS_STATE="$STATE/fireworks-pi.json"
PI_PROVIDER=termag-fireworks
# The shared Bazel cache ("Box-side Bazel
# flags"): Bazel's system rc, where apply writes its block; the values last
# applied, which status reads; the last flushGeneration and seq applied, which
# outlive remove (a box that comes back after a flush is flushed, and a stale
# step is refused); whether this box's local caches may hold entries from the
# shared cache (it has applied the block since its last flush), the only boxes
# a flush touches; a flush that failed, which status reports and the next step
# retries; whether apply created the rc, so remove can restore its absence; and
# the lock every bazel-cache step holds.
BAZEL_RC="${TERMAG_BAZEL_RC:-/etc/bazel.bazelrc}"
BAZEL_STATE="$STATE/bazel-cache.json"
BAZEL_FLUSHED="$STATE/bazel-cache.flush-generation"
BAZEL_USED="$STATE/bazel-cache.used"
BAZEL_FLUSH_FAILED="$STATE/bazel-cache.flush-failed"
BAZEL_STEPS="$STATE/bazel-cache.steps"
BAZEL_SEQ="$STATE/bazel-cache.seq"
BAZEL_RC_CREATED="$STATE/bazel-cache.rc-created"
BAZEL_SKIP="$STATE/bazel-cache.skip"
BAZEL_LOCK="$STATE/bazel-cache.lock"
# goHostModcache's module cache: one directory outside every output base, so a
# fresh output base copies webapp's Go modules instead of downloading them.
# Under the box user's home,
# as an absolute path: Bazel doesn't expand ~ in --repo_env.
BAZEL_GOMODCACHE="$HOME/.cache/bazel-gomodcache"
BAZEL_GOMODCACHE_RE='^/[A-Za-z0-9._/-]+$'
BAZEL_BEGIN='# >>> termag bazel-cache >>>'
BAZEL_END='# <<< termag bazel-cache <<<'

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
chmod 700 "$WORK"

say() { printf 'termag-credentials: %s\n' "$*" >&2; }

write_if_changed() {  # src dest mode
  if [ -f "$2" ] && cmp -s "$1" "$2"; then return 1; fi
  install -m "$3" "$1" "$2"
}

# Why the orchestrator removed a credential ({"reason": ...} on stdin), for
# status. An apply clears it.
record_reason() {  # provider
  local reason=
  [ -t 0 ] || reason=$(jq -r '.reason // empty' 2>/dev/null || true)
  install -d -m 700 "$STATE"
  if [ -n "$reason" ]; then printf '%s\n' "$reason" > "$STATE/$1.status"; fi
}
clear_reason() { rm -f "$STATE/$1.status"; }

# ── Claude gateway ───────────────────────────────────────────────────────────
# The gateway settings go into the owner's user settings, not managed settings:
# a Claude Code cloud session on this box gets its own config dir from the
# runner (termag-claude-runner), never reads this file, and so infers with the
# token Anthropic issues it. Managed settings would reach every session.
#
# Merged key by key into a file the owner edits. A key the owner set to a value
# of their own is left alone (and not recorded as ours); remove takes out only
# the keys whose value is still the one apply wrote.

# The delivery's keys as [path, value] pairs.
JQ_PAIRS='def pairs: [(if has("apiKeyHelper") then [["apiKeyHelper"], .apiKeyHelper] else empty end),
                      ((.env // {}) | to_entries[] | [["env", .key], .value])];'
# Drop the recorded keys that still hold the recorded value; an emptied env goes too.
JQ_STRIP='def strip($mine): reduce ($mine | pairs[]) as $p (.; if getpath($p[0]) == $p[1] then delpaths([$p[0]]) else . end)
                        | if .env == {} then del(.env) else . end;'

# Writes through a symlink to its target (dotfiles), keeping the file's mode.
write_settings() {  # json-file dest
  local dest tmp
  # readlink -f needs the parent to exist (a box that never ran claude has no ~/.claude).
  mkdir -p "$(dirname "$2")"
  dest=$(readlink -f "$2")
  tmp=$(mktemp "$dest.XXXXXX")
  if [ -e "$dest" ]; then chmod --reference="$dest" "$tmp"; else chmod 600 "$tmp"; fi
  jq . "$1" > "$tmp" && mv -f "$tmp" "$dest" || { rm -f "$tmp"; return 1; }
}

# Merges a delivery's keys into CLAUDE_SETTINGS, recording the ones it wrote
# in a state file. Our previous keys out, then each delivered key in unless the
# owner holds it.
settings_merge() {  # delivery.json state-file what whose
  local work=$WORK delivery=$1 state=$2 what=$3 whose=$4
  if [ -s "$CLAUDE_SETTINGS" ]; then cp "$CLAUDE_SETTINGS" "$work/current.json"; else echo '{}' > "$work/current.json"; fi
  if [ -s "$state" ]; then cp "$state" "$work/mine.json"; else echo '{}' > "$work/mine.json"; fi
  jq -e 'type == "object"' "$work/current.json" >/dev/null 2>&1 \
    || { say "$CLAUDE_SETTINGS is not a JSON object; not adding $what"; return 1; }
  jq --slurpfile mine "$work/mine.json" --slurpfile new "$delivery" "$JQ_PAIRS $JQ_STRIP"'
    strip($mine[0]) as $base
    | reduce ($new[0] | pairs[]) as $p ({settings: $base, mine: {}, kept: []};
        if ($base | getpath($p[0])) == null
        then .settings |= setpath($p[0]; $p[1]) | .mine |= setpath($p[0]; $p[1])
        elif ($base | getpath($p[0])) == $p[1] then .
        else .kept += [$p[0] | join(".")] end)' "$work/current.json" > "$work/merged.json"
  jq '.settings' "$work/merged.json" > "$work/settings.json"
  jq '.mine' "$work/merged.json" > "$work/mine.next.json"
  if [ -n "$(jq -r '.kept | join(", ")' "$work/merged.json")" ]; then
    say "left your own $(jq -r '.kept | join(", ")' "$work/merged.json") in $CLAUDE_SETTINGS in place of $whose"
  fi
  install -d -m 700 "$STATE"
  if ! { [ -s "$CLAUDE_SETTINGS" ] && [ "$(jq -S . "$work/current.json")" = "$(jq -S . "$work/settings.json")" ]; }; then
    write_settings "$work/settings.json" "$CLAUDE_SETTINGS" || { say "failed to write $CLAUDE_SETTINGS"; return 1; }
    say "wrote $what settings into $CLAUDE_SETTINGS"
  fi
  write_if_changed "$work/mine.next.json" "$state" 600 || true
}

# Takes the keys a state file records back out of CLAUDE_SETTINGS.
settings_strip() {  # state-file what
  [ -s "$1" ] || return 0
  if [ -s "$CLAUDE_SETTINGS" ]; then
    jq --slurpfile mine "$1" "$JQ_PAIRS $JQ_STRIP"' strip($mine[0])' "$CLAUDE_SETTINGS" > "$WORK/settings.json" 2>/dev/null \
      || { say "$CLAUDE_SETTINGS is not valid JSON; $2 keys are still in it"; return 1; }
    if [ "$(jq -S . "$CLAUDE_SETTINGS")" != "$(jq -S . "$WORK/settings.json")" ]; then
      write_settings "$WORK/settings.json" "$CLAUDE_SETTINGS" || { say "failed to write $CLAUDE_SETTINGS"; return 1; }
      say "removed $2 settings from $CLAUDE_SETTINGS"
    fi
  fi
  rm -f "$1"
}

claude_apply() {
  local work=$WORK
  if [ -e "$SKIP" ]; then
    claude_remove
    say 'claude-gateway skipped on this box (termag-credentials unskip claude-gateway to undo)'
    return 0
  fi
  local config
  config=$(agent_config) || { say 'no agent config for the Claude gateway token'; return 1; }
  # apiKeyHelper is a shell command; both paths are quoted for it.
  jq --arg helper "$SELF_DIR/termag-claude-token" --arg config "$config" --arg ph "$HELPER_PLACEHOLDER" \
    'if .apiKeyHelper == $ph then .apiKeyHelper = "\($helper | @sh) \($config | @sh)" else . end' > "$work/delivery.json"
  jq -e '.env.CLAUDE_CODE_USE_BEDROCK == "1"' "$work/delivery.json" >/dev/null \
    || { say 'refusing claude-gateway settings without CLAUDE_CODE_USE_BEDROCK'; return 1; }
  clear_reason claude-gateway
  settings_merge "$work/delivery.json" "$CLAUDE_STATE" 'the Claude gateway' "the gateway's" || return 1
  # Only now: until the user settings hold the gateway, the managed copy is
  # all an existing box has.
  remove_managed
}

claude_remove() {
  remove_managed
  settings_strip "$CLAUDE_STATE" 'the Claude gateway'
}

# The managed settings file an earlier revision wrote. Only a file this script
# wrote: its apiKeyHelper is our token helper. Match the name, not the path:
# the agent's copy and the one on PATH differ.
remove_managed() {
  [ -e "$MANAGED" ] || return 0
  if jq -e '(.apiKeyHelper // "") | test("/termag-claude-token(\u0027|$)")' "$MANAGED" >/dev/null 2>&1; then
    $SUDO rm -f "$MANAGED"
    say "removed $MANAGED"
  fi
}

# ── Claude Code telemetry ────────────────────────────────────────────────────
# OpenTelemetry for the interactive sessions on this box, to the telemetry
# project the orchestrator ships to (a cloud runner session pins its own export
# and drops these keys from the config it copies). Merged into the owner's settings like the gateway
# keys, and recorded the same way so remove takes out only ours. Metadata only:
# a delivery may name the exporters, the endpoint and the resource, never a
# content gate (OTEL_LOG_*) or a header. An owner with an exporter of their own
# (an OTLP endpoint, header or client cert, or otelHeadersHelper) keeps it, and
# gets none of ours: their collector credential must never reach this endpoint.
TELEMETRY_KEYS='^(CLAUDE_CODE_ENABLE_TELEMETRY|CLAUDE_CODE_ENHANCED_TELEMETRY_BETA|OTEL_(METRICS|LOGS|TRACES)_EXPORTER|OTEL_EXPORTER_OTLP_(PROTOCOL|ENDPOINT)|OTEL_METRICS_INCLUDE_SESSION_ID|OTEL_RESOURCE_ATTRIBUTES)$'
# The same goes for an exporter the owner's shell sets, which settings.json
# can't see: settings env overrides only the variables it names, so a shell's
# header, client key or certificate, or per-signal endpoint, would ride on ours.
# Each is written empty, which Claude Code's exporter reads as unset; a
# delivery may name them, empty only, and any it leaves out are added here.
TELEMETRY_BLANK='^OTEL_EXPORTER_OTLP_((METRICS|LOGS|TRACES)_)?(HEADERS|CLIENT_KEY|CLIENT_CERTIFICATE)$|^OTEL_EXPORTER_OTLP_(METRICS|LOGS|TRACES)_(ENDPOINT|PROTOCOL)$'
JQ_BLANKS='def blanks: [(("" , "METRICS_", "LOGS_", "TRACES_") as $s | ("HEADERS", "CLIENT_KEY", "CLIENT_CERTIFICATE") as $v | "OTEL_EXPORTER_OTLP_\($s)\($v)"),
                     (("METRICS", "LOGS", "TRACES") as $s | ("ENDPOINT", "PROTOCOL") as $v | "OTEL_EXPORTER_OTLP_\($s)_\($v)")]
                    | map({(.): ""}) | add;'

telemetry_apply() {
  local work=$WORK box
  cat > "$work/telemetry.json"
  jq -e --arg keys "$TELEMETRY_KEYS" --arg blank "$TELEMETRY_BLANK" '
    (keys == ["env"]) and (.env | type == "object" and length > 0)
    and all(.env | to_entries[]; (.value | type == "string")
                                 and ((.key | test($keys)) or ((.key | test($blank)) and .value == "")))
    and (.env.OTEL_EXPORTER_OTLP_ENDPOINT // "" | test("^https://[A-Za-z0-9.:-]+$"))' "$work/telemetry.json" >/dev/null 2>&1 \
    || { say 'refusing telemetry settings that are not exporter, endpoint and resource keys to an https origin'; return 1; }
  clear_reason telemetry
  if [ -s "$CLAUDE_SETTINGS" ]; then
    if [ -s "$TELEMETRY_STATE" ]; then cp "$TELEMETRY_STATE" "$work/tmine.json"; else echo '{}' > "$work/tmine.json"; fi
    if jq -e --slurpfile mine "$work/tmine.json" "$JQ_PAIRS $JQ_STRIP"'
         strip($mine[0]) | has("otelHeadersHelper") or ((.env // {}) | keys | any(test("^OTEL_EXPORTER_OTLP_")))' \
         "$CLAUDE_SETTINGS" >/dev/null 2>&1; then
      settings_strip "$TELEMETRY_STATE" 'the termag telemetry'
      printf '%s\n' "your own OpenTelemetry exporter in $CLAUDE_SETTINGS is kept, so termag adds none" > "$STATE/telemetry.status"
      say "left your own OpenTelemetry exporter in $CLAUDE_SETTINGS; termag's telemetry is off"
      return 0
    fi
  fi
  box=$(hostname -s 2>/dev/null) || box=unknown
  case $box in ''|*[!A-Za-z0-9.-]*) box=unknown ;; esac
  # The owner's resource is what a Claude Code session termag did not launch
  # exports with: a person's own `claude`, a script's `claude -p`, termag's
  # own background calls that name no kind. Every termag launch names its kind
  # (telemetry_launch), so the settings' is `external`, not the delivered
  # `interactive`, which would pass such a session off as a pane.
  jq --arg box "$box" "$JQ_BLANKS"'
    .env.OTEL_RESOURCE_ATTRIBUTES |= (if . then
        "\(sub("(?<p>^|,)termag\\.session\\.kind=interactive(?<s>,|$)"; "\(.p)termag.session.kind=external\(.s)")),termag.box=\($box)"
      else empty end)
    | .env += blanks' \
    "$work/telemetry.json" > "$work/telemetry.delivery.json"
  settings_merge "$work/telemetry.delivery.json" "$TELEMETRY_STATE" 'the termag telemetry' "termag's telemetry"
}

telemetry_remove() { settings_strip "$TELEMETRY_STATE" 'the termag telemetry'; }

telemetry_status() {
  local endpoint
  if [ ! -s "$TELEMETRY_STATE" ]; then off_line telemetry; return; fi
  endpoint=$(jq -r '.env.OTEL_EXPORTER_OTLP_ENDPOINT // empty' "$CLAUDE_SETTINGS" 2>/dev/null || true)
  case $endpoint in
    '') echo "telemetry: NOT WORKING: $CLAUDE_SETTINGS no longer names an OTLP endpoint (env.OTEL_EXPORTER_OTLP_ENDPOINT)" ;;
    *)  echo "telemetry: on ($CLAUDE_SETTINGS), new Claude Code sessions export metrics, events and traces to $endpoint" ;;
  esac
}

# The settings for one Claude Code launch the browser asked for
# (`claude --settings "$(termag-credentials telemetry-launch <id>)"`, typed by
# the orchestrator, backend/src/services/launchCommand.ts): the resource
# attributes termag's telemetry put in the owner's settings, plus
# termag.replay.id naming the browser session recording the launch came
# from, so the session's spans are filed under that recording. A --settings key
# outranks the user settings file, which is why the whole string is repeated.
# The pane's project and workstream come the same way, from TERMAG_PROJECT and
# TERMAG_WORKSTREAM in the environment (both or neither; `-` as the id means
# no replay), as termag.project and termag.workstream: the two every agent
# resource carries beside termag.agent and termag.session.kind.
# A launch that is not a pane names its kind in TERMAG_SESSION_KIND (the chat
# runner's turns `chat`, its Haiku one-shots `oneshot`, with TERMAG_ONESHOT
# saying which: agent/chat-runner.js chatTelemetryEnv), which replaces the
# settings' termag.session.kind; a bad kind is dropped, never the launch.
# An ask's turns (kind `ask`) also say who asked, from TERMAG_ASK_THREAD,
# TERMAG_ASK_HOP and TERMAG_ASK_PARENT_{BOX,PROJECT,WORKSTREAM,SESSION}, as
# termag.ask.thread, termag.ask.hop and termag.ask.parent.{box,project,
# workstream,session}; each bad value is dropped on its own (the parent's
# project and workstream together), and the parent's without a thread.
# Never fails the launch: without termag's telemetry (off, or the owner's own
# exporter), with a malformed id and no project, it prints {} and Claude Code
# starts as it would have. Ids only go in (letters, digits, - and _), so no
# value needs OTEL escaping.
telemetry_launch() {  # replay-id|-
  local id=${1:-} project=${TERMAG_PROJECT:-} workstream=${TERMAG_WORKSTREAM:-} extra=
  local kind=${TERMAG_SESSION_KIND:-} oneshot=${TERMAG_ONESHOT:-}
  case $id in ''|*[!A-Za-z0-9]*) id= ;; esac
  if [ ${#id} -lt 20 ] || [ ${#id} -gt 64 ]; then id=; fi
  case $project in ''|*[!A-Za-z0-9_-]*) project= ;; esac
  case $workstream in ''|*[!A-Za-z0-9_-]*) workstream= ;; esac
  if [ ${#project} -gt 64 ] || [ ${#workstream} -gt 64 ]; then project='' workstream=''; fi
  if [ -n "$project" ] && [ -n "$workstream" ]; then extra=",termag.project=$project,termag.workstream=$workstream"; fi
  [ -n "$id" ] && extra="$extra,termag.replay.id=$id"
  case $kind in ''|*[!a-z-]*) kind= ;; esac
  case $oneshot in ''|*[!a-z-]*) oneshot= ;; esac
  if [ ${#kind} -gt 32 ]; then kind=; fi
  if [ -z "$kind" ] || [ ${#oneshot} -gt 32 ]; then oneshot=; fi
  [ -n "$oneshot" ] && extra="$extra,termag.oneshot=$oneshot"
  extra="$extra$(ask_resource)$(work_resource)"
  if { [ -z "$extra" ] && [ -z "$kind" ]; } || [ ! -s "$TELEMETRY_STATE" ] || [ ! -s "$CLAUDE_SETTINGS" ]; then
    echo '{}'; return 0
  fi
  jq -c --arg extra "$extra" --arg kind "$kind" '
    def kinded: if $kind == "" then .
      elif test("(^|,)termag\\.session\\.kind=") then sub("(?<p>^|,)termag\\.session\\.kind=[^,]*"; "\(.p)termag.session.kind=\($kind)")
      else "\(.),termag.session.kind=\($kind)" end;
    if (.env.OTEL_RESOURCE_ATTRIBUTES | type) == "string" and (.env.OTEL_RESOURCE_ATTRIBUTES | length) > 0
    then {env: {OTEL_RESOURCE_ATTRIBUTES: "\(.env.OTEL_RESOURCE_ATTRIBUTES | kinded)\($extra)"}}
    else {} end' "$CLAUDE_SETTINGS" 2>/dev/null || echo '{}'
}

# The settings every Claude Code launch off a model backend gets
# (telemetry-launch, launch-settings without --backend): telemetry_launch's,
# plus `model: ""` when the owner's settings save a Fireworks id as `model`:
# an empty `model` is Claude Code's default (checked on 2.1.314; `"default"`
# there is an unrecognized model, unlike `--model default`). Claude Code's /model menu lists the Fireworks models on a box set up
# for them, and Enter there saves the pick; a Fireworks or gateway launch sets its own model and never
# reads it, but an owner's own login would start on it and fail. The owner's
# file is left as it is; a Claude pick, or no pick, is kept.
claude_launch() {  # replay-id|-
  local telemetry saved
  telemetry=$(telemetry_launch "${1:-}")
  saved=$(jq -r '.model // empty | strings' "$CLAUDE_SETTINGS" 2>/dev/null || true)
  if printf '%s' "$saved" | grep -Eq "$FIREWORKS_MODEL"; then
    printf '%s' "$telemetry" | jq -c '. + {model: ""}' 2>/dev/null || echo '{"model":""}'
  else
    printf '%s\n' "$telemetry"
  fi
}

# The work a session is on, for its resource ("The
# session's work"), a leading comma each: termag.repo (the owner/name of the
# checkout's origin, never the URL, which can carry a token), termag.git.branch
# and termag.git.commit, read from the directory the session starts in
# (TERMAG_WORK_DIR, which the chat runner sets, `-` for none, else the working directory) at
# its launch, so a later checkout or commit is not on it; and a spawned agent's
# spawn from the orchestrator's TERMAG_SPAWN_ID, _ROOT, _DEPTH,
# _PARENT_PROJECT, _PARENT_WORKSTREAM and _PARENT_BOX (services/launchCommand.ts
# spawnEnvPrefix), as termag.spawn.id, .root, .depth and termag.spawn.parent.*.
# Each value with anything but letters, digits and ._/- is dropped on its own
# (the parent's project and workstream together), so no value needs OTEL
# escaping. Not a git checkout, no origin, a detached HEAD: that part is left
# out. Never fails, and prints nothing for nothing.
work_resource() {
  local dir=${TERMAG_WORK_DIR:-$PWD} commit repo branch
  [ "$dir" = - ] && dir=
  if [ -n "$dir" ] && [ -d "$dir" ] && commit=$(git -C "$dir" rev-parse --verify -q HEAD 2>/dev/null); then
    repo=$(repo_slug "$(git -C "$dir" remote get-url origin 2>/dev/null || true)")
    [ -n "$repo" ] && printf ',termag.repo=%s' "$repo"
    branch=$(git -C "$dir" symbolic-ref -q --short HEAD 2>/dev/null || true)
    case $branch in ''|*[!A-Za-z0-9._/-]*) branch= ;; esac
    [ ${#branch} -gt 100 ] && branch=
    [ -n "$branch" ] && printf ',termag.git.branch=%s' "$branch"
    case $commit in *[!0-9a-f]*) commit= ;; esac
    [ ${#commit} -eq 40 ] && printf ',termag.git.commit=%s' "$commit"
  fi
  spawn_resource
  return 0
}

# owner/name from a remote URL with a host (https://[user@]host/owner/name[.git],
# ssh://git@host/owner/name, git@host:owner/name), or nothing: a local path or
# file:// (or any other scheme's) remote names no repository anyone else can find.
repo_slug() {
  local url=${1:-} path owner name
  url=${url%/}; url=${url%.git}
  case $url in
    https://*|http://*|ssh://*|git://*|git+ssh://*|ssh+git://*)
      path=${url#*://}; [ -n "${path%%/*}" ] || return 0; path=${path#*/} ;;
    *://*) return 0 ;;
    /*|.*) return 0 ;;
    *:*) path=${url#*:} ;;
    *) return 0 ;;
  esac
  case $path in */*) ;; *) return 0 ;; esac
  name=${path##*/}; owner=${path%/*}; owner=${owner##*/}
  case $owner in ''|*[!A-Za-z0-9._-]*) return 0 ;; esac
  case $name in ''|*[!A-Za-z0-9._-]*) return 0 ;; esac
  if [ ${#owner} -gt 100 ] || [ ${#name} -gt 100 ]; then return 0; fi
  printf '%s/%s' "$owner" "$name"
}

# work_resource's termag.spawn.* from the orchestrator's TERMAG_SPAWN_*.
spawn_resource() {
  local id=${TERMAG_SPAWN_ID:-} root=${TERMAG_SPAWN_ROOT:-} depth=${TERMAG_SPAWN_DEPTH:-}
  local project=${TERMAG_SPAWN_PARENT_PROJECT:-} workstream=${TERMAG_SPAWN_PARENT_WORKSTREAM:-} box=${TERMAG_SPAWN_PARENT_BOX:-}
  case $id in ''|*[!a-z0-9]*) return 0 ;; esac
  if [ ${#id} -lt 8 ] || [ ${#id} -gt 40 ]; then return 0; fi
  printf ',termag.spawn.id=%s' "$id"
  case $root in ''|*[!a-z0-9]*) root= ;; esac
  if [ ${#root} -lt 8 ] || [ ${#root} -gt 40 ]; then root=; fi
  [ -n "$root" ] && printf ',termag.spawn.root=%s' "$root"
  case $depth in ''|*[!0-9]*|0*) depth= ;; esac
  [ ${#depth} -gt 3 ] && depth=
  [ -n "$depth" ] && printf ',termag.spawn.depth=%s' "$depth"
  case $project in ''|*[!A-Za-z0-9_-]*) project= ;; esac
  case $workstream in ''|*[!A-Za-z0-9_-]*) workstream= ;; esac
  if [ ${#project} -gt 64 ] || [ ${#workstream} -gt 64 ]; then project='' workstream=''; fi
  if [ -n "$project" ] && [ -n "$workstream" ]; then
    printf ',termag.spawn.parent.project=%s,termag.spawn.parent.workstream=%s' "$project" "$workstream"
  fi
  case $box in ''|*[!a-z0-9]*) box= ;; esac
  if [ ${#box} -lt 8 ] || [ ${#box} -gt 40 ]; then box=; fi
  [ -n "$box" ] && printf ',termag.spawn.parent.box=%s' "$box"
  return 0
}

# telemetry_launch's termag.ask.* (a leading comma each), or nothing without
# a well-formed TERMAG_ASK_THREAD. Only letters, digits, - and _ go in.
ask_resource() {
  local thread=${TERMAG_ASK_THREAD:-} hop=${TERMAG_ASK_HOP:-} box=${TERMAG_ASK_PARENT_BOX:-}
  local project=${TERMAG_ASK_PARENT_PROJECT:-} workstream=${TERMAG_ASK_PARENT_WORKSTREAM:-} session=${TERMAG_ASK_PARENT_SESSION:-}
  case $thread in ''|*[!a-z0-9]*) return 0 ;; esac
  if [ ${#thread} -lt 8 ] || [ ${#thread} -gt 40 ]; then return 0; fi
  printf ',termag.ask.thread=%s' "$thread"
  case $hop in ''|*[!0-9]*|0*) hop= ;; esac
  [ ${#hop} -gt 6 ] && hop=
  [ -n "$hop" ] && printf ',termag.ask.hop=%s' "$hop"
  case $box in ''|*[!A-Za-z0-9_-]*) box= ;; esac
  [ ${#box} -gt 64 ] && box=
  [ -n "$box" ] && printf ',termag.ask.parent.box=%s' "$box"
  case $project in ''|*[!A-Za-z0-9_-]*) project= ;; esac
  case $workstream in ''|*[!A-Za-z0-9_-]*) workstream= ;; esac
  if [ ${#project} -gt 64 ] || [ ${#workstream} -gt 64 ]; then project='' workstream=''; fi
  if [ -n "$project" ] && [ -n "$workstream" ]; then
    printf ',termag.ask.parent.project=%s,termag.ask.parent.workstream=%s' "$project" "$workstream"
  fi
  case $session in ''|*[!A-Za-z0-9-]*) session= ;; esac
  if [ ${#session} -lt 8 ] || [ ${#session} -gt 64 ]; then session=; fi
  [ -n "$session" ] && printf ',termag.ask.parent.session=%s' "$session"
  return 0
}

# The settings for one Claude Code launch on a model backend other than the
# owner's own: telemetry_launch's, merged under the
# backend's settings file, as one JSON, because Claude Code reads only the
# last `--settings`. The orchestrator types
# `termag_settings=$(termag-credentials launch-settings --backend fireworks <id|->) && claude --settings "$termag_settings"`,
# so a backend that is not set up here (skipped, never delivered, or removed)
# fails the launch with the reason instead of starting Claude Code on
# Bedrock. Without --backend it is claude_launch. A backend's launch keeps
# telemetry_launch's alone: it sets its own model.
# termag-credentials: fireworks-menu-v1 (agent/credentials.js advertises it
# while this line is here): --models, the flag's model list for /model.
launch_settings() {  # [--backend <name> --model <id> [--fast <id>] [--context <n>] [--models <base64>]] replay-id|-
  local backend='' model='' fast='' context='' models='' menu='[]' telemetry
  while [ $# -gt 1 ]; do
    case $1 in
      --backend) backend=${2:-}; shift 2 ;;
      --model) model=${2:-}; shift 2 ;;
      --fast) fast=${2:-}; shift 2 ;;
      --context) context=${2:-}; shift 2 ;;
      --models) models=${2:-}; shift 2 ;;
      *) break ;;
    esac
  done
  case $backend in
    '') ;;
    *) telemetry=$(telemetry_launch "${1:-}") ;;
  esac
  case $backend in
    '') claude_launch "${1:-}" ;;
    fireworks)
      fireworks_ready || return 1
      printf '%s' "$model" | grep -Eq "$FIREWORKS_MODEL" || { say "launch-settings: no Fireworks model given (--model)"; return 1; }
      [ -z "$fast" ] || printf '%s' "$fast" | grep -Eq "$FIREWORKS_MODEL" || { say "launch-settings: not a Fireworks model id: $fast"; return 1; }
      case $context in ''|*[!0-9]*) context='' ;; esac
      if [ -n "$models" ]; then
        menu=$(fireworks_menu "$models") || { say 'launch-settings: --models is not a model list; /model shows only the launch model'; menu='[]'; }
      fi
      # Every tier the model, but haiku and the small/fast model the fast one,
      # so no tier alias (/model fable, a subagent's `model: opus`) reaches an
      # Anthropic model; one context window for every model Claude Code does
      # not know. With a menu, each tier is named from it and /model lists
      # the menu instead of Claude's lineup.
      jq -c --argjson t "$telemetry" --arg m "$model" --arg f "${fast:-$model}" --arg c "$context" --argjson menu "$menu" '
        def row($id): ($menu | map(select(.id == $id)) | .[0]);
        def named($tier; $id): {("ANTHROPIC_DEFAULT_\($tier)_MODEL"): $id}
          + (row($id) | if . then {("ANTHROPIC_DEFAULT_\($tier)_MODEL_NAME"): .label, ("ANTHROPIC_DEFAULT_\($tier)_MODEL_DESCRIPTION"): .description} else {} end);
        $t * . * {env: ({ANTHROPIC_MODEL: $m, ANTHROPIC_SMALL_FAST_MODEL: $f}
                        + named("OPUS"; $m) + named("SONNET"; $m) + named("FABLE"; $m) + named("HAIKU"; $f)
                        + (if $c != "" then {CLAUDE_CODE_MAX_CONTEXT_TOKENS: $c} else {} end))}
        + (if ($menu | length) > 0
           then {modelPicker: {replaceBuiltInOptions: true, options: ($menu | map({model: .id, label, description}))}}
           else {} end)' "$FIREWORKS_CLAUDE" ;;
    *) say "no model backend named $backend"; return 1 ;;
  esac
}

# --models: base64 of [{id, label?, context?}] in the flag's order
# (fireworksMenuArg), checked: [{id, label, context?}]. A bad entry or a
# repeated id is dropped, a missing label is the id's last part, and a
# context that is not a whole number of at least 1000 tokens is left out.
fireworks_list() {  # base64
  case $1 in *[!A-Za-z0-9+/=]*) return 1 ;; esac
  [ ${#1} -le 12000 ] || return 1
  printf '%s' "$1" | jq -Rrj '@base64d' 2>/dev/null | jq -ce --arg re "$FIREWORKS_MODEL" '
    if type != "array" then error("not a list") else . end
    | [.[] | select(type == "object" and (.id | type) == "string" and (.id | test($re)))]
    | reduce .[] as $e ([]; if any(.[]; .id == $e.id) then . else . + [$e] end)
    | .[:32]
    | map({id,
           label: ((.label | if type == "string" then gsub("[[:cntrl:]]"; "") | sub("^\\s+"; "") | sub("\\s+$"; "") | .[:60] else "" end) as $l
                   | if $l == "" then .id | split("/") | last else $l end)}
          + (if (.context | type) == "number" and .context >= 1000 and .context == (.context | floor) and .context < 1000000000
             then {context} else {} end))' 2>/dev/null
}

# The list as Claude Code's /model rows [{id, label, description}]: the
# description says the window, "Fireworks · 1M context".
fireworks_menu() {  # base64
  local list
  list=$(fireworks_list "$1") && [ -n "$list" ] || return 1
  printf '%s' "$list" | jq -ce '
    def window: if . % 1000000 == 0 then "\(. / 1000000)M" elif . % 1048576 == 0 then "\(. / 1048576)M"
      elif . % 1000 == 0 then "\(. / 1000)k" elif . % 1024 == 0 then "\(. / 1024)k" else "\(. / 1000 | round)k" end;
    map({id, label, description: (if .context then "Fireworks · \(.context | window) context" else "Fireworks" end)})' 2>/dev/null
}

# ── Codex, Cursor, Devin and pi telemetry ────────────────────────────────────
# The same telemetry project and resource as Claude Code's, for the other
# agents a box runs. None of them reads Claude's
# settings, and each is configured differently, so the delivery is only the
# destination; this records it and each agent's own piece reads it at launch:
# termag-agent-otel (Codex, Devin), termag-cursor-otel-hook (Cursor's user
# hooks, installed here) and the pi extension termag-otel.ts. Metadata only,
# as for Claude Code: the record holds an https origin and resource attributes,
# never a header, and every reader leaves the owner's shell exporter out.
AGENT_RESOURCE='^[A-Za-z0-9._=,-]+$'
CURSOR_HOOK_EVENTS='["sessionStart","sessionEnd","stop","postToolUse","postToolUseFailure","subagentStop"]'

cursor_hook_command() { printf "'%s'" "$SELF_DIR/termag-cursor-otel-hook"; }

# Our command on each event of Cursor's user hooks, beside the owner's own.
# The previously recorded command goes first, so a moved checkout (a renamed
# home) leaves no stale entry.
cursor_hooks_apply() {
  local work=$WORK cmd old=''
  cmd=$(cursor_hook_command)
  [ -s "$CURSOR_HOOKS_STATE" ] && old=$(jq -r '.command // empty' "$CURSOR_HOOKS_STATE" 2>/dev/null || true)
  if [ -s "$CURSOR_HOOKS" ]; then cp "$CURSOR_HOOKS" "$work/hooks.json"; else echo '{"version":1,"hooks":{}}' > "$work/hooks.json"; fi
  jq -e 'type == "object" and ((.hooks // {}) | type == "object")' "$work/hooks.json" >/dev/null 2>&1 \
    || { say "$CURSOR_HOOKS is not a hooks object; not adding the termag Cursor telemetry hook"; return 1; }
  jq --arg cmd "$cmd" --arg old "$old" --argjson events "$CURSOR_HOOK_EVENTS" '
    .version //= 1
    | reduce $events[] as $e (.;
        .hooks[$e] = ([(.hooks[$e] // [])[] | select(.command != $cmd and .command != $old)] + [{command: $cmd}]))' \
    "$work/hooks.json" > "$work/hooks.next.json"
  if ! { [ -s "$CURSOR_HOOKS" ] && [ "$(jq -S . "$CURSOR_HOOKS")" = "$(jq -S . "$work/hooks.next.json")" ]; }; then
    write_settings "$work/hooks.next.json" "$CURSOR_HOOKS" || { say "failed to write $CURSOR_HOOKS"; return 1; }
    say "added the termag telemetry hook to $CURSOR_HOOKS"
  fi
  jq -n --arg cmd "$cmd" '{command: $cmd}' > "$work/cursor-hooks.state"
  write_if_changed "$work/cursor-hooks.state" "$CURSOR_HOOKS_STATE" 600 || true
}

cursor_hooks_remove() {
  local cmd
  [ -s "$CURSOR_HOOKS_STATE" ] || return 0
  cmd=$(jq -r '.command // empty' "$CURSOR_HOOKS_STATE" 2>/dev/null || true)
  if [ -n "$cmd" ] && [ -s "$CURSOR_HOOKS" ]; then
    jq --arg cmd "$cmd" '
      if (.hooks | type) == "object" then
        .hooks |= with_entries(.value |= map(select(.command != $cmd)) | select(.value | length > 0))
      else . end' "$CURSOR_HOOKS" > "$WORK/hooks.json" 2>/dev/null \
      || { say "$CURSOR_HOOKS is not valid JSON; the termag hook is still in it"; return 1; }
    if [ "$(jq -S . "$CURSOR_HOOKS")" != "$(jq -S . "$WORK/hooks.json")" ]; then
      write_settings "$WORK/hooks.json" "$CURSOR_HOOKS" || { say "failed to write $CURSOR_HOOKS"; return 1; }
      say "removed the termag telemetry hook from $CURSOR_HOOKS"
    fi
  fi
  rm -f "$CURSOR_HOOKS_STATE"
}

agent_telemetry_apply() {
  local work=$WORK box
  cat > "$work/agent-telemetry.json"
  jq -e --arg res "$AGENT_RESOURCE" '
    (keys == ["endpoint", "resourceAttributes"])
    and (.endpoint | type == "string" and test("^https://[A-Za-z0-9.:-]+$"))
    and (.resourceAttributes | type == "string" and test($res) and test("(^|,)telemetry\\.project_id=[A-Za-z0-9]+(,|$)"))' \
    "$work/agent-telemetry.json" >/dev/null 2>&1 \
    || { say 'refusing agent telemetry that is not an https origin and plain resource attributes'; return 1; }
  clear_reason agent-telemetry
  box=$(hostname -s 2>/dev/null) || box=unknown
  case $box in ''|*[!A-Za-z0-9.-]*) box=unknown ;; esac
  jq --arg box "$box" '.resourceAttributes += ",termag.box=\($box)"' "$work/agent-telemetry.json" > "$work/agent-telemetry.next.json"
  install -d -m 700 "$STATE"
  if write_if_changed "$work/agent-telemetry.next.json" "$AGENT_TELEMETRY_STATE" 600; then
    say "recorded the termag telemetry destination for Codex, Cursor, Devin and pi in $AGENT_TELEMETRY_STATE"
  fi
  cursor_hooks_apply
}

agent_telemetry_remove() {
  cursor_hooks_remove || true
  if [ -e "$AGENT_TELEMETRY_STATE" ]; then
    rm -f "$AGENT_TELEMETRY_STATE"
    say "removed the termag telemetry destination for Codex, Cursor, Devin and pi"
  fi
}

# Checks the command apply recorded, not this copy's own path: apply runs from
# the agent's checkout, status often from the ~/.local/bin copy.
agent_telemetry_status() {
  local endpoint cmd hook
  if [ ! -s "$AGENT_TELEMETRY_STATE" ]; then off_line agent-telemetry; return; fi
  endpoint=$(jq -r '.endpoint // empty' "$AGENT_TELEMETRY_STATE" 2>/dev/null || true)
  cmd=$(jq -r '.command // empty' "$CURSOR_HOOKS_STATE" 2>/dev/null || true)
  hook=${cmd#\'}; hook=${hook%\'}
  if [ -z "$cmd" ] || [ ! -x "$hook" ] || ! jq -e --arg cmd "$cmd" \
       '[.hooks[]?[]?.command] | index($cmd)' "$CURSOR_HOOKS" >/dev/null 2>&1; then
    echo "agent-telemetry: NOT WORKING: Cursor's hooks ($CURSOR_HOOKS) no longer run termag-cursor-otel-hook; Codex, Devin and pi still export to $endpoint"
    return
  fi
  echo "agent-telemetry: on, termag-launched Codex and Devin sessions, every Cursor session and termag's pi sessions export to $endpoint"
}

# ── MCP servers (through the orchestrator's MCP broker) ─────────────────────
# One mcpServers entry per connector in ~/.claude.json, named after it, its URL
# the broker's /c/<id> and its headersHelper termag-mcp-headers (the box token,
# read on each connect). No MCP credential is ever written here. An entry the
# owner made under the same name is theirs: it is left alone and not recorded.
# ~/.claude.json is Claude Code's own and large, so only mcpServers is touched,
# through a temp file and mv. The read, merge and write hold a termag lock (two
# deliveries never interleave), and the file is compared with what was read
# just before the mv: a write Claude Code made meanwhile is merged again rather
# than reverted. Claude Code takes no lock of ours, so a write landing between
# that comparison and the mv can still be lost; the window is one cmp.

# Drop the recorded entries that still hold the recorded value.
JQ_MCP_STRIP='def mcpstrip($mine): reduce ($mine | to_entries[]) as $e (.;
                  if (.mcpServers // {})[$e.key] == $e.value then del(.mcpServers[$e.key]) else . end)
                | if .mcpServers == {} then del(.mcpServers) else . end;'

mcp_bump_version() {
  install -d -m 700 "$STATE"
  printf '%s\n' "$(date +%s%N)" > "$MCP_VERSION.tmp" && mv -f "$MCP_VERSION.tmp" "$MCP_VERSION"
}

MCP_LOCK="$STATE/claude-json.lock"
MCP_ATTEMPTS=5

# Runs "$@" holding MCP_LOCK (without flock, as on macOS, unlocked).
mcp_locked() {
  local rc=0
  command -v flock >/dev/null 2>&1 || { "$@"; return; }
  install -d -m 700 "$STATE"
  exec 9>"$MCP_LOCK"
  if ! flock -w "${TERMAG_MCP_LOCK_WAIT:-30}" 9; then
    exec 9>&-
    say "another termag write of $CLAUDE_JSON held its lock too long; not changing MCP servers"
    return 1
  fi
  "$@" || rc=$?
  exec 9>&-
  return "$rc"
}

# Whether CLAUDE_JSON still holds what was read into current.json.
claude_json_unchanged() {  # current.json
  if [ -s "$CLAUDE_JSON" ]; then cmp -s "$1" "$CLAUDE_JSON"; else jq -e '. == {}' "$1" >/dev/null 2>&1; fi
}

# Writes CLAUDE_JSON when it changed, then the state, then the version.
# Returns 75 when CLAUDE_JSON changed since current.json was read.
mcp_write() {  # current.json next.json mine.next.json
  if ! { [ -s "$CLAUDE_JSON" ] && [ "$(jq -S . "$1")" = "$(jq -S . "$2")" ]; }; then
    claude_json_unchanged "$1" || return 75
    write_settings "$2" "$CLAUDE_JSON" || { say "failed to write $CLAUDE_JSON"; return 1; }
  fi
  local before='' after none='{}'
  [ -s "$MCP_STATE" ] && before=$(jq -S -c . "$MCP_STATE")
  after=$(jq -S -c . "$3")
  if [ "$before" != "$after" ]; then
    install -d -m 700 "$STATE"
    install -m 600 "$3" "$MCP_STATE"
    # Once per apply or remove, and only when the set changed: a missing
    # record is no servers, so a first delivery of none reloads no session.
    [ "${before:-$none}" = "$after" ] || mcp_bump_version
    say "MCP servers through termag: $(jq -r 'keys | if length == 0 then "none" else join(", ") end' "$3") ($CLAUDE_JSON)"
  fi
}

# Adds or takes out MCP_PLUGIN_DIR in CLAUDE_SETTINGS' env.CLAUDE_CODE_PLUGIN_DIRS
# (a colon list), leaving any other folder the owner put there.
mcp_plugin_dirs() {  # add|remove
  local work=$WORK
  if [ "$1" = add ] && [ ! -f "$MCP_PLUGIN_DIR/.claude-plugin/plugin.json" ]; then
    say "no termag-mcp-refresh mod at $MCP_PLUGIN_DIR (termag-reconcile installs it); running sessions pick up new MCP servers only after a restart"
    return 0
  fi
  if [ -s "$CLAUDE_SETTINGS" ]; then cp "$CLAUDE_SETTINGS" "$work/plugin-current.json"; else echo '{}' > "$work/plugin-current.json"; fi
  jq --arg d "$MCP_PLUGIN_DIR" --arg op "$1" '
    ((.env // {}).CLAUDE_CODE_PLUGIN_DIRS // "" | split(":") | map(select(. != "" and . != $d))) as $others
    | (if $op == "add" then $others + [$d] else $others end) as $dirs
    | if $dirs == [] then (if .env then del(.env.CLAUDE_CODE_PLUGIN_DIRS) else . end)
      else .env.CLAUDE_CODE_PLUGIN_DIRS = ($dirs | join(":")) end
    | if .env == {} then del(.env) else . end' "$work/plugin-current.json" > "$work/plugin-next.json" 2>/dev/null \
    || { say "$CLAUDE_SETTINGS is not valid JSON; not changing CLAUDE_CODE_PLUGIN_DIRS"; return 0; }
  [ "$(jq -S . "$work/plugin-current.json")" = "$(jq -S . "$work/plugin-next.json")" ] && return 0
  # A missing settings file and nothing to add: leave it missing.
  [ -s "$CLAUDE_SETTINGS" ] || [ "$1" = add ] || return 0
  write_settings "$work/plugin-next.json" "$CLAUDE_SETTINGS" || { say "failed to write $CLAUDE_SETTINGS"; return 0; }
}

mcp_apply() {
  local work=$WORK config
  cat > "$work/mcp.json"
  jq -e --arg known "$MCP_AGENTS" '
    (keys == ["broker", "connectors"] or keys == ["agents", "broker", "connectors"])
    and ((.agents // []) | type == "array" and all(.[]; type == "string" and (. as $a | $known | split(" ") | index($a))) and length == (unique | length))
    and (.broker | type == "string" and test("^https://[A-Za-z0-9.:-]+$"))
    and (.connectors | type == "array" and all(.[];
          type == "object" and keys == ["id", "name"]
          and (.id | type == "string" and test("^[a-z0-9]{1,40}$"))
          and (.name | type == "string" and test("^[a-z][a-z0-9-]{0,40}$"))))
    and ([.connectors[].name] | length == (unique | length))' "$work/mcp.json" >/dev/null 2>&1 \
    || { say 'refusing an mcp delivery that is not an https broker, connector ids and names, and known agents'; return 1; }
  config=$(agent_config) || { say 'no agent config for the MCP broker token'; return 1; }
  jq -c --arg helper "$SELF_DIR/termag-mcp-headers" --arg config "$config" \
    '{url: .broker, headers_command: [$helper, $config]}' "$work/mcp.json" > "$work/api-broker.json" \
    && install -m 644 "$work/api-broker.json" "$API_BROKER_STATE" || say "failed to write $API_BROKER_STATE"
  mcp_locked mcp_retry mcp_apply_once "$config" || return
  # A delivery without agents (an orchestrator from before mcp-broker-v2)
  # leaves the other agents' entries as they are.
  if jq -e 'has("agents")' "$work/mcp.json" >/dev/null; then
    mcp_locked mcp_agents_sync "$work/mcp.json" "$config"
  fi
}

# Runs one read-merge-write attempt again while CLAUDE_JSON keeps changing under it.
mcp_retry() {  # fn args...
  local i rc
  for ((i = 1; i <= MCP_ATTEMPTS; i++)); do
    "$@"; rc=$?
    [ "$rc" -eq 75 ] || return "$rc"
  done
  say "$CLAUDE_JSON kept changing while termag merged its MCP servers; try again"
  return 1
}

mcp_apply_once() {  # agent-config
  local work=$WORK config=$1
  if [ -s "$CLAUDE_JSON" ]; then cp "$CLAUDE_JSON" "$work/current.json"; else echo '{}' > "$work/current.json"; fi
  if [ -s "$MCP_STATE" ]; then cp "$MCP_STATE" "$work/mine.json"; else echo '{}' > "$work/mine.json"; fi
  jq -e 'type == "object" and ((.mcpServers // {}) | type == "object")' "$work/current.json" >/dev/null 2>&1 \
    || { say "$CLAUDE_JSON is not a JSON object with an mcpServers object; not adding MCP servers"; return 1; }
  # headersHelper is a shell command; both paths are quoted for it.
  jq --slurpfile mine "$work/mine.json" --slurpfile d "$work/mcp.json" \
     --arg helper "$SELF_DIR/termag-mcp-headers" --arg config "$config" "$JQ_MCP_STRIP"'
    ($d[0].broker | sub("/+$"; "")) as $broker
    | mcpstrip($mine[0]) as $base
    | reduce $d[0].connectors[] as $c ({cfg: $base, mine: {}, kept: []};
        {type: "http", url: "\($broker)/c/\($c.id)", headersHelper: "\($helper | @sh) \($config | @sh)"} as $e
        | if (($base.mcpServers // {}) | has($c.name)) | not
          then .cfg.mcpServers[$c.name] = $e | .mine[$c.name] = $e
          elif $base.mcpServers[$c.name] == $e then .mine[$c.name] = $e
          else .kept += [$c.name] end)' "$work/current.json" > "$work/merged.json"
  jq '.cfg' "$work/merged.json" > "$work/next.json"
  jq '.mine' "$work/merged.json" > "$work/mine.next.json"
  if [ -n "$(jq -r '.kept | join(", ")' "$work/merged.json")" ]; then
    say "left your own MCP server $(jq -r '.kept | join(", ")' "$work/merged.json") in $CLAUDE_JSON in place of termag's"
  fi
  clear_reason mcp
  mcp_write "$work/current.json" "$work/next.json" "$work/mine.next.json" || return
  mcp_plugin_dirs add
}

mcp_remove() {
  local rc=0
  rm -f "$API_BROKER_STATE"
  mcp_plugin_dirs remove
  [ ! -s "$MCP_AGENTS_STATE" ] || mcp_locked mcp_agents_sync '' '' || rc=1
  [ -s "$MCP_STATE" ] || { rm -f "$MCP_STATE"; return "$rc"; }
  mcp_locked mcp_retry mcp_remove_once || return
  return "$rc"
}

mcp_remove_once() {
  local work=$WORK
  [ -s "$MCP_STATE" ] || { rm -f "$MCP_STATE"; return 0; }
  if [ -s "$CLAUDE_JSON" ]; then
    cp "$CLAUDE_JSON" "$work/current.json"
    jq --slurpfile mine "$MCP_STATE" "$JQ_MCP_STRIP"' mcpstrip($mine[0])' "$work/current.json" > "$work/next.json" 2>/dev/null \
      || { say "$CLAUDE_JSON is not valid JSON; termag's MCP servers are still in it"; return 1; }
  else
    echo '{}' > "$work/current.json"; cp "$work/current.json" "$work/next.json"
  fi
  echo '{}' > "$work/mine.next.json"
  mcp_write "$work/current.json" "$work/next.json" "$work/mine.next.json" || return
  rm -f "$MCP_STATE"
}

mcp_status() {
  local names missing broker
  if [ ! -e "$MCP_STATE" ]; then off_line mcp; return; fi
  names=$(jq -r 'keys | join(", ")' "$MCP_STATE" 2>/dev/null || true)
  broker=$(jq -r '[.[].url][0] // empty | sub("/c/[^/]*$"; "")' "$MCP_STATE" 2>/dev/null || true)
  missing=$(jq -r --slurpfile cfg "$CLAUDE_JSON" \
    '[to_entries[] | select(($cfg[0].mcpServers // {})[.key] != .value) | .key] | join(", ")' "$MCP_STATE" 2>/dev/null || echo '?')
  if [ -n "$missing" ]; then
    echo "mcp: NOT WORKING: $CLAUDE_JSON no longer holds termag's MCP server $missing (the next delivery puts it back)"
  elif [ -z "$names" ]; then
    echo 'mcp: on, no MCP connectors yet (add them on the termag Settings page, MCP section)'
  else
    echo "mcp: on, $names through the termag MCP broker ($broker)"
  fi
  mcp_agents_status
}

# ── MCP servers for the other agent CLIs (mcp-broker-v2) ────────────────────
# termag-credentials: mcp-broker-v2
# (That line is the marker agent/credentials.js looks for before it advertises
# mcp-broker-v2: the mcp delivery may then carry `agents`.)
#
# Claude Code mints the broker's Authorization header per request with
# termag-mcp-headers; no other agent CLI can run a header helper. Each of them
# gets, per connector, a stdio server entry that runs termag-mcp-bridge with
# the broker URL and the agent config's path, so its config holds no token and
# the token is read on every request.
# Same rules as the Claude entries: an entry the owner made under the same name
# is theirs and left alone; only what is recorded in MCP_AGENTS_STATE
# ({agent: {name: entry}}) is ever taken out again; a config file is created
# only for a CLI that is installed; and an agent the delivery no longer names,
# or a CLI that is gone, has its entries taken out. JSON configs are merged
# key by key; TOML configs (Codex, vibe) get a marked block at the end, checked
# with python3's tomllib before it is written when python3 has it.
MCP_AGENTS_STATE="$STATE/mcp-agents.json"
MCP_AGENTS='auggie codex cursor devin gemini pi vibe'
TOML_BEGIN='# >>> termag mcp (managed by termag-credentials; edits here are replaced)'
TOML_END='# <<< termag mcp'

mcp_agent_file() {  # agent
  case $1 in
    auggie) echo "$HOME/.augment/settings.json" ;;
    codex)  echo "${CODEX_HOME:-$HOME/.codex}/config.toml" ;;
    cursor) echo "$HOME/.cursor/mcp.json" ;;
    devin)  echo "${XDG_CONFIG_HOME:-$HOME/.config}/devin/mcp_config.json" ;;
    gemini) echo "$HOME/.gemini/settings.json" ;;
    pi)     echo "$HOME/.pi/agent/mcp.json" ;;
    vibe)   echo "${VIBE_HOME:-$HOME/.vibe}/config.toml" ;;
  esac
}

# Whether the agent's CLI is here. The agent unit's PATH has the nvm bin dir
# but not ~/.local/bin, where the cursor-agent and devin installers put theirs.
mcp_agent_installed() {  # agent
  local cli
  # Tests name the installed agents instead.
  if [ -n "${TERMAG_MCP_AGENTS_INSTALLED+x}" ]; then case " $TERMAG_MCP_AGENTS_INSTALLED " in *" $1 "*) return 0 ;; *) return 1 ;; esac; fi
  case $1 in cursor) cli=cursor-agent ;; *) cli=$1 ;; esac
  command -v "$cli" >/dev/null 2>&1 || [ -x "$HOME/.local/bin/$cli" ]
}

# The keys of an entry its CLI lets the owner change in place (pi's /mcp
# writes exposure and enabled into the entry, Gemini's trust and tool filters
# are edited there): kept across deliveries, and ignored when telling our entry
# from the owner's, as termag-reconcile does for pi's metaterm entry.
mcp_agent_tunables() {  # agent -> JSON array
  case $1 in
    pi)     echo '["enabled","exposure","toolExposure","timeout"]' ;;
    gemini) echo '["trust","timeout","includeTools","excludeTools"]' ;;
    *)      echo '[]' ;;
  esac
}
JQ_MCP_BARE='def bare($tun): if type == "object" then with_entries(select(.key as $k | $tun | index($k) | not)) else . end;
             def tunables($tun): if type == "object" then with_entries(select(.key as $k | $tun | index($k))) else {} end;'

# The entry for one connector: {command, args} in every JSON config (devin
# also wants its transport named); the TOML agents get the same two fields.
mcp_agent_entries() {  # agent delivery.json config -> {name: entry}
  jq --arg agent "$1" --arg bridge "$SELF_DIR/termag-mcp-bridge" --arg config "$3" '
    (.broker | sub("/+$"; "")) as $broker
    | [.connectors[] | {key: .name, value: (
        {command: $bridge, args: ["\($broker)/c/\(.id)", $config]}
        + (if $agent == "devin" then {transport: "stdio"} else {} end))}]
    | from_entries' "$2"
}

# The server names a TOML config defines, one per line; exit 2 when it does
# not parse. Without python3's tomllib, a grep for the table headers.
toml_names() {  # codex|vibe file
  if python3 -c 'import tomllib' >/dev/null 2>&1; then
    python3 -I -c '
import sys, tomllib
try:
    data = tomllib.load(open(sys.argv[2], "rb"))
except Exception:
    sys.exit(2)
servers = data.get("mcp_servers", {})
if sys.argv[1] == "codex":
    names = servers.keys() if isinstance(servers, dict) else []
else:
    names = [s.get("name") for s in servers if isinstance(s, dict)] if isinstance(servers, list) else []
for n in names:
    if isinstance(n, str):
        print(n)
' "$1" "$2"
    return
  fi
  if [ "$1" = codex ]; then
    sed -n 's/^[[:space:]]*\[[[:space:]]*mcp_servers[[:space:]]*\.[[:space:]]*"\{0,1\}\([A-Za-z0-9_-]*\)"\{0,1\}[[:space:]]*\].*/\1/p' "$2"
  else
    sed -n 's/^[[:space:]]*name[[:space:]]*=[[:space:]]*"\([A-Za-z0-9_-]*\)".*/\1/p' "$2"
  fi
}

toml_parses() {  # file
  python3 -c 'import tomllib' >/dev/null 2>&1 || return 0
  python3 -I -c 'import sys, tomllib; tomllib.load(open(sys.argv[1], "rb"))' "$1" >/dev/null 2>&1
}

# The marked block for these entries ({name: {command, args}}), or nothing.
toml_block() {  # codex|vibe entries.json
  jq -r --arg kind "$1" --arg b "$TOML_BEGIN" --arg e "$TOML_END" '
    if length == 0 then empty else
      $b, (to_entries[] | if $kind == "codex"
        then "[mcp_servers.\(.key)]", "command = \(.value.command | tojson)", "args = \(.value.args | tojson)"
        else "[[mcp_servers]]", "name = \(.key | tojson)", "transport = \"stdio\"",
             "command = \(.value.command | tojson)", "args = \(.value.args | tojson)" end), $e
    end' "$2"
}

# Brings one agent's config to these entries; prints what it recorded.
mcp_agent_sync() {  # agent wanted.json mine.json -> stdout: recorded {name: entry}
  local agent=$1 wanted=$2 mine=$3 file work="$WORK/agent-$1" kept
  file=$(mcp_agent_file "$agent")
  mkdir -p "$work"
  if [ "$(jq 'length' "$wanted")" = 0 ] && [ "$(jq 'length' "$mine")" = 0 ]; then echo '{}'; return 0; fi
  case $agent in
    codex|vibe)
      if [ -s "$file" ]; then strip_block "$TOML_BEGIN" "$TOML_END" < "$file" > "$work/base.toml"; else : > "$work/base.toml"; fi
      # The blank line written before our block goes with it.
      if [ -s "$file" ] && grep -qxF "$TOML_BEGIN" "$file"; then
        sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$work/base.toml" > "$work/base.trim" && mv "$work/base.trim" "$work/base.toml"
      fi
      if ! toml_parses "$work/base.toml"; then
        say "$file is not valid TOML; not changing its termag MCP servers"; cat "$mine"; return 1
      fi
      toml_names "$agent" "$work/base.toml" | jq -R . | jq -s . > "$work/theirs.json"
      jq --slurpfile theirs "$work/theirs.json" 'with_entries(select(.key as $k | $theirs[0] | index($k) | not))' "$wanted" > "$work/mine.next.json"
      kept=$(jq -r --slurpfile mine "$work/mine.next.json" 'keys - ($mine[0] | keys) | join(", ")' "$wanted")
      { cat "$work/base.toml"
        if [ "$(jq length "$work/mine.next.json")" != 0 ]; then
          # The owner's last line ended, then a blank line before ours.
          if [ -s "$work/base.toml" ]; then
            [ -z "$(tail -c1 "$work/base.toml")" ] || echo
            [ -z "$(tail -n1 "$work/base.toml")" ] || echo
          fi
          toml_block "$agent" "$work/mine.next.json"
        fi
      } > "$work/next.toml"
      if ! toml_parses "$work/next.toml"; then
        say "termag's MCP servers would make $file invalid TOML; not changing it"; cat "$mine"; return 1
      fi
      if ! { [ -s "$file" ] && cmp -s "$file" "$work/next.toml"; } && ! { [ ! -e "$file" ] && [ ! -s "$work/next.toml" ]; }; then
        mkdir -p "$(dirname "$file")"
        write_text "$work/next.toml" "$file" || { say "failed to write $file"; cat "$mine"; return 1; }
      fi ;;
    *)
      if [ -s "$file" ]; then cp "$file" "$work/current.json"; else echo '{}' > "$work/current.json"; fi
      if ! jq -e 'type == "object" and ((.mcpServers // {}) | type == "object")' "$work/current.json" >/dev/null 2>&1; then
        say "$file is not a JSON object with an mcpServers object; not changing its termag MCP servers"; cat "$mine"; return 1
      fi
      jq --slurpfile mine "$mine" --slurpfile want "$wanted" --argjson tun "$(mcp_agent_tunables "$agent")" "$JQ_MCP_BARE"'
        (.mcpServers // {}) as $servers
        | reduce ($mine[0] | to_entries[]) as $e ({cfg: ., keep: {}};
            if ($servers[$e.key] | bare($tun)) == $e.value
            then .keep[$e.key] = ($servers[$e.key] | tunables($tun)) | del(.cfg.mcpServers[$e.key]) else . end)
        | .keep as $keep
        | (.cfg | if .mcpServers == {} then del(.mcpServers) else . end) as $base
        | reduce ($want[0] | to_entries[]) as $c ({cfg: $base, mine: {}, kept: []};
            if (($base.mcpServers // {}) | has($c.key)) | not
            then .cfg.mcpServers[$c.key] = ($c.value + ($keep[$c.key] // {})) | .mine[$c.key] = $c.value
            elif ($base.mcpServers[$c.key] | bare($tun)) == $c.value then .mine[$c.key] = $c.value
            else .kept += [$c.key] end)' "$work/current.json" > "$work/merged.json"
      jq '.cfg' "$work/merged.json" > "$work/next.json"
      jq '.mine' "$work/merged.json" > "$work/mine.next.json"
      kept=$(jq -r '.kept | join(", ")' "$work/merged.json")
      if [ "$(jq -S . "$work/current.json")" != "$(jq -S . "$work/next.json")" ]; then
        write_settings "$work/next.json" "$file" || { say "failed to write $file"; cat "$mine"; return 1; }
      fi ;;
  esac
  [ -z "$kept" ] || say "left your own MCP server $kept in $file in place of termag's"
  if [ "$(jq -S -c . "$mine")" != "$(jq -S -c . "$work/mine.next.json")" ]; then
    say "MCP servers through termag for $agent: $(jq -r 'keys | if length == 0 then "none" else join(", ") end' "$work/mine.next.json") ($file)"
  fi
  cat "$work/mine.next.json"
}

# Writes a text file through a symlink, keeping its mode (0600 when new).
write_text() {  # src dest
  local dest tmp
  dest=$(readlink -f "$2")
  tmp=$(mktemp "$dest.XXXXXX")
  if [ -e "$dest" ]; then chmod --reference="$dest" "$tmp"; else chmod 600 "$tmp"; fi
  cat "$1" > "$tmp" && mv -f "$tmp" "$dest" || { rm -f "$tmp"; return 1; }
}

# Every agent to the delivery's connectors when the delivery names it and its
# CLI is here, to none otherwise. No delivery (remove mcp): none for all.
mcp_agents_sync() {  # delivery.json|'' config
  local delivery=$1 config=$2 agent rc=0 work="$WORK/agents"
  mkdir -p "$work"
  if [ -s "$MCP_AGENTS_STATE" ]; then cp "$MCP_AGENTS_STATE" "$work/state.json"; else echo '{}' > "$work/state.json"; fi
  echo '{}' > "$work/state.next.json"
  for agent in $MCP_AGENTS; do
    jq --arg a "$agent" '.[$a] // {}' "$work/state.json" > "$work/$agent.mine.json"
    if [ -n "$delivery" ] && jq -e --arg a "$agent" '(.agents // []) | index($a)' "$delivery" >/dev/null && mcp_agent_installed "$agent"; then
      mcp_agent_entries "$agent" "$delivery" "$config" > "$work/$agent.want.json"
    else
      echo '{}' > "$work/$agent.want.json"
    fi
    mcp_agent_sync "$agent" "$work/$agent.want.json" "$work/$agent.mine.json" > "$work/$agent.rec.json" || rc=1
    jq --arg a "$agent" --slurpfile rec "$work/$agent.rec.json" \
      'if ($rec[0] | length) > 0 then .[$a] = $rec[0] else . end' "$work/state.next.json" > "$work/s.json"
    mv "$work/s.json" "$work/state.next.json"
  done
  if [ "$(jq length "$work/state.next.json")" = 0 ]; then
    rm -f "$MCP_AGENTS_STATE"
  else
    install -d -m 700 "$STATE"
    write_if_changed "$work/state.next.json" "$MCP_AGENTS_STATE" 600 || true
  fi
  return "$rc"
}

mcp_agents_status() {
  local agent file names missing
  [ -s "$MCP_AGENTS_STATE" ] || return 0
  for agent in $(jq -r 'keys[]' "$MCP_AGENTS_STATE" 2>/dev/null); do
    file=$(mcp_agent_file "$agent")
    [ -n "$file" ] || continue
    names=$(jq -r --arg a "$agent" '.[$a] | keys | join(", ")' "$MCP_AGENTS_STATE")
    case $agent in
      codex|vibe)
        missing=$(jq -r --arg a "$agent" '.[$a] | keys[]' "$MCP_AGENTS_STATE" | while read -r n; do
          { [ -f "$file" ] && grep -qxF "$TOML_BEGIN" "$file" && toml_names "$agent" "$file" | grep -qxF "$n"; } || echo "$n"
        done | paste -sd, - | sed 's/,/, /g') ;;
      *)
        missing=$(jq -r --arg a "$agent" --slurpfile cfg "$file" --argjson tun "$(mcp_agent_tunables "$agent")" "$JQ_MCP_BARE"'
          [.[$a] | to_entries[] | select((($cfg[0].mcpServers // {})[.key] | bare($tun)) != .value) | .key] | join(", ")' "$MCP_AGENTS_STATE" 2>/dev/null || echo '?') ;;
    esac
    if [ -n "$missing" ]; then
      echo "mcp ($agent): NOT WORKING: $file no longer holds termag's MCP server $missing (the next delivery puts it back)"
    else
      echo "mcp ($agent): on, $names through termag-mcp-bridge ($file)"
    fi
  done
}

# ── Fireworks (pi and Claude Code, through the gateway) ─────────────────────
# Two agents use the gateway's /fireworks route with this box's token, read
# from the agent config on each request by termag-claude-token: pi, through a
# `termag-fireworks` provider in its models file (OpenAI chat completions), and
# Claude Code, through a settings file launch-settings hands it as
# `--settings` (Anthropic messages). Neither touches ~/.claude/settings.json:
# only a session started on the fireworks backend leaves Bedrock. A
# `termag-fireworks` provider the owner wrote themselves is theirs and left
# alone.
FIREWORKS_MODEL='^accounts/[a-z0-9-]+/(models|routers)/[A-Za-z0-9._-]+$'

fireworks_apply() {
  local work=$WORK config helper
  cat > "$work/fireworks.json"
  if [ -e "$FIREWORKS_SKIP" ]; then
    fireworks_remove
    return 0
  fi
  jq -e '(keys == ["baseUrl"]) and (.baseUrl | type == "string" and test("^https://[A-Za-z0-9.:-]+(/[A-Za-z0-9._-]+)*/?$"))' \
    "$work/fireworks.json" >/dev/null 2>&1 || { say 'refusing a fireworks delivery that is not an https base'; return 1; }
  config=$(agent_config) || { say 'no agent config for the Fireworks gateway token'; return 1; }
  # A shell command for both agents; both paths are quoted for it.
  helper="$(printf '%s' "$SELF_DIR/termag-claude-token" | jq -Rr @sh) $(printf '%s' "$config" | jq -Rr @sh)"
  install -d -m 700 "$STATE"
  clear_reason fireworks

  # The Bedrock keys are empty, which Claude Code reads as unset, so a session
  # started with these talks Anthropic messages to the gateway whatever the
  # owner's settings say; Fireworks serves no Anthropic beta features. The
  # model comes with each launch (launch-settings).
  jq --arg helper "$helper" '
    (.baseUrl | sub("/+$"; "")) as $base
    | {apiKeyHelper: $helper,
       env: {
         ANTHROPIC_BASE_URL: "\($base)/inference",
         CLAUDE_CODE_USE_BEDROCK: "", CLAUDE_CODE_SKIP_BEDROCK_AUTH: "",
         CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS: "1"
       }}' "$work/fireworks.json" > "$work/claude-fireworks.json"
  write_if_changed "$work/claude-fireworks.json" "$FIREWORKS_CLAUDE" 600 \
    && say "Claude Code (Fireworks) settings in $FIREWORKS_CLAUDE" || true

  write_if_changed "$work/fireworks.json" "$FIREWORKS_STATE" 600 \
    && say "Fireworks through $(jq -r .baseUrl "$work/fireworks.json")" || true
  # pi's provider, if a launch already made one, onto the (new) base, keeping its models.
  if [ -s "$PI_FIREWORKS_STATE" ]; then fireworks_pi_entry "$helper" "$work/pi-entry.json" && pi_provider_merge "$work/pi-entry.json"; fi
}

# pi's provider: the delivered base and the token helper, with the models
# launches have added (fireworks_pi_model) or none yet.
fireworks_pi_entry() {  # helper out.json
  local mine='null'
  [ -s "$PI_FIREWORKS_STATE" ] && mine=$(cat "$PI_FIREWORKS_STATE")
  jq --arg helper "!$1" --argjson mine "$mine" '
    (.baseUrl | sub("/+$"; "")) as $base
    | {name: "Fireworks (termag)", baseUrl: "\($base)/inference/v1", api: "openai-completions", apiKey: $helper,
       models: ($mine.models // [])}' "$FIREWORKS_STATE" > "$2"
}

# Fails, saying why, where Fireworks is not set up here: skipped, never
# delivered, or removed (the orchestrator's reason, when it gave one).
fireworks_ready() {
  local reason
  if [ -e "$FIREWORKS_SKIP" ] || [ ! -s "$FIREWORKS_STATE" ] || [ ! -s "$FIREWORKS_CLAUDE" ]; then
    reason=$(cat "$STATE/fireworks.status" 2>/dev/null || true)
    [ -e "$FIREWORKS_SKIP" ] && reason='skipped on this box (termag-credentials unskip fireworks)'
    say "Fireworks is not set up on this box${reason:+: $reason}; termag-credentials status says more"
    return 1
  fi
}

# The models of pi's provider, as termag-pi-fireworks asks for them at
# launch. With --models (the flag's list, fireworksMenuArg) the provider's
# models become that list, in its order, each named by its label and with its
# window (pi otherwise guesses 128k), so pi's /model lists them all and a
# model dropped from the flag goes at the next launch; the launch's model is
# kept if the list lacks it. Without it (an older orchestrator, termag
# desktop's bridge) the launch's model is added to those already there.
# termag-credentials: fireworks-pi-menu-v1 (agent/credentials.js advertises it
# while this line is here, and termag-pi-fireworks has its own): --models.
fireworks_pi_model() {  # --model <id> [--context <n>] [--models <base64>]
  local work=$WORK model='' context='' models='' list='null' config helper
  while [ $# -gt 0 ]; do
    case $1 in
      --model) model=${2:-}; shift 2 2>/dev/null || shift ;;
      --context) context=${2:-}; shift 2 2>/dev/null || shift ;;
      --models) models=${2:-}; shift 2 2>/dev/null || shift ;;
      *) say "pi-model: unknown argument $1"; return 2 ;;
    esac
  done
  printf '%s' "$model" | grep -Eq "$FIREWORKS_MODEL" || { say "pi-model: not a Fireworks model id: $model"; return 1; }
  case $context in ''|[1-9][0-9][0-9][0-9]|[1-9][0-9][0-9][0-9][0-9]|[1-9][0-9][0-9][0-9][0-9][0-9]|[1-9][0-9][0-9][0-9][0-9][0-9][0-9]|[1-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]) ;;
    *) say "pi-model: not a context window: $context"; return 1 ;; esac
  fireworks_ready || return 1
  if [ -n "$models" ]; then
    list=$(fireworks_list "$models") && [ -n "$list" ] \
      || { say "pi-model: --models is not a model list; adding only $model to pi's provider"; list='null'; }
  fi
  config=$(agent_config) || { say 'no agent config for the Fireworks gateway token'; return 1; }
  helper="$(printf '%s' "$SELF_DIR/termag-claude-token" | jq -Rr @sh) $(printf '%s' "$config" | jq -Rr @sh)"
  fireworks_pi_entry "$helper" "$work/pi-base.json"
  jq --arg id "$model" --arg ctx "$context" --argjson list "$list" '
    def entry($id; $name; $c): {id: $id, name: $name} + (if $c then {contextWindow: $c} else {} end);
    ($ctx | if . != "" then tonumber else null end) as $c
    | if $list == null
      then .models = ([.models[] | select(.id != $id)] + [entry($id; $id | split("/") | last; $c)])
      else .models = ([$list[] | entry(.id; .label; (if .id == $id and $c then $c else .context end))]
                      + (if any($list[]; .id == $id) then [] else [entry($id; $id | split("/") | last; $c)] end))
      end' "$work/pi-base.json" > "$work/pi-entry.json"
  pi_provider_merge "$work/pi-entry.json"
}

# Our previous entry out (if it still holds what we wrote), the new one in
# unless the owner has their own under the same name.
pi_provider_merge() {  # entry.json
  local work=$WORK
  if [ -s "$PI_MODELS" ]; then cp "$PI_MODELS" "$work/pi-current.json"; else echo '{}' > "$work/pi-current.json"; fi
  if [ -s "$PI_FIREWORKS_STATE" ]; then cp "$PI_FIREWORKS_STATE" "$work/pi-mine.json"; else echo 'null' > "$work/pi-mine.json"; fi
  jq -e 'type == "object" and ((.providers // {}) | type == "object")' "$work/pi-current.json" >/dev/null 2>&1 \
    || { say "$PI_MODELS is not a JSON object with a providers object; not adding pi's Fireworks provider"; return 1; }
  jq --slurpfile mine "$work/pi-mine.json" --slurpfile e "$1" --arg p "$PI_PROVIDER" '
    (if (.providers // {})[$p] != null and .providers[$p] == $mine[0] then del(.providers[$p]) else . end) as $base
    | if (($base.providers // {}) | has($p)) then {cfg: $base, ours: false}
      else {cfg: ($base | .providers[$p] = $e[0]), ours: true} end' "$work/pi-current.json" > "$work/pi-merged.json"
  if [ "$(jq -r .ours "$work/pi-merged.json")" != true ]; then
    say "left your own $PI_PROVIDER provider in $PI_MODELS in place of termag's"
    rm -f "$PI_FIREWORKS_STATE"
    return 0
  fi
  jq .cfg "$work/pi-merged.json" > "$work/pi-next.json"
  if ! { [ -s "$PI_MODELS" ] && [ "$(jq -S . "$work/pi-current.json")" = "$(jq -S . "$work/pi-next.json")" ]; }; then
    write_settings "$work/pi-next.json" "$PI_MODELS" || { say "failed to write $PI_MODELS"; return 1; }
    say "pi's $PI_PROVIDER provider in $PI_MODELS"
  fi
  write_if_changed "$1" "$PI_FIREWORKS_STATE" 600 || true
}

fireworks_remove() {
  local work=$WORK
  if [ -s "$PI_FIREWORKS_STATE" ] && [ -s "$PI_MODELS" ]; then
    jq --slurpfile mine "$PI_FIREWORKS_STATE" --arg p "$PI_PROVIDER" '
      if (.providers // {})[$p] == $mine[0] then del(.providers[$p]) else . end' "$PI_MODELS" > "$work/pi-next.json" 2>/dev/null \
      || { say "$PI_MODELS is not valid JSON; termag's Fireworks provider is still in it"; return 1; }
    if [ "$(jq -S . "$PI_MODELS")" != "$(jq -S . "$work/pi-next.json")" ]; then
      write_settings "$work/pi-next.json" "$PI_MODELS" || { say "failed to write $PI_MODELS"; return 1; }
      say "removed pi's $PI_PROVIDER provider from $PI_MODELS"
    fi
  fi
  rm -f "$PI_FIREWORKS_STATE"
  if [ -e "$FIREWORKS_STATE" ] || [ -e "$FIREWORKS_CLAUDE" ]; then
    rm -f "$FIREWORKS_STATE" "$FIREWORKS_CLAUDE"
    say 'removed the Fireworks settings'
  fi
}

# The gateway's <base>/auth-check takes the same check as a model call and
# answers 204, so this makes no Fireworks call.
fireworks_status() {
  local base token code err
  if [ -e "$FIREWORKS_SKIP" ]; then echo 'fireworks: skipped on this box'; return; fi
  if [ ! -s "$FIREWORKS_STATE" ]; then off_line fireworks; return; fi
  base=$(jq -r '.baseUrl // empty | sub("/+$"; "")' "$FIREWORKS_STATE" 2>/dev/null || true)
  token=$(jq -r '.token // empty' "$(agent_config 2>/dev/null)" 2>/dev/null || true)
  code=$(printf 'header = "Authorization: Bearer %s"\n' "$token" | curl -sS -m 15 -K - -o "$WORK/fireworks" \
    -w '%{http_code}' "$base/auth-check" 2>"$WORK/fireworks.err" || true)
  case $code in
    204) echo "fireworks: on, pi and Claude Code on the fireworks backend reach Fireworks through the gateway at $base, which accepts this box's token" ;;
    000|'') err=$(tail -n1 "$WORK/fireworks.err" 2>/dev/null | sed 's/^curl: ([0-9]*) //')
            echo "fireworks: NOT WORKING: the gateway at $base is unreachable (${err:-no response})" ;;
    5*) echo "fireworks: NOT WORKING: the gateway at $base could not reach termag to check this box (HTTP $code)" ;;
    *) echo "fireworks: NOT WORKING: the gateway at $base refused this box (HTTP $code): $(jq -r '.message // empty' "$WORK/fireworks" 2>/dev/null)" ;;
  esac
}

# ── The shared Bazel cache ───────────────────────────────────────────────────
# Data path C:
# Bazel reads an S3 bucket anonymously through the VPC endpoint, so the box
# holds no credential and nothing here can fail a build. The block goes into
# the system rc, read before the workspace's .bazelrc, so a repository that
# sets its own cache flags wins (gotcha "box-bazelrc-global" on why not
# ~/.bazelrc). The backend sends values, never rc text: each is checked here
# again with the backend's ranges, and the block is rendered from them. Never
# --experimental_remote_downloader, which Bazel refuses next to an HTTP cache.
#
# Every step (apply or remove) runs under one lock, and carries the backend's
# monotonic seq: a step older than the last one applied is refused, so an apply
# evaluated before the flag turned off can't land after the remove. A step whose
# flushGeneration is higher than the last one recorded deletes what this box
# copied from the cache, a remove included, so a flush reaches a box whose block
# went off before it. Only a box that has applied the block since its last flush
# is flushed: the rest of the fleet, which never read the cache, keeps its
# servers, output bases and baked disk cache. A remove takes the block out
# before it flushes, so the kill switch never waits on a flush.
BAZEL_URL_RE='^https://[a-z0-9][a-z0-9-]{1,61}[a-z0-9]\.s3\.[a-z0-9-]+\.amazonaws\.com/g/[0-9]{4}w(0[1-9]|[1-4][0-9]|5[0-3])(-[1-9][0-9]?)?$'

bazel_block() {  # url download timeout retries jobs gomodcache|''
  cat <<BLOCK
$BAZEL_BEGIN
# Read webapp main's build outputs from termag's shared cache (S3, through
# the VPC endpoint). Boxes only read it; a termag-owned writer fills it.
# A dead cache costs seconds, not the build.
# Added by termag-credentials.
build --remote_cache=$1
build --noremote_upload_local_results
build --remote_download_$2
build --remote_timeout=${3}s
build --remote_retries=$4
build --remote_retry_max_delay=1s
build --experimental_circuit_breaker_strategy=failure
build --jobs=$5
BLOCK
  if [ -n "${6:-}" ]; then
    cat <<BLOCK
# Go modules from one module cache outside every output base (goHostModcache).
# The keys don't change.
common --repo_env=GO_REPOSITORY_USE_HOST_MODCACHE=1
common --repo_env=GOMODCACHE=$6
BLOCK
  fi
  printf '%s\n' "$BAZEL_END"
}

# An apply payload's fields, checked, one per line in this order: seq url
# flushGeneration remoteTimeoutSeconds remoteRetries jobs downloadOutputs
# goHostModcache. A missing tunable takes its code default; seq and url are
# required. Any bad field refuses the whole payload, saying which.
bazel_apply_fields() {  # payload.json
  jq -r --arg re "$BAZEL_URL_RE" '
    def int($lo; $hi): type == "number" and . == floor and . >= $lo and . <= $hi;
    def need($k; ok): if has($k) and (.[$k] | ok) then .[$k] else error("bad or missing \($k)") end;
    def opt($k; $d; ok): if has($k) then (if (.[$k] | ok) then .[$k] else error("bad \($k)") end) else $d end;
    if type != "object" then error("not a JSON object") else . end
    | [ need("seq"; int(0; 9007199254740991)),
        need("url"; type == "string" and test($re)),
        opt("flushGeneration"; 0; int(0; 2147483647)),
        opt("remoteTimeoutSeconds"; 5; int(1; 60)),
        opt("remoteRetries"; 1; int(0; 5)),
        opt("jobs"; 200; int(8; 400)),
        opt("downloadOutputs"; "toplevel"; . == "toplevel" or . == "all"),
        opt("goHostModcache"; false; type == "boolean") ]
    | .[] | tostring' "$1" 2>&1
}

# One field of a remove, if it is there and valid; nothing otherwise. A remove
# is the kill switch, so a bad field is ignored and the block still goes.
bazel_remove_field() {  # payload.json key max
  jq -r --arg k "$2" --argjson max "$3" '
    if type == "object" and has($k) and (.[$k] | type == "number" and . == floor and . >= 0 and . <= $max)
    then .[$k] | tostring else empty end' "$1" 2>/dev/null || true
}

# The lock every bazel-cache step holds until this script exits.
bazel_lock() {
  install -d -m 700 "$STATE"
  command -v flock >/dev/null 2>&1 || { say 'bazel-cache: no flock here; going on without the lock'; return 0; }
  exec 8>"$BAZEL_LOCK"
  flock -w "${TERMAG_BAZEL_CACHE_LOCK_WAIT:-120}" 8 || { say 'bazel-cache: another bazel-cache step held the lock too long'; return 1; }
}

# 0 when seq may be applied, 1 when it's older than the last one applied.
bazel_seq_ok() {  # seq|''
  local last
  [ -n "$1" ] || return 0
  last=$(cat "$BAZEL_SEQ" 2>/dev/null || true)
  [[ $last =~ ^[0-9]{1,16}$ ]] || return 0
  if [ "$1" -lt "$last" ]; then
    say "bazel-cache: refused a step older than the last one applied (seq $1 < $last)"
    return 1
  fi
}

bazel_seq_record() {  # seq|''
  [ -z "$1" ] || printf '%s\n' "$1" > "$BAZEL_SEQ"
}

# Replaces the system rc with <file>, or removes it, through sudo; renamed into
# place, so a build never reads half of it.
bazel_rc_put() {  # file|-
  if [ "$1" = - ]; then $SUDO rm -f "$BAZEL_RC"; return; fi
  $SUDO install -m 0644 "$1" "$BAZEL_RC.termag-new" && $SUDO mv -f "$BAZEL_RC.termag-new" "$BAZEL_RC"
}

# A flush (the runbook's, after a poisoned entry): anything this box copied
# from the shared cache goes. Bazel's combined cache copies remote hits into the
# local disk cache, which ~/.bazelrc keeps reading with no block at all, and an
# output base keeps bazel-bin and its own action cache. Each output base's
# server is stopped first, since it holds the base open. The repository cache
# and the repo contents cache hold no action results and stay.
# The output roots to flush: Bazel's default, and any --output_user_root the
# system rc (outside the block) or ~/.bazelrc names, where the bases sit
# directly under the root. Boxes ship without one; the bake's scratch volume
# sets one in the system rc (packer/scripts/prepare-scratch.sh).
bazel_output_roots() {
  printf '%s\n' "$HOME/.cache/bazel/_bazel_$(id -un)"
  { content_of "$BAZEL_RC" | strip_block "$BAZEL_BEGIN" "$BAZEL_END"; content_of "$HOME/.bazelrc"; } \
    | sed -n 's/^startup[[:space:]]\{1,\}--output_user_root=\([^[:space:]]\{1,\}\)[[:space:]]*$/\1/p' \
    | sed "s#^~/#$HOME/#" | grep '^/' || true
}

# This box's output bases, one per line.
bazel_output_bases() {
  local root base
  while IFS= read -r root; do
    for base in "$root"/*; do
      [[ ${base##*/} =~ ^[0-9a-f]{32}$ ]] && [ -d "$base" ] && [ -O "$base" ] && printf '%s\n' "$base"
    done
  done < <(bazel_output_roots | sort -u)
}

# In three passes, so one stuck output base can't keep the rest: stop every
# base's server first (a build still running would write remote hits into the
# disk cache after it went), then delete the disk cache, which ~/.bazelrc keeps
# reading with no block at all, then each output base, carrying on past one it
# can't delete. Fails, naming what is left, if anything is.
bazel_flush() {
  local base pid i left=()
  local -a bases
  mapfile -t bases < <(bazel_output_bases)
  for base in "${bases[@]}"; do
    pid=$(cat "$base/server/server.pid.txt" 2>/dev/null || true)
    if [[ $pid =~ ^[0-9]+$ ]] && tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -qF -- "--output_base=$base"; then
      kill "$pid" 2>/dev/null || true
      for i in $(seq 50); do kill -0 "$pid" 2>/dev/null || break; sleep 0.2; done
      kill -9 "$pid" 2>/dev/null || true
      for i in $(seq 10); do kill -0 "$pid" 2>/dev/null || break; sleep 0.2; done
    fi
  done
  # Bazel leaves its outputs read-only.
  if [ -e "$HOME/.cache/bazel-disk" ]; then
    chmod -R u+w "$HOME/.cache/bazel-disk" 2>/dev/null || true
    rm -rf "$HOME/.cache/bazel-disk" 2>/dev/null || left+=("$HOME/.cache/bazel-disk")
  fi
  for base in "${bases[@]}"; do
    chmod -R u+w "$base" 2>/dev/null || true
    rm -rf "$base" 2>/dev/null || left+=("$base")
  done
  if [ "${#left[@]}" -gt 0 ]; then
    say "bazel-cache: the flush could not delete ${left[*]}"
    printf '%s\n' "${left[@]}" > "$WORK/bazel-flush-left"
    return 1
  fi
  say 'bazel-cache: flushed the local disk cache and every output base (a new flush generation)'
}

# Whether this box's local caches may hold entries from the shared cache: it
# has applied the block since its last flush, or the block is in place.
bazel_used() {
  [ -e "$BAZEL_USED" ] || grep -qxF "$BAZEL_BEGIN" "$BAZEL_RC" 2>/dev/null
}

# The step lock goes while a flush runs, so a remove (the kill switch) never
# waits behind one.
bazel_unlock() {
  if command -v flock >/dev/null 2>&1; then flock -u 8 2>/dev/null || true; fi
}

# Under the step lock: 0 when a flush to gen must run first, 1 when none is
# needed. A flush is needed when gen is higher than the last one recorded, on
# a box whose local caches may hold entries from the shared cache. On a box
# that hasn't used the cache, an apply raises the record (a high-water mark:
# never lowered, so a variation reset can't make the old number flush again)
# and a remove leaves none. A used box with no record yet starts one.
bazel_flush_needed() {  # gen|'' apply|remove
  local last
  [ -n "$1" ] || return 1
  last=$(cat "$BAZEL_FLUSHED" 2>/dev/null || true)
  if ! bazel_used; then
    if [ "$2" = apply ] && { ! [[ $last =~ ^[0-9]{1,10}$ ]] || [ "$1" -gt "$last" ]; }; then
      printf '%s\n' "$1" > "$BAZEL_FLUSHED"
    fi
    return 1
  fi
  if ! [[ $last =~ ^[0-9]{1,10}$ ]]; then printf '%s\n' "$1" > "$BAZEL_FLUSHED"; return 1; fi
  [ "$1" -gt "$last" ]
}

# Runs the flush to gen with the step lock released, one flush at a time
# (its own lock, with no time limit: a flush always ends), then takes the step
# lock back. A flush that already reached gen meanwhile isn't repeated. A
# failed flush is recorded for status and leaves the record where it was, so
# the next step tries again. 0 when the box is flushed to gen.
bazel_flush_unlocked() {  # gen
  local last rc=0
  bazel_unlock
  if command -v flock >/dev/null 2>&1; then exec 9>"$BAZEL_LOCK.flush"; flock 9 || true; fi
  last=$(cat "$BAZEL_FLUSHED" 2>/dev/null || true)
  if ! { [[ $last =~ ^[0-9]{1,10}$ ]] && [ "$1" -le "$last" ]; }; then
    if bazel_flush; then
      rm -f "$BAZEL_FLUSH_FAILED"
      printf '%s\n' "$1" > "$BAZEL_FLUSHED"
    else
      { printf 'generation %s: ' "$1"; tr '\n' ' ' < "$WORK/bazel-flush-left" 2>/dev/null; echo; } > "$BAZEL_FLUSH_FAILED"
      rc=1
    fi
  fi
  if command -v flock >/dev/null 2>&1; then flock -u 9 2>/dev/null || true; fi
  bazel_lock || return 1
  return "$rc"
}

# Every accepted step, with a seq or without (the orchestrator's refusal to an
# unmanaged box carries none), bumps this counter under the step lock and
# prints the new value. A step that released the lock for a flush goes on
# only if the counter hasn't moved: any step that ran meanwhile decides.
bazel_step_begin() {
  local n
  n=$(cat "$BAZEL_STEPS" 2>/dev/null || true)
  [[ $n =~ ^[0-9]{1,18}$ ]] || n=0
  n=$((n + 1))
  printf '%s\n' "$n" > "$BAZEL_STEPS"
  printf '%s' "$n"
}

bazel_step_latest() {  # n
  [ "$(cat "$BAZEL_STEPS" 2>/dev/null)" = "$1" ]
}

# Takes the block out of the system rc; an rc apply created goes again.
bazel_block_remove() {
  local work=$WORK
  grep -qxF "$BAZEL_BEGIN" "$BAZEL_RC" 2>/dev/null || { rm -f "$BAZEL_RC_CREATED"; return 0; }
  strip_block "$BAZEL_BEGIN" "$BAZEL_END" < "$BAZEL_RC" > "$work/bazelrc"
  if [ ! -s "$work/bazelrc" ] && [ -e "$BAZEL_RC_CREATED" ]; then
    bazel_rc_put - || { say "bazel-cache: could not remove $BAZEL_RC"; return 1; }
  else
    bazel_rc_put "$work/bazelrc" || { say "bazel-cache: could not write $BAZEL_RC"; return 1; }
  fi
  rm -f "$BAZEL_RC_CREATED"
  say "bazel-cache: removed the shared cache from $BAZEL_RC"
}

bazel_cache_apply() {
  local work=$WORK out seq url gen timeout retries jobs dl gomod step modcache='' probe
  local -a f
  cat > "$work/bazel-cache.json"
  if ! out=$(bazel_apply_fields "$work/bazel-cache.json"); then
    say "bazel-cache payload refused: ${out##*: }"
    return 1
  fi
  mapfile -t f <<<"$out"
  [ "${#f[@]}" = 8 ] || { say 'bazel-cache payload refused'; return 1; }
  seq=${f[0]} url=${f[1]} gen=${f[2]} timeout=${f[3]} retries=${f[4]} jobs=${f[5]} dl=${f[6]} gomod=${f[7]}
  # Checked again where it matters, since each goes into the rc verbatim.
  [[ $url =~ $BAZEL_URL_RE && $seq =~ ^[0-9]+$ && $gen =~ ^[0-9]+$ && $timeout =~ ^[0-9]+$ \
     && $retries =~ ^[0-9]+$ && $jobs =~ ^[0-9]+$ && $dl =~ ^(toplevel|all)$ && $gomod =~ ^(true|false)$ ]] \
    || { say 'bazel-cache payload refused'; return 1; }

  bazel_lock || return 1
  bazel_seq_ok "$seq" || return 0
  # Accepted: no older step may land after this one, whatever happens below.
  bazel_seq_record "$seq"
  step=$(bazel_step_begin)
  if bazel_flush_needed "$gen" apply; then
    # No block while what this box copied from the cache is still here.
    bazel_block_remove || true
    rm -f "$BAZEL_STATE"
    if ! bazel_flush_unlocked "$gen"; then
      say 'bazel-cache: the flush failed, so the shared cache stays off here until one succeeds'
      return 1
    fi
    bazel_step_latest "$step" || return 0
  fi
  if [ -e "$BAZEL_SKIP" ]; then
    bazel_block_remove || return 1
    rm -f "$BAZEL_STATE"
    bazel_seq_record "$seq"
    return 0
  fi

  # goHostModcache: the module cache's two lines, once its directory exists.
  # The path goes into the rc verbatim, so it is checked like every other
  # value. Off renders no lines and leaves the directory: go makes its
  # contents read-only, they're checked against go.sum, and on again reuses them.
  if [ "$gomod" = true ]; then
    if ! [[ $BAZEL_GOMODCACHE =~ $BAZEL_GOMODCACHE_RE ]] || [[ $BAZEL_GOMODCACHE == *..* ]]; then
      say "bazel-cache: goHostModcache is on, but $BAZEL_GOMODCACHE can't go into the rc; Go modules stay per output base"
    elif ! mkdir -p "$BAZEL_GOMODCACHE" 2>/dev/null; then
      say "bazel-cache: goHostModcache is on, but $BAZEL_GOMODCACHE could not be created; Go modules stay per output base"
    # An existing directory the box user can't write (root's, or a read-only
    # mount) would fail every module download into it: probe it.
    elif ! probe=$(mktemp "$BAZEL_GOMODCACHE/.termag-probe.XXXXXX" 2>/dev/null) || ! rm -f "$probe"; then
      say "bazel-cache: goHostModcache is on, but $BAZEL_GOMODCACHE isn't writable; Go modules stay per output base"
    else
      modcache=$BAZEL_GOMODCACHE
    fi
  fi
  { content_of "$BAZEL_RC" | strip_block "$BAZEL_BEGIN" "$BAZEL_END"
    bazel_block "$url" "$dl" "$timeout" "$retries" "$jobs" "$modcache"; } > "$work/bazelrc"
  if ! cmp -s "$work/bazelrc" "$BAZEL_RC" 2>/dev/null; then
    [ -e "$BAZEL_RC" ] || [ -e "$BAZEL_RC_CREATED" ] || : > "$BAZEL_RC_CREATED"
    bazel_rc_put "$work/bazelrc" || { say "bazel-cache: could not write $BAZEL_RC"; return 1; }
    say "bazel-cache: Bazel reads the shared cache at $url ($BAZEL_RC)"
  fi
  # From here on, this box's local caches may hold entries from the shared cache.
  : > "$BAZEL_USED"

  # goHostModcache as it took effect: false when its directory couldn't be used.
  jq -n --arg url "$url" --argjson gen "$gen" --argjson t "$timeout" --argjson r "$retries" \
    --argjson j "$jobs" --arg dl "$dl" --argjson gm "$([ -n "$modcache" ] && echo true || echo false)" \
    '{url: $url, flushGeneration: $gen, remoteTimeoutSeconds: $t, remoteRetries: $r, jobs: $j,
      downloadOutputs: $dl, goHostModcache: $gm}' > "$work/bazel-state.json"
  write_if_changed "$work/bazel-state.json" "$BAZEL_STATE" 600 || true
  bazel_seq_record "$seq"
  clear_reason bazel-cache
}

# A remove's payload ({reason, flushGeneration, seq}, all optional) is on
# stdin; the block goes whatever else it says, unless it is older than the
# last step applied. It goes first: the remove is the kill switch, so a flush
# that fails afterwards (reported, and tried again at the next step) never
# leaves the block in place.
bazel_cache_remove() {  # payload.json|''
  local seq='' gen='' step
  if [ -n "${1:-}" ] && [ -s "$1" ]; then
    seq=$(bazel_remove_field "$1" seq 9007199254740991)
    gen=$(bazel_remove_field "$1" flushGeneration 2147483647)
  fi
  bazel_lock || return 1
  bazel_seq_ok "$seq" || return 0
  step=$(bazel_step_begin)
  # The reason only once the step is taken: a refused remove's would outlive
  # it and explain a removal that never happened. A remove without one clears
  # the last one, which is about an earlier step.
  if [ -n "${1:-}" ]; then
    clear_reason bazel-cache
    record_reason bazel-cache < "$1"
  fi
  # The block in place means this box used the cache, even with no mark (an
  # older install): record it before the block goes, so the flush still sees it.
  if grep -qxF "$BAZEL_BEGIN" "$BAZEL_RC" 2>/dev/null; then : > "$BAZEL_USED"; fi
  bazel_block_remove || return 1
  rm -f "$BAZEL_STATE"
  bazel_seq_record "$seq"
  if bazel_flush_needed "$gen" remove; then
    bazel_flush_unlocked "$gen" || return 1
    # Nothing from the cache is left here now, unless a newer step applied the
    # block while the flush ran.
    if bazel_step_latest "$step"; then rm -f "$BAZEL_USED"; fi
  fi
}

bazel_cache_remove_cmd() {
  local payload="$WORK/bazel-cache-remove.json"
  if [ -t 0 ]; then : > "$payload"; else cat > "$payload"; fi
  bazel_cache_remove "$payload"
}

# Bazel sends a .netrc entry for the cache's host (or a `default` entry) as
# Basic credentials, which S3 refuses, so every lookup would fail. $NETRC is
# Bazel's override.
bazel_netrc_entry() {  # host -> the file, when it has one
  local file=${NETRC:-$HOME/.netrc}
  [ -r "$file" ] || return 1
  tr -s ' \t' '\n\n' < "$file" | awk -v h="$1" '
    prev == "machine" && $0 == h { hit = 1 } $0 == "default" { hit = 1 } { prev = $0 } END { exit !hit }' \
    && printf '%s' "$file"
}

# One anonymous GET for an action key nobody has: 404 is a working miss, 403 a
# box S3 refuses (not through the VPC endpoint, or the bucket policy lost
# ListBucket, which also turns every miss into a 403).
bazel_cache_status() {
  local url host code err netrc
  if [ -e "$BAZEL_SKIP" ]; then echo 'bazel-cache: skipped on this box'; return; fi
  if [ -s "$BAZEL_FLUSH_FAILED" ]; then
    echo "bazel-cache: NOT WORKING: the last flush failed ($(head -n1 "$BAZEL_FLUSH_FAILED" | sed 's/[[:space:]]*$//')); the shared cache stays off here until a flush succeeds, which the next delivery tries"
    return
  fi
  if [ ! -s "$BAZEL_STATE" ]; then off_line bazel-cache; return; fi
  url=$(jq -r '.url // empty' "$BAZEL_STATE" 2>/dev/null || true)
  host=${url#https://}; host=${host%%/*}
  if ! grep -qxF "$BAZEL_BEGIN" "$BAZEL_RC" 2>/dev/null; then
    echo "bazel-cache: NOT WORKING: delivered, but $BAZEL_RC has no termag block"; return
  fi
  if netrc=$(bazel_netrc_entry "$host"); then
    echo "bazel-cache: NOT WORKING: $netrc has an entry for $host (or a default one), so Bazel sends it to S3 as Basic credentials and S3 refuses every lookup; builds run locally"
    return
  fi
  code=$(curl -sS -m 10 -o "$WORK/bazel-cache.body" -w '%{http_code}' "$url/ac/$(printf '%064d' 0)" 2>"$WORK/bazel-cache.err" || true)
  # S3 also answers 404 for a bucket that isn't there: every lookup then misses.
  if [ "$code" = 404 ] && grep -qF '<Code>NoSuchBucket</Code>' "$WORK/bazel-cache.body" 2>/dev/null; then
    echo "bazel-cache: NOT WORKING: the bucket in $url does not exist, so every lookup misses; builds run locally"; return
  fi
  case $code in
    404|200) echo "bazel-cache: on, Bazel reads the shared cache at $url ($BAZEL_RC)" ;;
    000|'') err=$(tail -n1 "$WORK/bazel-cache.err" 2>/dev/null | sed 's/^curl: ([0-9]*) //')
            echo "bazel-cache: NOT WORKING: the cache at $url is unreachable (${err:-no response}); builds run locally" ;;
    403) echo "bazel-cache: NOT WORKING: S3 refuses this box at $url (HTTP 403: not through the VPC endpoint, or the bucket policy changed); builds run locally" ;;
    *) echo "bazel-cache: NOT WORKING: the cache at $url answered HTTP $code; builds run locally" ;;
  esac
}

# ── GitHub (through the orchestrator's broker) ──────────────────────────────
strip_block() {  # begin end < in > out
  awk -v b="$1" -v e="$2" '$0 == b { skip = 1; next } $0 == e { skip = 0; next } !skip'
}

# A file's content, or nothing when it does not exist yet (/etc/gitconfig
# usually doesn't).
content_of() { if [ -f "$1" ]; then cat "$1"; fi; }

agent_config() {
  local c
  for c in "${TERMAG_AGENT_CONFIG:-}" "$HOME/src/termag/agent/agent.config.json" \
           "$HOME/.termag/agent.config.json" "$HOME/.config/termag/agent.config.json"; do
    if [ -n "$c" ] && [ -r "$c" ]; then printf '%s' "$c"; return 0; fi
  done
  return 1
}

# What the pre-broker revision wrote: a per-user key, an ssh config block and a
# gh login to github.com. Only the gh login termag made is logged out.
github_remove_legacy() {
  local work=$WORK current
  if [ -e "$KEY" ]; then rm -f "$KEY" "$KEY.pub"; say "removed $KEY"; fi
  if grep -qxF "$BEGIN" "$SSH_CONFIG" 2>/dev/null; then
    strip_block "$BEGIN" "$END" < "$SSH_CONFIG" > "$work/ssh_config"
    install -m 600 "$work/ssh_config" "$SSH_CONFIG"
    say "removed the termag block from $SSH_CONFIG"
  fi
  if [ -f "$GH_TOKEN_HASH" ]; then
    current=$(gh auth token -h github.com 2>/dev/null || true)
    if [ -n "$current" ] && [ "$(printf '%s' "$current" | sha256sum | cut -d' ' -f1)" = "$(cat "$GH_TOKEN_HASH")" ]; then
      gh auth logout -h github.com >/dev/null 2>&1 || true
      say 'gh logged out of github.com'
    fi
    rm -f "$GH_TOKEN_HASH"
  fi
}

# Git picks the longest matching insteadOf and never chains rewrites, so a
# user rule for a longer github.com prefix (the baked ~/.gitconfig sends
# https://github.com/example-org/ to ssh) would bypass the broker. Mirror each
# one onto the broker; the system file is read first and wins the tie.
broker_gitconfig() {  # broker config -> stdout
  local broker=$1 config=$2 v rest p
  printf '%s\n[url "%s/"]\n' "$BROKER_BEGIN" "$broker"
  printf '\tinsteadOf = %s\n' 'https://github.com/' 'git@github.com:' 'ssh://git@github.com/'
  { git config --global --get-regexp '^url\..*\.insteadof$' 2>/dev/null || true; } | while read -r _ v; do
    for p in 'https://github.com/' 'git@github.com:' 'ssh://git@github.com/'; do
      case $v in "$p"?*) rest=${v#"$p"}; printf '[url "%s/%s"]\n\tinsteadOf = %s\n' "$broker" "$rest" "$v" ;; esac
    done
  done
  printf '[credential "%s"]\n\thelper =\n\thelper = "%s %s"\n' "$broker" "$SELF_DIR/termag-git-credential" "$config"
  printf '%s\n' "$BROKER_END"
}

github_apply() {
  local work=$WORK payload broker host config token
  payload="$work/payload.json"
  cat > "$payload"
  if [ -e "$GH_SKIP" ]; then
    github_remove
    return 0
  fi
  broker=$(jq -r '.broker // empty' "$payload")
  case $broker in https://?*) ;; *) say 'github payload has no https broker'; return 1 ;; esac
  broker=${broker%/}
  host=${broker#https://}
  config=$(agent_config) || { say 'no agent config to authenticate to the broker with'; return 1; }
  install -d -m 700 "$STATE"

  github_remove_legacy

  { content_of "$GIT_SYSTEM" | strip_block "$BROKER_BEGIN" "$BROKER_END"
    broker_gitconfig "$broker" "$config"; } > "$work/gitconfig"
  if ! cmp -s "$work/gitconfig" "$GIT_SYSTEM" 2>/dev/null; then
    $SUDO install -m 0644 "$work/gitconfig" "$GIT_SYSTEM"
    say "git reaches github.com through $host ($GIT_SYSTEM)"
  fi

  printf 'export GH_HOST=%s\n' "$host" > "$work/gh-host.sh"
  if ! cmp -s "$work/gh-host.sh" "$PROFILE_D/termag-github.sh" 2>/dev/null; then
    $SUDO install -m 0644 "$work/gh-host.sh" "$PROFILE_D/termag-github.sh"
  fi
  { content_of "$ZSHENV" | strip_block "$BROKER_BEGIN" "$BROKER_END"
    printf '%s\nexport GH_HOST=%s\n%s\n' "$BROKER_BEGIN" "$host" "$BROKER_END"; } > "$work/zshenv"
  write_if_changed "$work/zshenv" "$ZSHENV" 644 || true

  # gh keeps the box token for the broker host; it is the same credential the
  # agent config holds, and the broker is the only host it is valid for.
  token=$(jq -r '.token // empty' "$config")
  if [ -n "$token" ] && [ "$(gh auth token -h "$host" 2>/dev/null || true)" != "$token" ]; then
    if printf '%s' "$token" | gh auth login --hostname "$host" --git-protocol https --with-token >/dev/null 2>&1; then
      say "gh logged in to $host"
    else
      say "gh could not log in to $host yet; git works, gh retries at the next delivery"
    fi
  fi
  printf '%s\n' "$host" > "$BROKER_STATE"
  clear_reason github
}

github_remove() {
  local work=$WORK host token
  github_remove_legacy
  if grep -qxF "$BROKER_BEGIN" "$GIT_SYSTEM" 2>/dev/null; then
    strip_block "$BROKER_BEGIN" "$BROKER_END" < "$GIT_SYSTEM" > "$work/gitconfig"
    $SUDO install -m 0644 "$work/gitconfig" "$GIT_SYSTEM"
    say "removed the broker from $GIT_SYSTEM"
  fi
  if [ -e "$PROFILE_D/termag-github.sh" ]; then $SUDO rm -f "$PROFILE_D/termag-github.sh"; fi
  if grep -qxF "$BROKER_BEGIN" "$ZSHENV" 2>/dev/null; then
    strip_block "$BROKER_BEGIN" "$BROKER_END" < "$ZSHENV" > "$work/zshenv"
    install -m 644 "$work/zshenv" "$ZSHENV"
  fi
  if [ -f "$BROKER_STATE" ]; then
    host=$(cat "$BROKER_STATE")
    token=$(jq -r '.token // empty' "$(agent_config)" 2>/dev/null || true)
    if [ -n "$host" ] && [ -n "$token" ] && [ "$(gh auth token -h "$host" 2>/dev/null || true)" = "$token" ]; then
      gh auth logout -h "$host" >/dev/null 2>&1 || true
      say "gh logged out of $host"
    fi
    rm -f "$BROKER_STATE"
  fi
}

# Why nothing was delivered when the orchestrator never said.
no_delivery_reason() {
  local url
  url=$(jq -r '.termag_url // empty' "$(agent_config 2>/dev/null)" 2>/dev/null || true)
  case $url in
    '')     echo 'no termag agent config found on this box' ;;
    *)      echo 'termag has delivered nothing yet: is termag-agent running and connected (and new enough)?' ;;
  esac
}

off_line() {  # provider
  if [ -s "$STATE/$1.status" ]; then echo "$1: off: $(cat "$STATE/$1.status")"
  else echo "$1: off: $(no_delivery_reason)"
  fi
}

# The gateway's /termag/auth-check takes the same check as a model call and
# answers 204, so this makes no Bedrock call.
claude_status() {
  local base token code err
  if [ -e "$SKIP" ]; then echo 'claude-gateway: skipped on this box (manual Claude login)'; return; fi
  if [ ! -s "$CLAUDE_STATE" ]; then off_line claude-gateway; return; fi
  base=$(jq -r '.env.ANTHROPIC_BEDROCK_BASE_URL // empty' "$CLAUDE_SETTINGS" 2>/dev/null || true)
  if [ -z "$base" ]; then echo "claude-gateway: NOT WORKING: $CLAUDE_SETTINGS no longer names the gateway (env.ANTHROPIC_BEDROCK_BASE_URL)"; return; fi
  token=$(jq -r '.token // empty' "$(agent_config 2>/dev/null)" 2>/dev/null || true)
  # The token goes in curl's config on stdin, never on the command line.
  code=$(printf 'header = "Authorization: Bearer %s"\n' "$token" | curl -sS -m 15 -K - -o "$WORK/claude" \
    -w '%{http_code}' "${base%/}/termag/auth-check" 2>"$WORK/claude.err" || true)
  case $code in
    204) echo "claude-gateway: on ($CLAUDE_SETTINGS), the gateway at $base accepts this box's token" ;;
    000|'') err=$(tail -n1 "$WORK/claude.err" 2>/dev/null | sed 's/^curl: ([0-9]*) //')
            echo "claude-gateway: NOT WORKING: the gateway at $base is unreachable (${err:-no response})" ;;
    5*) echo "claude-gateway: NOT WORKING: the gateway at $base could not reach termag to check this box (HTTP $code)" ;;
    *) echo "claude-gateway: NOT WORKING: the gateway at $base refused this box (HTTP $code): $(jq -r '.message // empty' "$WORK/claude" 2>/dev/null)" ;;
  esac
}

github_status() {
  local host token code err
  if [ -e "$GH_SKIP" ]; then echo 'github: skipped on this box (your own gh and git credentials)'; return; fi
  if [ ! -s "$BROKER_STATE" ]; then off_line github; return; fi
  host=$(cat "$BROKER_STATE")
  token=$(jq -r '.token // empty' "$(agent_config 2>/dev/null)" 2>/dev/null || true)
  # The token goes in curl's config on stdin, never on the command line.
  code=$(printf 'user = "termag-box:%s"\n' "$token" | curl -sS -m 10 -K - -o "$WORK/github" \
    -w '%{http_code}' "https://$host/api/v3/user" 2>"$WORK/github.err" || true)
  case $code in
    200) echo "github: on, through the termag broker ($host) as @$(jq -r '.login // "?"' "$WORK/github" 2>/dev/null)" ;;
    000|'') err=$(tail -n1 "$WORK/github.err" 2>/dev/null | sed 's/^curl: ([0-9]*) //')
            echo "github: NOT WORKING: the termag broker at $host is unreachable (${err:-no response})" ;;
    *) echo "github: NOT WORKING: the termag broker at $host refused (HTTP $code): $(jq -r '.message // empty' "$WORK/github" 2>/dev/null)" ;;
  esac
}

status() {
  claude_status
  github_status
  telemetry_status
  agent_telemetry_status
  mcp_status
  fireworks_status
  bazel_cache_status
  if [ -e "$KEY" ]; then echo 'github: a pre-broker termag key is still on disk (removed at the next delivery)'; fi
}

case "${1:-} ${2:-}" in
  'apply claude-gateway')  claude_apply ;;
  'remove claude-gateway') record_reason claude-gateway; claude_remove ;;
  'skip claude-gateway')   install -d -m 700 "$STATE"; touch "$SKIP"; claude_remove ;;
  'unskip claude-gateway') rm -f "$SKIP"; say 'the next delivery turns the gateway back on' ;;
  'apply github')          github_apply ;;
  'remove github')         record_reason github; github_remove ;;
  'skip github')           install -d -m 700 "$STATE"; touch "$GH_SKIP"; github_remove
                           say 'github skipped on this box; open a new shell to drop GH_HOST (termag-credentials unskip github to undo)' ;;
  'unskip github')         rm -f "$GH_SKIP"; say 'the next delivery routes git and gh through the broker again' ;;
  'apply telemetry')       telemetry_apply ;;
  'remove telemetry')      record_reason telemetry; telemetry_remove ;;
  'telemetry-launch '*)    claude_launch "${2:-}" ;;
  'work-resource '*)       work_resource; echo ;;
  'launch-settings '*)     launch_settings "${@:2}" ;;
  'pi-model '*)            fireworks_pi_model "${@:2}" ;;
  'apply agent-telemetry')  agent_telemetry_apply ;;
  'remove agent-telemetry') record_reason agent-telemetry; agent_telemetry_remove ;;
  'apply mcp')             mcp_apply ;;
  'remove mcp')            record_reason mcp; mcp_remove ;;
  'apply fireworks')       fireworks_apply ;;
  'remove fireworks')      record_reason fireworks; fireworks_remove ;;
  'skip fireworks')        install -d -m 700 "$STATE"; touch "$FIREWORKS_SKIP"; fireworks_remove
                           say 'fireworks skipped on this box (termag-credentials unskip fireworks to undo)' ;;
  'unskip fireworks')      rm -f "$FIREWORKS_SKIP"; say 'the next delivery sets the Fireworks agents up again' ;;
  'apply bazel-cache')     bazel_cache_apply ;;
  'remove bazel-cache')    bazel_cache_remove_cmd ;;
  'skip bazel-cache')      install -d -m 700 "$STATE"; touch "$BAZEL_SKIP"; bazel_cache_remove ''
                           say 'bazel-cache skipped on this box (termag-credentials unskip bazel-cache to undo)' ;;
  'unskip bazel-cache')    rm -f "$BAZEL_SKIP"; say 'the next delivery turns the shared Bazel cache back on' ;;
  'status '*)              status ;;
  *) sed -n '5,41p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
