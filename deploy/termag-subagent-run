#!/usr/bin/env bash
# termag-subagent-run -- run one agent-to-agent ask on this box.
#
# The agent's ask-run RPC (agent/ask-run.js) writes a job file and starts this
# as the box user. In full (no flag, an agent without ask-chat-v1) it:
#
#   1. prepares the thread's directory under ~/.termag/subagent/threads/ on
#      the first turn: a clone of the target checkout's *committed* code at
#      the base commit (the newest commit of its branch already on the remote,
#      so uncommitted and untracked files never reach the run, and the run
#      never touches the live checkout); later turns reuse it and resume
#      Claude's session
#   2. runs Claude Code headless in that clone as the box user, with the
#      owner's own settings, credentials, network and tools
#      (--permission-mode bypassPermissions, as no one is there to answer a
#      prompt). Asks are owner-only, so the run has nothing the asker lacks.
#      TMUX is unset so the owner's status hooks post nothing for it
#   3. uploads the commits the run made as a git bundle and posts the reply,
#      both to the orchestrator with the box token (PUT/POST
#      /api/cli/v1/ask/runs/<id>/{bundle,result}); the orchestrator checks the
#      bundle and publishes it as a draft PR (backend services/askPublish.ts).
#      The run may write that PR's description to TERMAG_ASK_PR_BODY_FILE,
#      .git/termag-pr-body.md in the clone (outside the git tree, kept across
#      turns); it goes up with the result as prDescription, cut to
#      PR_BODY_MAX bytes, and only when a bundle went up.
#      A run can open several PRs: the bundle carries the clone's `ask`
#      branch (the thread's own PR) and every `pr/<name>` branch with
#      commits on the base (one PR each), and each pr/<name>'s description
#      comes from TERMAG_ASK_PR_DIR/<name>.md. refs/termag/base names the
#      base in the clone, for `git switch -c pr/<name> termag/base`
#
# With ask-chat-v1 the agent runs step 2 itself, as a turn of the thread's
# chat on the target project (agent/ask-chat.js, the chat runner), and calls
# the other steps as phases:
#
#   --prepare <job>          step 1 only; prints {repoDir, base, repo, fresh}.
#                            A job without a runId (a person's message in the
#                            ask's chat) reports nothing when it fails.
#   --report <job> <result>  step 3, from the turn's stream-json `result`
#                            event (the same fields -p --output-format json
#                            prints)
#   --fail <job> <reason>    an error reply, for a turn that never ran
#
# There is no time or turn limit. A failure before Claude runs is still
# reported, as an error reply, so the asker is never left waiting.
#
# A TERM (the agent's ask-run-cancel, after the orchestrator marked the
# message canceled) stops the run's process group and exits 143 without
# reporting.
#
# Threads idle for TERMAG_SUBAGENT_THREAD_TTL_MIN minutes (default three days)
# are removed, with their Claude transcripts, at the start of a run; job files
# and logs after a week.
#
# Usage: termag-subagent-run [--prepare | --report | --fail] <job.json> [<result.json> | <reason>]
#
# Env (tests): TERMAG_SUBAGENT_ROOT (default ~/.termag/subagent),
#   TERMAG_SUBAGENT_CLAUDE (the claude binary), TERMAG_SUBAGENT_KILL_GRACE_S,
#   TERMAG_SUBAGENT_CHECKOUT_WAIT_S, TERMAG_SUBAGENT_LOCK_WAIT_S,
#   TERMAG_AGENT_CONFIG
#
# Pushing (ask-push-v1): a job with `pushBranch`
# gets a normal clone with `origin` (the live checkout's GitHub URL, reached
# through the box's GitHub broker like any repo here) on that branch, and the
# run pushes and opens its draft PRs itself. --report then sends no bundle:
# it names the branches the clone pushed (their remote-tracking reflogs say
# `update by push`), and the orchestrator looks their PRs up on GitHub. The
# clone gets a pre-push hook that refuses a push to the default branch, and
# the repo's own pre-commit hooks when it has them. An older clone of the
# thread is converted in place on its first push-mode turn.
#
# Phases: ask-chat-v1 (agent/ask-chat.js checks for this line before it
# announces the capability).
# Pushes: ask-push-v1 (agent/ask-run.js checks for this line likewise).
set -uo pipefail

mode=run
case ${1:-} in
  --prepare) mode=prepare; shift ;;
  --report) mode=report; shift ;;
  --fail) mode=fail; shift ;;
esac
job=${1:-}
arg2=${2:-}
STATE=$HOME/.termag/subagent
ROOT=${TERMAG_SUBAGENT_ROOT:-$STATE}
THREAD_TTL_MIN=${TERMAG_SUBAGENT_THREAD_TTL_MIN:-4320}
KILL_GRACE_S=${TERMAG_SUBAGENT_KILL_GRACE_S:-10}
CHECKOUT_WAIT_S=${TERMAG_SUBAGENT_CHECKOUT_WAIT_S:-300}
# A phase waits out another phase's prepare, which can be a long first clone;
# under ask-chat.js's 15-minute prepare timeout.
LOCK_WAIT_S=${TERMAG_SUBAGENT_LOCK_WAIT_S:-840}
# The result goes through the orchestrator's JSON body limit (100 KB); the
# reply is cut only as far as that needs.
BODY_MAX=95000
BUNDLE_MAX=$((25 * 1024 * 1024))
# The orchestrator keeps 16 KB of a PR description and says it cut the rest.
PR_BODY_MAX=20000
# Every pr/<name> description together, so the reply keeps most of the body.
PR_DESCS_MAX=60000
# backend services/agentMessages.ts ASK_PR_KEY.
PR_NAME_RE='^[a-z0-9][a-z0-9-]{0,39}$'

run='?'
log() { printf '%s termag-subagent-run[%s]: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$run" "$*" >&2; }

[ -n "$job" ] && [ -r "$job" ] || { log "usage: termag-subagent-run [--prepare | --report | --fail] <job.json>"; exit 2; }
case $mode in report|fail) [ -n "$arg2" ] || { log "--$mode needs a second argument"; exit 2; } ;; esac
command -v jq >/dev/null 2>&1 || { log 'jq is not installed'; exit 2; }
command -v curl >/dev/null 2>&1 || { log 'curl is not installed'; exit 2; }

work=$(mktemp -d) || exit 1
# A prepared job is the agent's until its turn is reported.
if [ "$mode" = prepare ]; then trap 'rm -rf "$work"' EXIT
else trap 'rm -rf "$work"; rm -f "$job"' EXIT
fi

field() { jq -r --arg k "$1" '.[$k] // empty' "$job"; }
run=$(field runId)
thread_id=$(field threadId)
cwd=$(field cwd)
id_re='^[a-z0-9]{8,40}$'
# Only --prepare may go without a run: then it is a person's message, and
# nothing is reported.
reports=true
if [ "$mode" = prepare ] && [ -z "$run" ]; then run='-'; reports=false
elif ! [[ $run =~ $id_re ]]; then run='?'; log 'the job has no valid runId'; exit 2
fi
[[ $thread_id =~ $id_re ]] || { log 'the job has no valid threadId'; exit 2; }

# Canceled: the orchestrator has already marked the message, so nothing is
# reported. Bash runs the trap only between commands, which is why the run
# itself is waited for in the background. The run leads its own process
# group (setsid), so its tools and their children stop with it.
child=
cancel() {
  log 'canceled'
  if [ -n "$child" ]; then
    kill -TERM -- "-$child" 2>/dev/null
    local i
    for ((i = 0; i < KILL_GRACE_S * 10; i++)); do
      kill -0 -- "-$child" 2>/dev/null || break
      sleep 0.1
    done
    kill -KILL -- "-$child" 2>/dev/null || kill -KILL "$child" 2>/dev/null
  fi
  exit 143
}
trap cancel TERM INT

# --- talking to the orchestrator ---------------------------------------------

find_agent_config() {
  local c
  for c in "${TERMAG_AGENT_CONFIG:-}" "$HOME/src/termag/agent/agent.config.json" \
           "$HOME/.termag/agent.config.json" "$HOME/.config/termag/agent.config.json"; do
    if [ -n "$c" ] && [ -r "$c" ]; then printf '%s' "$c"; return 0; fi
  done
  return 1
}
# ws(s)://host/termag/ws/agent -> http(s)://host/termag/api/cli/v1/ask/runs/<run>
runs_endpoint() {
  local url=${1%%\?*}
  case $url in
    ws://*)  url="http://${url#ws://}" ;;
    wss://*) url="https://${url#wss://}" ;;
  esac
  case $url in
    */ws/agent) printf '%s/api/cli/v1/ask/runs/%s' "${url%/ws/agent}" "$run" ;;
    *) return 1 ;;
  esac
}
token=
endpoint=
if [ "$reports" = true ]; then
  config=$(find_agent_config) || { log 'no agent config: cannot report back'; exit 1; }
  token=$(jq -r '.token // empty' "$config" 2>/dev/null) || token=
  endpoint=$(runs_endpoint "$(jq -r '.termag_url // empty' "$config" 2>/dev/null)") || endpoint=
  [ -n "$token" ] && [ -n "$endpoint" ] || { log "$config has no token or no agent termag_url: cannot report back"; exit 1; }
fi

# curl with the token in its config on stdin, never on the command line.
# Retries a connection failure or a 5xx a few times. Prints the HTTP code.
call() {
  local code attempt
  for attempt in 1 2 3 4; do
    code=$(printf 'header = "Authorization: Bearer %s"\n' "$token" \
      | curl -s -m 120 -K - -o "$work/response" -w '%{http_code}' "$@" 2>/dev/null) || code=000
    case $code in 000|5??) sleep $((attempt * 3)) ;; *) break ;; esac
  done
  printf '%s' "$code"
}

base=
repo=
# Push mode: the thread's branch, its clone's default branch.
push_branch=
default_branch=
session=
num_turns=null
is_error=false
reason=
bundle_sent=false

# cut_utf8 <bytes> <file>: the first <bytes> of a file, without a split character.
cut_utf8() {
  if command -v iconv >/dev/null; then
    head -c "$1" "$2" | iconv -c -f UTF-8 -t UTF-8 2>/dev/null
  else
    head -c "$1" "$2"
  fi
}

# The branches of the thread's clone that go up, one ref per line: `ask` (the
# thread's own PR) and each pr/<name> (a PR of its own) that has commits on
# the base. With neither, a HEAD with commits, as before a run could open
# several. What stays behind is said in the reply.
publish_refs() {
  local dir=$thread/repo r name n head
  local -a refs=()
  n=$(git -C "$dir" rev-list --count "$base..refs/heads/ask" 2>/dev/null) || n=0
  [ "${n:-0}" -gt 0 ] && refs+=(refs/heads/ask)
  while IFS= read -r r; do
    [ -n "$r" ] || continue
    name=${r#refs/heads/pr/}
    if ! [[ $name =~ $PR_NAME_RE ]]; then
      printf '\n\n[termag: branch pr/%s was not published: name a PR branch pr/<name>, with lowercase letters, digits and hyphens, at most 40]\n' "$name" >> "$work/reply"
      continue
    fi
    n=$(git -C "$dir" rev-list --count "$base..$r" 2>/dev/null) || n=0
    [ "${n:-0}" -gt 0 ] && refs+=("$r")
  done < <(git -C "$dir" for-each-ref --format='%(refname)' refs/heads/pr/)
  if [ "${#refs[@]}" -eq 0 ]; then
    head=$(git -C "$dir" symbolic-ref -q HEAD 2>/dev/null) || head=
    n=$(git -C "$dir" rev-list --count "$base..HEAD" 2>/dev/null) || n=0
    case $head in refs/heads/pr/*) ;; *) [ "${n:-0}" -gt 0 ] && refs+=(HEAD) ;; esac
  fi
  while IFS= read -r r; do
    case $r in refs/heads/ask|refs/heads/pr/*|'') continue ;; esac
    n=$(git -C "$dir" rev-list --count "$r" "^$base" ${refs[@]+"${refs[@]/#/^}"} 2>/dev/null) || n=0
    [ "${n:-0}" -gt 0 ] && printf '\n\n[termag: branch %s has %s commit(s) that were not published: only `ask` and pr/<name> branches become pull requests]\n' "${r#refs/heads/}" "$n" >> "$work/reply"
  done < <(git -C "$dir" for-each-ref --format='%(refname)' refs/heads/)
  [ "${#refs[@]}" -eq 0 ] || printf '%s\n' "${refs[@]}"
}

# pr_descriptions <ref>...: the pr/<name> descriptions in $pr_dir as a JSON
# object in $work/pr-descs.json, each cut to PR_BODY_MAX and all of them to
# PR_DESCS_MAX. Regular files only: a symlink could point the upload anywhere.
pr_descriptions() {
  local r name f size total=0
  printf '{}' > "$work/pr-descs.json"
  for r in "$@"; do
    case $r in refs/heads/pr/*) name=${r#refs/heads/pr/} ;; *) continue ;; esac
    f=$pr_dir/$name.md
    [ -f "$f" ] && [ ! -L "$f" ] || continue
    cut_utf8 "$PR_BODY_MAX" "$f" > "$work/desc.cut"
    size=$(wc -c < "$work/desc.cut")
    if [ $((total + size)) -gt "$PR_DESCS_MAX" ]; then
      log "PR description of pr/$name not sent: the descriptions are over $PR_DESCS_MAX bytes together"
      continue
    fi
    total=$((total + size))
    jq --arg k "$name" --rawfile v "$work/desc.cut" '. + {($k): $v}' "$work/pr-descs.json" > "$work/pr-descs.next" \
      && mv "$work/pr-descs.next" "$work/pr-descs.json"
  done
  [ "$total" -eq 0 ] || log "pr/<name> descriptions sent ($total bytes)"
}

# post_result <reply-file>
post_result() {
  local reply=$1 cap=$BODY_MAX body code
  [ -f "$work/pr-body.cut" ] || : > "$work/pr-body.cut"
  [ -f "$work/pr-descs.json" ] || printf '{}' > "$work/pr-descs.json"
  [ -f "$work/pushes.json" ] || printf 'null' > "$work/pushes.json"
  while :; do
    # A byte cut can split a character; iconv -c drops the partial one rather
    # than leave jq to turn it into U+FFFD.
    cut_utf8 "$cap" "$reply" > "$work/reply.cut"
    # No set -e here: a body jq could not build would go up empty and be
    # refused, so the run is reported as failed instead.
    body=$(jq -n --rawfile result "$work/reply.cut" --arg sid "$session" --argjson turns "$num_turns" \
      --argjson isError "$is_error" --arg reason "$reason" --arg base "$base" --arg repo "$repo" \
      --argjson bundle "$bundle_sent" --rawfile prBody "$work/pr-body.cut" --slurpfile prDescs "$work/pr-descs.json" \
      --slurpfile pushes "$work/pushes.json" \
      'def opt: if . == "" then null else . end;
       {result: $result, sessionId: ($sid | opt), isError: $isError, numTurns: $turns,
        exitReason: ($reason | opt), baseSha: ($base | opt), repo: ($repo | opt), bundle: $bundle,
        prDescription: ($prBody | opt), prDescriptions: ($prDescs[0] // {})}
       + (if $pushes[0] == null then {} else {pushes: $pushes[0]} end)') \
      || body='{"result":"","isError":true,"numTurns":null,"exitReason":"termag-subagent-run could not encode the reply","bundle":false}'
    printf '%s' "$body" > "$work/result.json"
    # Bytes, not ${#body}: that counts characters in a UTF-8 locale.
    [ "$(wc -c < "$work/result.json")" -le "$BODY_MAX" ] || [ "$cap" -le 1024 ] && break
    cap=$((cap * 9 / 10))
  done
  code=$(call -X POST -H 'Content-Type: application/json' --data-binary "@$work/result.json" "$endpoint/result")
  case $code in
    202|204) if [ "$is_error" = true ]; then log "result reported (error: $reason)"; else log 'result reported'; fi ;;
    *) log "result not reported: $endpoint/result answered HTTP $code"; return 1 ;;
  esac
}

# fail <reason>: report an error reply and stop. A person's message in the
# ask's chat has no run to report to: the reason goes to stderr, where the
# agent turns it into the send's error.
fail() {
  is_error=true
  reason=$1
  log "failed: $reason"
  [ "$reports" = true ] || exit 1
  printf 'termag could not run this ask on the target box: %s\n' "$reason" > "$work/reply"
  post_result "$work/reply"
  exit 1
}

if [ "$mode" = fail ]; then fail "$arg2"; fi

# --- housekeeping ------------------------------------------------------------

# Claude Code keeps a session's transcript under
# <config dir>/projects/<cwd, every non-alphanumeric turned to '-'>.
transcripts_of() {
  printf '%s/projects/%s' "${CLAUDE_CONFIG_DIR:-$HOME/.claude}" "$(printf '%s' "$1" | sed 's/[^A-Za-z0-9]/-/g')"
}

thread=$ROOT/threads/$thread_id
# Outside the git tree, so they never land in a commit; kept across the
# thread's turns. Every phase names the same two: the turn writes them,
# report reads them.
pr_body_file=$thread/repo/.git/termag-pr-body.md
pr_dir=$thread/repo/.git/termag-prs

sweep() {
  mkdir -p "$STATE/jobs" "$STATE/logs" "$ROOT/threads" && chmod 700 "$STATE" "$STATE/jobs" "$STATE/logs" "$ROOT/threads" 2>/dev/null
  find "$STATE/jobs" "$STATE/logs" -type f -mtime +7 -delete 2>/dev/null
  find "$ROOT/threads" -mindepth 1 -maxdepth 1 -type d -mmin "+$THREAD_TTL_MIN" -print 2>/dev/null \
    | while IFS= read -r old; do
        [ "$(basename "$old")" = "$thread_id" ] && continue
        rm -rf -- "$(transcripts_of "$old/repo")"
        rm -rf -- "$old" && log "removed idle thread $(basename "$old")"
      done
}

# --- the thread's clone --------------------------------------------------------

# A pane checkout leaves the project `none` (askable) while its fetch still
# runs, so the first ask on a new box can arrive before the dir, the repo or
# its first commit. Give the checkout time to land before judging it.
wait_for_checkout() {
  local waited=0
  until git -C "$cwd" rev-parse -q --verify 'HEAD^{commit}' >/dev/null 2>&1; do
    [ "$waited" -ge "$CHECKOUT_WAIT_S" ] && return 0
    [ "$waited" = 0 ] && log "waiting up to ${CHECKOUT_WAIT_S}s for the checkout in $cwd to land"
    sleep 2
    waited=$((waited + 2))
  done
}

# The newest commit of the checkout's branch that its remote already has.
pick_base() {
  local up r
  if up=$(git -C "$cwd" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null) && [ -n "$up" ]; then
    git -C "$cwd" merge-base HEAD "$up" 2>/dev/null && return 0
  fi
  for r in origin/HEAD origin/main origin/master; do
    if git -C "$cwd" rev-parse -q --verify "$r^{commit}" >/dev/null 2>&1; then
      git -C "$cwd" merge-base HEAD "$r" 2>/dev/null && return 0
    fi
  done
  return 1
}

# owner/name when origin is on github.com. The configured URL, not `remote
# get-url`, which expands insteadOf: a box's GitHub broker rewrite would turn
# every origin into the broker's.
github_repo() {
  local url
  url=$(git -C "$cwd" config --get remote.origin.url 2>/dev/null) || return 1
  url=$(printf '%s\n' "$url" | sed -nE 's#^(https://([^@/]+@)?github\.com/|git@github\.com:|ssh://git@github\.com/)([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)/?$#\3#p')
  url=${url%.git}
  [[ $url =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] && printf '%s' "$url"
}

# --- push mode -----------------------------------------------------------------

# fetch_local <repo> <git fetch args...>: a fetch from the live checkout. The base
# is a commit, often not a branch tip (the merge-base with an upstream that moved
# on), and upload-pack serves an unadvertised commit only under protocol v2 or
# with allowAnySHA1InWant; an owner's protocol.version=0 or 1 would refuse it.
fetch_local() {
  local r=$1; shift
  git -C "$r" fetch --upload-pack='git -c uploadpack.allowAnySHA1InWant=true upload-pack' "$@"
}

# A branch name the job may give: what git accepts, nothing a shell or a URL
# would read twice (backend agentMessages.ts isPushBranch).
valid_branch() {
  [[ $1 =~ ^[A-Za-z0-9._/-]{1,200}$ ]] && [[ $1 != -* ]] && [[ $1 != *..* ]] && [[ $1 != *//* ]] \
    && [[ $1 != */ ]] && [[ $1 != *.lock ]] && git check-ref-format --branch "$1" >/dev/null 2>&1
}

# The checkout's default branch on origin: its origin/HEAD, else GitHub's.
pick_default_branch() {
  local d
  d=$(git -C "$cwd" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null) && [ -n "$d" ] && { printf '%s' "${d#origin/}"; return 0; }
  d=$(git -C "$thread/repo" ls-remote --symref origin HEAD 2>/dev/null | sed -nE 's#^ref: refs/heads/([^[:space:]]+)[[:space:]]+HEAD$#\1#p')
  [ -n "$d" ] && { printf '%s' "$d"; return 0; }
  for d in main master; do
    git -C "$cwd" rev-parse -q --verify "refs/remotes/origin/$d" >/dev/null 2>&1 && { printf '%s' "$d"; return 0; }
  done
  printf 'main'
}

# The pre-push hook of a push-mode clone: refuses a push to the default branch,
# warns about protected paths and commits not authored as the asker. Hygiene,
# not a boundary (--no-verify skips it); GitHub's rules protect the rest.
write_pre_push_hook() {
  local hook=$thread/repo/.git/hooks/pre-push
  mkdir -p "$(dirname "$hook")"
  cat > "$hook" <<'HOOK'
#!/usr/bin/env bash
# termag: an ask clone's pre-push hook, written by termag-subagent-run.
remote=${1:-origin}
default=$(git config --get termag.defaultBranch)
email=$(git config --get termag.askerEmail)
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$remote_ref" ] || continue
  if [ -n "$default" ] && [ "$remote_ref" = "refs/heads/$default" ]; then
    echo "termag: not pushing to $default, the default branch: push your own branch and open a draft pull request for it (termag-pr-create --draft)" >&2
    status=1
    continue
  fi
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    range=("$local_sha" "^$remote_sha")
  else
    range=("$local_sha" --not --remotes="$remote")
  fi
  paths=$(git log --format= --name-only "${range[@]}" 2>/dev/null | grep -E '^\.github/workflows/|(^|/)CODEOWNERS$|(^|/)sudoers(\.d/|$)|\.sudoers$' | sort -u)
  [ -z "$paths" ] || printf 'termag: warning: %s changes protected files, which need a reviewer who owns them:\n%s\n' "${remote_ref#refs/heads/}" "$paths" >&2
  if [ -n "$email" ]; then
    others=$(git log --format='%h %ae %ce' "${range[@]}" 2>/dev/null | awk -v e="$email" '$2 != e || $3 != e' | head -5)
    [ -z "$others" ] || printf 'termag: warning: commits on %s not authored and committed as %s:\n%s\n' "${remote_ref#refs/heads/}" "$email" "$others" >&2
  fi
done
exit $status
HOOK
  chmod 755 "$hook"
}

# set_upstream <branch>: its own origin branch when GitHub has it, else the
# default branch (gotcha ask-push-clone-upstream). Written as config when the
# tracking ref isn't there (GitHub unreachable while preparing): the chat
# runner reads branch.<b>.remote and .merge, and a clone with origin but no
# upstream would lose its tools, so a prepare that can't set one fails.
set_upstream() {
  local r=$thread/repo
  if git -C "$r" rev-parse -q --verify "refs/remotes/origin/$1" >/dev/null; then
    git -C "$r" branch -q --set-upstream-to="origin/$1" "$1" 2>/dev/null && return 0
  elif git -C "$r" rev-parse -q --verify "refs/remotes/origin/$default_branch" >/dev/null; then
    git -C "$r" branch -q --set-upstream-to="origin/$default_branch" "$1" 2>/dev/null && return 0
  else
    log "origin/$default_branch is not fetched; $1 tracks it by config until a fetch brings it"
  fi
  git -C "$r" config "branch.$1.remote" origin && git -C "$r" config "branch.$1.merge" "refs/heads/$default_branch" \
    || fail "could not give $1 an upstream in the clone"
}

# The clone's settings and hooks for pushing; every push-mode prepare reapplies them.
configure_push_clone() {
  local r=$thread/repo b
  git -C "$r" config push.default current
  git -C "$r" config termag.defaultBranch "$default_branch"
  git -C "$r" config termag.askerEmail "$(field gitEmail)"
  # A turn never starts on a branch with no upstream, which the chat runner
  # would not take for the project's own tree.
  b=$(git -C "$r" symbolic-ref -q --short HEAD 2>/dev/null) || b=
  if [ -n "$b" ] && ! git -C "$r" rev-parse -q --verify "$b@{upstream}" >/dev/null 2>&1; then set_upstream "$b"; fi
  write_pre_push_hook
  # The repo's own hooks (gitleaks, for termag) when it has them. pre-commit
  # keeps an existing hook as .legacy and runs it, so ours stays in force.
  if [ -f "$r/.pre-commit-config.yaml" ] && command -v pre-commit >/dev/null 2>&1; then
    (cd "$r" && pre-commit install >/dev/null 2>&1) || log "pre-commit install failed in the clone; its hooks will not run"
  fi
}

# fetch_origin: the default branch and the thread's branch, when GitHub has it.
fetch_origin() {
  local r=$thread/repo
  git -C "$r" fetch -q --no-tags origin "+refs/heads/$default_branch:refs/remotes/origin/$default_branch" \
    || log "could not fetch $default_branch from origin"
  git -C "$r" fetch -q --no-tags origin "+refs/heads/$push_branch:refs/remotes/origin/$push_branch" 2>/dev/null || true
}

# Puts the clone on push_branch: GitHub's tip of it when there is one and the
# clone has none, else the base. The branch tracks its own origin branch, or
# the default branch: a branch with no refs/heads upstream is not the
# project's own tree to the chat runner (agent/chat-runner.js checkoutOwnTree).
checkout_push_branch() {
  local r=$thread/repo
  if git -C "$r" rev-parse -q --verify "refs/heads/$push_branch" >/dev/null; then :
  elif git -C "$r" rev-parse -q --verify "refs/remotes/origin/$push_branch" >/dev/null; then
    git -C "$r" branch -q "$push_branch" "refs/remotes/origin/$push_branch" || fail "could not create $push_branch in the clone"
  else
    git -C "$r" branch -q "$push_branch" "$base" || fail "could not create $push_branch in the clone"
  fi
  git -C "$r" -c advice.detachedHead=false checkout -q "$push_branch" || fail "could not check out $push_branch in the clone"
  set_upstream "$push_branch"
}

# A push-mode clone of the base: its whole history, fetched from the live
# checkout (only the base's, so unpushed commits never come along), then
# origin.
clone_for_push() {
  local url=$1 r=$thread/repo
  rm -rf -- "$r" "$thread/meta.json"
  git init -q "$r" \
    && fetch_local "$r" -q --no-tags "file://$cwd" "+$base:refs/termag/start" \
    && git -C "$r" remote add origin "$url" \
    || fail "could not clone ${base:0:12} from $cwd"
  git -C "$r" update-ref -d refs/termag/start
  default_branch=$(pick_default_branch)
  fetch_origin
  checkout_push_branch
}

# A clone from before push mode (shallow, `ask` and pr/<name>, refs/termag/base)
# becomes a push-mode one: its history in full, origin, and its branches renamed
# to the names they publish as.
convert_for_push() {
  local url=$1 r=$thread/repo b name
  if [ -f "$r/.git/shallow" ]; then
    fetch_local "$r" -q --no-tags --unshallow "file://$cwd" "$base" 2>/dev/null \
      || log "could not unshallow the clone; merges with older history may not find a base"
  fi
  git -C "$r" remote get-url origin >/dev/null 2>&1 || git -C "$r" remote add origin "$url" || fail "could not add origin to the clone"
  default_branch=$(pick_default_branch)
  fetch_origin
  if git -C "$r" rev-parse -q --verify refs/heads/ask >/dev/null && ! git -C "$r" rev-parse -q --verify "refs/heads/$push_branch" >/dev/null; then
    git -C "$r" branch -q -m ask "$push_branch" || fail "could not rename ask to $push_branch"
  fi
  while IFS= read -r b; do
    [ -n "$b" ] || continue
    name=${b#pr/}
    if [[ $name =~ $PR_NAME_RE ]] && ! git -C "$r" rev-parse -q --verify "refs/heads/$push_branch-$name" >/dev/null; then
      git -C "$r" fetch -q --no-tags origin "+refs/heads/$push_branch-$name:refs/remotes/origin/$push_branch-$name" 2>/dev/null || true
      git -C "$r" branch -q -m "$b" "$push_branch-$name" && set_upstream "$push_branch-$name"
    fi
  done < <(git -C "$r" for-each-ref --format='%(refname:short)' refs/heads/pr/)
  git -C "$r" update-ref -d refs/termag/base 2>/dev/null
  checkout_push_branch
  log "converted the thread's clone for pushing, on $push_branch"
}

# Sets base, repo, resume and fresh (true when the clone was made now). The
# full run holds the thread's lock to the end, so a second turn on the same
# thread is refused; a phase holds it only while it prepares, and waits for
# another phase's prepare rather than fail.
resume=
fresh=false
prepare_thread() {
  sweep
  # A person's message goes to a thread whose checkout is long there.
  if [ "$(jq -r '.waitForCheckout' "$job")" != false ]; then [ -n "$cwd" ] && wait_for_checkout; fi
  [ -n "$cwd" ] && [ -d "$cwd" ] || fail "the project checkout $cwd does not exist"
  git -C "$cwd" rev-parse --git-dir >/dev/null 2>&1 || fail "$cwd is not a git checkout"

  mkdir -p "$thread" && chmod 700 "$thread" || fail "cannot create $thread"
  exec 9>"$thread/.lock"
  if [ "$mode" = run ]; then
    flock -n 9 || fail "another turn of thread $thread_id is running on this box"
  else
    flock -w "$LOCK_WAIT_S" 9 || fail "another turn of thread $thread_id is still being prepared on this box"
  fi
  touch "$thread"

  resume=$(field resumeSessionId)
  push_branch=$(field pushBranch)
  if [ -n "$push_branch" ] && ! valid_branch "$push_branch"; then fail "the job's pushBranch is not a branch name"; fi
  if [ -f "$thread/meta.json" ] && [ -d "$thread/repo/.git" ]; then
    base=$(jq -r '.base // empty' "$thread/meta.json")
    repo=$(jq -r '.repo // empty' "$thread/meta.json")
    if [ "$(jq -r '.layout // empty' "$thread/meta.json")" = push ]; then
      default_branch=$(jq -r '.defaultBranch // empty' "$thread/meta.json")
      [ -n "$default_branch" ] || default_branch=$(pick_default_branch)
      meta_branch=$(jq -r '.branch // empty' "$thread/meta.json")
      if [ -n "$push_branch" ] && [ "$push_branch" != "$meta_branch" ]; then
        # The job names another branch than the clone's (a follow-up --update-pr on a
        # thread that published nothing): fetch it and move the clone onto it. The old
        # branch keeps its commits; --report names any it never pushed.
        # Ask GitHub first: a branch it doesn't have (exit 2) starts from the base as a
        # new thread branch, but one it couldn't be asked about fails the prepare with
        # nothing changed, so the next prepare tries again rather than inherit a branch
        # made from the base.
        if ! git -C "$thread/repo" rev-parse -q --verify "refs/heads/$push_branch" >/dev/null; then
          rc=0; git -C "$thread/repo" ls-remote --exit-code origin "refs/heads/$push_branch" >/dev/null 2>&1 || rc=$?
          case $rc in
            0) git -C "$thread/repo" fetch -q --no-tags origin "+refs/heads/$push_branch:refs/remotes/origin/$push_branch" \
                 || fail "could not fetch $push_branch from GitHub; ask again" ;;
            2) ;;
            *) fail "could not reach GitHub to switch the clone to $push_branch; ask again" ;;
          esac
        fi
        checkout_push_branch
        jq --arg b "$push_branch" '.branch = $b' "$thread/meta.json" > "$thread/meta.json.next" \
          && mv "$thread/meta.json.next" "$thread/meta.json" || fail "could not record $push_branch in meta.json"
        log "the clone moves from ${meta_branch:-no branch} to $push_branch, as the job names"
      else
        # A person's message names no branch: the clone's own.
        push_branch=$meta_branch
      fi
      configure_push_clone
    elif [ -n "$push_branch" ] && [ -n "$repo" ]; then
      convert_for_push "$(git -C "$cwd" config --get remote.origin.url)"
      configure_push_clone
      jq -n --arg base "$base" --arg repo "$repo" --arg branch "$push_branch" --arg d "$default_branch" \
        '{base: $base, repo: $repo, layout: "push", branch: $branch, defaultBranch: $d}' > "$thread/meta.json"
    else
      push_branch=
    fi
  else
    base=$(field baseSha)
    if [ -n "$base" ]; then
      git -C "$cwd" cat-file -e "$base^{commit}" 2>/dev/null \
        || fail "the thread's base commit ${base:0:12} is no longer in $cwd; start a new thread"
    else
      base=$(pick_base) || base=
      if [ -z "$base" ]; then
        base=$(git -C "$cwd" rev-parse -q --verify 'HEAD^{commit}') || fail "$cwd has no commits"
        log "no remote branch to start from; using HEAD ${base:0:12}, and the commits will not be published"
      fi
    fi
    repo=$(github_repo) || repo=
    [ -n "$repo" ] || log "origin is not on github.com; the commits will not be published"
    if [ -n "$push_branch" ] && [ -n "$repo" ]; then
      clone_for_push "$(git -C "$cwd" config --get remote.origin.url)"
      configure_push_clone
      jq -n --arg base "$base" --arg repo "$repo" --arg branch "$push_branch" --arg d "$default_branch" \
        '{base: $base, repo: $repo, layout: "push", branch: $branch, defaultBranch: $d}' > "$thread/meta.json"
    else
      push_branch=
      # A clone of one commit: the live checkout is only ever read from.
      rm -rf -- "$thread/repo" "$thread/meta.json"
      git init -q "$thread/repo" \
        && fetch_local "$thread/repo" -q --depth=1 --no-tags "file://$cwd" "$base" \
        && git -C "$thread/repo" -c advice.detachedHead=false checkout -q -b ask FETCH_HEAD \
        || fail "could not clone ${base:0:12} from $cwd"
      jq -n --arg base "$base" --arg repo "$repo" '{base: $base, repo: $repo}' > "$thread/meta.json"
    fi
    [ -n "$resume" ] && log "the thread's earlier session is not on this box; starting a new one"
    resume=
    fresh=true
  fi
  if [ -z "$push_branch" ]; then
    git -C "$thread/repo" update-ref refs/termag/base "$base" 2>/dev/null || log "could not set refs/termag/base in the clone"
  fi
  mkdir -p "$pr_dir"
  [ "$mode" = run ] || exec 9>&-
}

# --- the run ---------------------------------------------------------------------------

# The native install, else one on PATH, else the newest nvm global: the agent
# runs under systemd, whose PATH has no nvm (agent/chat-runner.js resolveClaude).
find_claude() {
  local bin
  if [ -n "${TERMAG_SUBAGENT_CLAUDE:-}" ]; then printf '%s' "$TERMAG_SUBAGENT_CLAUDE"; return 0; fi
  if [ -x "$HOME/.local/bin/claude" ]; then printf '%s' "$HOME/.local/bin/claude"; return 0; fi
  command -v claude 2>/dev/null && return 0
  while IFS= read -r bin; do
    [ -x "$bin" ] && { printf '%s' "$bin"; return 0; }
  done < <(printf '%s\n' "${NVM_DIR:-$HOME/.nvm}"/versions/node/*/bin/claude | sort -rV)
  return 1
}

run_claude() {
  local claude args git_name git_email
  claude=$(find_claude) || fail "Claude Code is not installed on this box"

  field systemPrompt > "$work/system-prompt.txt"
  # claude -p stays up while a wakeup or cron it scheduled is pending, so a
  # fallback wakeup left behind after the answer holds the reply until it fires
  # (30 min). Background agents still bring the run back without them.
  args=(-p --output-format json --permission-mode bypassPermissions
        --disallowedTools 'ScheduleWakeup CronCreate'
        --append-system-prompt "$(cat "$work/system-prompt.txt")")
  [ -n "$resume" ] && args+=(--resume "$resume")

  git_name=$(field gitName)
  git_email=$(field gitEmail)
  log "thread $thread_id: running in $thread/repo (base ${base:0:12}${resume:+, resuming $resume})"
  field prompt > "$work/prompt"
  (
    cd "$thread/repo" || exit 70
    unset TMUX TMUX_PANE
    PATH="$(dirname "$claude"):$HOME/.local/bin:$PATH"
    export PATH
    export GIT_AUTHOR_NAME=$git_name GIT_AUTHOR_EMAIL=$git_email
    export GIT_COMMITTER_NAME=$git_name GIT_COMMITTER_EMAIL=$git_email
    export TERMAG_ASK_THREAD=$thread_id
    if [ -n "$push_branch" ]; then unset TERMAG_ASK_PR_BODY_FILE TERMAG_ASK_PR_DIR
    else export TERMAG_ASK_PR_BODY_FILE=$pr_body_file TERMAG_ASK_PR_DIR=$pr_dir
    fi
    exec setsid "$claude" "${args[@]}" < "$work/prompt"
  ) > "$work/claude.json" &
  child=$!
  status=0
  wait "$child" || status=$?
  child=
}

# --- report ------------------------------------------------------------------------------

# Push mode: the branches the clone pushed to GitHub, as [{branch, sha}] in
# $work/pushes.json. git logs `update by push` in a remote-tracking ref's
# reflog whenever a push moves it, so these are the branches the run (or a
# person in the thread's chat) pushed, whatever the turn; the orchestrator
# records each idempotently. Local branches with commits no origin branch
# has are named in the reply: committed but not pushed.
report_pushes() {
  local r=$thread/repo ref b n
  printf '[]' > "$work/pushes.json"
  while IFS= read -r ref; do
    b=${ref#refs/remotes/origin/}
    [ "$b" = HEAD ] && continue
    # To a file first: a pipeline ending in grep -q would SIGPIPE git under pipefail.
    git -C "$r" reflog show --format='%gs' "$ref" > "$work/reflog" 2>/dev/null
    grep -q '^update by push' "$work/reflog" || continue
    jq --arg b "$b" --arg sha "$(git -C "$r" rev-parse "$ref")" '. + [{branch: $b, sha: $sha}]' "$work/pushes.json" > "$work/pushes.next" \
      && mv "$work/pushes.next" "$work/pushes.json"
  done < <(git -C "$r" for-each-ref --format='%(refname)' refs/remotes/origin/)
  log "pushed branches: $(jq -r 'map(.branch) | join(", ") | if . == "" then "none" else . end' "$work/pushes.json")"
  while IFS= read -r b; do
    [ -n "$b" ] || continue
    if git -C "$r" rev-parse -q --verify "refs/remotes/origin/$b" >/dev/null; then
      n=$(git -C "$r" rev-list --count "refs/remotes/origin/$b..refs/heads/$b" 2>/dev/null) || n=0
    else
      n=$(git -C "$r" rev-list --count "refs/heads/$b" --not --remotes=origin 2>/dev/null) || n=0
    fi
    [ "${n:-0}" -gt 0 ] && printf '\n\n[termag: branch %s has %s commit(s) that were committed but not pushed; they stay in %s on the box]\n' "$b" "$n" "$r" >> "$work/reply"
  done < <(git -C "$r" for-each-ref --format='%(refname:short)' refs/heads/)
}

# From $work/claude.json (claude -p's JSON, or the chat turn's result event)
# and $status: the commits as a bundle, then the reply.
report() {
  if jq -e 'type == "object" and has("result")' "$work/claude.json" >/dev/null 2>&1; then
    jq -j '.result' "$work/claude.json" > "$work/reply"
    session=$(jq -r '.session_id // empty' "$work/claude.json")
    num_turns=$(jq -r '.num_turns // "null" | tostring' "$work/claude.json")
    [ "$(jq -r '.is_error // false' "$work/claude.json")" = true ] && { is_error=true; reason="Claude Code ended with $(jq -r '.subtype // "an error"' "$work/claude.json")"; }
  else
    is_error=true
    reason="the run exited $status without a result"
    { printf 'The ask run on the target box ended without an answer (exit %s).\n' "$status"; tail -c 2000 "$work/claude.json"; } > "$work/reply"
  fi
  [[ $num_turns =~ ^[0-9]+$ ]] || num_turns=null

  if [ -n "$push_branch" ]; then
    report_pushes
    post_result "$work/reply" || exit 1
    exit 0
  fi

  local count size code
  local -a refs
  mapfile -t refs < <(publish_refs)
  count=0
  [ "${#refs[@]}" -eq 0 ] || count=$(git -C "$thread/repo" rev-list --count "${refs[@]}" "^$base" 2>/dev/null) || count=0
  if [ "${count:-0}" -gt 0 ]; then
    if [ -z "$repo" ]; then
      printf '\n\n[termag: the run committed changes, but the target has no GitHub origin, so they stay in %s on the box]\n' "$thread/repo" >> "$work/reply"
    elif ! git -C "$thread/repo" bundle create -q "$work/run.bundle" "${refs[@]}" "^$base" 2>/dev/null; then
      printf '\n\n[termag: the run'\''s commits could not be bundled, and were not published]\n' >> "$work/reply"
    else
      size=$(stat -c %s "$work/run.bundle" 2>/dev/null || echo 0)
      if [ "$size" -gt "$BUNDLE_MAX" ]; then
        printf '\n\n[termag: the run'\''s commits are %s bytes, over the %s-byte limit, and were not published]\n' "$size" "$BUNDLE_MAX" >> "$work/reply"
      else
        code=$(call -X PUT -H 'Content-Type: application/octet-stream' --data-binary "@$work/run.bundle" "$endpoint/bundle")
        if [ "$code" = 204 ]; then
          bundle_sent=true; log "bundle uploaded ($size bytes, $count commit(s) on ${#refs[@]} branch(es))"
          pr_descriptions "${refs[@]}"
          # A regular file only: a symlink could point the upload anywhere.
          if [ -f "$pr_body_file" ] && [ ! -L "$pr_body_file" ]; then
            cut_utf8 "$PR_BODY_MAX" "$pr_body_file" > "$work/pr-body.cut"
            log "PR description sent ($(wc -c < "$work/pr-body.cut") bytes)"
          fi
        else log "bundle not uploaded: HTTP $code"; printf '\n\n[termag: the commits could not be uploaded (HTTP %s)]\n' "$code" >> "$work/reply"; fi
      fi
    fi
  fi

  post_result "$work/reply" || exit 1
  exit 0
}

case $mode in
  prepare)
    prepare_thread
    jq -cn --arg dir "$thread/repo" --arg base "$base" --arg repo "$repo" --argjson fresh "$fresh" \
      --arg prBodyFile "$pr_body_file" --arg prDir "$pr_dir" --arg branch "$push_branch" \
      'if $branch == "" then {repoDir: $dir, base: $base, repo: $repo, fresh: $fresh, prBodyFile: $prBodyFile, prDir: $prDir}
       else {repoDir: $dir, base: $base, repo: $repo, fresh: $fresh, push: true, branch: $branch} end'
    exit 0
    ;;
  report)
    status=0
    [ -f "$thread/meta.json" ] && [ -d "$thread/repo/.git" ] || fail "the thread's clone is no longer on this box"
    base=$(jq -r '.base // empty' "$thread/meta.json")
    repo=$(jq -r '.repo // empty' "$thread/meta.json")
    # Push or bundle comes from the job, as in prepare, not from meta.json's
    # layout, which the turn can rewrite; jobs from before pushBranch fall back to it.
    push_branch=$(field pushBranch)
    if [ -n "$push_branch" ] && ! valid_branch "$push_branch"; then push_branch=; fi
    if [ -z "$push_branch" ] && [ "$(jq -r '.layout // empty' "$thread/meta.json")" = push ]; then
      push_branch=$(jq -r '.branch // empty' "$thread/meta.json")
      [ -n "$push_branch" ] || push_branch='(unnamed)'
    fi
    cp "$arg2" "$work/claude.json" 2>/dev/null || : > "$work/claude.json"
    report
    ;;
  run)
    prepare_thread
    run_claude
    report
    ;;
esac
