{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/termag-status\" session-start >/dev/null 2>&1 || true"
          },
          {
            "type": "command",
            "command": "[ \"$TERMAG_SPACE_MEMORY_MANAGED\" = 1 ] || { [ -x \"$HOME/.local/bin/termag\" ] && \"$HOME/.local/bin/termag\" space memory context --hook SessionStart --refresh 60s 2>/dev/null; } || true",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); printf '%s' \"$INPUT\" | \"$HOME/.local/bin/termag-status\" t3-guard; [ $? != 2 ] || exit 2; printf '%s' \"$INPUT\" | \"$HOME/.local/bin/termag-status\" prompt-submit >/dev/null 2>&1 & [ \"$TERMAG_SPACE_MEMORY_MANAGED\" = 1 ] || { [ -x \"$HOME/.local/bin/termag\" ] && printf '%s' \"$INPUT\" | \"$HOME/.local/bin/termag\" space memory context --hook UserPromptSubmit --refresh 60s 2>/dev/null; } || true",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/termag-status\" working >/dev/null 2>&1 &"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); printf '%s' \"$INPUT\" | \"$HOME/.local/bin/termag-status\" post-tool >/dev/null 2>&1 &"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); printf '%s' \"$INPUT\" | \"$HOME/.local/bin/termag-status\" notification >/dev/null 2>&1 &"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); printf '%s' \"$INPUT\" | \"$HOME/.local/bin/termag-status\" stop >/dev/null 2>&1 &"
          }
        ]
      }
    ]
  },
  "idleCompaction": false
}
