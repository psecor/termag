[Unit]
Description=termag: bring Claude Code to its floor and to npm's latest before the agent starts
After=termag-reconcile.service
Before=termag-agent.service

# Only on a box that has been launched: cloud-init writes the agent's config
# (with its token) at launch, and an image bake never has one. So a bake never
# runs this, and never has an npm install writing ~/.nvm while it stops
# termag's processes or takes its home write baseline (packer/scripts/
# bake-webapp-fetch.sh). The image's own claude is the bake's npm install,
# checked against the floor by setup.sh. The paths are the agent config search
# order termag-box-update and termag-status use; any one is enough. A skipped
# unit counts as done, so the agent's ordering is unchanged.
ConditionPathExists=|%h/src/termag/agent/agent.config.json
ConditionPathExists=|%h/.termag/agent.config.json
ConditionPathExists=|%h/.config/termag/agent.config.json

[Service]
# Why this exists: a stopped box boots with every Claude gone. Nothing runs on
# an old binary yet, so updating Claude Code here, before the agent, means
# everything after starts on the new one: the agent's reconnect relaunches the
# agent panes, and cloud sessions come only after the agent has connected.
# Without it a box keeps its image's Claude Code until something else moves
# the shared npm prefix.
#
# After termag-reconcile, so the floor file (deploy/claude-code-floor) and the
# script are the checkout's. The user manager has no network-online.target,
# so the script waits for the npm registry itself, bounded.
Type=oneshot

# The copy termag-reconcile installed moments earlier, from the same checkout
# as this unit, and the one termag-claude-runner's guard runs; it does not
# depend on the checkout's branch having the script. %h survives the
# cloud-init user rename. --boot applies the floor and installs npm's latest
# when the box is behind it; it restarts nothing.
ExecStart=%h/.local/bin/termag-claude-update --boot

# Never keep the box from booting or the agent from starting: exit 1 (still
# below the floor, or no network) and exit 3 (an install was rejected) are
# successes here, and Before= is ordering only, so the agent starts whatever
# this does. A rejected install is not left in place: the script puts the
# previous version back, verified, or quarantines what it installed, so the
# agent's pane relaunch never starts unverified bytes; the record in
# ~/.termag/claude-update.rejected is the signal, and keeps cloud runners
# refused until a later run verifies that path. A unit failed on every boot
# would only be noise beside it. The cap stops a hung npm from holding the
# agent back past the orchestrator's box start timeout; a slower start is
# accepted.
SuccessExitStatus=0 1 3
#
# The budget. --boot stops itself inside TERMAG_CLAUDE_BUDGET (240 s): the lock
# wait (as long as the budget allows less an 18 s reserve, so about 222 s at
# most), the registry wait (120 s), each install (300 s) and the
# npm retry all take their share of what is left of those 240 s, less a 30 s
# reserve for what must follow (a 10 s TERM-to-KILL grace, two 8 s version
# checks, 4 s of slack). So the worst case ends by 240 s, and systemd's 300 s below leaves
# 60 s of margin: an install is stopped by the script, which knows it did not
# finish, rather than cut by systemd; a half-written npm global is noticed by
# the next run (its claude does not run) and reinstalled. The agent waits at
# most 5 min for this, well inside the orchestrator's box start timeout
# (BOX_START_TIMEOUT_SECONDS, 15 min).
Environment=TERMAG_CLAUDE_BUDGET=240
TimeoutStartSec=5min

# Behind the owner's own work, should they connect while it runs.
Nice=10

[Install]
WantedBy=default.target
