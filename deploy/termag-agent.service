[Unit]
Description=Termag per-user agent
After=network.target

[Service]
# nvm-only: there is no system node. Source nvm so `node` (and `codex`, which
# agent.js spawns directly) resolve from the user's nvm install. The default
# alias is set at bake time (`nvm alias default lts/*`). $HOME is set by the
# systemd user manager, so this works under any owner after the box rename.
#
# Adjust the agent/ path if you cloned termag somewhere other than ~/src/termag.
# Avoid ~/termag/, since termag's project dirs live at ~/termag/projects/<name>/
# and a clone there will collide.
ExecStart=/bin/bash -c 'export NVM_DIR="$HOME/.nvm"; . "$NVM_DIR/nvm.sh"; exec node "$HOME/src/termag/agent/agent.js" "$HOME/src/termag/agent/agent.config.json"'
Restart=always
RestartSec=5

# Do not take the user's tmux server down with the agent.
#
# agent.js starts tmux sessions with `tmux new-session`. tmux daemonises, so it
# reparents to the systemd user manager and `ps` makes it look independent -- but
# it stays in this unit's *cgroup*, and the default KillMode=control-group
# SIGKILLs the entire cgroup on stop. So `systemctl --user restart termag-agent`
# destroys the tmux server and every pane with it: any build, test run or
# interactive login in any project dies, and scrollback is lost. The agent then
# recreates empty sessions on reconnect, so the panes come back looking healthy,
# which makes the data loss easy to miss.
#
# KillMode=process signals only the main process and leaves the rest of the
# cgroup alone, so the tmux server survives a restart and the agent reattaches to
# the existing sessions (see AGENTS.md on reconnect reconstructing session state).
# Trade-off: leftover `tmux attach-session` clients are no longer force-killed.
# They exit when their PTY closes, so they are transient rather than leaked.
KillMode=process

[Install]
WantedBy=default.target
