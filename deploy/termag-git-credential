#!/bin/sh
# termag-git-credential -- git credential helper for the termag GitHub broker
#. termag-credentials configures it for the broker's URL
# only, so it never answers for github.com or anything else. `get` prints this
# box's agent token, read from the agent config each time; nothing is stored.
#
# Usage (from git): termag-git-credential <agent.config.json> get|store|erase
config=$1
action=${2:-}
cat >/dev/null
[ "$action" = get ] || exit 0
token=$(jq -r '.token // empty' "$config" 2>/dev/null) || exit 0
[ -n "$token" ] || exit 0
printf 'username=termag-box\npassword=%s\n' "$token"
