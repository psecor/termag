#!/usr/bin/env bash
# termag-agent-otel — start Codex, Devin, Cursor or pi with termag's
# OpenTelemetry, then exec the agent.
#
# Usage:
#   termag-agent-otel <codex|devin|cursor|pi> [--replay <id>] -- <command> [args...]
#
# TERMAG_PROJECT and TERMAG_WORKSTREAM in the environment (the orchestrator
# sets both ahead of the command) name the pane's project and workstream on
# the resource as termag.project and termag.workstream, the two every agent
# resource carries beside termag.agent and termag.session.kind. Environment
# rather than flags, so an older copy of this script ignores them. Both or
# neither, ids only (letters, digits, - and _, at most 64).
#
# The orchestrator types this in front of a provider's launch command on a box
# whose agent advertises agent-telemetry-v1 (backend/src/services/launchCommand.ts),
# and the Codex status bridge starts `codex app-server` through it. The
# destination is what termag-credentials recorded from the orchestrator's
# agent-telemetry delivery; with none (off, removed, or unreadable) the command
# runs exactly as given, so a launch never fails on telemetry.
#
#   codex   the export goes in as `-c otel.*` overrides on this launch only:
#           traces and metrics over OTLP/HTTP. Codex's log exporter stays off,
#           because its codex.tool_result log records carry tool arguments and
#           output; its spans carry only their lengths. The resource gets a
#           session.id, a UUID per start, since Codex sends none. An owner whose
#           ~/.codex/config.toml has an otel table of their own keeps theirs.
#   devin   Devin reads the standard OTLP variables (metrics and logs, which
#           carry no prompt or tool content without the OTEL_LOG_* gates).
#   cursor  Cursor's own exporter only reaches Cursor; termag-cursor-otel-hook
#   pi      and the pi extension termag-otel.ts send instead, reading the
#           same record. Here they get only the replay id (TERMAG_OTEL_REPLAY_ID).
#
# Whenever it exports, every OTEL_EXPORTER_OTLP_* and OTEL_LOG_* variable the
# owner's shell set is dropped first: both Rust exporters merge a shell's
# OTEL_EXPORTER_OTLP_HEADERS into a configured exporter, which would send the
# owner's collector credential to the telemetry backend's ingest.
#
# Env: TERMAG_AGENT_TELEMETRY (the record; default ~/.config/termag/agent-telemetry.json),
# CODEX_HOME.
set -u

usage() { sed -n '5,6p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

agent=${1:-}; [ $# -gt 0 ] && shift
replay=
while [ $# -gt 0 ]; do
  case $1 in
    --replay) replay=${2:-}; shift 2 || usage ;;
    --) shift; break ;;
    *) usage ;;
  esac
done
[ $# -gt 0 ] || usage
case $agent in codex|devin|cursor|pi) ;; *) usage ;; esac

# Letters and digits only, as for Claude's telemetry-launch: it goes into
# OTEL_RESOURCE_ATTRIBUTES unescaped.
case $replay in *[!A-Za-z0-9]*) replay= ;; esac
if [ ${#replay} -lt 20 ] || [ ${#replay} -gt 64 ]; then replay=; fi

record=${TERMAG_AGENT_TELEMETRY:-$HOME/.config/termag/agent-telemetry.json}
endpoint='' resource=''
if [ -s "$record" ] && command -v jq >/dev/null 2>&1; then
  endpoint=$(jq -r 'if (.endpoint | type) == "string" then .endpoint else empty end' "$record" 2>/dev/null)
  resource=$(jq -r 'if (.resourceAttributes | type) == "string" then .resourceAttributes else empty end' "$record" 2>/dev/null)
fi
# The same checks termag-credentials made: anything else and nothing is added.
[[ $endpoint =~ ^https://[A-Za-z0-9.:-]+$ ]] || endpoint=
[[ $resource =~ ^[A-Za-z0-9._=,-]+$ ]] || resource=
if [ -z "$endpoint" ] || [ -z "$resource" ]; then exec "$@"; fi

[ -n "$replay" ] && export TERMAG_OTEL_REPLAY_ID=$replay
case $agent in cursor|pi) exec "$@" ;; esac

if [ "$agent" = codex ]; then
  # An otel table of the owner's own: theirs, untouched (environment too).
  if grep -Eq '^[[:space:]]*(\[[[:space:]]*otel[[:space:]]*[].]|otel[[:space:]]*[.=])' \
       "${CODEX_HOME:-$HOME/.codex}/config.toml" 2>/dev/null; then
    exec "$@"
  fi
fi

for v in $(compgen -e); do
  case $v in OTEL_EXPORTER_OTLP_*|OTEL_LOG_*|OTEL_SERVICE_NAME) unset "$v" ;; esac
done
resource="$resource,service.name=termag-$agent-session,termag.agent=$agent"
project=${TERMAG_PROJECT:-} workstream=${TERMAG_WORKSTREAM:-}
[[ $project =~ ^[A-Za-z0-9_-]{1,64}$ ]] && [[ $workstream =~ ^[A-Za-z0-9_-]{1,64}$ ]] \
  && resource="$resource,termag.project=$project,termag.workstream=$workstream"
# The session's work, as Claude's telemetry-launch adds it: the checkout's
# repository, branch and commit, and a spawned agent's spawn
# (termag-credentials work-resource). The copy beside
# this one: beside the script itself, following a symlink (a pane's launch
# names this by PATH, and a link in a bin directory points into a checkout),
# then beside the name it was run by, then the one on PATH. An older one
# without the subcommand prints usage on stderr and nothing here, and anything
# that is not a list of pairs is dropped.
credentials_script() {
  local self=$0 real d
  case $self in */*) ;; *) self=$(command -v -- "$self" 2>/dev/null) || self= ;; esac
  if [ -n "$self" ]; then
    real=$(readlink -f -- "$self" 2>/dev/null) || real=
    for d in ${real:+"$(dirname -- "$real")"} "$(dirname -- "$self")"; do
      [ -x "$d/termag-credentials" ] && { printf '%s' "$d/termag-credentials"; return 0; }
    done
  fi
  command -v termag-credentials 2>/dev/null
}
work=
creds=$(credentials_script) && [ -n "$creds" ] \
  && { work=$("$creds" work-resource 2>/dev/null </dev/null) || work=; }
[[ $work =~ ^(,[A-Za-z0-9._]+=[A-Za-z0-9._/-]+)+$ ]] && resource="$resource$work"
# Codex's spans carry no session.id (its thread id is on some turn and tool
# spans only, none of the app server's request spans), so each start gets one
# on the resource: a UUID. The status bridge starts one app server per pane,
# and the pane's TUI can start more than one thread on it (/new, a resume,
# subagents), so it names the app server's run, not one conversation.
# None when no UUID can be had: never a constant.
session_uuid() {
  local u
  u=$(cat /proc/sys/kernel/random/uuid 2>/dev/null) \
    || u=$(od -An -N16 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n' \
      | sed -E 's/^(.{8})(.{4})(.{4})(.{4})(.{12})$/\1-\2-\3-\4-\5/') || u=
  [[ $u =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] && printf '%s' "$u"
}
if [ "$agent" = codex ]; then
  sid=$(session_uuid) && resource="$resource,session.id=$sid"
fi
[ -n "$replay" ] && resource="$resource,termag.replay.id=$replay"
# The inference backend and model ("The inference
# backend"). Codex: termag never sets its provider, so the owner's
# $CODEX_HOME/config.toml says: no model_provider (or openai) is `openai`, any
# other provider (a local or self-hosted one) `custom`, never its URL; the
# model is the launch's --model / -m, else the config's top-level model.
# Devin runs on Cognition's own backend, which termag can't see: `devin`, with
# the launch's --model when there is one. Cursor's hook and pi's extension name
# their own. Ids only; a bad model is left out, never the launch.
model_arg() {  # the value of --model / -m / --model=… in the command's arguments
  local prev=
  for a in "$@"; do
    case $prev in --model|-m) printf '%s' "$a"; return 0 ;; esac
    case $a in --model=*) printf '%s' "${a#--model=}"; return 0 ;; --) return 0 ;; esac
    prev=$a
  done
}
codex_top() {  # a top-level string key of config.toml, before its first table
  awk -v k="$1" '/^[[:space:]]*\[/ { exit }
    $0 ~ "^[[:space:]]*" k "[[:space:]]*=" { sub(/^[^=]*=[[:space:]]*/, ""); gsub(/^["\x27]|["\x27][[:space:]]*(#.*)?$/, ""); print; exit }' \
    "${CODEX_HOME:-$HOME/.codex}/config.toml" 2>/dev/null
}
inference=
case $agent in
  codex)
    case $(codex_top model_provider) in ''|openai) inference=openai ;; *) inference=custom ;; esac
    inf_model=$(model_arg "$@"); [ -n "$inf_model" ] || inf_model=$(codex_top model) ;;
  devin) inference=devin; inf_model=$(model_arg "$@") ;;
esac
if [ -n "$inference" ]; then
  resource="$resource,termag.inference.backend=$inference"
  [[ ${inf_model:-} =~ ^[A-Za-z0-9._:/@-]{1,128}$ ]] && resource="$resource,termag.inference.model=$inf_model"
fi
export OTEL_RESOURCE_ATTRIBUTES=$resource

case $agent in
  devin)
    export OTEL_EXPORTER_OTLP_ENDPOINT=$endpoint OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
    exec "$@" ;;
  codex)
    # Codex sets service.name itself (codex_cli_rs, codex_exec); termag.agent
    # is the attribute to filter on.
    prog=$1; shift
    exec "$prog" \
      -c 'otel.exporter="none"' \
      -c "otel.trace_exporter={otlp-http={endpoint=\"$endpoint/v1/traces\",protocol=\"binary\"}}" \
      -c "otel.metrics_exporter={otlp-http={endpoint=\"$endpoint/v1/metrics\",protocol=\"binary\"}}" \
      -c 'otel.log_user_prompt=false' \
      -c 'otel.environment="termag"' \
      "$@" ;;
esac
