#!/usr/bin/env bash
# termag-status — report Claude Code agent status to the termag server.
#
# Called from the hooks in ~/.claude/settings.json (see deploy/claude-settings.json).
#
# Why this exists: the hooks used to POST to a hardcoded
# http://localhost:3040/termag/api/status. That is only correct when the termag
# server is co-located with the agent. On a provisioned box the server lives
# elsewhere, so every POST failed — silently, because the hooks background their
# curl and discard output. Status lights stayed grey and needs-input Slack
# notifications never fired, with nothing in any log to say why.
#
# This resolves the endpoint from the per-user agent's own termag_url, mirroring
# getStatusEndpoint() in agent/agent.js, so co-located and remote boxes both work
# with no per-box configuration.
#
# Usage:
#   termag-status working|idle|not_running|waiting [options]
#   termag-status meta [options]      # metadata-only (contextTokens / rateLimited)
#   termag-status notification        # Claude Code hook JSON on stdin
#   termag-status prompt-submit       # UserPromptSubmit hook JSON on stdin:
#                                     # posts `working`; inside a Claude Code
#                                     # cloud session on a termag box, also
#                                     # posts the first prompt's first line
#                                     # once as the session's title (the
#                                     # once-marker is claimed before posting)
#   termag-status post-tool           # PostToolUse hook JSON on stdin: posts
#                                     # `working`, plus a milestone when the
#                                     # tool was a Bash `gh pr create|merge`
#   termag-status stop                # Stop hook JSON on stdin: posts `idle`;
#                                     # inside a Claude Code cloud session on a
#                                     # termag box, also posts the session's
#                                     # cumulative token usage, summed from the
#                                     # transcript the payload names
#   termag-status usage [--transcript <jsonl>]...
#                                     # the usage post alone, from the given
#                                     # transcripts (or the hook JSON on stdin);
#                                     # no tmux session needed: the runner's
#                                     # post-session hook calls it once more at
#                                     # the end
#   termag-status --classify          # hook JSON on stdin → "<kind> <url>" when
#                                     # the call opened/merged a PR (the URL in
#                                     # the output is the proof it succeeded),
#                                     # else nothing; POSTs nothing (tests)
#   termag-status session-start       # SessionStart hook: ~/.local/bin onto
#                                     # $CLAUDE_ENV_FILE, POSTs nothing
#   termag-status --print-endpoint    # resolve and print, POST nothing
#   termag-status --print-auth        # 'token: present|absent', never the token
#
# Options (after the mode; all optional, unknown ones are ignored):
#   --source <id>            status source, e.g. pi-ext:pi. Omitted =
#                            the historical payload, which the server books as
#                            Claude -- the Claude hooks rely on exactly that.
#   --reason approval|user_input   waitingReason for `waiting`
#   --message <text>         trimmed to 200 chars
#   --notify                 ask the server to notify (Slack/Discord needs-input)
#   --context-tokens <n|null>, --rate-limited <text|null>
#                            metadata; `null` clears. Valid on `meta` and on a
#                            status post.
#   --print-payload          print the JSON that would be sent, POST nothing
#
#   termag-status --print-mirrors     # one resolved mirror endpoint per line, POST nothing
#
# Mirrors: every post also goes to each endpoint listed in
#   ~/.config/termag/status-mirrors   (TERMAG_STATUS_MIRRORS overrides the path)
# one agent-config path per line, `#` comments and blank lines ignored, unreadable
# paths skipped. Each config resolves to its own endpoint + token exactly as the
# primary does; a mirror that resolves to the primary's endpoint is skipped, so a
# caller that already targets a mirror never double-posts. A file reaches the
# hooks AND pi's status extension in already-running panes, which an environment
# variable cannot -- this is how the staging stack (scripts/stage/stage.sh) gets a
# copy of every status event without duplicating hook entries per provider.
#
# Env:
#   TERMAG_AGENT_CONFIG    override the config path
#   TERMAG_STATUS_MIRRORS  override the mirrors file path
#   TERMAG_CLAUDE_RUNNER_ORDER, TERMAG_CLAUDE_RUNNER_DIR, CLAUDE_CODE_REMOTE_SESSION_ID
#                          set by termag-claude-runner and the runner inside a
#                          cloud session: the order the title post names, where
#                          the once-only marker goes, and the session id
#   TERMAG_STATUS_SESSION  override the tmux session name (tests, non-tmux callers);
#                          without it, a hook outside tmux ($TMUX unset) posts nothing
#   TERMAG_T3              set in the box's t3 server (agent/t3-bridge.js): the
#                          hook is a desktop app thread's, so the session is
#                          the project whose checkout holds CLAUDE_PROJECT_DIR
#                          (else the working directory), found among the box's
#                          tmux sessions; the t3 server's own `termag-t3`
#                          when no project's does. Such posts carry
#                          `source: t3:claude` and the hook's session_id as
#                          `threadId`. A t3 server an older agent started
#                          is recognised by its tmux session instead.
#   TERMAG_STATUS_DEBUG=1  dump the last notification payload to
#                          ~/.cache/termag-status/last-notification.json

set -u
PATH=/usr/local/bin:/usr/bin:/bin:$PATH

MODE=${1:-}
[ -n "$MODE" ] || exit 0
[ $# -gt 0 ] && shift

# session-start: Claude Code's SessionStart hook. Its Bash tool runs every
# command in a non-login, non-interactive shell whose PATH is the snapshot's
# copy of the claude process's own PATH, so no startup file reaches it; what
# does is $CLAUDE_ENV_FILE, sourced before each command. Without this,
# ~/.local/bin (termag, termag-status, gh wrappers) is missing whenever claude
# was started from a shell or service that didn't have it.
LOCAL_BIN_LINE='if [ -d "$HOME/.local/bin" ]; then case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac; fi'
if [ "$MODE" = session-start ]; then
  f=${CLAUDE_ENV_FILE:-}
  [ -n "$f" ] || exit 0
  grep -qxF "$LOCAL_BIN_LINE" "$f" 2>/dev/null || printf '%s\n' "$LOCAL_BIN_LINE" >> "$f" 2>/dev/null
  exit 0
fi

# --- options ----------------------------------------------------------------
SOURCE='' REASON='' MESSAGE='' NOTIFY='' CTX_TOKENS='' RATE_LIMITED='' PRINT_PAYLOAD=''
TRANSCRIPTS=()
while [ $# -gt 0 ]; do
  case $1 in
    --source)         SOURCE=${2:-};       shift 2 2>/dev/null || shift ;;
    --reason)         REASON=${2:-};       shift 2 2>/dev/null || shift ;;
    --message)        MESSAGE=${2:-};      shift 2 2>/dev/null || shift ;;
    --notify)         NOTIFY=1;            shift ;;
    --context-tokens) CTX_TOKENS=${2:-};   shift 2 2>/dev/null || shift ;;
    --rate-limited)   RATE_LIMITED=${2:-}; shift 2 2>/dev/null || shift ;;
    --print-payload)  PRINT_PAYLOAD=1;     shift ;;
    --transcript)     [ -n "${2:-}" ] && TRANSCRIPTS+=("$2"); shift 2 2>/dev/null || shift ;;
    *)                shift ;;   # forward compatible: unknown options are ignored
  esac
done

# --- resolve the endpoint ---------------------------------------------------
# Config search order follows agent/agent.js, plus the path the systemd unit
# passes explicitly.
find_config() {
  local c
  for c in "${TERMAG_AGENT_CONFIG:-}" \
           "$HOME/src/termag/agent/agent.config.json" \
           "$HOME/.termag/agent.config.json" \
           "$HOME/.config/termag/agent.config.json"; do
    if [ -n "$c" ] && [ -r "$c" ]; then printf '%s' "$c"; return 0; fi
  done
  return 1
}

# Both resolvers take an optional config path (a mirror); without one they use
# the primary config from find_config.
resolve_token() {
  local config=${1:-}
  [ -n "$config" ] || config=$(find_config) || return 0
  jq -r '.token // empty' "$config" 2>/dev/null || true
}

resolve_endpoint() {
  # agent.js's own fallback, for a co-located server with no readable config.
  local endpoint='http://127.0.0.1:3040/termag/api/status' config=${1:-} url
  [ -n "$config" ] || config=$(find_config) || config=
  if [ -n "$config" ]; then
    url=$(jq -r '.termag_url // empty' "$config" 2>/dev/null) || url=
    if [ -n "$url" ]; then
      url=${url%%\?*}                                   # strip query (token etc.)
      case $url in
        ws://*)  url="http://${url#ws://}"   ;;
        wss://*) url="https://${url#wss://}" ;;
      esac
      case $url in
        */ws/agent) endpoint="${url%/ws/agent}/api/status" ;;
        *)          endpoint="$url"                        ;;
      esac
    fi
  fi
  printf '%s' "$endpoint"
}

if [ "$MODE" = "--print-endpoint" ]; then
  resolve_endpoint; echo
  exit 0
fi

# Mirror configs: readable paths from the mirrors file, in file order.
mirror_configs() {
  local file=${TERMAG_STATUS_MIRRORS:-$HOME/.config/termag/status-mirrors} line
  [ -r "$file" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%%#*}
    line=$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    [ -n "$line" ] || continue
    # shellcheck disable=SC2088  # a literal "~/" typed into the mirrors file; expanded to $HOME here
    case $line in "~/"*) line="$HOME/${line#"~/"}" ;; esac
    [ -r "$line" ] && printf '%s\n' "$line"
  done <"$file"
}

# Mirror endpoints that differ from the primary and from each other, one per
# line as "<endpoint>\t<config>", so the posting loop can fetch each token.
mirror_targets() {
  local primary=$1 config endpoint seen=$'\n'
  while IFS= read -r config; do
    endpoint=$(resolve_endpoint "$config")
    [ "$endpoint" != "$primary" ] || continue
    case $seen in *$'\n'"$endpoint"$'\n'*) continue ;; esac
    seen="$seen$endpoint"$'\n'
    printf '%s\t%s\n' "$endpoint" "$config"
  done < <(mirror_configs)
}

if [ "$MODE" = "--print-mirrors" ]; then
  mirror_targets "$(resolve_endpoint)" | cut -f1
  exit 0
fi

if [ "$MODE" = "--print-auth" ]; then
  # Deliberately reports presence only -- printing the token would defeat the
  # care taken to keep it out of argv and logs.
  if [ -n "$(resolve_token)" ]; then echo "token: present"; else echo "token: absent"; fi
  exit 0
fi

# Remove heredoc bodies from a shell command: after a line containing
# <<WORD / <<-WORD / <<'WORD' / <<"WORD", skip lines up to and including the
# terminator (leading whitespace tolerated, as with <<-). Portable awk: the
# regex is built from strings so no \x escapes are needed.
strip_heredocs() {
  awk -v q="'" '
    BEGIN { term = ""; re = "<<-?[[:space:]]*[\"" q "]?[A-Za-z_][A-Za-z0-9_]*[\"" q "]?" }
    term != "" {
      line = $0; sub(/^[[:space:]]+/, "", line)
      if (line == term) term = ""
      next
    }
    {
      if (match($0, re)) {
        t = substr($0, RSTART, RLENGTH); sub(/^<<-?[[:space:]]*/, "", t); gsub(/["\047]/, "", t); term = t
      }
      print
    }'
}

# --- milestone classification -------------------------------------------------
# A PostToolUse payload describes one tool call. The only ones we care about
# are Bash commands that open or merge a PR; the PR URL is in the tool output.
# Prints "<kind> <url>" (url may be "-") or nothing. Only the classification
# and URL ever leave the box -- never the command text itself.
classify_tool() {
  local input=$1 tool cmd out kind url
  tool=$(printf '%s' "$input" | jq -r '.tool_name // empty' 2>/dev/null) || return 0
  [ "$tool" = "Bash" ] || return 0
  cmd=$(printf '%s' "$input" | jq -r '.tool_input.command // empty' 2>/dev/null) || return 0
  [ -n "$cmd" ] || return 0
  # grep's ^ is line-anchored, so a heredoc BODY that merely documents
  # "gh pr create" on its own line (cat <<EOF ... EOF) would match. Drop
  # heredoc bodies first; the line carrying the << operator itself is kept, so
  # `gh pr create --body-file - <<'EOF'` still counts.
  cmd=$(printf '%s\n' "$cmd" | strip_heredocs)
  # Match the gh subcommand as a word at a command boundary, so "echo gh pr create"
  # inside a string does not count but "cd x && gh pr create ..." does.
  # termag-pr-create (bare or by path) is the termag-pr skill's way to open one:
  # it runs gh pr create itself, so the hook never sees that command.
  if printf '%s' "$cmd" | grep -Eq '(^|[;&|(]|\|\||&&)[[:space:]]*(gh[[:space:]]+pr[[:space:]]+create|([^[:space:];&|()]*/)?termag-pr-create)([[:space:]]|$)'; then
    kind=pr_created
  elif printf '%s' "$cmd" | grep -Eq '(^|[;&|(]|\|\||&&)[[:space:]]*gh[[:space:]]+pr[[:space:]]+merge([[:space:]]|$)'; then
    kind=pr_merged
  else
    return 0
  fi
  # tool_response is a string for Bash in some Claude Code versions and an
  # object with .stdout/.stderr in others. What counts as evidence the command
  # SUCCEEDED:
  #   create: the new PR's URL, which gh prints on STDOUT. Only stdout is read
  #           when it is separate: a create that fails because the branch
  #           already has a PR exits non-zero and prints that PR's URL on
  #           stderr, and that is not a PR anybody just opened. (A string
  #           response can't be split; it is read whole.)
  #   merge:  gh's success line, on stderr, "✓ Squashed and merged pull request
  #           owner/repo#N (title)" ("Merged" / "Rebased and merged" for the
  #           other methods). The ref on that line wins: the title in parens
  #           often carries another PR's URL (backports, reverts). A URL
  #           anywhere in the output is only the fallback, as gh prints none.
  # A failed run prints an error and neither, and so do the two merge outcomes
  # that are not a merge: --auto ("Pull request o/r#N will be automatically
  # merged ... when all requirements are met") and "... was already merged".
  # Without evidence there is no milestone -- better to miss a prompt than to
  # announce a PR that doesn't exist.
  out=$(printf '%s' "$input" | jq -r --arg kind "$kind" '
    (.tool_response // "") | if type == "object" then
      (if $kind == "pr_created" then (.stdout // .output // "" | tostring)
       else ([.stdout, .stderr, .output] | map(select(. != null) | tostring) | join("\n")) end)
    else tostring end' 2>/dev/null) || out=
  url=
  if [ "$kind" = pr_merged ]; then
    local ref
    ref=$(printf '%s' "$out" | grep -oE '(^|[^A-Za-z])(Squashed and merged|Rebased and merged|Merged) pull request [A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[0-9]+' | head -n1 \
      | grep -oE '[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[0-9]+$')
    [ -z "$ref" ] || url="https://github.com/${ref%%#*}/pull/${ref##*#}"
  fi
  [ -n "$url" ] || url=$(printf '%s' "$out" | grep -oE 'https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/[0-9]+' | head -n1)
  [ -n "$url" ] || return 0
  printf '%s %s\n' "$kind" "$url"
}

if [ "$MODE" = "--classify" ]; then
  classify_tool "$(cat)"
  exit 0
fi

# --- cloud session token usage --------
# The session's own transcript, summed the way agent/usage-scanner.js sums the
# owner's: one JSONL line per content block repeats the same message.usage, so
# lines are deduped on (requestId, message.id), falling back to message.id and
# uuid. Reads lines raw (-R) and skips one that does not parse (a truncated
# tail). Prints the event body for the order in TERMAG_CLAUDE_RUNNER_ORDER, or
# nothing when there is no order, no readable transcript or no usage at all.
usage_payload() {  # usage_payload <jsonl>...
  local order=${TERMAG_CLAUDE_RUNNER_ORDER:-} f files=()
  [ -n "$order" ] || return 0
  for f in "$@"; do [ -r "$f" ] && files+=("$f"); done
  [ "${#files[@]}" -gt 0 ] || return 0
  jq -n -R -c --arg o "$order" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '
    reduce (inputs | fromjson? // empty) as $e
      ({seen: {}, input: 0, output: 0, cacheRead: 0, cacheCreate: 0, calls: 0, models: {}};
       ($e.message // null) as $m
       | if ($m | type) != "object" or (($m.usage // null) | type) != "object" then .
         else
           (($e.requestId // "") | tostring) as $r | (($m.id // "") | tostring) as $mid
           | (if $r != "" and $mid != "" then $r + "|" + $mid
              elif $mid != "" then "msg|" + $mid
              elif (($e.uuid // "") | tostring) != "" then "uuid|" + ($e.uuid | tostring)
              else null end) as $k
           | if $k != null and .seen[$k] then .
             else (if $k != null then .seen[$k] = true else . end)
               | .input += ($m.usage.input_tokens // 0)
               | .output += ($m.usage.output_tokens // 0)
               | .cacheRead += ($m.usage.cache_read_input_tokens // 0)
               | .cacheCreate += ($m.usage.cache_creation_input_tokens // 0)
               | .calls += 1
               | if (($m.model // "") | tostring) != "" then .models[$m.model | tostring] += 1 else . end
             end
         end)
    | select(.calls > 0)
    | {event: "usage", orderId: $o, input, output, cacheRead, cacheCreate, calls,
       model: ((.models | to_entries | sort_by(-.value) | .[0].key) // null), at: $at}' "${files[@]}" 2>/dev/null
}
# Where a usage post goes: the event route beside the status route, primary only
# (the order exists on the orchestrator that launched the run, not on a mirror).
usage_endpoint() { printf '%s' "${1%/api/status}/api/claude-runner/event"; }

if [ "$MODE" = usage ]; then
  if [ "${#TRANSCRIPTS[@]}" -eq 0 ]; then
    # The hook payload names the transcript (Claude Code's documented hook stdin).
    T=$(jq -r '.transcript_path // empty' 2>/dev/null) || T=
    [ -n "$T" ] && TRANSCRIPTS+=("$T")
  fi
  USAGE_PAYLOAD=$(usage_payload "${TRANSCRIPTS[@]}")
  [ -n "$USAGE_PAYLOAD" ] || exit 0
  if [ -n "$PRINT_PAYLOAD" ]; then printf '%s\n' "$USAGE_PAYLOAD"; exit 0; fi
  ENDPOINT=$(resolve_endpoint)
  post_usage() {  # defined again below for the status modes; here for the bare mode
    local url=$1 body=$2 token=$3
    if [ -n "$token" ]; then
      printf 'header = "Authorization: Bearer %s"\n' "$token" \
        | curl -sf -m 5 -K - -X POST "$url" -H 'Content-Type: application/json' -d "$body" >/dev/null 2>&1
    else
      curl -sf -m 5 -X POST "$url" -H 'Content-Type: application/json' -d "$body" >/dev/null 2>&1
    fi
  }
  post_usage "$(usage_endpoint "$ENDPOINT")" "$USAGE_PAYLOAD" "$(resolve_token)"
  exit 0
fi

# --- which session ------------------------------------------------------------
# The server keys status on the tmux session name; no session means no context.
# Only with $TMUX is there one: without it, display-message answers for the
# box's tmux server anyway, naming its most recently used session, which is
# some other project's (a claude in a t3 terminal, an ask run, the briefing).
#
# Inside the box's t3 server (the desktop app's threads)
# the pane is the server's own `termag-t3`, which no project owns. There the
# session is the one whose checkout holds the thread's project directory.
T3_SESSION=termag-t3

canon_dir() { (cd "$1" 2>/dev/null && pwd -P); }

# t3_session <dir>: the `-agent` session with the longest session_path that is
# <dir> or one of its parents (tmux-create starts every session in its
# checkout), never through a .worktrees/ segment (a workstream's checkout is
# its own session's) and never the home directory itself; else termag-t3.
# A rename moves the checkout and renames the session but leaves its
# session_path behind, so a session_path that is gone gives way to where its
# pane's process is now (the moved directory). Fields are split on the first
# space (session names have none): tmux 3.4, the box image's, prints a tab in
# a format as `_`.
t3_session() {
  local dir home best='' best_len=0 name path p rest
  dir=$(canon_dir "$1") || dir=
  home=$(canon_dir "$HOME") || home=
  if [ -n "$dir" ]; then
    while read -r name path; do
      case $name in *-agent) ;; *) continue ;; esac
      p=$(canon_dir "$path") \
        || p=$(canon_dir "$(tmux display-message -p -t "=$name:" '#{pane_current_path}' 2>/dev/null)") \
        || continue
      case $p in ''|/) continue ;; esac
      [ "$p" != "$home" ] || continue
      case $dir in
        "$p") rest= ;;
        "$p"/*) rest=${dir#"$p"/} ;;
        *) continue ;;
      esac
      case $rest in .worktrees|.worktrees/*) continue ;; esac
      if [ "${#p}" -gt "$best_len" ]; then best=$name; best_len=${#p}; fi
    done < <(tmux list-sessions -F '#{session_name} #{session_path}' 2>/dev/null)
  fi
  printf '%s' "${best:-$T3_SESSION}"
}

SESSION=${TERMAG_STATUS_SESSION:-}
IN_T3=
if [ -z "$SESSION" ]; then
  PANE_SESSION=
  [ -n "${TMUX:-}" ] && PANE_SESSION=$(tmux display-message -p '#S' 2>/dev/null)
  if [ -n "${TERMAG_T3:-}" ] || [ "$PANE_SESSION" = "$T3_SESSION" ]; then
    IN_T3=1
    SESSION=$(t3_session "${CLAUDE_PROJECT_DIR:-.}")
  else
    SESSION=$PANE_SESSION
  fi
fi
[ -n "$SESSION" ] || exit 0

ENDPOINT=$(resolve_endpoint)

# --- build the payload ------------------------------------------------------
MILESTONE_PAYLOAD=
TITLE_PAYLOAD=
TITLE_ENDPOINT=
TITLE_MARKER=
USAGE_PAYLOAD=
# Optional fields are added only when given, so a plain `termag-status working`
# still sends exactly {session,status} -- the payload the Claude hooks have
# always sent, which the server attributes to Claude by the absence of `source`.
extras() {
  jq -nc --arg src "$SOURCE" --arg r "$REASON" --arg m "$MESSAGE" --arg n "$NOTIFY" \
         --arg ct "$CTX_TOKENS" --arg rl "$RATE_LIMITED" '
    {}
    + (if $src != "" then {source:$src} else {} end)
    + (if $r   != "" then {waitingReason:$r} else {} end)
    + (if $m   != "" then {message:($m|.[0:200])} else {} end)
    + (if $n   != "" then {notify:true} else {} end)
    + (if $ct == "null" then {contextTokens:null}
       elif ($ct|test("^[0-9]+$")) then {contextTokens:($ct|tonumber)} else {} end)
    + (if $rl == "null" then {rateLimited:null} elif $rl != "" then {rateLimited:$rl} else {} end)'
}

case $MODE in
  working|idle|not_running|waiting)
    PAYLOAD=$(jq -nc --arg s "$SESSION" --arg st "$MODE" --argjson x "$(extras)" '{session:$s,status:$st} + $x')
    ;;
  meta)
    # Metadata-only update (routes/status.ts: no `status`, but contextTokens
    # and/or rateLimited). Nothing to send is not an error.
    [ -n "$CTX_TOKENS$RATE_LIMITED" ] || exit 0
    PAYLOAD=$(jq -nc --arg s "$SESSION" --argjson x "$(extras)" '{session:$s} + $x')
    # e.g. a non-numeric --context-tokens leaves only {session}: nothing to send.
    [ "$(printf '%s' "$PAYLOAD" | jq 'del(.session, .source) | length')" -gt 0 ] || exit 0
    ;;
  post-tool)
    # Read stdin in the foreground (see `notification` below for why). Always
    # post `working`, as the old PostToolUse line did; additionally post a
    # milestone when the tool call opened or merged a PR.
    INPUT=$(cat)
    PAYLOAD=$(jq -nc --arg s "$SESSION" '{session:$s,status:"working"}')
    CLASS=$(classify_tool "$INPUT")
    if [ -n "$CLASS" ]; then
      KIND=${CLASS%% *}; URL=${CLASS#* }
      MILESTONE_PAYLOAD=$(jq -nc --arg s "$SESSION" --arg k "$KIND" --arg u "$URL" '{session:$s, kind:$k, url:$u}')
    fi
    ;;
  prompt-submit)
    # The UserPromptSubmit payload, read in the foreground (see `notification`).
    # Always `working`, as the old UserPromptSubmit line posted. Inside a Claude
    # Code cloud session on a termag box, the
    # first prompt's first line becomes the session's title: one POST to the
    # event route, once per run (a marker file in the runner's state dir), with
    # the order id the runner wrapper exported. The server cuts the line to
    # 120 characters and keeps the first title it gets. Never a status payload
    # field: prompt text belongs on the run row only.
    INPUT=$(cat)
    PAYLOAD=$(jq -nc --arg s "$SESSION" '{session:$s,status:"working"}')
    if [ -n "${CLAUDE_CODE_REMOTE_SESSION_ID:-}" ] && [ -n "${TERMAG_CLAUDE_RUNNER_ORDER:-}" ]; then
      TITLE_MARKER=${TERMAG_CLAUDE_RUNNER_DIR:-$HOME/.termag/claude-runner}/$TERMAG_CLAUDE_RUNNER_ORDER.titled
      if [ ! -e "$TITLE_MARKER" ]; then
        TITLE_LINE=$(printf '%s' "$INPUT" | jq -r '(.prompt // "") | split("\n") | map(gsub("^\\s+|\\s+$"; "")) | map(select(length > 0)) | .[0] // ""' 2>/dev/null | cut -c1-400)
        # Claim the marker before any network call, atomically (noclobber is
        # O_EXCL): two prompts whose hooks overlap would otherwise both post
        # and the server would keep whichever arrived first. The claim stands
        # whatever the POST answers, so a prompt is never re-sent.
        if [ -n "$TITLE_LINE" ] && mkdir -p "$(dirname "$TITLE_MARKER")" 2>/dev/null && ( set -C; : > "$TITLE_MARKER" ) 2>/dev/null; then
          TITLE_PAYLOAD=$(jq -nc --arg o "$TERMAG_CLAUDE_RUNNER_ORDER" --arg t "$TITLE_LINE" '{event:"title", orderId:$o, title:$t}')
          TITLE_ENDPOINT=${ENDPOINT%/api/status}/api/claude-runner/event
        fi
      fi
    fi
    ;;
  stop)
    # The Stop payload, read in the foreground (see `notification`). Posts
    # `idle`, as the old Stop line did. Inside a Claude Code cloud session on a
    # termag box, also sums the transcript the payload names into the run's
    # cumulative usage (usage_payload): once per turn, newest post wins on the
    # server, so a lost post costs nothing; the runner's post-session hook
    # posts once more at the end.
    INPUT=$(cat)
    PAYLOAD=$(jq -nc --arg s "$SESSION" '{session:$s,status:"idle"}')
    if [ -n "${CLAUDE_CODE_REMOTE_SESSION_ID:-}" ] && [ -n "${TERMAG_CLAUDE_RUNNER_ORDER:-}" ]; then
      T=$(printf '%s' "$INPUT" | jq -r '.transcript_path // empty' 2>/dev/null) || T=
      [ -n "$T" ] && USAGE_PAYLOAD=$(usage_payload "$T")
    fi
    ;;
  notification)
    # Read stdin in the foreground: the caller backgrounds the POST, not this
    # read, or Claude Code can close the pipe before we get the payload.
    INPUT=$(cat)
    if [ -n "${TERMAG_STATUS_DEBUG:-}" ]; then
      mkdir -p "$HOME/.cache/termag-status"
      printf '%s\n' "$INPUT" > "$HOME/.cache/termag-status/last-notification.json"
    fi
    # idle_prompt means the agent finished; anything else means it needs input.
    PAYLOAD=$(printf '%s' "$INPUT" | jq -c --arg s "$SESSION" '
      { session: $s,
        status:  (if (.notification_type // "") == "idle_prompt" then "idle" else "waiting" end),
        notify:  true,
        message: ((.message // "") | .[0:200]) }' 2>/dev/null) || PAYLOAD=
    ;;
  *)
    exit 0
    ;;
esac

[ -n "$PAYLOAD" ] || exit 0

# A desktop thread's post (inside the t3 server): its source and its Claude
# session id, so the server tells the threads of one checkout apart and keeps
# the session working while any of them works (backend services/sessionTurns.ts).
if [ -n "$IN_T3" ]; then
  THREAD=
  [ -n "${INPUT:-}" ] && THREAD=$(printf '%s' "$INPUT" | jq -r '(.session_id // empty) | tostring | select(test("^[A-Za-z0-9._:-]{1,128}$"))' 2>/dev/null)
  PAYLOAD=$(printf '%s' "$PAYLOAD" | jq -c --arg src "${SOURCE:-t3:claude}" --arg t "${THREAD:-}" \
    '. + {source: $src} + (if $t != "" then {threadId: $t} else {} end)') || exit 0
fi

if [ -n "$PRINT_PAYLOAD" ]; then
  printf '%s\n' "$PAYLOAD"
  [ -n "$TITLE_PAYLOAD" ] && printf '%s\n' "$TITLE_PAYLOAD"
  [ -n "$USAGE_PAYLOAD" ] && printf '%s\n' "$USAGE_PAYLOAD"
  exit 0
fi

# Status writes from a remote host require the agent token: the server trusts
# same-host callers (isLocalPeer) but a box reaches :3040 over the private VPC,
# where requireAuthOrAgentToken applies. Without this a provisioned box 401s and,
# because the hooks discard output, fails silently -- the exact failure mode this
# script exists to remove. agent.js sends the same token on the same path.
#
# Passed via `curl -K -` (config on stdin), never as -H on the command line:
# process command lines are world-readable, and this token can write status for
# any of the owner's sessions. agent.js takes the same care (see its comment on
# passing the bearer token via env rather than argv).
# -m 5 so an unreachable server can't leave hook processes hanging around.
post_json() {
  local url=$1 body=$2 token=$3
  if [ -n "$token" ]; then
    printf 'header = "Authorization: Bearer %s"\n' "$token" \
      | curl -sf -m 5 -K - -X POST "$url" \
          -H 'Content-Type: application/json' \
          -d "$body" >/dev/null 2>&1
  else
    # No token in the agent config: only a same-host server will accept this.
    curl -sf -m 5 -X POST "$url" \
      -H 'Content-Type: application/json' \
      -d "$body" >/dev/null 2>&1
  fi
}

post_all() {  # post_all <endpoint> <token>: the status, and the milestone if any
  post_json "$1" "$PAYLOAD" "$2"
  [ -n "$MILESTONE_PAYLOAD" ] && post_json "$1/milestone" "$MILESTONE_PAYLOAD" "$2"
  return 0
}

PRIMARY_TOKEN=$(resolve_token)
post_all "$ENDPOINT" "$PRIMARY_TOKEN"
# The title: once per run (the marker was claimed above); an older server
# (400) simply never gets one. Primary only: it names a claude-runner order,
# which exists on the orchestrator that launched the run, not on a mirror.
[ -n "$TITLE_PAYLOAD" ] && post_json "$TITLE_ENDPOINT" "$TITLE_PAYLOAD" "$PRIMARY_TOKEN"
# The usage, when a cloud session's Stop summed it: primary only, like the title.
[ -n "$USAGE_PAYLOAD" ] && post_json "$(usage_endpoint "$ENDPOINT")" "$USAGE_PAYLOAD" "$PRIMARY_TOKEN"

# Mirrors get the same status/milestone payloads with their own token. The
# primary is posted first and each mirror in the background, so a slow or dead
# mirror (a staging stack that is down) never delays the primary or holds up
# the caller's hook.
while IFS=$'\t' read -r m_endpoint m_config; do
  [ -n "$m_endpoint" ] || continue
  post_all "$m_endpoint" "$(resolve_token "$m_config")" &
done < <(mirror_targets "$ENDPOINT")
wait

exit 0
