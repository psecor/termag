{
  "name": "termag-backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "node dist/scripts/dbPush.js",
    "db:guard": "node dist/scripts/dbGuard.js",
    "push:vapid": "node -e \"const k=require('web-push').generateVAPIDKeys();console.log('VAPID_PUBLIC_KEY='+k.publicKey+'\\\\nVAPID_PRIVATE_KEY='+k.privateKey+'\\\\nVAPID_SUBJECT=mailto:you@example.com')\""
  },
  "dependencies": {
    "@aws-crypto/client-node": "^5.0.2",
    "@aws-sdk/client-ec2": "^3.1056.0",
    "@aws-sdk/client-iam": "^3.1056.0",
    "@aws-sdk/client-kms": "^3.1146.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/client-ssm": "^3.1142.0",
    "@aws-sdk/client-sts": "^3.1152.0",
    "@aws-sdk/credential-providers": "^3.1125.0",
    "@aws-sdk/rds-signer": "^3.1125.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-pg": "^5.22.0",
    "@prisma/client": "^5.10.0",
    "@slack/bolt": "^3.22.0",
    "aws-jwt-verify": "^5.2.1",
    "connect-pg-simple": "^9.0.1",
    "cors": "^2.8.5",
    "croner": "^9.1.0",
    "discord.js": "^14.26.3",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-session": "^1.18.0",
    "graphql": "^16.14.2",
    "jsonwebtoken": "^9.0.2",
    "openid-client": "^5.7.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.23.0",
    "prisma": "^5.22.0",
    "web-push": "^3.6.7",
    "ws": "^8.16.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.0",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.14",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.10",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.11"
  }
}
