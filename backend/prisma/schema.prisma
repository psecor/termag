generator client {
  provider        = "prisma-client-js"
  // driverAdapters lets backend/src/db.ts hand Prisma a node-postgres pool
  // whose password is minted per connection (RDS IAM auth). Without
  // PG_IAM_AUTH the default engine + DATABASE_URL path is used unchanged.
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(cuid())
  googleId             String    @unique
  googleEmail          String    @unique
  unixUsername         String    @unique
  displayName          String
  defaultAgentProvider String    @default("claude")
  // Boxes get Claude Code settings for the termag Bedrock gateway unless the
  // user turns this off; off means per-box Claude login.
  claudeGatewayEnabled Boolean   @default(true)
  dotfilesRepoUrl      String?
  // Per-user theme (background mode and colour), validated and defaulted by
  // src/theme/schema.ts. A fresh row holds {} = all defaults.
  theme                Json      @default("{}")
  slackUserId          String?   @unique
  discordUserId        String?   @unique
  createdAt            DateTime  @default(now())
  // Admin authorization. "member" | "admin". Seeded at startup from the
  // ADMIN_USERS env list (adminSource "env", not demotable from the UI) or
  // granted by another admin (adminSource "grant").
  role                 String    @default("member")
  adminSource          String?
  userSegmentDaily     UserSegmentDaily[]
  // Bumped by requireAuth at most once per 5 minutes; the admin directory's
  // "last seen" column. Null for users who have not signed in since it landed.
  lastSeenAt           DateTime?
  // First-run setup wizard finished or skipped; offered while NULL and the user has no projects.
  onboardedAt          DateTime?
  // Where later visits open: "simple" (termag) or "full" (Lab), under
  // onboarding-refresh-enabled.
  // NULL: not chosen, and each browser keeps its own.
  uiMode               String?
  /// The IANA zone this person's termag clients last reported, so working
  /// time (work_time_entries) is banked by their local day, not the
  /// orchestrator's. NULL until a client reports one: the orchestrator's own.
  timeZone             String?

  projects             Project[]
  agentTokens          AgentToken[]
  sharedWithMe         ProjectShare[]        @relation("sharedWithMe")
  previewAudiencesOwned PreviewAudience[]    @relation("previewAudiencesOwned")
  previewAudienceGrants PreviewAudienceGrantee[]
  previewAudienceViews PreviewAudienceViewer[]
  previewLinkSessions  PreviewLinkSession[]
  previewLinkConfirmations PreviewLinkConfirmation[]
  previewSharesOwned   PreviewShare[]        @relation("previewSharesOwned")
  previewSharesGranted PreviewShare[]        @relation("previewSharesGranted")
  previewShareViews    PreviewShareViewer[]
  sentInvites          ProjectInvite[]       @relation("sentInvites")
  receivedInvites      ProjectInvite[]       @relation("receivedInvites")
  visits               ProjectVisit[]
  warpSamples          WarpSample[]
  tokenUsage           TokenUsageDay[]
  tokenUsageModels     TokenUsageModelDay[]
  instances            Instance[]
  credentials          UserCredential[]
  mcpConnectors        McpConnector[]
  mcpOAuthStates       McpOAuthState[]
  sshPublicKeys        SshPublicKey[]
  cliSessions          CliSession[]
  claudeRunnerSessions ClaudeRunnerSession[]
  claudeSessionEvents  ClaudeSessionEvent[]
  agentThreads         AgentThread[]
  agentMessages        AgentMessage[]
  prDeferrals          PrDeferral[]
  workstreamPrs        WorkstreamPr[]
  prReviewGroups       PrReviewGroup[]
  prReviewRounds       PrReviewRound[]
  prGroupSuggestionDismissals PrGroupSuggestionDismissal[]
  agentSpawns          AgentSpawn[]
  /// The session orphaned spawns go to when no ancestor is alive: { projectId, workstream }.
  spawnOrphanHome      Json?
  agentHandoffs        AgentHandoff[]
  collabRequests       CollabRequest[]
  claudeSessionNotices ClaudeSessionNotice[]
  /// The last "Claude Cloud N" handed to this owner; outlives the run rows' 90-day retention.
  claudeSessionSeq     Int                   @default(0)
  // Daily briefing schedule, validated and defaulted
  // by services/briefing/schedule.ts. {} = off: briefings are opt-in.
  briefingSchedule     Json                  @default("{}")
  briefings            Briefing[]
  briefingDismissals   BriefingDismissal[]
  spaceMemberships     SpaceMember[]
  // Phone web push: with at least one live subscription,
  // skip this owner's Slack/Discord "needs input" posts (Done still posts).
  pushMutesChat        Boolean               @default(false)
  // Simple UI: notify (push, or the open tab) when a chat this user can see
  // finishes its turn. Off until they opt in.
  chatTurnNotify       Boolean               @default(false)
  // Settings > Telemetry: send this person's chat session titles to termag's
  // telemetry as the session.titled product event (docs/agents/observability.md).
  // On until they turn it off.
  telemetryTitles      Boolean               @default(true)
  // Settings > Box notices: the bot's DMs before and after termag stops one
  // of this person's boxes on its own (services/boxIdleNotices.ts). On until
  // they turn it off, here or with the DM's "Stop these messages".
  boxIdleNotify        Boolean               @default(true)
  pushSubscriptions    PushSubscription[]

  @@map("users")
}

// One daily briefing: what the user left open since
// the previous one and what to pick up next. Composed by a one-shot headless
// Claude on one of the user's boxes (services/briefing/runner.ts), which posts
// the result back with the box's agent token. Holds the composed text and the
// ledger's numbers only, never pane or transcript excerpts.
model Briefing {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // manual | schedule | slack
  trigger      String
  // running | done | failed | skipped
  status       String
  // Why a run failed or was skipped, in words the card shows.
  error        String?
  // The window reviewed: since the previous done briefing, capped
  // (services/briefing/window.ts), and the timezone its label is written in.
  since        DateTime
  until        DateTime
  tz           String
  // "Fri 9 Oct 16:00 to Mon 12 Oct 07:00 (2 days 15 hours)".
  windowLabel  String
  // How the window was chosen (BriefingWindow.basis): since_last | first | capped | explicit.
  windowBasis  String    @default("since_last")
  // The box the review ran on; null while skipped (no box ready).
  instanceId   String?
  // "<userId>:<local day>" for scheduled rows, so one per user per day even
  // with two overlapping orchestrator processes; null for manual runs.
  scheduleKey  String?   @unique
  // Also DM the result on Slack (scheduled runs, and "Run again" from Slack).
  deliverSlack Boolean   @default(false)
  slackSentAt  DateTime?
  // BriefingContent (services/briefing/content.ts) once done.
  content      Json?
  // LedgerTotals, for the stats strip.
  stats        Json?
  // BriefingCharts (services/briefing/charts.ts): database-only series for the card.
  charts       Json?
  // LedgerPattern[] the review was given, kept when it reads its ledger, so
  // the result checks Work better on any process (runner.ts rememberLedger).
  patterns     Json?
  inputTokens  Int?
  outputTokens Int?
  model        String?
  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("briefings")
}

// Done or "Defer a day" on a briefing item (services/briefing/dismissals.ts):
// a Work better pattern ("pattern:<id>") or a Left open session ("open:<projectId>:<workstream>").
model BriefingDismissal {
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key    String
  // done | defer
  kind   String
  until  DateTime
  // When the user last pressed it: a done session item comes back once the session does something after this.
  at     DateTime

  @@id([userId, key])
  @@map("briefing_dismissals")
}

// A browser's Web Push subscription (routes/push.ts, services/webPush.ts).
// `endpoint` is a URL the server POSTs to, so it is only stored after the
// push-service allow-list (isAllowedPushEndpoint). A 404/410 from the push
// service deletes the row; any other failure stamps failedAt.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  failedAt   DateTime?

  @@index([userId])
  @@map("push_subscriptions")
}

// Laptop SSH public keys, installed in the termag-managed block of every
// owned EC2 box's ~/.ssh/authorized_keys (services/sshKeySync.ts).
model SshPublicKey {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicKey   String // canonical `type base64 [comment]` line
  fingerprint String // SHA256:...
  createdAt   DateTime @default(now())

  @@unique([userId, fingerprint])
  @@map("ssh_public_keys")
}

// A `termag` CLI signed in on one device (routes/cliApi.ts). Kept apart from
// AgentToken so /ws/agent, which only looks there, can never accept one.
// Valid while used within 7 days and younger than 30 (services/cliAuth.ts).
model CliSession {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName  String
  tokenHash   String    @unique // SHA-256 of the raw token
  tokenPrefix String // display only, e.g. "tmcli_a1b2c3d…"
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())
  revokedAt   DateTime?
  /// The box this sign-in was made on: the CLI sends the box's own credential
  /// with the code exchange (routes/cliApi.ts POST /token). Null: not on a box,
  /// which every sign-in made before the column reads as. A box-issued token is
  /// one every process on that box can read, so what it may do is narrower
  /// (routes/cliPreviewLinks.ts: wider preview audiences need a browser confirm).
  issuedOnBoxId String?

  @@index([userId])
  @@map("cli_sessions")
}

// One row per Claude Code cloud session the spawn route started on a box
// (routes/claudeRunner.ts).
// `orderId` is Anthropic's per-spawn idempotency key. The row is written as the
// runner is launched and completed by the box's end-of-session report
// (routes/claudeRunnerEvents.ts), so who ran what for how long is a query over
// this table as well as over the journal lines.
model ClaudeRunnerSession {
  id                String    @id @default(cuid())
  orderId           String    @unique
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  instanceId        String
  instance          Instance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  // DEV_INSTANCE of the session on the box (2..), see services/claudeRunnerSpawn.ts.
  slot              Int
  startedAt         DateTime  @default(now())
  // Null while the session runs, or forever when the box never reported the
  // end (an abrupt kill, or a box whose runner script predates the report).
  endedAt           DateTime?
  // The runner script's exit status as the box reported it.
  exitStatus        Int?
  // Why the slot was given back, when the box could tell; a short lowercase
  // token such as the runner's post-session reason. Null otherwise.
  exitReason        String?
  // The Anthropic session (cse_...) this run serves.
  // One session has several runs, each its own order: a re-offer after a
  // refusal, a resume after the idle release. Null on rows from before the column.
  sessionId         String?
  // The surface that created the session (web_claude_ai, desktop_app, ios, ...),
  // reported by the runner's command hook with the `started` event.
  clientPlatform    String?
  // The first line of the session's first prompt, set once by the `title`
  // event and copied to a new run of the same session; never in the event
  // log. Owner-only: the admin view leaves it out. The owner may rename it
  // from the UI (routes/claudeSessions.ts), which sets it on every run.
  title             String?
  // The session's ordinal among the owner's sessions, the "3" in "Claude
  // Cloud 3": assigned when the session's first run is recorded, the same
  // on every run of the session. Null on rows without a session id, and on
  // rows from before this column until the startup backfill numbers them.
  sessionSeq        Int?
  // Token usage posted from inside the session: cumulative over the run, from its own transcript on every Stop hook and
  // once more from the post-session hook; the newest post wins (usageAt). Null
  // until the first post. Read as provider `claude-cloud` by every token report
  // (services/admin/tokenSource.ts); the usage scanner never sees these sessions.
  inputTokens       BigInt?
  outputTokens      BigInt?
  cacheReadTokens   BigInt?
  cacheCreateTokens BigInt?
  usageCalls        Int?
  model             String?
  usageAt           DateTime?
  // From the wrapper's `ended` report (S5): the session directory's size as the
  // post-session hook measured it, and whether the checkout was kept under
  // ~/ccr/kept because GitHub did not have all of its work.
  checkoutBytes     BigInt?
  kept              Boolean?

  @@index([userId, startedAt])
  @@index([instanceId, endedAt])
  @@index([sessionId, startedAt])
  @@index([userId, sessionSeq])
  @@map("claude_runner_sessions")
}

// What happened to a Claude Code cloud session, one row per signal
//: every spawn
// outcome, refusals included (`queued` carries the reason the Activity tab
// shows), the box's `started` and `ended`, the reconciler's `lost`, and an end
// requested from the UI. Keyed by the Anthropic session id so the runs of one
// session group together; `orderId` has no foreign key because a refused order
// never gets a run row. `detail` never holds an email, a token or prompt text.
// Swept after 30 days (services/claudeSessions.ts).
model ClaudeSessionEvent {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId  String
  orderId    String
  // Null for a refusal that never reached a box.
  instanceId String?
  instance   Instance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  kind       String
  detail     String?
  // For `queued` and `agent-failed`: the refusal's stable code (REFUSAL_CODES
  // in services/claudeRunnerSpawn.ts). Null on rows from before it, and on
  // every other kind.
  code       String?
  at         DateTime  @default(now())

  @@index([sessionId, at])
  @@index([userId, at])
  @@index([orderId])
  @@map("claude_session_events")
}

// one row per owner notice (a Slack DM about a cloud session), the
// dedupe record for services/claudeRunnerNotices.ts. A table, not an event
// kind, so the session's event log and the admin report never see them.
// Swept after NOTICE_RETENTION_DAYS by the cloud session retention sweep.
model ClaudeSessionNotice {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String
  // The refusal code the notice was about, or `github-absent`.
  code      String
  at        DateTime @default(now())

  @@index([userId, code, at])
  @@map("claude_session_notices")
}

model AgentToken {
  id          String    @id @default(cuid())
  name        String // e.g. "macbook", "dev-server", or instance name
  tokenHash   String    @unique // SHA-256 hash of the token
  tokenPrefix String // first 8 chars for display (e.g. "tmag_a1b2...")
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  // What the token may do. "agent" (default, every pre-existing row) may open
  // /ws/agent and call the agent-facing REST routes. "admin" is minted from the
  // admin UI, accepted by requireAdmin while its owner still has role=admin,
  // and rejected on /ws/agent so it can never evict a real agent. Laptop
  // clients (the CLI and its TUI) use cli_sessions, not this table.
  scope       String    @default("agent")
  // Null = never expires (agent tokens). Admin tokens default to 90 days.
  expiresAt   DateTime?

  // Null until the box is claimed: a pool box's token authenticates the box,
  // not a person.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // When the token was minted for a specific Instance (e.g. an AWS box
  // boxProvisioner launched), this links to it. Null for legacy per-user
  // tokens (legacy per-user agents) where the agent picks the host.
  instanceId String?
  instance   Instance? @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([instanceId])
  @@map("agent_tokens")
}

model Project {
  id             String   @id @default(cuid())
  name           String
  description    String?
  color          String? // hex color for UI differentiation
  slackChannelId String? // Slack channel ID for the main workstream (#proj-<user>-<name>; legacy #proj-<name>)
  archived       Boolean  @default(false)
  pinned         Boolean  @default(false)
  // "normal" for ordinary projects; "metaterm" marks the per-user singleton
  // control-tower project (pinned, lives on the orchestrator, refuses
  // rename/archive/share/branch-off); "automation" is a project whose runs a
  // schedule starts. String-not-enum, like Instance.kind;
  // what each kind may do is services/projectKind.ts.
  // One MetaTerm per user is enforced by a partial unique index in the
  // 20260916000000_project_kind migration (NULL instanceId defeats @@unique).
  kind           String   @default("normal")
  /// What the project was made for, when its creator said: 'ask' from
  /// `termag ask --new-box` (or the deprecated `--for-ask`); null otherwise.
  /// Only a hint: the simple UI folds away a main that has never been used
  /// in any project with ask threads, recorded or not.
  createdFor     String?
  /// The environment the project's checkouts came
  /// from, when one did; no foreign key, so it outlives the environment, as
  /// environment_events does. Anyone signed in can set a shared environment's
  /// repositories, so an ask of such a project is capped below
  /// bypassPermissions (services/askService.ts askModeFor): its checkout's
  /// settings, hooks and MCP servers never load.
  environmentId  String?
  lastActiveAt   DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The box this project lives on. Nullable so existing projects (which
  // live on the user's legacy agent) work unchanged. New projects
  // created via the box-CRUD UI will set this at create time.
  instanceId String?
  instance   Instance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)

  repoUrl           String?
  repoDefaultBranch String?
  // none | pending | cloning | ready | failed (services/projectSetup.ts). Only
  // none and ready allow tmux sessions (services/sessionGate.ts).
  setupStatus       String  @default("none")
  setupError        String?
  // Bumped by Retry; the clone RPC carries it and the box echoes it, so a
  // report from an earlier attempt is recognised as stale.
  setupAttempt      Int     @default(0)
  // The browser session recording (its id) the browser created this
  // project from, kept for the agent launch the box's clone defers
  // (services/projectClone.ts), which types it into the launch so the
  // session's Claude Code spans are filed under that replay
  // (services/launchCommand.ts); cleared by that launch.
  launchReplaySessionId String?
  // The owner trusted this repository for the simple UI's chat: its Claude
  // runs tools without asking (services/chatTrust.ts). Null for a repo
  // outside the trusted GitHub owners that nobody has trusted yet.
  chatTrustedAt DateTime?
  // Retired: a chat's model is its workstream's Workflow.model now. The
  // startup move (services/chatModelMove.ts) copies a value left here onto the
  // chat rows and clears it; nothing else reads or writes it. Dropped once no
  // deploy reads it.
  claudeModel           String?
  // New session's "Act as an orchestrator": every chat turn is told to use the
  // opt-in agent-orchestrator skill (agent/chat-runner.js ORCHESTRATOR_SYSTEM_PROMPT).
  chatOrchestrator      Boolean  @default(false)
  // "repo" (one repository, or none, at the project dir) or "workspace" (the
  // project dir is a plain directory holding one checkout per ProjectRepo).
  // Set at creation, never changes. String, not
  // enum, like kind. A workspace project's repoUrl is null and its setupStatus
  // is the aggregate over its repositories (services/projectRepos.ts).
  layout                String   @default("repo")
  // The environment file this project was made from:
  // { name, repo, path }, the environment's own; null for a project from a
  // repository, whose implicit file is its `.termag/environment.json`. Read by
  // services/projectEnvironment.ts when the box runs the file's steps.
  environmentFile       Json?
  // The box's last report of those steps (agent/environment-run.js): setup's
  // time, the run, each port's health, the secret names and warnings. Null
  // until a box has run them.
  environmentStatus     Json?
  // Where a repo project's checkout really is when it isn't its project
  // directory: the static layout's ~/code/<repo> (or its `path`), on a box made
  // from an environment.
  // The project directory, ~/termag/projects/<name>, is then a link to it, so
  // everything that derives the directory from the name still reaches it.
  // Set from the box's answer to its clone (services/staticLayout.ts); null
  // for every other project, a workspace's included (each of its
  // repositories is linked under its root instead).
  dir                   String?

  workflows      Workflow[]
  workstreams    Workstream[]
  chatTranscripts ChatTranscript[]
  chatResumes     ChatResume[]
  chatHeldMessages ChatHeldMessage[]
  chatContinueLock ChatContinueLock?
  spaceListings   ProjectSpace[]
  repos          ProjectRepo[]
  // The schedule and prompt of an automation project (kind "automation").
  automation     Automation?
  browserTabs    BrowserTab[]
  shares         ProjectShare[]
  invites        ProjectInvite[]
  previewAudiences PreviewAudience[]
  previewLinkConfirmations PreviewLinkConfirmation[]
  previewLinkRequests PreviewLinkRequest[]
  previewShares  PreviewShare[]
  previewShareSettings PreviewShareSettings?
  visits         ProjectVisit[]
  contextSamples ContextSample[]
  tokenUsage     TokenUsageDay[]
  tokenUsageModels TokenUsageModelDay[]
  agentThreads   AgentThread[]
  chatActiveTargets ChatActiveTarget[]

  // Name is unique per (user, box). Two boxes can have a project named "termag"
  // without collision. Legacy projects (instanceId NULL) treat NULL as distinct
  // per Postgres semantics; the app enforces single legacy "termag" anyway.
  @@unique([userId, instanceId, name])
  @@index([userId, archived])
  @@index([instanceId])
  @@map("projects")
}

// Per-minute samples of a project/workstream's Claude context-window occupancy
// (the badge gauge), persisted for the "context usage over time" reporting.
// Mirrors WarpSample: an in-memory sampler (services/contextSampler.ts) buckets
// contextTokens reports per minute and upserts one row per (project, workstream,
// minute). meanTokens/maxTokens summarize the minute.
// Daily token totals per (user, host, provider, raw source bucket). Written by
// services/tokenUsageSampler.ts from the agents' `usage-scan` responses (one
// row per Claude log directory / Codex cwd / etc.) as ABSOLUTE day totals from
// an authoritative rescan — so the upsert is idempotent. projectId/workstream
// are resolved server-side from cwdHint/sourceKey against projectDir(); null =
// unattributed, kept so user totals stay right. Uniqueness is on the RAW bucket
// (not the resolved project) so rows can be re-resolved later.
model TokenUsageDay {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hostKey     String // Instance.id for a box agent, "legacy" for the per-user agent, "poller" for tmux-poller estimates
  provider    String // claude | codex | mistral | cursor | ...
  date        String // YYYY-MM-DD. UTC for claude/codex; vibe = local day at session start; poller = server-local
  sourceKey   String // claude: encoded log dir; codex: cwd hint or ""; vibe / schema-1 agents: ""
  cwdHint     String?
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  workstream  String?
  input       BigInt   @default(0)
  output      BigInt   @default(0)
  cacheRead   BigInt   @default(0)
  cacheCreate BigInt   @default(0)
  reasoning   BigInt   @default(0) // pi only; tagged separately, folded into output at reporting
  calls       Int      @default(0)
  estimated   Boolean  @default(false) // poller rows (context-% × window guess), not real counts
  agentSchema Int      @default(1) // 1 = schema-1 agent (unattributable), 2 = per-directory buckets
  scannedAt   DateTime
  updatedAt   DateTime @updatedAt

  @@unique([userId, hostKey, provider, date, sourceKey])
  @@index([userId, date])
  @@index([projectId, date])
  @@map("token_usage_days")
}

// The same scanned tokens as token_usage_days, split by the model (and, for pi,
// the provider it names, e.g. fireworks) the agent's logs record. One
// day row's model rows sum to it. A day row with none (an agent from before the
// split, or vibe) reads as model '' in the admin report (admin/tokenSource.ts).
model TokenUsageModelDay {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hostKey     String
  provider    String
  date        String
  sourceKey   String
  /// As the log names it ("claude-opus-5-5", "us.anthropic.claude-opus-5-5", "accounts/fireworks/models/kimi-k3"); '' when it names none.
  model       String
  /// pi's message provider (fireworks, say); '' for harnesses whose logs don't say.
  backend     String   @default("")
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  workstream  String?
  input       BigInt   @default(0)
  output      BigInt   @default(0)
  cacheRead   BigInt   @default(0)
  cacheCreate BigInt   @default(0)
  reasoning   BigInt   @default(0)
  calls       Int      @default(0)
  scannedAt   DateTime
  updatedAt   DateTime @updatedAt

  @@unique([userId, hostKey, provider, date, sourceKey, backend, model])
  @@index([date])
  @@map("token_usage_model_days")
}

model ContextSample {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workstream  String // workstream name ("main", etc.)
  bucket      DateTime // truncated to the minute (UTC)
  meanTokens  Int
  maxTokens   Int
  sampleCount Int

  @@unique([projectId, workstream, bucket])
  @@index([projectId, bucket])
  @@map("context_samples")
}

// A workstream is a parallel effort inside a project — typically a git worktree
// on a different branch. Every project has at least one (named "main"). The UI
// collapses single-workstream projects so the user doesn't see a "main" level
// they didn't ask for. Workflows (tmux session pairs, etc.) attach to the
// workstream, not the project, so multi-branch parallel work is straightforward.
model Workstream {
  id             String         @id @default(cuid())
  projectId      String
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String // "main" by default
  branch         String // git branch this worktree targets
  slackChannelId String? // Slack channel ID (#proj-<user>-<project>-<workstream>); main uses Project.slackChannelId
  archived       Boolean        @default(false)
  /// Claude's own title for the session the workstream's chat runs (a /rename,
  /// else the one Claude generated), from the chat runner's turn-end; what the
  /// simple UI's sidebar leads with.
  sessionTitle   String?
  /// When sessionTitle last changed, so the desktop app and termag web keep
  /// the newer of their two titles for a chat (GET /api/cli/v1/chats titleAt).
  sessionTitleAt DateTime?
  /// Who set sessionTitle: `person` (a rename in termag web or the desktop
  /// app) or `claude` (Claude's title at a turn end). Claude's titles never
  /// replace a person's. Null before the first title.
  sessionTitleSource String?
  /// The space this chat belongs to, fixed when it starts:
  /// the space New session started it in, else its box's first
  /// granted space when the server first lists it or sends it a message
  /// (services/chatSpace.ts). Its sidebar group, header chip and memory are
  /// this space's; a later grant never moves it.
  spaceId        String?
  space          Space?         @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  /// When the space was decided. Set with no spaceId, the chat is under "No space" for good.
  spaceFixedAt   DateTime?
  /// Which runtime drives this chat's Claude session, the single writer:
  /// `runner` (termag's chat runner: web, Slack, held messages, ask notices,
  /// automations) or `t3` (the desktop app's thread, t3ThreadId). Null is the
  /// runner, as before anything claimed it. A send from the other side takes
  /// it over once the holder is idle.
  chatHolder     String?
  /// When chatHolder last changed hands.
  chatHolderAt   DateTime?
  /// The desktop app's T3 thread for this session: the one a desktop-made
  /// session started with, or the one that last claimed it. One per workstream.
  t3ThreadId     String?
  /// The Claude session id this chat resumes, as termag last heard it (a
  /// runner turn, or a desktop thread's hook post); null before its first turn.
  chatSessionId  String?
  /// When its owner archived it from a space's Files (chat-nested-agents-enabled):
  /// Files lists it, and the
  /// agents under it, in its Archived fold instead. Only a list's: the session,
  /// its box and its asks carry on, and one that is working shows anyway. Null:
  /// listed as usual.
  explorerArchivedAt DateTime?
  lastActiveAt   DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  workflows      Workflow[]
  prs            WorkstreamPr[]
  /// The automation run this workstream is; null for every other workstream.
  automationRun  AutomationRun?
  /// The ask thread whose chat this workstream is.
  askThread      AgentThread?   @relation("AskChat")
  previewAudiences PreviewAudience[]
  previewShares  PreviewShare[]
  chatTranscripts ChatTranscript[]
  chatResumes     ChatResume[]
  chatHeldMessages ChatHeldMessage[]
  chatNotices     ChatNotice[]

  @@unique([projectId, name])
  @@index([projectId])
  @@index([spaceId])
  @@map("workstreams")
}

// One repository of a workspace project (Project.layout = "workspace"): its
// main checkout is <project dir>/<name>. setupStatus moves like
// Project.setupStatus does for a repo project, per repository.
model ProjectRepo {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  url           String
  defaultBranch String?
  // pending | cloning | ready | failed
  setupStatus   String   @default("pending")
  setupError    String?
  setupAttempt  Int      @default(0)
  position      Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([projectId, name])
  @@index([projectId])
  @@map("project_repos")
}

model Workflow {
  id        String       @id @default(cuid())
  type      WorkflowType
  provider  String?
  // The model backend an agent workflow's harness runs on:
  // a backend id from the provider's `backends` in providers/registry.ts, such
  // as "fireworks". Null is the harness's own default (Claude Code's settings,
  // pi's own model configuration). Nullable so an overlapping deploy's old process
  // can ignore the column.
  backend   String?
  // The model the agent starts on (`--model`): one of services/modelChoices.ts
  // for this provider and backend. Null is the backend's default.
  model     String?
  server    String       @default("localhost") // future: ssh to other servers
  createdAt DateTime     @default(now())

  // projectId is kept during phase 1 for backward compat — phase 2 drops it
  // and routes everything through workstream → project.
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // The workstream this workflow belongs to. During phase 1 every project has
  // exactly one workstream named "main", so projectId and workstreamId carry
  // redundant information.
  workstreamId String
  workstream   Workstream @relation(fields: [workstreamId], references: [id], onDelete: Cascade)

  // (projectId, type) was the legacy phase-1 uniqueness — dropped so a
  // project can carry one agent workflow per workstream.
  @@unique([workstreamId, type])
  @@index([workstreamId])
  @@map("workflows")
}

enum WorkflowType {
  agent
  data
}

// AgentProvider is now a plain String validated at the application layer
// via PROVIDER_IDS from backend/src/providers/registry.ts.
// This avoids a DB migration every time a new provider is added.

model BrowserTab {
  id       String   @id @default(cuid())
  url      String
  title    String
  favIcon  String?
  windowId Int? // Chrome window ID from CDP snapshot
  addedAt  DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("browser_tabs")
}

// Notification targets — which channels to notify when a tmux session needs input.
// One entry per session+platform+instance. instanceId "" is the orchestrator and
// any row written before instance identity existed.
model NotificationTarget {
  tmuxSession String
  platform    String
  instanceId  String   @default("")
  channel     String
  userId      String
  updatedAt   DateTime @default(now()) @updatedAt

  @@id([tmuxSession, platform, instanceId])
  @@map("notification_targets")
}

// What a chat user's `/t` drives outside a project channel (`/t switch`,
// `/t attach`, the Slack Home tab's Attach): write-through copy of the map in
// backend/src/slack/activeTargets.ts, so a deploy keeps it. chatUserId is the
// Slack or Discord user id, not a termag user: the bot's operators may have none.
model ChatActiveTarget {
  platform   String
  chatUserId String
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workstream String   @default("main")
  updatedAt  DateTime @default(now()) @updatedAt

  @@id([platform, chatUserId])
  @@index([projectId])
  @@map("chat_active_targets")
}

// A Slack agent session's thread (slack/agentSession.ts, agentStore.ts): which
// Claude session a reply there resumes and, in a channel, whose conversation it
// is. Owner and session share a row so a restart brings them back together.
// resetAt is set by "new session"/"reset"/"clear", which forgets the session.
// runHolder/runBeatAt: the process running a turn in the thread right now, so
// a second process (a lease handover) never runs claude on the same session.
model SlackAgentThread {
  channelId       String
  threadTs        String
  ownerSlackId    String?
  claudeSessionId String?
  workingDir      String?
  resetAt         DateTime?
  runHolder       String?
  runBeatAt       DateTime?
  // What the thread is bound to (slack/session/scope.ts):
  // personal | space | router; every thread before space channels is personal.
  scope           String    @default("personal")
  spaceId         String?
  routeSeq        Int       @default(0)
  // Set on a thread that was in a channel when it was linked or unlinked: no more turns.
  frozenAt        DateTime?
  // For space turns' least privilege (tech spec §5.7, M10): set once the session
  // loaded content not authored by the runner, sticky until a fresh session.
  mixedAt         DateTime?
  mixedReasons    Json?
  memoryVersions  Json?
  updatedAt       DateTime  @default(now()) @updatedAt

  @@id([channelId, threadTs])
  @@index([updatedAt])
  @@map("slack_agent_threads")
}

// The newest Claude session in each Slack DM, which a new thread there picks up
// for half an hour (claudeSessionFor's carry-over).
model SlackAgentDmLast {
  channelId       String   @id
  claudeSessionId String
  workingDir      String
  at              DateTime
  // The space binding of the thread the session ran in: carry-over stays within one binding.
  spaceId         String?

  @@map("slack_agent_dm_last")
}

// Working time accumulated from status transitions (working → idle/waiting)
model WorkTimeEntry {
  id         String   @id @default(cuid())
  username   String
  project    String
  provider   String
  date       String // YYYY-MM-DD
  totalMs    Int      @default(0)
  sessions   Int      @default(0)
  // "" is the orchestrator and rows written before instance identity existed.
  instanceId String   @default("")
  updatedAt  DateTime @updatedAt

  @@unique([username, project, provider, date, instanceId])
  @@index([username, date])
  @@map("work_time_entries")
}

// Write-through copy of the in-memory live status (services/status.ts), so a
// backend restart or host replacement re-reads it instead of showing every
// pill as not_running. Written on transitions and meta changes only; rows
// untouched for 24 h are ignored and pruned at startup (statusPersistence.ts).
model SessionStatus {
  // Instance.id, or "" for the orchestrator: Postgres treats NULLs as distinct
  // in a primary key. Same convention as WorkTimeEntry.instanceId.
  instanceKey      String
  session          String
  status           String
  updatedAt        DateTime
  // Open "working" span: the first transition out of working after a restart
  // banks from here, so the span survives the restart.
  workingStartedAt DateTime?
  provider         String?
  source           String?
  message          String?
  waitingReason    String?
  threadId         String?
  contextTokens    Int?
  rateLimited      String?
  // SessionMilestone: { kind, url, at (ISO), contextTokens }
  milestone        Json?
  // When the session last came to rest (working/waiting → idle/not_running);
  // the sidebar's "stopped since you looked" marker reads it.
  stoppedAt        DateTime?

  @@id([instanceKey, session])
  @@index([updatedAt])
  @@map("session_statuses")
}

// Project sharing — grants another user access to a project's tmux sessions
model ProjectShare {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String // the collaborator (invitee)
  user      User     @relation("sharedWithMe", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_shares")
}

// Pending invitations to share a project
model ProjectInvite {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inviterId String
  inviter   User     @relation("sentInvites", fields: [inviterId], references: [id])
  inviteeId String
  invitee   User     @relation("receivedInvites", fields: [inviteeId], references: [id])
  status    String   @default("pending") // pending | accepted | declined
  createdAt DateTime @default(now())

  @@unique([projectId, inviteeId])
  @@map("project_invites")
}

// Append-only log of project context switches.
// One row per setActiveProject() call where the project actually changed.
// Powers switches/day, mean dwell, stdev between switches stats.
model ProjectVisit {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId         String?
  project           Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  previousProjectId String?
  timestamp         DateTime @default(now())
  sessionTag        String? // per-browser-tab UUID
  // Workstream the visit landed on; null for rows older than the column
  // (read as "main"). A same-project row with a different workstream is a
  // workstream switch, which the "switches" stats deliberately ignore.
  workstream        String?

  @@index([userId, timestamp])
  @@index([projectId, timestamp])
  @@map("project_visits")
}

// Per-minute rollup of the hyperspace targetWarp value (the synthesized
// activity score). Frontend posts raw samples every 5s; backend aggregates
// into per-minute buckets in-memory and flushes here.
model WarpSample {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bucket      DateTime // truncated to minute (UTC)
  meanWarp    Float
  maxWarp     Float
  p95Warp     Float
  sampleCount Int
  activeMs    Int // ms in this bucket where warp > idle threshold

  @@unique([userId, bucket])
  @@index([userId, bucket])
  @@map("warp_samples")
}

// A per-user compute box (typically an EC2 instance that boxProvisioner
// launches with the AWS SDK). Hosts the user's tmux sessions and runs the
// termag agent. Replaces the legacy 1-agent-per-user model with
// N-agents-per-user, keyed by instance.
//
// Non-EC2 hosts (the user's Mac, the orchestrator's own host) can be
// represented here too with ec2InstanceId = null, but the V1 box-CRUD
// only creates AWS-backed rows.
model Instance {
  id String @id @default(cuid())

  // Null means an unclaimed pool box, which belongs to nobody until it is
  // claimed. `status` is the discriminator: "warming" and "warm" rows (the warm
  // pool) and the env-* rows (an environment pool)
  // have no owner, every other status has one.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String // user-supplied, e.g. "peter-laptop", "peter-heavy"

  // How this box is managed:
  //   ec2       — orchestrator-provisioned EC2 box (boxProvisioner owns its
  //               AWS lifecycle: SG, IAM, RunInstances, TerminateInstances).
  //   external  — self-managed / BYO host (the user's own laptop, devbox, or
  //               any machine). The orchestrator never touches AWS for these;
  //               it just mints an instance-bound token the user drops into
  //               their agent.config.json. Lets one user run several distinct
  //               machines at once, each keyed by instanceId in agentRegistry
  //               (a plain per-user token can only hold one slot at a time).
  kind String @default("ec2")

  // Which published AMI a managed EC2 box launches from:
  //   full     — the standard bake (tag Component=box): toolchains, agent
  //              CLIs, the dev stack and Docker pre-installed. This is also
  //              what a user's `box-image` flag chooses among (service,
  //              channel, pin).
  //   minimal  — the lean bake (tag Component=box-min): only what the box
  //              contract needs (the placeholder unix user, nvm node, the
  //              agent checkout, termag-agent.service). The owner bootstraps
  //              the rest (CLI: `termag box create <name> --minimal`); the
  //              root volume floors at BOX_MINIMAL_ROOT_VOLUME_GB. Per box —
  //              the box-image flag is per-user and must not override it.
  // External boxes never launch from an AMI and always read 'full'.
  flavor String @default("full")

  // AWS coordinates. All nullable so the model can describe non-EC2 boxes
  // (e.g. kind="external", where every AWS field stays null).
  // securityGroupId / iamRoleName are the per-box resources boxProvisioner
  // creates via the SDK; terminateBox uses them to tear everything down.
  ec2InstanceId String? @unique
  region        String?
  hostname      String? // private DNS or private IP; mostly diagnostic

  // Reported by the agent in its `hello` frame on connect: the unix user it
  // runs as and that user's home directory. Both stay null for an agent old
  // enough not to send `hello`, so every reader must fall back.
  hostUnixUser      String?
  hostHome          String?
  // Host pressure from the agent (hello and the host-sample RPC): disk used under the home filesystem,
  // memory used, the one-minute load, and the Claude runner checkouts kept
  // under ~/ccr/kept. Null until an agent that samples has connected.
  diskUsedPct       Int?
  memUsedPct        Int?
  load1             Float?
  keptCheckouts     Int?
  hostSampledAt     DateTime?
  // The last run of termag-box-update on the box, as the box reported it
  // (POST /api/box-update/report; services/boxUpdateReport.ts): when, the one
  // outcome word (updated, deferred, failed, skipped, current), the step
  // tokens behind it, and the commit the checkout ended on. Null until a box
  // whose script reports has run.
  lastUpdateAt      DateTime?
  lastUpdateOutcome String?
  lastUpdateDetail  String?
  lastUpdateCommit  String?
  // Open SSH and SSM sessions in the agent's latest host sample (written with
  // hostSampledAt; null from an agent that doesn't count them). The lifecycle
  // sweep's `ssh` busy check reads it: editors on Remote-SSH and port forwards
  // never reach the orchestrator.
  sshSessions       Int?
  // Open port-forward tunnels (`tunnels.port`, not the desktop's t3 relay) in
  // the agent's latest host sample, written like sshSessions: the `tunnels`
  // busy check keeps a box with an open forward from auto-parking, up to the
  // soft cap.
  openTunnels       Int?
  // When the orchestrator last asked the box to run termag-box-update
  // (services/boxUpdate.ts). Until the box reports that run (lastUpdateAt),
  // for at most 20 minutes, the lifecycle sweep leaves the box up.
  updatePushedAt    DateTime?

  securityGroupId       String? // per-box egress-only SG (also gets an ALB ingress rule)
  iamRoleName            String? // per-box role (== instance-profile name)
  // The instance profile, recorded once it exists. The role is created first,
  // so iamRoleName alone cannot tell teardown whether the profile came after.
  iamInstanceProfileName String?

  // Logical status — set by the backend's box-CRUD path. The EC2 instance
  // has its own state ("running", "stopped", etc.) that we query on demand
  // rather than caching here.
  //   provisioning   — SDK launching, EC2 booting, agent not yet seen (ec2)
  //   awaiting-agent — external box created, waiting for its self-run agent
  //                    to dial in (external; no AWS work happens)
  //   warming        — ownerless pool box booting and running its on-warm steps
  //   warm           — ownerless pool box, agent connected and on-warm
  //                    succeeded; claimable
  //   ready          — agent has connected at least once
  //   stopping       — owner asked EC2 to stop the box; the power sweep
  //                    settles it to stopped from the EC2 state (ec2)
  //   stopped        — EC2 instance stopped; only its EBS volumes cost (ec2)
  //   starting       — owner asked EC2 to start or resume it; the agent's
  //                    connect makes it ready again (ec2)
  //   hibernating    — owner asked EC2 to hibernate the box; the power sweep
  //                    settles it to hibernated (ec2, hibernationConfigured)
  //   hibernated     — EC2 instance stopped with its RAM saved to the root
  //                    volume; a start resumes it rather than booting it.
  //                    Never replaced on start, unlike stopped (ec2)
  //   failed         — provisioning errored (see provisioningError) or the box
  //                    never dialed in within the stuck-provisioning window
  //   quarantined    — an admin cut the box off for forensics
  //                    (services/boxQuarantine.ts): tokens revoked, AWS access
  //                    denied, network closed, volumes snapshotted, instance
  //                    stopped. Nothing starts or terminates it but an admin's
  //                    terminate, so the volumes stay as they were found.
  //   terminated     — instance gone (kept for history; cleanup is a sweep)
  // An environment pool's ownerless boxes ("Pool
  // states"; poolEnvironmentId names the environment):
  //   env-preparing  — launched (or started for a refresh): cloning, then
  //                    `setup`. The only status the GitHub broker answers with
  //                    the pool credential, and only for fetches of the
  //                    environment's repositories (services/githubAuthz.ts)
  //   env-stopping   — `setup` succeeded; StopInstances sent
  //   env-stopped    — stopped, prepared, claimable
  //   env-starting   — taken by a claim; StartInstances sent, waiting for the agent
  //   env-failed     — the clone or `setup` failed; kept for its log, then terminated
  status            String    @default("provisioning")
  provisioningError String? // populated when status flips to failed
  createdAt         DateTime  @default(now())
  terminatedAt      DateTime?

  // Teardown of a terminated ec2 box's AWS resources (terminateBox). The route
  // and pool retirement mark the row `terminated` first and tear down in the
  // background, so a restart can cut a teardown short; cleanedUpAt stays null
  // until every step has succeeded or found its resource already gone, and the
  // provisioning sweep re-runs teardown for terminated rows still missing it.
  // cleanupAttemptedAt is the latest start, stamped through a guarded update so
  // a teardown already in flight is never started a second time.
  cleanedUpAt        DateTime?
  cleanupAttemptedAt DateTime?

  // When the agent on this box was last seen connected to the orchestrator.
  // Drives future "idle eviction" logic in the pool model.
  lastConnectedAt DateTime?

  // First time this box's agent ever dialed in, written once on the
  // provisioning -> ready transition and never overwritten. Every reconnect
  // overwrites lastConnectedAt, so only readyAt - createdAt measures how long
  // cold provisioning took. A pool box never gets one: its guard is
  // status "provisioning", and warmedAt is the equivalent warm measurement.
  readyAt DateTime?

  // Warm pool. Only pool boxes populate these.
  poolSpecHash          String? // pool spec this box launched from, re-compared against the current hash each reconciler tick
  // Environment pool: the Environment this box was launched (and is prepared)
  // for. Set on the env-* statuses only. The GitHub broker reads it to decide
  // which repositories a preparing box may fetch with the pool credential.
  poolEnvironmentId     String?
  // The environment pool's columns
  // (services/envPool.ts). A row is current while poolSetupHash equals its
  // environment's now: sha256 of the resolved `setup`, the pool spec (image,
  // type, cloud-init shape) and the size and disk. preparedCommit is
  // {"owner/name": sha} for each repository as `setup` last succeeded on it,
  // poolRepos the repositories resolved at launch ([{repo, branch, dir}]),
  // which the broker's pool rule reads instead of GitHub. poolLog is the last
  // prepare failure's log tail (env-failed), shown on the environment's page.
  poolSetupHash         String?
  preparedCommit        Json?
  preparedAt            DateTime?
  poolRepos             Json?
  poolLog               String?
  // The refresh: refreshStartedAt is
  // when the refresh now running started an env-stopped box again (null
  // otherwise), so its prepare times out from there and only its own setup's
  // success stops the box; refreshCheckedAt is when the refresh last checked
  // the row, so a stopped box is checked once each ENV_POOL_REFRESH_MINUTES.
  refreshStartedAt      DateTime?
  refreshCheckedAt      DateTime?
  // An env-failed row whose setup ran and failed, which holds the pool at its hash and heads; any other failure
  // (its launch, the image, a clone, a timeout) only delays the next launch for the same hash and heads.
  poolSetupFailed       Boolean   @default(false)
  // Where EC2 put the box: a stopped box can't change zone, so a claim refused
  // for capacity in one takes a pool box in another. Recorded for every launch.
  availabilityZone      String?
  subnetId              String?
  warmedAt              DateTime? // when the box became claimable; claim order is oldest first
  claimedAt             DateTime? // start of the claim latency budget
  // Stamped on socket close, and deliberately NOT cleared on reconnect: the
  // connect write races the close write, so a reader compares the two columns
  // instead. A live agent is `agentDisconnectedAt IS NULL OR < lastConnectedAt`,
  // and a warm box whose agent has been gone too long is failed, not claimed.
  agentDisconnectedAt   DateTime?
  onWarmStatus          String? // pending | running | succeeded | failed
  onWarmLog             String? // last 4 KB of the on-warm runner's log, for the failure case
  onClaimStatus         String? // pending | running | succeeded | failed | skipped
  onClaimError          String? // one line, shown in a UI badge tooltip
  // A claim's update to the orchestrator's commit before its first launch
  // (services/claimUpdate.ts): updating | updated | current | skipped |
  // failed | timed-out, with a one-line detail (the reason, for the last
  // three). `updating` opens the box's update policy for a few minutes from
  // claimUpdateStartedAt, and both chat views' setup steps say "Updating the box".
  claimUpdateStatus     String?
  claimUpdateDetail     String?
  claimUpdateStartedAt  DateTime?
  githubDeliveredAt     DateTime?
  repoPromptDismissedAt DateTime?

  // The AMI the box was launched from, and how it was chosen
  // (services/boxImage.ts): published, channel:<name>, pinned, or
  // fallback:<what the owner's box-image flag asked for> when that image was
  // unusable and the box got the published one. Null for boxes launched
  // before these were recorded, and for external boxes.
  imageId     String?
  imageSource String?
  // The EC2 type the box launched as: BOX_INSTANCE_TYPE, a fallback after a
  // capacity refusal, or a caller's own choice (ProvisionArgs.instanceTypes).
  // Null for boxes launched before it was recorded, and for external boxes.
  instanceType String?
  // The size it was launched at (services/boxSize.ts): small, medium or
  // large, which instanceType is one of the types of. Null when it launched
  // as BOX_INSTANCE_TYPE with no size (box-default-size off, older and
  // external boxes). A pool box has its pool's, and keeps it when claimed.
  size         String?
  // The root disk in GiB (services/boxDiskSize.ts): the one asked for, the
  // repo's .termag/environment.json resources.diskGiB, else BOX_ROOT_VOLUME_GB
  // (120), written at create and again at launch with what the box got (never
  // under the image's snapshot; hibernation's RAM is on top). A pool box has
  // the default. Null for boxes made before it was recorded, and for external
  // boxes. A finished grow (services/boxDisk.ts, owner or admin) sets it to the new size.
  diskGiB      Int?

  // Whether termag sets the box up (services/boxSetup.ts):
  // false delivers no skills, agent config, credentials or project seeding,
  // and never a warm-pool box. Chosen at launch and written to
  // ~/.config/termag/setup by cloud-init, which the box side reads.
  setupEnabled Boolean @default(true)

  // Hibernation. EC2 only accepts HibernationOptions at RunInstances, so this
  // is written once at launch and is false forever for every box launched
  // before it (or from an AMI without the hibernation bake).
  hibernationConfigured Boolean   @default(false)
  // When the box last hibernated; kept through a start so a resume that
  // doesn't take falls back to hibernated, cleared by the next stop or
  // hibernate request. EC2 supports at most 60 days hibernated.
  hibernatedAt          DateTime?
  // The power sweep resumed this box to restart the 60-day clock and will
  // hibernate it again once its agent connects.
  rehibernatePending    Boolean   @default(false)
  // The resume marker: when
  // an owner's or a caller's start resumed this box from `hibernated`, not a
  // refresh resume. Its sessions came back on the binaries they had, so the
  // tool sweep (services/toolUpdate/autoRuns.ts) gives it a run on its first
  // hello after the resume and clears it.
  resumedFromHibernationAt DateTime?

  // Automatic lifecycle (services/boxLifecycle.ts).
  // Only boxes with hibernationConfigured take part. Null is off, or the
  // default window's stop.
  idleHibernateHours Int?
  // Last human input, agent `working` status or cloud-session start or end on
  // the box, throttled to a write a minute (services/boxActivity.ts). System
  // actions never bump it, nor does anything while the box isn't ready.
  lastActivityAt     DateTime?
  // When the box last came up: the agent's connect that made it ready after a
  // start, a resume or a first boot, whoever started it (connectUpdate). The
  // lifecycle sweep leaves a box alone for 15 minutes after it; a reconnect of
  // a box that was already ready doesn't touch it.
  lastReadyAt        DateTime?
  // The default window's warning about a coming stop, and the stop time it
  // promised. A warning from before the last activity, promising a time before
  // the current due time, or more than an hour past it, is stale, so nothing
  // has to clear these.
  idleWarnedAt       DateTime?
  idleParkAt         DateTime?
  // When the sweep last parked the box. Cleared by an owner's start (markInUse),
  // not by an automation's wake, so the next sweep knows a woken box is
  // untouched and stops it again without a warning.
  autoParkedAt       DateTime?
  // When the box went to hibernated and stayed there: set on the first
  // settle, kept through the 60-day refresh, cleared by an owner's start.
  parkedAt           DateTime?
  // When the box went down, for box.resumed's downMinutes
  // (services/boxStartLatency.ts). Stamped by the power sweep's settle of a
  // stop or hibernate while it is null. Ended (cleared) whenever the box is
  // up for use: the agent connect that brings it up (connectUpdate), a stop
  // or hibernate asked of a ready box, and a stop or hibernate that times
  // out back to ready. The 60-day refresh keeps it: its connect, and its
  // re-hibernate of a box nobody used since (sleepKeepsDownClock). The
  // refresh's start fills it from hibernatedAt for a box hibernated before
  // this column.
  downSince          DateTime?
  // One line the box list shows about the last automatic action.
  lifecycleNote      String?
  // Terminate after this many days parked (hibernated). Null is off.
  hibernatedTerminateDays Int?
  // The agent's `unsaved-work` scan, run just before each automatic
  // hibernate, and when. A scan older than lastActivityAt doesn't count.
  unsavedWork          Json?
  unsavedWorkCheckedAt DateTime?
  // Set when the lifecycle sweep terminated the box; the box list shows it
  // for a week afterwards.
  autoTerminatedAt     DateTime?

  // Quarantine (status `quarantined`, services/boxQuarantine.ts): when, by
  // which admin, why, the status it was quarantined from, and the outcome of
  // each containment step (QuarantineStepResult[] in boxQuarantinePolicy.ts),
  // snapshot ids included. Kept after an admin terminates the box.
  quarantinedAt         DateTime?
  quarantinedById       String?
  quarantineReason      String?
  quarantineFromStatus  String?
  quarantineSteps       Json?

  // The box whose own credentials created this one through the CLI
  // (`termag box create` / `project create --new-box` run on a box), null for
  // every other box. The parent may remove it.
  /// What the box was made for, when its creator said: 'ask' from `termag ask
  /// --new-box` (or the deprecated `--for-ask`), which gave it the ask-box
  /// lifecycle (applyAskBoxPolicy); it is sized like any other box.
  createdFor       String?
  parentInstanceId String?
  parent           Instance?  @relation("InstanceParent", fields: [parentInstanceId], references: [id], onDelete: SetNull)
  children         Instance[] @relation("InstanceParent")

  projects             Project[]
  agentTokens          AgentToken[]
  claudeRunnerSessions ClaudeRunnerSession[]
  claudeSessionEvents  ClaudeSessionEvent[]
  spaceBoxes           SpaceBox[]
  boxEvents            BoxEvent[]

  // Uniqueness on (userId, name) is enforced by a PARTIAL unique index that
  // EXCLUDES terminated boxes, so a terminated box's name can be reused. Prisma
  // can't express partial uniques in the schema, so the index is created in the
  // migration 20260902000000_instance_name_partial_unique instead of via
  // @@unique here. (`prisma migrate dev` will report this index as drift — it's
  // intentionally managed by that migration; `migrate deploy` applies it as-is.)
  // Postgres treats nulls as distinct, so ownerless pool rows never collide on
  // that index and it needs no change.
  @@index([userId, status])
  @@index([parentInstanceId])
  @@index([status, poolEnvironmentId])
  @@map("instances")
}

// Fleet operations on a box (services/boxEvents.ts): one row per operation,
// written when it is asked for and updated as it goes, never deleted. `kind`
// is resize or disk-grow for now (stop, start, park and terminate may follow).
// The latest open row of a kind is the operation in progress: a resize's
// one-at-a-time lock, the 409, and the progress the UIs show. Kept when the
// box row goes (boxId is set null; boxName keeps what it was called). Who
// asked: actorId (a user id, no FK, so a removed user's rows stay) and
// actorRole (owner, admin, system), with an admin's reason. from/to are the
// operation's own values (a size, a disk size); detail holds the rest.
model BoxEvent {
  id         String    @id @default(cuid())
  boxId      String?
  box        Instance? @relation(fields: [boxId], references: [id], onDelete: SetNull)
  boxName    String
  kind       String
  actorId    String?
  actorRole  String
  reason     String?
  from       String?
  to         String?
  // requested, then the kind's steps (resize: resuming, stopping, resizing,
  // starting; disk-grow: modifying, filesystem), then done or failed.
  phase      String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  error      String?
  detail     Json?

  @@index([boxId, startedAt])
  @@index([kind, startedAt])
  @@map("box_events")
}

// Every request to the admin REST surface or the admin MCP server, reads
// included. Who (actor + the admin token if one was used), which surface, what
// action, a summary of the arguments, and how it ended. Never pruned
// automatically.
model AdminAuditLog {
  id      String   @id @default(cuid())
  at      DateTime @default(now())
  actorId String
  tokenId String?
  // The box whose own agent token made the call: an admin's box reading or
  // triaging bug reports from the CLI. Null otherwise.
  boxId   String?
  surface String // rest | mcp
  action  String // route (METHOD /path) or MCP tool name
  args    Json?
  outcome String // ok | denied | not_found | rejected | error (middleware/admin.ts auditOutcome)
  status  Int? // HTTP status for rest; null for mcp

  @@index([at])
  @@index([actorId, at])
  @@map("admin_audit_log")
}

// Latest Chrome tab snapshot from the local relay, keyed by relay token
model RelaySnapshot {
  id         String   @id @default(cuid())
  relayToken String   @unique
  snapshotAt DateTime @default(now())
  windows    Json // array of { windowId, tabs: [{ url, title, favIcon }] }

  @@map("relay_snapshots")
}

/// connect-pg-simple's session store. Declared here ONLY so `prisma db push`
/// creates it (as the migration user) and stops dropping it as an unknown
/// table on every schema sync — the app never queries it through Prisma.
/// Shape mirrors connect-pg-simple/table.sql (varchar sid PK, json sess,
/// timestamp(6) expire, index on expire).
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

// One stored credential per user and provider (services/credentialStore.ts).
// Listing reads only the label, so it needs no KMS call.
// A chat-runner session's Claude Code transcript, kept by the orchestrator so
// the chat reads while its box is down. One row
// per Claude session; a cleared chat starts a new session and a new row.
model ChatTranscript {
  projectId    String
  workstreamId String
  sessionId    String // Claude's session id
  // Bytes of the session's JSONL stored so far: where the next chunk starts.
  rawBytes     BigInt                @default(0)
  // Past CHAT_TRANSCRIPT_RAW_CAP the raw JSONL stops; view entries still land.
  rawCapped    Boolean               @default(false)
  // The chat's live session; older sessions are history.
  current      Boolean               @default(true)
  // The checkout's git state at the session's last turn end (services/chatGitState.ts):
  // branch, HEAD, upstream, counts, the open PR. No file names or contents.
  gitState     Json?
  gitStateAt   DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  project      Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workstream   Workstream            @relation(fields: [workstreamId], references: [id], onDelete: Cascade)
  chunks       ChatTranscriptChunk[]

  @@id([projectId, workstreamId, sessionId])
  @@index([workstreamId, current])
  @@map("chat_transcripts")
}

// One turn's lines of a ChatTranscript: bytes [byteStart, byteEnd) of the JSONL.
model ChatTranscriptChunk {
  projectId    String
  workstreamId String
  sessionId    String
  byteStart    BigInt
  byteEnd      BigInt
  // AWS Encryption SDK messages bound to (purpose, projectId, workstreamId,
  // sessionId, byteStart). False only where CHAT_TRANSCRIPT_ALLOW_PLAINTEXT
  // stored them unsealed (e2e and dev).
  sealed       Boolean
  // gzip of the JSONL bytes, then sealed. Null once the transcript is capped.
  raw          Bytes?
  // The chat-history entries these lines render as, elided, as JSON, then sealed.
  entries      Bytes
  entryCount   Int
  createdAt    DateTime       @default(now())
  transcript   ChatTranscript @relation(fields: [projectId, workstreamId, sessionId], references: [projectId, workstreamId, sessionId], onDelete: Cascade)

  @@id([projectId, workstreamId, sessionId, byteStart])
  @@map("chat_transcript_chunks")
}

// A chat continued on a new box after its box was terminated:
// which session goes where, whether it is on the new
// box yet, and whether its first turn there has been told what was lost.
model ChatResume {
  id             String     @id @default(cuid())
  projectId      String
  workstreamId   String
  sessionId      String
  fromInstanceId String
  toInstanceId   String
  // The old box's last git state (ChatTranscript.gitState), for the notice.
  gitState       Json?
  // The project's other workstreams, which don't come along in v1:
  // [{ name, gitState }], named as lost in the notice.
  lostWorkstreams Json?
  // The new box has the owner's credentials (the Claude gateway settings):
  // its hello settled, or the claim's delivery finished. Until then its first
  // turn waits, on whichever orchestrator process serves it.
  credentialsReadyAt DateTime?
  // The session's JSONL is on the new box (chat-session-restore).
  restoredAt     DateTime?
  // The turn whose message carries the notice (its turn-start said so): only
  // that turn's Claude init tells it, on whichever process sees the init.
  noticeTurnId   String?
  // The first turn on the new box carried the notice.
  noticeSentAt   DateTime?
  createdAt      DateTime   @default(now())
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workstream     Workstream @relation(fields: [workstreamId], references: [id], onDelete: Cascade)

  @@unique([workstreamId, toInstanceId])
  @@index([toInstanceId])
  @@map("chat_resumes")
}

// A "Continue on a new box" under way for a project (services/chatContinueLock.ts):
// one row per project, so two clicks, even on two orchestrator processes, launch
// one box. Deleted when the continue ends either way; a row older than the
// stale timeout is a crashed process's, and the next continue takes it over.
model ChatContinueLock {
  projectId String   @id
  token     String
  startedAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("chat_continue_locks")
}

// A message sent to a chat whose box is gone or down (services/chatHeld.ts):
// sending it started the new box (or the stopped one), and it goes in, oldest
// first, once the chat can take it. Kept here, not in the browser, so a closed
// tab still has it sent.
model ChatHeldMessage {
  id           String     @id @default(cuid())
  projectId    String
  workstreamId String
  senderId     String
  text         String
  model        String?
  backend      String?
  effort       String?
  // A delivery under way (one process at a time); stale after a few minutes.
  claimedAt    DateTime?
  // The chat refused it for good; it stays, shown with this, and is not retried.
  error        String?
  // The send's images, [{mediaType, data (base64)}], as a send carries them; their types alone for the view.
  images       Json?
  imageTypes   String[]   @default([])
  // When a start of the chat's box was asked for it (on send, or by held delivery once a stopping box stopped).
  boxStartedAt DateTime?
  createdAt    DateTime   @default(now())
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workstream   Workstream @relation(fields: [workstreamId], references: [id], onDelete: Cascade)

  @@index([workstreamId, createdAt])
  @@map("chat_held_messages")
}

// A line in a chat's timeline that is neither the person's nor the agent's:
// today only a tool update's restart notice ("In the
// chat"), the same text the pane printed (services/toolUpdate/notice.ts,
// checked against NOTICE_SAFE before it is stored). Shown to everyone who can
// read the chat, never sent to the agent. The newest CHAT_NOTICE_KEEP per
// workstream are kept (services/chatNotices.ts).
model ChatNotice {
  id           String     @id @default(cuid())
  workstreamId String
  workstream   Workstream @relation(fields: [workstreamId], references: [id], onDelete: Cascade)
  /// `tool-update`.
  kind         String
  /// The pane it was printed in: `agent` (the orchestrator's relaunch), or the
  /// workstream's `ctrl`, `review`, `data` or `data-ctrl` pane (the box's resume).
  pane         String
  text         String
  /// The software_update_runs row that restarted the session; no FK, like that table.
  runId        String?
  at           DateTime   @default(now())

  @@index([workstreamId, at])
  @@map("chat_notices")
}

model UserCredential {
  userId     String
  provider   String // "github"
  label      String // e.g. "@octocat"; never any part of the value
  // AWS Encryption SDK message: the KMS-encrypted data key and the AES-GCM
  // ciphertext, bound to (purpose, userId, provider) by its encryption context.
  ciphertext Bytes
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, provider])
  @@map("user_credentials")
}

// A credential that belongs to no user: the environment pool's GitHub
// credential (provider "github"), which the GitHub broker swaps in for a preparing pool box's git
// fetches. Never delivered to a box. Sealed like user_credentials, under the
// same KMS key, with the encryption context (purpose: termag-pool-credential,
// provider) (services/poolCredential.ts). Set by an admin: PUT
// /api/admin/pool-credential/github.
model PoolCredential {
  provider        String   @id
  label           String // e.g. "@octocat"; never any part of the value
  ciphertext      Bytes
  updatedByUserId String?
  updatedAt       DateTime @updatedAt

  @@map("pool_credentials")
}

// A user's MCP server, reached from their boxes through the MCP broker.
// Secrets live in user_credentials as provider
// "mcp-<id>"; this row holds none.
model McpConnector {
  id              String   @id @default(cuid())
  userId          String
  // The mcpServers key on the box and the mcp__<name>__ tool prefix
  // (services/mcpConnectors.ts CONNECTOR_NAME), derived from the name typed.
  name            String
  // The name as typed ("Claude Docs"), which Settings shows; null when that
  // is the name itself, as for every connector made before display names.
  displayName     String?
  // https URL, normalised (services/mcpConnectors.ts validateUpstream).
  upstream        String
  authType        String // "static" | "oauth"
  // static: {headerName: template}, referencing secrets as {{secret.<name>}}.
  headerTemplates Json?
  // oauth: what discovery found (services/mcpOAuth.ts DiscoveredOAuth); nothing secret.
  oauthMetadata   Json?
  // oauth: "linked" | "needs_link"; null for static.
  linkStatus      String?
  // oauth: why the last link or refresh failed, shown on Settings.
  linkError       String?
  // oauth: the last sign-in's scopes, {requested: string[], granted: string[] | null}
  // (services/mcpOAuthScopes.ts ConnectorScopes); granted is null when the
  // token response named none. Nothing secret.
  oauthScopes     Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthStates     McpOAuthState[]

  @@unique([userId, name])
  @@map("mcp_connectors")
}

// One pending OAuth authorize per row: the state's nonce and its PKCE
// verifier, consumed (deleted) by the callback, at most 10 minutes old.
model McpOAuthState {
  id           String       @id
  userId       String
  connectorId  String
  codeVerifier String
  // The scopes this sign-in's authorize URL asked for.
  scopes       String[]     @default([])
  // Where the callback sends the browser: null for Settings → MCP, 'welcome'
  // for the setup wizard's MCP step (routes/mcpConnectors.ts linkRedirect).
  returnTo     String?
  expiresAt    DateTime
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  connector    McpConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("mcp_oauth_states")
}

// Which orchestrator process does the singleton work (services/orchestratorLease.ts).
// One row. Only processes started with ORCHESTRATOR_LEASE=true touch it; the
// newest claimer wins, and the one it displaced drains for the deploy.
model OrchestratorLease {
  id          String   @id
  holderId    String
  holderLabel String
  claimedAt   DateTime
  heartbeatAt DateTime

  @@map("orchestrator_leases")
}

// Agent-to-agent asks. A thread is one conversation
// with a target project's workstream: its Claude session id on the target box,
// the commit its sandbox clone started from, and the draft PR it publishes to.
// Metadata only: prompts and replies are never stored. A reply goes from the
// box's result straight to the asker's waiting poll (Postgres NOTIFY between
// orchestrators, services/askReplyBus.ts) and is dropped if nobody waits.
model AgentThread {
  id              String         @id @default(cuid())
  originUserId    String
  originUser      User           @relation(fields: [originUserId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workstream      String         @default("main")
  // The box the thread runs on; no foreign key, so a removed box leaves its log.
  instanceId      String
  claudeSessionId String?
  baseSha         String?
  // owner/name on github.com, from the target checkout's origin.
  repo            String?
  // A multi-repo project's repository (ProjectRepo.name) the thread runs in;
  // null for a single-repository project.
  repoName        String?
  branch          String?
  prNumber        Int?
  prUrl           String?
  // An existing PR of the asker's the thread publishes to instead of its own
  // branch (`termag ask --update-pr`): its number, owner/name and head branch, as
  // the first ask checked them. Every publish checks it again on GitHub.
  targetPr        Int?
  targetRepo      String?
  targetBranch    String?
  // Messages on the thread so far; no cap (each message records its own hop).
  hopCount        Int            @default(0)
  // What the caller named the thread (`termag ask --title`, at most 60
  // characters; nothing is derived): the simple UI's name for its chat, which
  // shows `ask-<thread>` while it is null. Display only: the chat workstream
  // stays `ask-<thread>`.
  title           String?
  // The session that sent the thread's first ask, when the CLI said and the
  // orchestrator could check it (askService.askSession): the simple UI nests
  // the thread's chat under it. No foreign key, like a spawn's parent.
  parentProjectId  String?
  parentWorkstream String?
  // The Claude Code session id that sent the first ask (the CLI's
  // CLAUDE_CODE_SESSION_ID), unchecked: it names the thread's parent in its
  // turns' telemetry (termag.ask.parent.session), so a telemetry reader can roll the
  // thread's spend up under that conversation, and it finds a desktop app
  // thread's asks (GET /api/cli/v1/chat/asks), always among the caller's own
  // threads. Nothing delivers to it or authorizes by it.
  parentClaudeSession String?
  // The thread's chat on the target project (ask-chat-v1): a workstream with
  // no worktree of its own, whose turns run in the thread's clone.
  chatWorkstreamId String?     @unique
  chatWorkstream   Workstream? @relation("AskChat", fields: [chatWorkstreamId], references: [id], onDelete: SetNull)
  // `termag ask --new-box` made the thread's box (Instance.createdFor 'ask')
  // and project for it, so they are the thread's: whoever cleans up ask boxes
  // can remove the box once the thread's PRs are done.
  newBox           Boolean     @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  messages        AgentMessage[]
  prs             AgentThreadPr[]

  @@index([originUserId, updatedAt])
  @@index([projectId])
  @@map("agent_threads")
}

// One ask: who sent it from where, which project ran it, and how it ended.
model AgentMessage {
  id               String      @id @default(cuid())
  threadId         String
  thread           AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderUserId     String
  sender           User        @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  // The box whose token sent it; null for a laptop sign-in or a browser.
  senderInstanceId String?
  projectId        String
  workstream       String
  instanceId       String
  hop              Int
  // The Claude tier (opus | sonnet | haiku) it asked for with `termag ask
  // --model` until it starts, then the one its turn launched on; null for none
  // (the box's default). With `modelIgnored` set, the one it asked for, which
  // its turn could not take (it ran on the box's default), and why: an older
  // box agent, a headless run.
  model            String?
  modelIgnored     String?
  // A2A's TaskState names: submitted | working | completed | failed | canceled,
  // plus superseded: a follow-up went into its running turn (supersededById).
  status           String      @default("submitted")
  error            String?
  promptBytes      Int
  replyBytes       Int?
  numTurns         Int?
  // none | published | partial | unpushed | refused | failed, with a reason that never holds a token.
  publish          String?
  publishDetail    String?
  createdAt        DateTime    @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  // When the box reported the run's end; publishing may still follow.
  resultAt         DateTime?
  // When a poll first got the reply; null on a finished message means it was dropped.
  readAt           DateTime?
  // An ask to a parked box waits here for the box's agent: the only time a
  // prompt is stored, cleared the moment the run is sent or the wait ends.
  queuedPrompt     String?
  // While queued, when the wait ends; once sent, when it was sent.
  queuedUntil      DateTime?
  // The follow-up that went into this message's running turn and whose reply
  // answers it too (status superseded).
  supersededById   String?
  // The session that sent this message, when the CLI said and the orchestrator
  // could check it (askService.askSession); null for no sender or an unchecked
  // one. `notifyVia` says how it is told of the finish: chat (a chat-runner
  // turn's project and workstream) or pane (its workstream's agent pane).
  // Null `notifyVia`: no notice (`--no-notify`, a ctrl shell), the sender
  // still recorded.
  notifyProjectId  String?
  notifyWorkstream String?
  notifyVia        String?
  // When the finish notice was settled, and how: chat | pane (delivered),
  // waiter (a poll got the finish), together (a follow-up's notice covers it),
  // gone (the session's box is down or it is archived), off, expired, failed.
  notifiedAt       DateTime?
  notice           String?
  // The run's final reply, sealed, for 14 days.
  storedReply      AskReply?

  @@index([senderUserId, status, readAt])
  @@index([threadId, createdAt])
  @@index([queuedUntil])
  @@index([notifiedAt, completedAt])
  @@map("agent_messages")
}

// A finished message's final reply,
// written in the transaction that marks the message finished and sealed with
// the chat transcript store's KMS key, bound to the message id. Read only by
// the message's sender (`termag ask --reply`); the ask sweep deletes it after
// 14 days. `bytes` is what is kept: a reply over 1 MiB is cut, `truncated`.
model AskReply {
  messageId String       @id
  message   AgentMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  sealed    Boolean
  text      Bytes
  bytes     Int
  truncated Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@index([createdAt])
  @@map("ask_replies")
}

// The commits a run made, as the git bundle its box uploaded, until the
// orchestrator has published them (or an hour passes).
// One draft PR an ask thread opened.
// `key` is '' for the run's own branch (also kept on agent_threads.prNumber /
// prUrl for older processes) or the <name> of its pr/<name> branch.
model AgentThreadPr {
  id        String      @id @default(cuid())
  threadId  String
  thread    AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  key       String
  branch    String
  prNumber  Int
  prUrl     String
  headSha   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([threadId, key])
  @@map("agent_thread_prs")
}

model AgentBundle {
  messageId String   @id
  data      Bytes
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("agent_bundles")
}

// ── PR analytics ─────────────────────────────────────
// Pull requests of the repos the repo groups include, ingested from GitHub
// with one admin's stored gh token (pr_analytics_settings.tokenUserId).
// Logins are stored lowercase; GitHub compares them case-insensitively.
model GithubPr {
  id             String    @id // GitHub node id
  repo           String // owner/name, lowercase
  repoVisibility String // public | internal | private
  number         Int
  authorLogin    String // '' when GitHub has no author (a deleted account)
  authorType     String // User | Bot | Mannequin | ''
  authorClass    String // human | agent | automation
  /// The human the PR counts for: the author of a human PR, or the person an agent PR was done for.
  creditedLogin  String?
  creditSource   String // author | commit-author | co-author | body | none
  /// An agent wrote commits on, or co-authored, this PR (any author class).
  agentAssisted  Boolean   @default(false)
  state          String // OPEN | CLOSED | MERGED
  isDraft        Boolean   @default(false)
  baseRef        String    @default("")
  /// The PR's head commit (headRefOid) when last read; null on rows read before it was stored.
  headSha        String?
  /// The commit the merge put on the base branch (mergeCommit.oid; the squash or merge commit), for
  /// joining a PR to the deploys and observability service.version that contain it. Null until merged, and on
  /// rows read before it was stored.
  mergeSha       String?
  additions      Int       @default(0)
  deletions      Int       @default(0)
  changedFiles   Int       @default(0)
  createdAt      DateTime
  mergedAt       DateTime?
  closedAt       DateTime?
  prUpdatedAt    DateTime
  ingestedAt     DateTime  @updatedAt
  /// Ready for review: the last ReadyForReviewEvent, else createdAt.
  readyAt        DateTime?
  /// Review requests, of the last 30 timeline events: [{ who: login | 'team:<slug>', at }].
  reviewRequests Json      @default("[]")
  /// Conversation comments, every author.
  comments       Int       @default(0)
  /// Conversation comments by people, of the last 100.
  humanComments  Int       @default(0)
  /// GitHub's review total; more than the stored rows when a PR has over 100.
  reviewCount    Int       @default(0)
  /// When reviews were stored for this PR; null on rows from before reviews were read.
  reviewsReadAt  DateTime?
  reviews        GithubPrReview[]

  @@unique([repo, number])
  @@index([repo, mergedAt])
  @@index([repo, createdAt])
  @@index([creditedLogin, mergedAt])
  @@index([mergeSha])
  @@map("github_prs")
}

/// One submitted review of a PR. Replaced with the PR on each write.
model GithubPrReview {
  id            String   @id // GitHub node id
  prId          String
  pr            GithubPr @relation(fields: [prId], references: [id], onDelete: Cascade)
  reviewerLogin String // lowercase, '' when GitHub has no author
  reviewerClass String // human | agent | automation
  state         String // APPROVED | CHANGES_REQUESTED | COMMENTED | DISMISSED
  submittedAt   DateTime
  /// Inline comments in this review.
  comments      Int      @default(0)

  @@index([prId])
  @@index([submittedAt])
  @@index([reviewerLogin, submittedAt])
  @@map("github_pr_reviews")
}

/// Per-repo ingestion state: survives restarts and feeds the ingest status.
model GithubRepoSync {
  repo           String    @id // owner/name, lowercase
  visibility     String    @default("")
  /// Next page of the first pass (newest updated first) while backfillDone is false.
  backfillCursor String?
  /// Newest PR updatedAt when the first pass started; becomes highWater when it ends.
  backfillTop    DateTime?
  backfillDone   Boolean   @default(false)
  /// Every PR updated at or before this is in github_prs.
  highWater      DateTime?
  /// The review backfill (PR_ANALYTICS_REVIEW_DAYS): a first pass re-reading recent PRs for their reviews.
  reviewsCursor  String?
  reviewsTop     DateTime?
  reviewsDone    Boolean   @default(false)
  lastRunAt      DateTime?
  lastError      String?
  updatedAt      DateTime  @updatedAt

  @@map("github_repo_sync")
}

/// A named collection of repos.
model RepoGroup {
  slug      String   @id
  name      String
  /// [{ kind: 'repo' | 'pattern' | 'topic', value: string, org?: string }]
  members   Json     @default("[]")
  /// owner/name repos left out despite a match.
  excluded  Json     @default("[]")
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("repo_groups")
}

/// Repos a group resolved to at the last discovery.
model RepoGroupMember {
  groupSlug  String
  repo       String // owner/name, lowercase
  visibility String
  /// Set when only some of the repo's PRs count (a `path` member): { paths, minShare, keys }.
  /// Those PRs are the group's rows in repo_group_prs.
  scope      Json?
  resolvedAt DateTime @default(now())

  @@id([groupSlug, repo])
  @@index([repo])
  @@map("repo_group_members")
}

/// A PR of a path-scoped repo that counts for a group, scored at ingest (prAnalytics/groups.ts scorePr).
model RepoGroupPr {
  groupSlug    String
  prId         String // github_prs.id
  /// Changed files under the group's paths, of at most the first 100.
  matchedFiles Int
  scoredAt     DateTime @default(now())

  @@id([groupSlug, prId])
  @@index([prId])
  @@map("repo_group_prs")
}

/// A team roster: a named set of people, sourced from the org-tree
/// (ld-org-explorer). A parent's roster is the de-duped union of its descendants'.
model Team {
  key       String   @id
  name      String
  /// Another team's key, or null at the top.
  parent    String?
  hidden    Boolean  @default(false)
  sort      Int      @default(0)
  /// When the last sync wrote the team; null for a seed or a hand-made team.
  syncedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   TeamMembership[]

  @@map("teams")
}

/// One membership interval of a team: a login on a team from `start`
/// to `end` (null = still on it). `source` manual rows survive a sync and win over synced ones.
model TeamMembership {
  teamKey   String
  team      Team      @relation(fields: [teamKey], references: [key], onDelete: Cascade)
  login     String // lowercase GitHub handle
  email     String?
  name      String?
  start     DateTime
  end       DateTime?
  /// The start is the first observation, not the real join date (the org-tree's open_start).
  openStart Boolean   @default(false)
  source    String    @default("synced") // synced | manual
  updatedAt DateTime  @updatedAt

  @@id([teamKey, login, start])
  @@index([login, start])
  @@map("team_memberships")
}

/// One row (id 'settings'): whose token ingests, and the bot / agent login lists.
model PrAnalyticsSettings {
  id           String   @id @default("settings")
  tokenUserId  String?
  /// The default groups were created once; deleting them all does not bring them back.
  groupsSeeded Boolean  @default(false)
  /// Slugs of the seed groups created so far, each once (a deleted one stays deleted).
  seededGroups Json     @default("[]")
  /// Keys of the seed teams created so far, each once (a deleted one stays deleted).
  seededTeams  Json     @default("[]")
  /// Logins that are bots even though GitHub types them User.
  botLogins    Json     @default("[]")
  /// Bot logins of AI coding agents (authorClass agent).
  agentLogins  Json     @default("[]")
  updatedAt    DateTime @updatedAt

  @@map("pr_analytics_settings")
}

/// One row (id 'settings'): the spend model's assumptions. Validated by services/admin/spend/config.ts.
model SpendSettings {
  id            String   @id @default("settings")
  /// Fully loaded cost of one person a year, the spend-share denominator.
  loadedCostUsd Float    @default(500000)
  /// Company headcount, the population of a proportional pool that names none.
  orgHeadcount  Int      @default(626)
  /// provider → model → weight: the assumed blend while token rows carry no model.
  modelMix      Json     @default("{}")
  /// The default prices and pools were created once; deleting them does not bring them back.
  seeded        Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  @@map("spend_settings")
}

/// USD per million tokens for a provider's model from a day on (services/admin/spend/model.ts priceOn). model '*' = any.
model ModelPrice {
  id            String   @id @default(cuid())
  provider      String
  model         String   @default("*")
  /// YYYY-MM-DD; a later row for the same provider and model replaces it from its own day.
  effectiveFrom String
  input         Float
  output        Float
  cacheRead     Float
  cacheWrite    Float
  createdAt     DateTime @default(now())

  @@unique([provider, model, effectiveFrom])
  @@map("model_prices")
}

/// Flat-priced spend: a vendor contract or an internal inference box fleet, shared and split per model.ts computeSpend.
model SpendPool {
  id              String   @id @default(cuid())
  name            String
  /// contract | infra
  kind            String
  /// The termag providers it covers; they are never also metered.
  providers       String[]
  annualUsd       Float?
  /// infra: boxes running (null = sized from peak concurrency), each boxCostUsd a year for usersPerBox at once.
  boxes           Int?
  boxCostUsd      Float?
  usersPerBox     Int?
  /// proportional | usage | full
  share           String   @default("proportional")
  shareValue      Float?
  populationLabel String?
  populationSize  Int?
  /// even | by-tokens | by-usage
  allocation      String   @default("even")
  startDate       String?
  endDate         String?
  note            String?
  sort            Int      @default(100)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("spend_pools")
}

/// A row of the PR overlay the user put off (routes/prs.ts, services/prDeferrals.ts):
/// left out of "Needs you" and the PRs tile until `until`. Keyed by the row's
/// overlay key, `owner/name#n` for a PR or `owner/name:branch` for a branch.
model PrDeferral {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  until     DateTime
  createdAt DateTime @default(now())

  @@id([userId, key])
  @@map("pr_deferrals")
}

/// Which workstream a pull request was worked on in (services/workstreamPrs.ts):
/// recorded when the
/// workstream's agent opens it, when the workstream's checkout is seen on its
/// branch, or by hand from the PR overlay. One per user and PR; the PR pills
/// and the overlay's workstream link read it.
model WorkstreamPr {
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// GitHub owner/name, lowercased.
  repo         String
  number       Int
  workstreamId String
  workstream   Workstream @relation(fields: [workstreamId], references: [id], onDelete: Cascade)
  /// created | branch | manual; a manual link is only replaced by hand.
  source       String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@id([userId, repo, number])
  @@index([workstreamId])
  @@map("workstream_prs")
}

/// A named, ordered list of pull requests the user reviews together
/// (services/prReviewGroups.ts). The
/// user's own: never shown to anyone else. A closed group is kept 30 days.
model PrReviewGroup {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  /// Null while open: closed by hand, or once every member is merged or closed.
  closedAt  DateTime?
  createdAt DateTime            @default(now())
  members   PrReviewGroupMember[]

  @@index([userId])
  @@map("pr_review_groups")
}

/// What the user posted on a PR from the simple UI's review card, one row a
/// round (services/prReviewRounds.ts): the head it
/// was of, the verdict and how many inline comments, so a push since or a
/// re-request brings the PR back for the next round.
model PrReviewRound {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// owner/name, lowercased, as workstream_prs keeps it.
  repo     String
  number   Int
  round    Int
  headSha  String
  /// APPROVE, COMMENT or REQUEST_CHANGES.
  event    String
  comments Int
  /// The PR's title and author when posted, for a PR no lane lists any more.
  title    String  @default("")
  author   String?
  postedAt DateTime @default(now())

  @@unique([userId, repo, number, round])
  @@index([userId, postedAt])
  @@map("pr_review_rounds")
}

/// One pull request of a review group, in review order. A PR is in at most
/// one of a user's open groups: the service's rule, not the schema's.
model PrReviewGroupMember {
  groupId  String
  group    PrReviewGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// GitHub owner/name, lowercased, as workstream_prs.
  repo     String
  number   Int
  position Int
  /// One line the user keeps with it ("merge after 1 is deployed").
  note     String?
  /// The title when it was added: shown while GitHub cannot be read.
  title    String        @default("")
  addedAt  DateTime      @default(now())

  @@id([groupId, repo, number])
  @@map("pr_review_group_members")
}

/// A suggested review group the user said "Not these" to
/// (services/prGroupSuggestions.ts). Keyed by a hash of the suggestion's
/// key, so it stays dismissed until its set of PRs changes.
model PrGroupSuggestionDismissal {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// sha256 hex of the suggestion key.
  keyHash   String
  createdAt DateTime @default(now())

  @@id([userId, keyHash])
  @@map("pr_group_suggestion_dismissals")
}

/// A shared file store across boxes. The files live in S3
/// under `<id>/`; this row is the name, the quota and the lifecycle.
model Space {
  id          String           @id @default(cuid())
  /// [a-z0-9-]{2,40}, unique across termag so `space:path` is unambiguous.
  /// A deleted space's name is released (rewritten to `deleted:<id>`).
  name        String           @unique
  description String?
  createdById String
  createdAt   DateTime         @default(now())
  /// Set when the last owner leaves termag; a space with no owner member is
  /// read-only even without it (services/spaceAccess.ts).
  readOnlyAt  DateTime?
  /// Set on delete; the spaces sweep purges the prefix, then the row.
  deletedAt   DateTime?
  /// Every stored version, current and noncurrent, plus unfinished multipart
  /// parts: charged when upload URLs are signed, recounted hourly from S3.
  usedBytes   BigInt           @default(0)
  quotaBytes  BigInt           @default(107374182400)
  members     SpaceMember[]
  boxes       SpaceBox[]
  invites     SpaceInvite[]
  charges     SpaceCharge[]
  fileShares  SpaceFileShare[]
  listings    ProjectSpace[]
  /// The chats that belong to this space (Workstream.spaceId).
  workstreams Workstream[]
  /// Slack for the space: its linked channels and orchestrator.
  slack       SpaceSlack?

  @@map("spaces")
}

/// One file shared read-only with anyone signed in to termag.
/// The share follows the path: whatever is saved there is
/// what a viewer gets. Deleted on Make private and when the file is deleted
/// or moved; it works only while `sharedById` is an editor or owner of a
/// space that isn't read-only.
model SpaceFileShare {
  id         String   @id @default(cuid())
  spaceId    String
  space      Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  /// A normalized file path (spacePaths.normalizeFilePath), never a folder.
  path       String
  sharedById String
  createdAt  DateTime @default(now())

  @@unique([spaceId, path])
  @@map("space_file_shares")
}

/// A quota charge for upload URLs that may not have been used yet. The hourly
/// recount adds every charge still live to what S3 holds, so a recount can't
/// drop bytes a signed URL may still write; the sweep deletes expired ones.
model SpaceCharge {
  id          String   @id
  spaceId     String
  bytes       BigInt
  /// When the URLs this charge paid for stop working.
  liveUntil   DateTime
  createdAt   DateTime @default(now())
  /// The object the URLs write (null for a move, whose copies finish in the
  /// request), and for a part batch its multipart upload and part numbers; the
  /// recount drops a charge whose object has landed or whose upload is no
  /// longer in progress, and counts an open upload's parts no live charge covers.
  key         String?
  uploadId    String?
  partNumbers Int[]    @default([])
  space       Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId, liveUntil])
  @@map("space_charges")
}

model SpaceMember {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// owner | editor | viewer
  role      String
  addedById String
  createdAt DateTime @default(now())

  @@unique([spaceId, userId])
  @@index([userId])
  @@map("space_members")
}

/// An explicit box grant. The box acts with its owner's current role, and
/// only while the owner is a member.
model SpaceBox {
  id         String   @id @default(cuid())
  spaceId    String
  space      Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  instanceId String
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  addedById  String
  createdAt  DateTime @default(now())

  @@unique([spaceId, instanceId])
  @@index([instanceId])
  @@map("space_boxes")
}

/// Which spaces a project is listed in. SpaceBox is the access; this is only where the project shows, so a
/// project whose box terminated stays in its spaces. Recorded from the box's
/// grants, inherited ones included, by the spaces sweep before it prunes a
/// terminated box's grants; removing a box or member from the space removes it.
model ProjectSpace {
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  /// The box the project was on when listed. Only that box counts as listed
  /// (listedBoxes): a project moved to another box doesn't take the space with it.
  instanceId String
  addedById String
  createdAt DateTime @default(now())

  @@id([projectId, spaceId])
  @@index([spaceId])
  @@map("project_spaces")
}

/// A member added by an email that has not signed in to termag yet; turned
/// into a SpaceMember on that user's first spaces request.
model SpaceInvite {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  /// Lowercased.
  email     String
  role      String
  addedById String
  createdAt DateTime @default(now())

  @@unique([spaceId, email])
  @@index([email])
  @@map("space_invites")
}

/// Append-only audit of a space: membership changes, writes, deletes, moves
/// and download presigns. No foreign keys, so it outlives what it names;
/// swept after 90 days.
model SpaceEvent {
  id               String   @id @default(cuid())
  at               DateTime @default(now())
  spaceId          String
  actorUserId      String
  /// Set when a box token acted.
  actorInstanceId  String?
  /// The box the access was inherited through, when it was.
  via              String?
  /// space.* | member.* | invite.* | box.* | file.put | file.put.signed | file.get | file.rm | file.mv |
  /// file.share | file.unshare. A non-member's read of a shared file is file.get with via 'share'.
  /// slack.* (space channels), written with surface `slack`.
  action           String
  path             String?
  bytes            BigInt?
  /// The S3 version a file.put stored (HEAD at the confirm), so a change can be diffed and restored.
  versionId        String?
  /// Why, as the writer said it (`termag space memory … --note`), at most 200 characters, secret-scanned.
  note             String?
  /// Where the action came from: `slack`, or null for every other writer (the web UI, the CLI, a box).
  /// A Slack entry point (slack_command, web, …) goes in `note` as `linkedVia=<value>`.
  surface          String?
  /// The space member a Slack-originated action was for, when the actor (the runner) acted for someone.
  onBehalfOfUserId String?

  @@index([spaceId, at])
  @@map("space_events")
}

// ── Spaces in Slack ──────────────────────
/// Slack for one space: who the orchestrator runs as and where. Created by the space's first channel link.
model SpaceSlack {
  id             String         @id @default(cuid())
  spaceId        String         @unique
  space          Space          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  enabledById    String
  /// The owner whose identity, box and budget the orchestrator uses.
  runnerUserId   String
  /// The orchestrator project (kind `space-orchestrator`).
  projectId      String?        @unique
  instanceId     String?
  /// active | paused | suspended
  status         String         @default("active")
  suspendReason  String?
  /// {newBoxApprovers: 'runner' | 'owners'}; the runner always may.
  approvalPolicy Json?
  /// Per-space overrides of the space-slack-limits caps (services/spaceSlack/limits.ts).
  limits         Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  disabledAt     DateTime?
  channels       SpaceChannel[]

  @@index([runnerUserId])
  @@map("space_slack")
}

/// A Slack channel linked to a space. One space per channel (the id is the key); up to channelsPerSpace per space.
model SpaceChannel {
  channelId       String     @id
  teamId          String
  spaceSlackId    String
  spaceSlack      SpaceSlack @relation(fields: [spaceSlackId], references: [id], onDelete: Cascade)
  /// The name as last seen (channel_rename keeps it current); display only.
  name            String
  isPrivate       Boolean    @default(false)
  createdByTermag Boolean    @default(false)
  linkedById      String
  /// slack_command | slack_shortcut | app_home | web | cli | create
  linkedVia       String
  linkedAt        DateTime   @default(now())
  /// ts of termag's confirmation message in the channel.
  confirmTs       String?
  /// Paused on a Slack Connect share; answers stop until an owner unlinks or the share ends.
  pausedAt        DateTime?
  pauseReason     String?
  unlinkedAt      DateTime?
  /// owner | archived | removed | ext_shared | disabled | space_deleted | relinked
  unlinkReason    String?
  lastCheckedAt   DateTime?

  @@index([spaceSlackId])
  @@map("space_channels")
}

/// Each hand-off of a Slack thread to a space: the thread's binding history.
model SlackThreadRoute {
  channelId              String
  threadTs               String
  seq                    Int
  spaceId                String
  requestedBySlackId     String
  requestedByUserId      String
  /// channel | thread | explicit | single | context | router_model | user_choice
  decidedBy              String
  candidateCount         Int
  orchestratorWorkstream String?
  at                     DateTime @default(now())

  @@id([channelId, threadTs, seq])
  @@index([spaceId, at])
  @@map("slack_thread_routes")
}

/// An ask a space orchestrator started from a Slack thread (report-back).
model SpaceSlackTask {
  agentThreadId     String    @id
  spaceId           String
  channelId         String
  threadTs          String
  requestedByUserId String
  postedAt          DateTime?
  createdAt         DateTime  @default(now())

  @@index([spaceId])
  @@map("space_slack_tasks")
}

/// A space turn waiting for the runner's box to wake.
model SpaceSlackPending {
  id        String   @id @default(cuid())
  spaceId   String
  channelId String
  threadTs  String
  slackId   String
  message   String
  queuedAt  DateTime @default(now())

  @@index([spaceId, queuedAt])
  @@map("space_slack_pending")
}

// ── Environments ────────────────────────────────────
/// A named environment definition: environment.json's JSON, either stored
/// here (`inline`) or read from a file in a repository (`pointer`, repo :
/// branch : path, read at box creation). The repositories a project made from
/// it clones are the definition's `repos`. Shared: anyone signed in can see,
/// use and edit any of them, and every create, edit and delete writes an
/// EnvironmentEvent.
model Environment {
  id              String   @id @default(cuid())
  /// Lowercase letters, digits and hyphens: what `--environment` names.
  name            String   @unique
  /// inline | pointer
  kind            String
  /// inline: the definition, as environment.json would hold it.
  definition      Json?
  /// pointer: the file's repository (owner/name), branch (null: its default) and path.
  fileRepo        String?
  fileBranch      String?
  filePath        String?
  createdByUserId String?
  updatedByUserId String?
  /// personal | shared. Personal: only its owner sees, uses, edits or deletes it. Shared: everyone signed in sees
  /// and uses it, and it is a pointer to a file on its repository's default branch (services/environments.ts).
  /// Null for a row written without one, which backfillEnvironmentVisibility decides at startup (and reads
  /// take as legacyVisibility until it has).
  visibility      String?
  /// Who owns it: its creator (null with visibility: its creator). Only the owner switches it between personal and shared.
  ownerUserId     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ownerUserId])
  @@map("environments")
}

/// Append-only history of every environment change, on SpaceEvent's pattern:
/// no foreign keys, so it outlives a deleted environment, and never pruned.
model EnvironmentEvent {
  id            String   @id @default(cuid())
  at            DateTime @default(now())
  environmentId String
  actorUserId   String
  /// environment.create | environment.update | environment.delete
  action        String
  /// The stored fields ({ name, kind, definition | file }) before and after; null before a create, after a delete.
  before        Json?
  after         Json?

  @@index([environmentId, at])
  @@map("environment_events")
}

// ── Deployed software ───────────────────────────
/// The latest observed version of each component on each host.
model HostSoftware {
  /// 'orchestrator', an instance id, or 'agent:<userId>' for a per-user agent on the orchestrator.
  hostKey    String
  hostKind   String // orchestrator | box | agent
  component  String // termag, termag-checkout, image, hooks, claude, codex, …, os, kernel
  version    String?
  raw        String?
  path       String?
  ok         Boolean  @default(false)
  source     String // agent | self | image | hello | report
  observedAt DateTime

  @@id([hostKey, component])
  @@index([component])
  @@map("host_software")
}

/// A component's version changed on a host (rollout history, kept 180 days).
model SoftwareChange {
  id        String   @id @default(cuid())
  hostKey   String
  component String
  from      String?
  to        String?
  at        DateTime @default(now())

  @@index([component, at])
  @@index([hostKey, at])
  @@map("software_changes")
}

/// One update of a tool on a host: asked for from
/// the admin Software tab (or, from phase 3, the sweep), or recorded from a box's
/// own report for a boot or runner-guard run. No foreign keys, like host_software.
model SoftwareUpdateRun {
  id            String    @id @default(cuid())
  /// host_software's key: an instance id for a box.
  hostKey       String
  instanceId    String?
  component     String // claude
  trigger       String // manual | boot | guard | floor | resume | nightly
  /// Why an automatic run (floor, resume, nightly) was made, in words: the sweep's decision.
  reason        String?
  requestedById String?
  restart       String // none | idle | force
  status        String // requested | running | done | failed | refused | expired
  outcome       String? // updated | current | partial | failed
  target        String?
  fromVersion   String?
  toVersion     String?
  /// At most 2000 characters.
  detail        String?
  /// {stopped, resumed, fresh, cut, typed, other, runnersLeft}
  sessions      Json?
  requestedAt   DateTime  @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?

  @@index([hostKey, requestedAt])
  @@map("software_update_runs")
}

/// What the automatic tool sweep (services/toolUpdate/autoRuns.ts) keeps per box and tool between passes.
model ToolAutoUpdateState {
  /// host_software's key: an instance id.
  hostKey     String
  component   String
  /// When the sweep first saw the box with the tool's auto-update flag on: a box with no run is due a nightly run from here.
  firstSeenAt DateTime @default(now())
  /// The last pass that looked at the box with the flag on: a gap of over an hour starts firstSeenAt again.
  lastSeenAt  DateTime?
  /// The floor the box is below, and since when the sweep has seen it so (force after the policy's forceAfterHours). Null: not below.
  breachFloor String?
  breachSince DateTime?
  /// The last pass that saw the breach: a gap of over an hour (the flag off, no leader) starts the force clock again.
  breachSeenAt DateTime?

  @@id([hostKey, component])
  @@map("tool_auto_update_states")
}

/// The latest client version each user was seen with, per client kind.
model ClientVersion {
  userId     String
  kind       String // web | mobile | cli | tui | metaterm
  version    String
  lastSeenAt DateTime

  @@id([userId, kind])
  @@map("client_versions")
}

/// One agent started by another: the parent session
/// that asked, the workstream or project the child got, the brief it was
/// launched on, and what it reported back. The brief is claimed (launchedAt)
/// by the first launch of the child's agent pane.
model AgentSpawn {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// delegate | peer
  relationship     String
  parentProjectId  String?
  parentWorkstream String?
  parentRole       String?
  /// The parent's tmux session name at spawn time; the nudge types into it.
  parentSession    String?
  /// The commit the child's checkout was made from, when known; a local-only
  /// project's retire check counts against it.
  baseSha          String?
  parentInstanceId String?
  /// Null until a project-target create returns.
  childProjectId   String?
  childProjectName String
  childWorkstream  String
  childInstanceId  String?
  provider         String
  /// First line of the task.
  title            String
  /// The composed prompt-file content.
  brief            String
  depth            Int       @default(1)
  /// starting | running | done | blocked | needs_input | failed
  state            String    @default("starting")
  error            String?
  report           Json?
  launchedAt       DateTime?
  reportedAt       DateTime?
  nudgedAt         DateTime?
  /// The first spawn of this tree (itself for a root): cost and time roll up by it.
  rootSpawnId      String?
  /// When the child's agent pane or workstream went away.
  endedAt          DateTime?
  /// Parked: its agent CLI was stopped after it finished.
  /// Its worktree and conversation stay, and it can be resumed. Null = not parked.
  parkedAt         DateTime?
  /// Retired: its workstream was removed (or its project archived). Final.
  retiredAt        DateTime?
  /// Why the last retire was refused (dirty, unpushed, unknown), shown to the owner.
  keptReason       String?
  /// Foster parent: who gets this child's
  /// reports and nudges once its own parent is gone. The parent* fields stay
  /// as they were, for history. Null = the original parent.
  fosterProjectId  String?
  fosterWorkstream String?
  fosterRole       String?
  adoptedAt        DateTime?
  /// ancestor | home | owner | agent
  adoptedBy        String?
  /// Its parent went away and nobody alive could take it: it gathers on the
  /// dashboard and in the briefing until adopted.
  orphanedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([rootSpawnId])
  @@index([parentProjectId, parentWorkstream])
  @@index([childProjectName, childWorkstream])
  @@map("agent_spawns")
}

/// One "hand off" of an agent pane: the agent writes a
/// handoff, its context is cleared or compacted in place or the pane is
/// restarted (optionally on another provider), and the next agent starts on
/// the handoff. The handoff sweep (services/agentHandoffSweep.ts) moves it.
model AgentHandoff {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId           String
  workstream          String
  instanceId          String?
  /// The agent pane's tmux session when it was asked.
  session             String
  /// clear | compact | restart, after the provider fallback (see requestedMode).
  mode                String
  requestedMode       String
  fromProvider        String
  /// restart only, and only for a real switch; null = whatever the pane runs when it restarts.
  toProvider          String?
  /// person | agent
  initiator           String
  /// web | mobile | tui | cli | slack | mcp
  surface             String
  /// What the person or agent added for the next agent; part of the prompt file.
  note                String?
  /// requested | writing | written | resetting | done | failed | aborted
  state               String    @default("requested")
  reason              String?
  /// The handoff markdown, after the secret scan and size cap.
  body                String?
  /// Later: where the body lives if it moves out of Postgres (an S3 object).
  storageRef          String?
  contextTokensBefore Int?
  /// When the "write your handoff" line was typed (person-started handoffs).
  writeRequestedAt    DateTime?
  writtenAt           DateTime?
  /// When the reset (clear / compact / kill) was typed or done.
  resetAt             DateTime?
  /// restart only: when the old agent's pane was killed. A retry that finds it
  /// unset (the leader died between the claim and the kill) kills again.
  killedAt            DateTime?
  /// When the read-in line or the prompted launch was typed.
  launchedAt          DateTime?
  doneAt              DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([projectId, workstream, state])
  @@index([state])
  @@map("agent_handoffs")
}

/// A message one person sends colleagues through Slack about their work: a
/// typed card (kind) with one ask, posted by
/// the termag bot on the sender's behalf. An agent can only draft one; the
/// sender previews it in a Slack DM and sends it. Replies are CollabResponse
/// rows, told to the sender and to the asking agent's pane.
model CollabRequest {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// fyi | help (phase 1); decision | review | action | handoff later.
  kind           String
  ask            String
  /// string[]: 0-6 short bullets of context.
  context        Json             @default("[]")
  tried          String?
  helpWanted     String?
  /// A short excerpt (error lines, a diff hunk), posted as the first thread reply.
  evidence       String?
  /// string[]: PR, doc or dashboard URLs.
  links          Json             @default("[]")
  /// Where it is about. Null workstream = main.
  projectId      String?
  workstream     String?
  /// The agent pane that drafted it, for the reply nudge. Null = written in the web UI.
  fromSession    String?
  fromRole       String?
  fromInstanceId String?
  /// "agent" (drafted by an agent, previewed in Slack) | "web" (written and sent in the UI).
  origin         String           @default("agent")
  /// Where it goes: "project" (the workstream's channel), a channel id, or null for a DM to people[0].
  toChannel      String?
  /// string[]: Slack user ids to mention (channel) or DM (one person, no channel).
  toPeople       Json             @default("[]")
  /// draft | sending (claimed by a Send in flight) | open | resolved | canceled
  state          String           @default("draft")
  previewChannel String?
  previewTs      String?
  slackChannel   String?
  slackTs        String?
  permalink      String?
  sentAt         DateTime?
  resolvedAt     DateTime?
  resolvedBy     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  responses      CollabResponse[]

  @@index([userId, createdAt])
  @@index([projectId, workstream])
  @@index([slackChannel, slackTs])
  @@map("collab_requests")
}

/// One reply to a CollabRequest: a thread reply or the card's Reply modal.
/// The text is the responder's words: shown to the sender, and to the asking
/// agent only as untrusted data.
model CollabResponse {
  id               String        @id @default(cuid())
  requestId        String
  request          CollabRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  responderSlackId String
  responderName    String?
  text             String
  /// thread | modal
  source           String
  slackTs          String?
  /// When the sender was DMed about it, and when the asking agent's pane was told.
  notifiedAt       DateTime?
  nudgedAt         DateTime?
  createdAt        DateTime      @default(now())

  @@unique([requestId, slackTs])
  @@index([requestId, createdAt])
  @@index([nudgedAt])
  @@map("collab_responses")
}

/// What happened to agent spawns, refusals included.
/// Append-only; swept after 90 days. `detail` carries counts and reasons,
/// never brief, report or pane text.
model SpawnEvent {
  id         String   @id @default(cuid())
  /// Null for a refused request: it never got a spawn row.
  spawnId    String?
  userId     String
  /// requested | refused | created | launched | reported | nudged | failed | ended
  kind       String
  /// The refusal reason, report status or ending, as one word.
  reason     String?
  /// The box the child runs on (or would have).
  instanceId String?
  parentProjectId  String?
  parentWorkstream String?
  detail     Json?
  at         DateTime @default(now())

  @@index([userId, at])
  @@index([kind, at])
  @@index([spawnId])
  @@map("spawn_events")
}

/// A box's five-minute host sample, kept 30 days.
/// `Instance` keeps only the latest reading; this is the history.
model HostSample {
  id           String   @id @default(cuid())
  instanceId   String
  at           DateTime @default(now())
  diskUsedPct  Int?
  memUsedPct   Int?
  load1        Float?
  cores        Int?
  memTotalMb   Int?
  /// Agent-role tmux sessions alive on the box.
  liveAgents   Int?
  /// Of those, spawned agents that have not ended.
  spawnedLive  Int?

  @@index([instanceId, at])
  @@index([at])
  @@map("host_samples")
}

// Daily engagement-ladder segment per user. Written by
// the segment tracker (services/segments/tracker.ts) once a day per user, so
// the admin Segments tab and the history queries read precomputed rows.
model UserSegmentDaily {
  id          String @id @default(cuid())
  userId      String
  date        String // YYYY-MM-DD, UTC — one row per user per evaluated day
  segment     String // New | Power | Active | Passive | Dormant | Service
  agentMs     Int    @default(0) // the signals that drove the active-day flag
  humanMs     Int    @default(0)
  tokenRows   Int    @default(0)
  visited     Boolean @default(false)
  computedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
  @@map("user_segment_daily")
}

/// An automation: a project (kind "automation") whose prompt a fresh agent runs
/// on a cron schedule, each run in its own workstream as one chat-runner turn.
model Automation {
  id                  String    @id @default(cuid())
  projectId           String    @unique
  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId              String
  /// 5-field cron, normalised (services/automations/schedule.ts).
  schedule            String
  /// IANA zone the schedule is read in.
  timezone            String
  /// The owner's text; the brief wraps it (services/automations/brief.ts).
  prompt              String
  /// chat: each run is a chat-runner turn on the box (the default). t3: each run calls a
  /// T3 Code scheduled task's webhook on the box's t3 server, which starts its thread there;
  /// its hook is in user_credentials as `t3h-<id>`.
  kind                String    @default("chat")
  /// The T3 scheduled task a t3 automation starts, as the box's t3 server names it.
  t3TaskId            String?
  /// full | read: the turn's permission tier (decision 4).
  tier                String    @default("full")
  enabled             Boolean   @default(true)
  /// The brief asks the run to push and open a draft PR when it committed.
  prOnChange          Boolean   @default(true)
  /// Start a stopped or hibernated box for a run.
  wakeBox             Boolean   @default(false)
  maxRunMinutes       Int       @default(60)
  /// Finished runs beyond this many lose their worktree; the rows stay.
  keepRuns            Int       @default(20)
  /// The space the automation lives in: its folder holds the notes mirror, state, run logs and outputs (services/automations/spaceSync.ts).
  spaceName           String?
  /// The folder in spaceName (no leading or trailing slash): .termag/automations/<id>, written when a space is attached (services/automations/spaceFolder.ts); null with no space. A row from before the fixed folder keeps its old one (automations/<name>, a chosen one, or automations/<projectId>) until scripts/moveAutomationFolders.ts moves it.
  spaceFolder         String?
  /// The box whose SpaceBox grant to spaceName this automation added (spaceSync.ts); removed again when the mirror is unwound.
  mirrorGrantBoxId    String?
  /// Post each finished run's report to the project's Slack channel (services/automations/report.ts).
  notifySlack         Boolean   @default(false)
  /// Why the scheduler stopped starting runs; null = fine. Cleared by a PATCH.
  pausedReason        String?
  consecutiveFailures Int       @default(0)
  /// Wakes of the box EC2 refused in a row (Insufficient capacity, most often), when that streak began and the last error; the next start that takes clears all three (scheduler.ts noteBoxStartFailure).
  boxStartFailures    Int       @default(0)
  boxStartFailingSince DateTime?
  boxStartError       String?
  /// Cached from the schedule on every save and after every occurrence.
  nextRunAt           DateTime?
  /// The newest occurrence the scheduler has enumerated (decision 7).
  lastOccurrence      DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  runs                AutomationRun[]

  @@index([userId])
  @@index([enabled, nextRunAt])
  @@map("automations")
}

/// One occurrence of an automation: a run (its workstream and chat turn), or
/// why no run happened.
model AutomationRun {
  id            String     @id @default(cuid())
  automationId  String
  automation    Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  /// schedule | manual
  trigger       String
  /// The occurrence minute, or the click time for a manual run.
  scheduledFor  DateTime
  /// pending | running | done | blocked | needs_input | failed | skipped
  state         String
  /// skipped: previous_running | box_concurrent | box_unavailable | box_gone | missed | flag_off | budget | paused | runner_outdated | disabled
  /// failed:  timeout | interrupted | runner-error | launch | <exit>
  reason        String?
  /// The run's workstream; its id is half of the chat key (services/chatRunner.ts chatKeyFor).
  /// Set null when the worktree goes (keepRuns, Retire, a deleted workstream); the row stays.
  workstreamId  String?    @unique
  workstream    Workstream? @relation(fields: [workstreamId], references: [id], onDelete: SetNull)
  instanceId    String?
  /// Claude's session id from the turn's init event.
  chatSessionId String?
  /// The text after STATUS: in the run's last message.
  summary       String?
  branch        String?
  prUrl         String?
  costUsd       Float?
  inputTokens   Int?
  outputTokens  Int?
  /// What the run left on its branch, read at its end (services/automations/report.ts): commits beyond the default branch, pushed, uncommitted changes.
  commitsAhead  Int?
  pushed        Boolean?
  dirty         Boolean?
  /// The Slack report was posted.
  reportedAt    DateTime?
  /// Why the space step was skipped or failed for this run (a refusal code, or `<file> <direction> <outcome>`); null = synced, or no space.
  spaceSyncError String?
  startedAt     DateTime?
  finishedAt    DateTime?
  /// The worktree was removed (keepRuns, or the owner's Retire); the row stays.
  retiredAt     DateTime?
  createdAt     DateTime   @default(now())

  @@unique([automationId, scheduledFor, trigger])
  @@index([automationId, createdAt])
  @@index([state, startedAt])
  @@map("automation_runs")
}

/// A preview share: one workstream's browser pane, for
/// a named termag user (audience `user`) or, in phase 2, anyone signed in who
/// holds the link (audience `link`). Only the browser socket's guest path reads
/// it: nothing else treats it as access to the project, so a check forgotten
/// elsewhere cannot widen it.
model PreviewShare {
  id            String               @id @default(cuid())
  projectId     String
  project       Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// The workstream's row; null for a project's implicit main (a project with
  /// no workstream rows yet). An id, not a name: a rename keeps the share.
  workstreamId  String?
  workstream    Workstream?          @relation(fields: [workstreamId], references: [id], onDelete: Cascade)
  ownerId       String
  owner         User                 @relation("previewSharesOwned", fields: [ownerId], references: [id], onDelete: Cascade)
  /// user | link
  audience      String
  granteeId     String?
  grantee       User?                @relation("previewSharesGranted", fields: [granteeId], references: [id], onDelete: Cascade)
  /// sha256 of the link's 128-bit token (audience link); the token itself is never stored.
  linkTokenHash String?              @unique
  /// { kind: 'webapp-dev-stack' } | { kind: 'manual', origins: [...] }; the
  /// agent resolves it at every attach (agent/browser-guest.js).
  originRecipe  Json
  /// Phase 2: the PR a link share was made for, and the comment that carries it.
  prRepo        String?
  prNumber      Int?
  prCommentId   String?
  /// The PR's head commit as GitHub last said (at the share, then each sweep): the guest header's "PR head".
  prHeadOid     String?
  /// 4d: the PR's head branch when shared. A guest is refused while the
  /// share's checkout is on another branch (routes/browserWs.ts).
  prHeadBranch  String?
  /// 4d: the PR's checkout on the box, its resolved top level, when it isn't
  /// the workstream's own (`~/src/<repo>`, a plain worktree). Seam 1
  /// (shareTarget) shows it in place of the workstream's directory.
  checkoutDir   String?
  wakeAllowed   Boolean              @default(false)
  expiresAt     DateTime
  revokedAt     DateTime?
  /// Set with endedReason when the share ends for any reason; null while it is active.
  endedAt       DateTime?
  /// One active link share per workstream: the workstream's key (its id, or
  /// `<projectId>:main` for an implicit main) while a link share is active,
  /// cleared when it ends. A unique nullable column rather than a partial
  /// index, which Prisma can't express and `db push` (how deploys sync the
  /// schema) would never create: ended shares are null, so they never block
  /// a new share for the same PR after a revoke or a reopen.
  activeLinkKey String?              @unique
  /// revoked | expired | merged | closed | superseded | workstream-removed | project-archived | token-invalid
  endedReason   String?
  lastOpenedAt  DateTime?
  createdAt     DateTime             @default(now())
  viewers       PreviewShareViewer[]
  events        PreviewShareEvent[]

  @@index([granteeId])
  @@index([projectId])
  @@index([workstreamId])
  @@map("preview_shares")
}

/// Someone who opened a preview share, from their first open: their own
/// browser profile, their audit trail, and an owner can revoke them alone.
model PreviewShareViewer {
  id            String       @id @default(cuid())
  shareId       String
  share         PreviewShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstOpenedAt DateTime     @default(now())
  lastOpenedAt  DateTime     @default(now())
  revokedAt     DateTime?

  @@unique([shareId, userId])
  @@index([userId])
  @@map("preview_share_viewers")
}

/// What happened to a preview share: created | opened | refused | woke |
/// blocked-origin | revoked | extended | ended. `reason` says why for a
/// refusal or an end.
model PreviewShareEvent {
  id      String       @id @default(cuid())
  shareId String
  share   PreviewShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  actorId String?
  kind    String
  reason  String?
  detail  Json?
  at      DateTime     @default(now())

  @@index([shareId, at])
  @@map("preview_share_events")
}

/// A project's preview-share settings: PR
/// link shares on or off, the recipe they use, and the sign-in hint shown to
/// reviewers. Phase 1 creates the table; phase 2 reads it.
model PreviewShareSettings {
  projectId           String   @id
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  prLinksEnabled      Boolean  @default(false)
  originRecipe        Json?
  reviewerAccountHint String?
  /// Phase 2, 4c: share a PR automatically only when it changes a path under one of these prefixes; empty, any PR.
  pathFilter          String[] @default([])
  updatedAt           DateTime @updatedAt

  @@map("preview_share_settings")
}

/// Who may see a preview of a workstream, whatever delivers it
/// (services/previewAudience.ts
/// owns these four tables). One audience, one or more deliveries, each with
/// its own token: a PreviewLink today; preview shares and webapp-attach's
/// AttachGrant are meant to become deliveries on it later. Ending an audience
/// ends every delivery on it, through previewAudience.ts's end hook.
model PreviewAudience {
  id           String      @id @default(cuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Null for a project's implicit main, as PreviewShare.
  workstreamId String?
  workstream   Workstream? @relation(fields: [workstreamId], references: [id], onDelete: Cascade)
  /// Who made it: the project's owner or a collaborator.
  ownerId      String
  owner        User        @relation("previewAudiencesOwned", fields: [ownerId], references: [id], onDelete: Cascade)
  /// owner (the project's owner and collaborators) | people (and the grantees) | link (and anyone with a delivery's token)
  kind         String
  /// The audience's one expiry; a grantee may also have their own (PreviewAudienceGrantee.expiresAt).
  expiresAt    DateTime
  /// Set when someone revoked it, beside endedAt.
  revokedAt    DateTime?
  /// Set with endReason when it ends for any reason; null while it is live.
  endedAt      DateTime?
  /// expired | revoked | box-gone | project-gone | workstream-gone | kill-switch | admin
  endReason    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  grantees     PreviewAudienceGrantee[]
  viewers      PreviewAudienceViewer[]
  events       PreviewAudienceEvent[]
  links        PreviewLink[]

  @@index([projectId])
  @@index([workstreamId])
  @@index([ownerId])
  @@index([expiresAt])
  @@map("preview_audiences")
}

/// A termag user a `people` (or `link`) audience names (A1). Every viewer is a termag user (A2).
model PreviewAudienceGrantee {
  id         String          @id @default(cuid())
  audienceId String
  audience   PreviewAudience @relation(fields: [audienceId], references: [id], onDelete: Cascade)
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// This person's own expiry, before the audience's; null: the audience's alone. Links leave it null.
  expiresAt  DateTime?
  createdAt  DateTime        @default(now())

  @@unique([audienceId, userId])
  @@index([userId])
  @@map("preview_audience_grantees")
}

/// Who opened a preview (A3), whatever delivered it, as PreviewShareViewer.
model PreviewAudienceViewer {
  id            String          @id @default(cuid())
  audienceId    String
  audience      PreviewAudience @relation(fields: [audienceId], references: [id], onDelete: Cascade)
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstOpenedAt DateTime        @default(now())
  lastOpenedAt  DateTime        @default(now())
  /// Set when the owner removes them, as PreviewShareViewer.revokedAt: every
  /// way in is refused until a renew names them again.
  revokedAt     DateTime?

  @@unique([audienceId, userId])
  @@index([userId])
  @@map("preview_audience_viewers")
}

/// created | opened | refused | revoked | extended | ended | viewer-removed | requested, as PreviewShareEvent.
model PreviewAudienceEvent {
  id           String          @id @default(cuid())
  audienceId   String
  audience     PreviewAudience @relation(fields: [audienceId], references: [id], onDelete: Cascade)
  /// The actor's user id; null for the sweep and the system.
  actorId      String?
  kind         String
  reason       String?
  /// The delivery it happened on (`link` and its id), or null for the audience itself.
  deliveryKind String?
  deliveryId   String?
  detail       Json?
  at           DateTime        @default(now())

  @@index([audienceId, at])
  @@map("preview_audience_events")
}

/// A preview audience delivered at <name>.<PREVIEW_LINKS_DOMAIN>: a port on the
/// workstream's box. From #167's
/// PublishedPort. Who may open it, its expiry and its end are its audience's;
/// what is the link's own is here: its name, port, host mode and token.
model PreviewLink {
  id            String          @id @default(cuid())
  audienceId    String
  audience      PreviewAudience @relation(fields: [audienceId], references: [id], onDelete: Cascade)
  /// The hostname label (PRD P2), kept for history. Not unique: ended links keep
  /// it. Which link a name serves is PreviewLinkName.linkId.
  name          String
  /// The link's own host is <name>--<hostSuffix>.<domain> (SR19): 6 random
  /// base32 characters, minted with each new link, kept by renew and extend.
  /// The database default fills rows that predate it, for `db push` as for the
  /// migration: md5 hex with the four digits base32 lacks mapped to w-z. The
  /// app always writes its own.
  hostSuffix    String          @default(dbgenerated("substr(translate(md5((random())::text), '0189'::text, 'wxyz'::text), 1, 6)"))
  port          Int
  /// sha256 of the link's own 128-bit token (a `link` audience); the token is
  /// never stored. Per delivery, never the audience's (SR11).
  linkTokenHash String?         @unique
  /// localhost | public (PRD U2)
  hostMode      String          @default("localhost")
  /// The PreviewLinkRequest an agent made, when the link came from one (P4).
  requestId     String?         @unique
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  /// The reservation, while this is the link its name serves.
  nameRow       PreviewLinkName?
  codes         PreviewLinkCode[]
  sessions      PreviewLinkSession[]

  @@index([name])
  @@index([audienceId])
  @@map("preview_links")
}

/// A name's reservation (PRD P2, SR19). It has no relation a delete cascades
/// through: a project, workstream, owner or link going leaves it in place, so
/// a name stays held for 30 days after its link could last have worked.
model PreviewLinkName {
  name          String       @id
  /// The owner's user id, as a plain string (no relation): the same owner may
  /// take the name back at any time.
  ownerId       String
  /// Live link's expiresAt + 30 days, moved on every publish, renew and extend;
  /// now + 30 days on revoke or end. Never moved earlier.
  reservedUntil DateTime
  /// The link this name serves now; null once that link is deleted (a cascade
  /// from its project, workstream or owner), which leaves the reservation in place.
  linkId        String?      @unique
  link          PreviewLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@index([reservedUntil])
  @@map("preview_link_names")
}

/// The one-time handoff from the landing page to the preview host (60 s, single use).
model PreviewLinkCode {
  /// sha256 of 256 random bits
  codeHash      String      @id
  linkId        String
  link          PreviewLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  userId        String
  /// Why the viewer was let in: owner | collaborator | grant | token. For token,
  /// the linkTokenHash it matched, so the exchange checks it was not rotated since.
  basis         String
  tokenHash     String?
  /// Set for a re-verification: the session this code refreshes, not a new one.
  sessionIdHash String?
  /// The app path to land on: origin-form only, validated at the landing page.
  next          String
  expiresAt     DateTime

  @@index([linkId])
  @@index([expiresAt])
  @@map("preview_link_codes")
}

/// A viewer's session on one preview host. The cookie carries the id and its HMAC.
model PreviewLinkSession {
  /// sha256 of the cookie's 256-bit id
  idHash     String      @id
  linkId     String
  link       PreviewLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  /// As PreviewLinkCode's: what let the viewer in, checked again at each re-verification.
  basis      String
  tokenHash  String?
  /// The termag user (A2); deleting the user ends their sessions.
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// When termag access was last verified through the landing page; at most an hour ago (A2).
  verifiedAt DateTime
  /// min(link.expiresAt, created + 8 h)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime    @default(now())

  @@index([linkId])
  @@index([userId])
  @@index([expiresAt])
  @@map("preview_link_sessions")
}

/// A preview link change asked for with a device sign-in made on a box that
/// would let more people see the app (a `people` or `link` audience): nothing
/// is applied until the person who asked confirms it in their browser, at
/// `/termag/previews/confirm/<id>` (services/previewLinkConfirmations.ts). An
/// agent on that box can read the sign-in's token, but not the person's termag
/// session.
model PreviewLinkConfirmation {
  /// sha256 of the confirm URL's 256-bit id; the id itself is never stored.
  idHash     String    @id
  /// Who asked, and the only person who may confirm.
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// The box the asking sign-in was made on (CliSession.issuedOnBoxId).
  fromBoxId  String
  /// publish (a publish or renew) | extend
  kind       String
  /// What exactly to apply: the publish body, or { linkId, ttlHours }.
  request    Json
  /// pending | confirmed | declined | expired | failed
  state      String    @default("pending")
  /// Why a confirm failed to apply (the publish's own refusal), for the CLI.
  failure    String?
  /// The link it made or changed, once confirmed.
  linkId     String?
  /// A new link token's share URL, sealed: AES-256-GCM under a key derived
  /// from the confirm URL's raw id, which only its hash is stored beside, so the
  /// database alone (a backup) can't open it. Held only until the CLI that asked
  /// reads it once (services/previewLinkConfirmations.ts sealShareUrl).
  shareUrlSealed String?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  decidedAt  DateTime?

  @@index([userId])
  @@index([expiresAt])
  @@map("preview_link_confirmations")
}

/// An agent's ask for a link (P4), shown to the owner until they act on it.
model PreviewLinkRequest {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workstreamId String?
  boxId        String
  port         Int
  /// What the agent said the port is, shown as untrusted text (≤ 200 chars).
  note         String?
  /// pending | approved | declined | expired
  state        String    @default("pending")
  createdAt    DateTime  @default(now())
  decidedAt    DateTime?

  @@index([projectId, state])
  @@map("preview_link_requests")
}

/// One EC2 box's metered usage in one UTC hour. Written by
/// the box meter (services/boxCost/meter.ts) from EC2's own state every few
/// minutes, adding to the hour's row, so a cost is these seconds × the rates
/// in services/boxCost/rates.ts. Keyed by the EC2 id, not the Instance, so a
/// box running with no row behind it is metered too (instanceId null).
model BoxUsageHour {
  id            String   @id @default(cuid())
  ec2InstanceId String
  /// Start of the UTC hour.
  hour          DateTime
  /// Null: EC2 has the box and termag has no row for it.
  instanceId    String?
  /// The owner when last metered; null for a warm-pool box.
  userId        String?
  instanceType  String
  region        String
  /// EBS attached when last metered, all of it gp3.
  volumeGb      Int
  /// Running time, split by what the box was doing (meter.ts classify).
  activeSec     Int      @default(0)
  idleSec       Int      @default(0)
  poolSec       Int      @default(0)
  bootSec       Int      @default(0)
  orphanSec     Int      @default(0)
  /// GB × seconds the volumes existed, whatever the power state.
  storageGbSec  Float    @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([ec2InstanceId, hour])
  @@index([hour])
  @@index([userId, hour])
  @@map("box_usage_hours")
}

/// The box cost jobs' clocks. id `meter`: the meter's last tick, moved forward
/// with a guarded update, so two orchestrators overlapping in a deploy never
/// meter a span twice. id `bill`: the last successful Cost Explorer pull
/// (services/boxCost/bill.ts).
model BoxMeterState {
  id     String   @id @default("meter")
  tickAt DateTime

  @@map("box_meter_state")
}

/// One EC2 instance's billed compute on one UTC day, from Cost Explorer's
/// resource-level data (services/boxCost/bill.ts). Every instance in the
/// account, not only boxes: reconcile tells them apart by the meter's rows.
model BoxBilledDay {
  id            String   @id @default(cuid())
  /// YYYY-MM-DD, UTC.
  day           String
  ec2InstanceId String
  instanceType  String
  hours         Float
  /// Net amortized: after the Savings Plan and the enterprise discount.
  usd           Float
  /// Cost Explorer still marks the day estimated; a later pull replaces it.
  estimated     Boolean
  pulledAt      DateTime @default(now())

  @@unique([ec2InstanceId, day, instanceType])
  @@index([day])
  @@map("box_billed_days")
}

/// A rate learned from one day of the bill: an instance type's net amortized
/// $ per running hour, or key `ebs:gp3` for $ per GB-month.
model BoxRate {
  id        String   @id @default(cuid())
  day       String
  key       String
  usd       Float
  /// The hours (or GB-months) and cost the rate was divided from.
  usage     Float
  cost      Float
  estimated Boolean
  pulledAt  DateTime @default(now())

  @@unique([key, day])
  @@index([day])
  @@map("box_rates")
}

/// A termag bug that an agent or a person ran into, filed with `termag bug
/// report`. What the reporter sent is append-only: the
/// title, body, reporter and context are never edited. Only the triage fields
/// (status, duplicateOfId, linkUrl, triagedAt) change, from /admin/bugs, and
/// each change is a BugReportEvent. No foreign keys on the reporter or the
/// box, like admin_audit_log: a report outlives the box and the user.
model BugReport {
  id                   String    @id @default(cuid())
  /// The caller: a box credential's owner, or the signed-in person.
  reporterUserId       String
  /// `box` (the box's own credential) or `device` (a `termag login`).
  credential           String
  /// The box the report came from: the credential's box, else the project's.
  boxId                String?
  /// From the CLI's TERMAG_PROJECT_ID / TERMAG_WORKSTREAM, kept only when the
  /// project is the reporter's. threadId when the workstream is an ask's.
  projectId            String?
  workstream           String?
  threadId             String?
  /// The coding agent that filed it, as the caller says (claude, codex, …).
  agentProvider        String?
  agentModel           String?
  agentVersion         String?
  title                String
  /// Markdown.
  body                 String
  /// low | medium | high
  severity             String    @default("medium")
  /// spaces | asks | publish | boxes | chat | cli | broker | other
  area                 String    @default("other")
  cliVersion           String?
  /// What the orchestrator knew of the box's agent when the report came in.
  boxAgentCommit       String?
  boxAgentCapabilities String[]  @default([])
  boxImage             String?
  /// The command that went wrong and its error output, as the caller sent them.
  command              String?
  errorOutput          String?
  /// The kinds of secret-shaped strings replaced before storing (secretPatterns.ts).
  redacted             String[]  @default([])
  /// new | triaged | duplicate | fixed | wontfix
  status               String    @default("new")
  duplicateOfId        String?
  /// A GitHub issue or pull request.
  linkUrl              String?
  triagedAt            DateTime?
  createdAt            DateTime  @default(now())
  events               BugReportEvent[]

  @@index([status, createdAt])
  @@index([boxId, createdAt])
  @@index([reporterUserId, createdAt])
  @@map("bug_reports")
}

/// One triage change to a BugReport, by an admin: the fields it set (null:
/// unchanged; linkUrl "" cleared the link). The detail page's history; the
/// admin audit log records the request too.
model BugReportEvent {
  id            String    @id @default(cuid())
  reportId      String
  report        BugReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actorId       String
  status        String?
  duplicateOfId String?
  linkUrl       String?
  note          String?
  createdAt     DateTime  @default(now())

  @@index([reportId, createdAt])
  @@map("bug_report_events")
}
