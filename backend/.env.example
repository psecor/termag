# =============================================================================
# termag backend configuration
# =============================================================================
# Copy this file to .env and fill in real values. Variables without a default
# are required.

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/termag"

# Public-facing URL where the frontend is served. Must match what your reverse
# proxy exposes (Slack OAuth callbacks and CORS depend on this).
FRONTEND_URL="https://example.com"

# Subpath the app is mounted at behind the reverse proxy. Use "" if mounted at
# the domain root, or e.g. "/termag" if proxied at https://example.com/termag.
BASE_PATH="/termag"

# Extra origins (comma-separated) allowed to open a browser WebSocket, beyond
# the origin of FRONTEND_URL (always allowed). The WebSocket upgrade handler
# rejects any browser handshake whose Origin isn't listed, so a page on another
# same-site origin can't ride the session cookie to open a terminal. Only set
# this if the UI is legitimately served from more than one host.
# ALLOWED_WS_ORIGINS="https://alt.example.com"

# Port the Express server listens on (your reverse proxy forwards to this).
PORT=3040
# Interface to listen on. Unset listens on all interfaces. AUTH_MODE=local
# requires 127.0.0.1 or ::1.
# BIND_HOST="127.0.0.1"

# Express session secret. Generate with: openssl rand -hex 32
SESSION_SECRET="replace-with-random-secret"

# Alternative to DATABASE_URL for platforms that inject discrete Postgres
# variables: when DATABASE_URL is unset it is composed from these at startup
# (PG_USER is accepted as an alias for PG_USERNAME; PG_PASSWORD and PG_SSLMODE
# are optional).
# PG_HOST=""
# PG_PORT="5432"
# PG_DATABASE="termag"
# PG_USERNAME=""
# PG_PASSWORD=""
# PG_SSLMODE="require"
#
# RDS IAM authentication (Aurora behind RDS Proxy): no
# password — a short-lived IAM token is minted per connection for PG_USERNAME.
# Prisma then runs through a node-postgres pool (backend/src/db.ts). The
# signing region comes from PG_IAM_REGION, else AWS_REGION, else the RDS
# hostname. TLS is required by RDS; the container image bakes Amazon's CA bundle
# at /app/certs/rds-global-bundle.pem (PG_SSL_CA_FILE overrides) so the server
# certificate is verified. `npm run db:push` uses the same rules.
# PG_IAM_AUTH="true"
# PG_IAM_REGION="us-east-1"
# PG_SSL_CA_FILE="/app/certs/rds-global-bundle.pem"
# PG_POOL_MAX="10"

# Whether this orchestrator can run tmux sessions in-process for "legacy"
# projects that have no box (Project.instanceId == null). Default true (the EC2
# host). Set to false where there is no tmux / no engineer home directories —
# the container image bakes this in — so those code paths fail fast with an
# actionable error and every project must live on a box or a self-managed agent.
# LOCAL_SESSIONS_ENABLED="true"

# Provision host accounts on demand (services/hostSetup.ts). When "true", the
# first time a signed-in user needs the orchestrator (login, a "this host"
# project, MetaTerm) and has no host agent connected, the backend mints their
# host agent token and runs /usr/local/sbin/termag-host-setup through sudo,
# which creates their unix account and starts their agent. Needs the
# orchestrator AMI's helper + sudoers rule; set by the Termag cloud-init only.
# Leave unset where agents are installed by hand.
# HOST_AUTOSETUP="true"

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

# AUTH_MODE selects the sign-in mechanism (see backend/src/routes/auth.ts):
#   google  (default) in-app Google OAuth; needs GOOGLE_CLIENT_ID/SECRET.
#   okta    identity established at the edge by an AWS ALB authenticate-oidc
#           action (Okta, where Kolide device trust is enforced). The app
#           verifies the ALB-signed `x-amzn-oidc-data` header. Only valid
#           behind such an ALB.
#             ALB_ARN             the ALB whose signature is accepted (required;
#                                 signing keys are shared by every ALB in a region)
#             ALB_OIDC_ISSUER     the Okta issuer the ALB authenticates against (required)
#             ALB_OIDC_CLIENT_ID  the Okta app's client id (required)
#   oidc    in-app OpenID Connect code flow (PKCE) against any issuer — for
#           deployments with no ALB edge auth, e.g. the container behind a
#           Kubernetes ingress. Register the redirect URI
#           <FRONTEND_URL><BASE_PATH>/auth/oidc/callback on the OIDC app.
#   local   no identity provider: /auth/login signs in as the first
#           ALLOWED_USERS identity. For the local e2e stack (make e2e-up) only;
#           the server refuses to start with it unless NODE_ENV is development
#           or test and BIND_HOST is a loopback address, and refuses sign-ins
#           a same-host proxy forwarded from another host.
# In every mode ALLOWED_USERS (below) is the fine-grained gate.
# AUTH_MODE="google"
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# ALB_ARN="arn:aws:elasticloadbalancing:us-east-1:...:loadbalancer/app/..."
# ALB_OIDC_ISSUER="https://your-org.okta.com/oauth2/default"
# ALB_OIDC_CLIENT_ID=""
# OIDC_ISSUER_URL="https://your-org.okta.com"
# OIDC_CLIENT_ID=""
# OIDC_CLIENT_SECRET=""
# OIDC_SCOPE="openid profile email"

# Comma-separated list of allowed sign-ins (Okta email -> unix user). Each entry:
#   email:unixuser        exact mapping (highest priority)
#   @domain.com           anyone in the domain; unix username = email local part
#   @domain.com:unixuser  anyone in the domain mapped to a fixed unix username
# Example: ALLOWED_USERS="admin@example.com:root,@example.org"
# Note: unix usernames are NOT auto-provisioned on the host — make sure each
# mapped or derived username corresponds to a real unix user, or the account's
# first agent operation will fail.
ALLOWED_USERS="you@example.com:youruser"

# Who may open the admin view (/termag/admin, /api/admin) and the admin MCP
# server (/termag/mcp/admin). Comma-separated emails or @domains; a trailing
# ":unixuser" is ignored so ALLOWED_USERS entries can be pasted as-is. Synced
# into users.role at startup (these admins cannot be demoted from the UI);
# further admins can be granted from the Settings tab. Unset = nobody is an
# admin.
# ADMIN_USERS="you@example.com"

# -----------------------------------------------------------------------------
# Slack integration (optional — leave unset to disable)
# -----------------------------------------------------------------------------

# Slack app credentials. Create the app at https://api.slack.com/apps
# Required scopes are documented in deploy/setup.md.
SLACK_BOT_TOKEN="xoxb-..."
SLACK_APP_TOKEN="xapp-..."          # Socket Mode app-level token
SLACK_SIGNING_SECRET="..."

# Comma-separated list mapping allowed Slack user IDs → unix usernames.
# Format: U01ABCDEF:youruser,U02GHIJKL:otheruser
ALLOWED_SLACK_USERS="U01ABCDEF:youruser"

# -----------------------------------------------------------------------------
# Discord integration (optional — leave unset to disable)
# -----------------------------------------------------------------------------

DISCORD_TOKEN=""
DISCORD_APP_ID=""

# Comma-separated list mapping Discord user IDs → unix usernames.
# Format: 123456789012345678:youruser
DISCORD_USER_MAP=""

# -----------------------------------------------------------------------------
# Local relay (Chrome tab capture)
# -----------------------------------------------------------------------------

# Token the local Chrome relay uses to authenticate to the backend.
# Generate with: openssl rand -hex 32
RELAY_TOKEN="replace-with-random-relay-token"

# -----------------------------------------------------------------------------
# Pane capture API (used by Claude Code Stop hook → backend)
# -----------------------------------------------------------------------------

# Shared secret hooks use to POST captured panes to the backend.
# Generate with: openssl rand -hex 32
CAPTURE_API_SECRET="replace-with-random-capture-secret"

# -----------------------------------------------------------------------------
# Box provisioning (optional — the "Add box" button)
# -----------------------------------------------------------------------------
# When all required vars below are set, POST /api/instances launches an EC2 box
# via the AWS SDK under the box-provisioning IAM grant. Leave them unset to
# fall back to the legacy manual-terraform path (POST returns a raw token to
# paste into `terraform apply` in terraform/box/). Most values are outputs of
# your own box-provisioning terraform (the EC2-host module, or an off-host
# provisioning module for a containerised orchestrator).
# Credentials come from the ambient identity (instance role / pod identity) —
# no keys here — optionally chained through BOX_PROVISIONER_ROLE_ARN.
#
# AWS region the boxes (and the SDK clients) live in.
# AWS_REGION="us-east-1"
#
# Optional: role in the BOX account to assume for every EC2/IAM call. Set this
# when the orchestrator's own identity lives in another account (e.g. an EKS
# pod identity); leave unset on the EC2 host, whose instance role holds the
# grant directly. Module output: box_provisioner_role_arn.
# BOX_PROVISIONER_ROLE_ARN="arn:aws:iam::ACCOUNT:role/development-termag-box-provisioner"
#
# WebSocket URL the box's agent dials. Baked into the box's user_data. On the
# EC2 host this is internal, host-to-host on the backend port; for a container
# it is the ingress hostname (wss://...), which must let /termag/ws/agent and
# /termag/api/status through without browser auth (they are bearer-token
# authenticated). Module output: agent_ws_url.
# AGENT_WS_URL="ws://ip-10-0-0-5.us-east-1.compute.internal:3040/termag/ws/agent"
#
# Agents send their token on that socket as `Authorization: Bearer`. Agents
# from before that send it as ?token=, which lands in nginx and ALB request
# logs; set this to false to refuse them once the admin System page shows none
# left ("agent token in URL"). Default: accepted.
# AGENT_WS_QUERY_TOKEN="true"
#
# Overlapping deploys. With the lease
# on, the newest process does the singleton work and the one it displaced
# drains: /termag/health/serving answers 503, new WebSockets are refused with
# 4503, and after the grace it closes its box agents' sockets with 4503, then
# its browsers' (the browser delay later); they reconnect to the new process.
# Off (the default), the process always serves. Never turn it on for a second
# backend that shares the production database without being a deploy (a
# mirror): it would take over.
# ORCHESTRATOR_LEASE="true"
# ORCHESTRATOR_LEASE_HEARTBEAT_MS="5000"
# ORCHESTRATOR_LEASE_STALE_MS="30000"
# ORCHESTRATOR_DRAIN_GRACE_MS="45000"
# ORCHESTRATOR_DRAIN_BROWSER_DELAY_MS="1500"
#
# Prefix for every per-box AWS resource (SG / role / instance profile). Must
# match the grant's resource-name condition. Module output: box_resource_prefix.
# BOX_RESOURCE_PREFIX="termag-box"
#
# Permissions boundary applied to each per-box role (the grant denies
# CreateRole without it). Module output: box_permissions_boundary_arn.
# BOX_PERMISSIONS_BOUNDARY_ARN="arn:aws:iam::ACCOUNT:policy/termag-box-boundary"
#
# VPC + private subnet (NAT route for outbound; no public IP) the boxes launch in.
# BOX_VPC_ID="vpc-..."
# BOX_SUBNET_ID="subnet-..."
#
# Optional: the orchestrator's HOST security group — boxes get a :3040 ingress
# rule added so their agent can reach the backend directly over the private VPC
# network (not via the ALB). Only meaningful on the EC2 host; leave unset for a
# container, whose agent endpoint reachability is the ingress/LB's job.
# Module output: host_security_group_id.
# HOST_SECURITY_GROUP_ID="sg-..."
#
# Instance type — MUST be arm64/Graviton; the box AMI is arm64-only. Default t4g.medium.
# BOX_INSTANCE_TYPE="t4g.medium"
#
# ManagedBy tag value the grant scopes tag-conditioned actions on. Module
# output: box_managed_tag. Default "termag-box".
# BOX_MANAGED_TAG="termag-box"
#
# Root EBS volume size in GB, as a FLOOR. Default 120. The provisioner raises
# it to the box AMI's snapshot size when the image is bigger, so a grown AMI
# cannot outrun this setting — EC2 rejects a launch whose root volume is under
# the snapshot. Set it only to give boxes *more* than the image needs.
# BOX_ROOT_VOLUME_GB="120"
#
# Optional: Secrets Manager ARN of a private-repo git PAT. When set, each box's
# role gets read access to just this secret (the box reads it at boot — it is
# deliberately NOT placed in user_data).
# BOX_GIT_TOKEN_SECRET_ARN="arn:aws:secretsmanager:REGION:ACCOUNT:secret:..."
#
# Hibernation (docs/box-hibernation.md). "true" launches new boxes with
# HibernationOptions and a root grown by the type's RAM size, but only from an
# AMI tagged Hibernation=supported on a type that supports it; every other box,
# and every box launched before, keeps plain Stop. Default off.
# BOX_HIBERNATION_ENABLED="true"
#
# EC2 supports at most 60 days hibernated. The power sweep resumes a box
# hibernated this many days and hibernates it again. Default 55, capped at 59,
# 0 = never (the box list still warns from day 50).
# BOX_HIBERNATION_REFRESH_DAYS="55"

# Optional: pull-only ECR for box roles (backend_env of the box-provisioning
# module, which writes the same list into the box boundary). Each box role gets
# a termag-box-ecr-pull inline policy on these repositories (pull-through-cache
# prefixes included), and existing box roles are backfilled at startup.
# Unset = boxes get no ECR access.
# BOX_ECR_PULL_REPOSITORY_ARNS="arn:aws:ecr:us-east-1:ACCOUNT:repository/example-org/dev/*,arn:aws:ecr:us-east-1:ACCOUNT:repository/docker.io/*"

# --- Auth once. Every block is optional and off unless all of
# its variables are set.
#
#
# Per-user credentials (the user's gh token), envelope-encrypted in Postgres
# (user_credentials) under this KMS key. It must be the key's ARN, not
# alias/termag-user-credentials: decryption matches the ARN stored with each data
# key. Boxes never receive the token: their git and gh go through the GitHub
# broker, a listener on the Claude gateway's Envoy, at GITHUB_BROKER_URL (no
# broker without it). It must be on 443: gh takes a bare hostname as a GitHub
# Enterprise host, never host:port.
# GITHUB_BROKER_URL="https://github-broker.termag.example.com"
#
# Orgs listed beside the signed-in user's own repos. Comma-separated slugs.
# Unset or blank uses example-org,example-labs. Bad slugs are dropped.
# GITHUB_REPO_ORGS="example-org,example-labs"
# How long a repo list is served before revalidation, in seconds. 0 revalidates
# on every request. Unset uses 600.
# GITHUB_REPO_CACHE_SECONDS="600"
#
# The gateway's checks. Envoy asks this backend about each GitHub broker
# request at /termag/internal/github-authz and each Claude call at
# /termag/internal/claude-authz, on the TLS agent listener. Both routes exist
# only with GATEWAY_AUTHZ_ALLOWED_CALLER_ARNS, the gateway task role(s) whose
# signed sts:GetCallerIdentity (replayed to GATEWAY_AUTHZ_STS_URL, default the
# AWS_REGION endpoint) proves the caller.
# GATEWAY_AUTHZ_ALLOWED_CALLER_ARNS="arn:aws:iam::ACCOUNT:role/termag-claude-gateway-task"
# CREDENTIAL_STORE_KMS_KEY_ID="arn:aws:kms:REGION:ACCOUNT:key/KEY_ID"
#
# termag CLI access tokens: RS256 JWTs the orchestrator ALB verifies (its
# jwt-validation rule on /termag/api/cli/*) against GET /termag/api/cli/v1/jwks.json.
# CLI_JWT_KMS_KEY_IDS lists asymmetric KMS keys (RSA_2048, SIGN_VERIFY), the
# signing key first; every listed key is published, so a new key goes on the
# end a day before it moves to the front. Unset signs with an in-memory key that
# does not survive a restart (fine locally). CLI_JWT_ISSUER must equal the ALB
# rule's issuer; it defaults to FRONTEND_URL + BASE_PATH.
# CLI_JWT_KMS_KEY_IDS="alias/termag-cli-jwt-1"
# CLI_JWT_ISSUER="https://termag.example.com/termag"
#
# Claude Code through the termag Bedrock gateway. CLAUDE_GATEWAY_URL is the
# Bedrock base URL Claude Code is pointed at; the models are inference-profile
# ids. Boxes send the gateway their own agent token, which it checks at
# /termag/internal/claude-authz (above), so the gateway also needs
# GATEWAY_AUTHZ_ALLOWED_CALLER_ARNS.
# CLAUDE_GATEWAY_URL="https://claude-gateway.termag.example.com"
# CLAUDE_BEDROCK_REGION="us-east-2"
# CLAUDE_BEDROCK_MODELS="opus=us.anthropic.claude-opus-...,sonnet=us.anthropic.claude-sonnet-...,haiku=us.anthropic.claude-haiku-..."
#
# Stop/start from the box menu. A stop EC2 still reports running after
# BOX_STOP_TIMEOUT_SECONDS goes back to ready; a start whose agent hasn't
# connected after BOX_START_TIMEOUT_SECONDS is reported on the box. Defaults
# 600 and 900; tests shorten them.
# BOX_STOP_TIMEOUT_SECONDS="600"
# BOX_START_TIMEOUT_SECONDS="900"
#
# Teardown retry. Terminating a box tears its AWS resources down in the
# background; a teardown a restart cut short (or one that failed) is re-run by
# the provisioning sweep, every BOX_PROVISIONING_SWEEP_SECONDS, for terminated
# boxes BOX_TEARDOWN_RETRY_SECONDS past both their termination and their last
# attempt. Defaults 300 and 600; the e2e stack shortens them.
# BOX_PROVISIONING_SWEEP_SECONDS="300"
# BOX_TEARDOWN_RETRY_SECONDS="600"

# -----------------------------------------------------------------------------
# Warm pool (off by default; leave the target at 0 in production)
# -----------------------------------------------------------------------------
# The reconciler holds a small pool of ownerless, pre-warmed EC2 boxes so an
# "Add box" click can hand one over instead of waiting out a cold provision.
# It needs the box provisioning block above to be configured.
#
# How many claimable warm boxes to hold. 0 (the default) means no pool at all:
# nothing is launched, anything already warm is drained, and every claim takes
# the cold path. An idle pool costs a running box's price per box, so set this
# only where a faster first box is worth that.
# WARM_POOL_TARGET_SIZE="0"
#
# Concurrent `warming` launches. Caps a refill storm so it cannot starve a real
# cold provision. 0 is a kill switch: whatever is warm stays, nothing new
# launches. Default 2.
# WARM_POOL_MAX_INFLIGHT="2"
#
# Reconciler tick interval in seconds. Each tick reads the pool's rows, and
# resolves the box AMI only when there is something to do. The AMI lookup
# behind the pool spec hash is cached for five minutes, so the tick interval
# does not set the DescribeImages rate. Default 60.
# WARM_POOL_RECONCILE_SECONDS="60"
#
# A warm box older than this is stale: a replacement is launched first and the
# old box is retired only once the pool is back at its target, so a rollover
# never leaves an empty window. Default 24.
# WARM_POOL_MAX_AGE_HOURS="24"

# -----------------------------------------------------------------------------
# Feature flags (optional)
# -----------------------------------------------------------------------------
# A JSON object of flag key to value. Unset, every flag uses its built-in
# fallback. The values apply to every user and are served to the browser at
# GET /termag/api/flags. Flags in use: warm-pool-enabled, repo-first-gate-enabled,
# repo-first-picker-enabled, box-auto-update-enabled, mobile-redirect-enabled,
# claude-cloud-sessions-ui (all default off) and hyperspace-background-enabled
# (defaults on).
# TERMAG_FLAGS='{"warm-pool-enabled": true}'

# -----------------------------------------------------------------------------
# Telemetry (optional)
# -----------------------------------------------------------------------------
# Where Claude cloud-session runners send their OpenTelemetry: an OTLP/HTTP
# collector origin and the routing key it files them under. Both or neither.
# OBSERVABILITY_OTLP_ENDPOINT="https://otel.example.com"
# OBSERVABILITY_PROJECT="termag"

# -----------------------------------------------------------------------------
# Tunables (all have defaults — override only if needed)
# -----------------------------------------------------------------------------

# Max seconds to wait for a `claude` CLI invocation before killing it.
CLAUDE_TIMEOUT_SECONDS=120

# Max characters of agent output sent back in a Slack/Discord response.
MAX_RESPONSE_LENGTH=3500

# Min seconds between successive DM commands from the same user.
RATE_LIMIT_SECONDS=2

# How often (ms) to flush partial streaming updates to Slack/Discord.
STREAMING_UPDATE_INTERVAL_MS=1500
