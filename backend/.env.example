# =============================================================================
# termag backend configuration
# =============================================================================
# Copy this file to .env and fill in real values. Variables without a default
# are required.

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/termag"

# Public-facing URL where the frontend is served. Must match what your reverse
# proxy exposes (Slack OAuth callbacks and CORS depend on this).
FRONTEND_URL="https://example.com"

# Subpath the app is mounted at behind the reverse proxy. Use "" if mounted at
# the domain root, or e.g. "/termag" if proxied at https://example.com/termag.
BASE_PATH="/termag"

# Port the Express server listens on (your reverse proxy forwards to this).
PORT=3040

# Express session secret. Generate with: openssl rand -hex 32
SESSION_SECRET="replace-with-random-secret"

# Alternative to DATABASE_URL for platforms that inject discrete Postgres
# variables: when DATABASE_URL is unset it is composed from these at startup
# (PG_USER is accepted as an alias for PG_USERNAME; PG_PASSWORD and PG_SSLMODE
# are optional).
# PG_HOST=""
# PG_PORT="5432"
# PG_DATABASE="termag"
# PG_USERNAME=""
# PG_PASSWORD=""
# PG_SSLMODE="require"
#
# RDS IAM authentication (Aurora behind RDS Proxy, e.g. on Shepherd): no
# password — a short-lived IAM token is minted per connection for PG_USERNAME.
# Prisma then runs through a node-postgres pool (backend/src/db.ts). The
# signing region comes from PG_IAM_REGION, else AWS_REGION, else the RDS
# hostname. TLS is required by RDS; the container image bakes Amazon's CA bundle
# at /app/certs/rds-global-bundle.pem (PG_SSL_CA_FILE overrides) so the server
# certificate is verified. `npm run db:push` uses the same rules.
# PG_IAM_AUTH="true"
# PG_IAM_REGION="us-east-1"
# PG_SSL_CA_FILE="/app/certs/rds-global-bundle.pem"
# PG_POOL_MAX="10"

# Whether this orchestrator can run tmux sessions in-process for "legacy"
# projects that have no box (Project.instanceId == null). Default true (the EC2
# host). Set to false where there is no tmux / no engineer home directories —
# the container image bakes this in — so those code paths fail fast with an
# actionable error and every project must live on a box or a self-managed agent.
# LOCAL_SESSIONS_ENABLED="true"

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

# AUTH_MODE selects the sign-in mechanism (see backend/src/routes/auth.ts):
#   google  (default) in-app Google OAuth; needs GOOGLE_CLIENT_ID/SECRET.
#   okta    identity established at the edge by an AWS ALB authenticate-oidc
#           action (Okta, where Kolide device trust is enforced). The app
#           verifies the ALB-signed `x-amzn-oidc-data` header. Only valid
#           behind such an ALB.
#             AWS_REGION  region whose ALB public-key endpoint signs the header
#             ALB_ARN     optional; pins the JWT signer to this ALB
#   oidc    in-app OpenID Connect code flow (PKCE) against any issuer — for
#           deployments with no ALB edge auth, e.g. the container behind a
#           Kubernetes ingress. Register the redirect URI
#           <FRONTEND_URL><BASE_PATH>/auth/oidc/callback on the OIDC app.
# In every mode ALLOWED_USERS (below) is the fine-grained gate.
# AUTH_MODE="google"
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# ALB_ARN="arn:aws:elasticloadbalancing:us-east-1:...:loadbalancer/app/..."
# OIDC_ISSUER_URL="https://your-org.okta.com"
# OIDC_CLIENT_ID=""
# OIDC_CLIENT_SECRET=""
# OIDC_SCOPE="openid profile email"

# Comma-separated list of allowed sign-ins (Okta email -> unix user). Each entry:
#   email:unixuser        exact mapping (highest priority)
#   @domain.com           anyone in the domain; unix username = email local part
#   @domain.com:unixuser  anyone in the domain mapped to a fixed unix username
# Example: ALLOWED_USERS="admin@example.com:root,@example.org"
# Note: unix usernames are NOT auto-provisioned on the host — make sure each
# mapped or derived username corresponds to a real unix user, or the account's
# first agent operation will fail.
ALLOWED_USERS="you@example.com:youruser"

# -----------------------------------------------------------------------------
# Slack integration (optional — leave unset to disable)
# -----------------------------------------------------------------------------

# Slack app credentials. Create the app at https://api.slack.com/apps
# Required scopes are documented in deploy/setup.md.
SLACK_BOT_TOKEN="xoxb-..."
SLACK_APP_TOKEN="xapp-..."          # Socket Mode app-level token
SLACK_SIGNING_SECRET="..."

# Comma-separated list mapping allowed Slack user IDs → unix usernames.
# Format: U01ABCDEF:youruser,U02GHIJKL:otheruser
ALLOWED_SLACK_USERS="U01ABCDEF:youruser"

# -----------------------------------------------------------------------------
# Discord integration (optional — leave unset to disable)
# -----------------------------------------------------------------------------

DISCORD_TOKEN=""
DISCORD_APP_ID=""

# Comma-separated list mapping Discord user IDs → unix usernames.
# Format: 123456789012345678:youruser
DISCORD_USER_MAP=""

# -----------------------------------------------------------------------------
# Local relay (Chrome tab capture)
# -----------------------------------------------------------------------------

# Token the local Chrome relay uses to authenticate to the backend.
# Generate with: openssl rand -hex 32
RELAY_TOKEN="replace-with-random-relay-token"

# -----------------------------------------------------------------------------
# Pane capture API (used by Claude Code Stop hook → backend)
# -----------------------------------------------------------------------------

# Shared secret hooks use to POST captured panes to the backend.
# Generate with: openssl rand -hex 32
CAPTURE_API_SECRET="replace-with-random-capture-secret"

# -----------------------------------------------------------------------------
# Box provisioning (optional — the "Add box" button)
# -----------------------------------------------------------------------------
# When all required vars below are set, POST /api/instances launches an EC2 box
# via the AWS SDK under the box-provisioning IAM grant. Leave them unset to
# fall back to the legacy manual-terraform path (POST returns a raw token to
# paste into `terraform apply` in terraform/box/). Most values are outputs of
# your own box-provisioning terraform (the EC2-host module, or an off-host
# provisioning module for a containerised orchestrator).
# Credentials come from the ambient identity (instance role / pod identity) —
# no keys here — optionally chained through BOX_PROVISIONER_ROLE_ARN.
#
# AWS region the boxes (and the SDK clients) live in.
# AWS_REGION="us-east-1"
#
# Optional: role in the BOX account to assume for every EC2/IAM call. Set this
# when the orchestrator's own identity lives in another account (e.g. an EKS
# pod identity); leave unset on the EC2 host, whose instance role holds the
# grant directly. Module output: box_provisioner_role_arn.
# BOX_PROVISIONER_ROLE_ARN="arn:aws:iam::ACCOUNT:role/development-termag-box-provisioner"
#
# WebSocket URL the box's agent dials. Baked into the box's user_data. On the
# EC2 host this is internal, host-to-host on the backend port; for a container
# it is the ingress hostname (wss://...), which must let /termag/ws/agent and
# /termag/api/status through without browser auth (they are bearer-token
# authenticated). Module output: agent_ws_url.
# AGENT_WS_URL="ws://ip-10-0-0-5.us-east-1.compute.internal:3040/termag/ws/agent"
#
# Prefix for every per-box AWS resource (SG / role / instance profile). Must
# match the grant's resource-name condition. Grant output: box_resource_prefix.
# BOX_RESOURCE_PREFIX="termag-box"
#
# Permissions boundary applied to each per-box role (the grant denies
# CreateRole without it). Grant output: box_permissions_boundary_arn.
# BOX_PERMISSIONS_BOUNDARY_ARN="arn:aws:iam::ACCOUNT:policy/termag-box-boundary"
#
# VPC + private subnet (NAT route for outbound; no public IP) the boxes launch in.
# BOX_VPC_ID="vpc-..."
# BOX_SUBNET_ID="subnet-..."
#
# Optional: the orchestrator's HOST security group — boxes get a :3040 ingress
# rule added so their agent can reach the backend directly over the private VPC
# network (not via the ALB). Only meaningful on the EC2 host; leave unset for a
# container, whose agent endpoint reachability is the ingress/LB's job.
# Module output: host_security_group_id.
# HOST_SECURITY_GROUP_ID="sg-..."
#
# Instance type — MUST be arm64/Graviton; the box AMI is arm64-only. Default t4g.medium.
# BOX_INSTANCE_TYPE="t4g.medium"
#
# ManagedBy tag value the grant scopes tag-conditioned actions on. Default
# "termag-box". Must match the tag your IAM grant scopes on.
# BOX_MANAGED_TAG="termag-box"
#
# Root EBS volume size in GB. Default 30.
# BOX_ROOT_VOLUME_GB="30"
#
# Optional: Secrets Manager ARN of a private-repo git PAT. When set, each box's
# role gets read access to just this secret (the box reads it at boot — it is
# deliberately NOT placed in user_data).
# BOX_GIT_TOKEN_SECRET_ARN="arn:aws:secretsmanager:REGION:ACCOUNT:secret:..."
#
# Auto-provision the first box on first login. When "true" (and box
# provisioning above is configured), a user who authenticates with zero boxes
# gets exactly one EC2 box spun up automatically. Off by default; the box-CRUD
# UI (POST /api/instances) is unaffected either way. Fired async — a slow or
# failed spin-up never blocks login.
# AUTO_PROVISION_FIRST_BOX="false"
#
# Name given to the auto-provisioned first box. Default "default".
# AUTO_PROVISION_BOX_NAME="default"

# -----------------------------------------------------------------------------
# Tunables (all have defaults — override only if needed)
# -----------------------------------------------------------------------------

# Max seconds to wait for a `claude` CLI invocation before killing it.
CLAUDE_TIMEOUT_SECONDS=120

# Max characters of agent output sent back in a Slack/Discord response.
MAX_RESPONSE_LENGTH=3500

# Min seconds between successive DM commands from the same user.
RATE_LIMIT_SECONDS=2

# How often (ms) to flush partial streaming updates to Slack/Discord.
STREAMING_UPDATE_INTERVAL_MS=1500
